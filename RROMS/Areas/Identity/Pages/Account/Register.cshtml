@page
@model RROMS.Areas.Identity.Pages.Account.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using RROMS.Models
@{
    // US01 (Owner: Member 1): customer registration page.
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create account";
    ViewData["FullWidth"] = true;   // lets the decorations reach the page edges
}

@* Small SVG country flags for the phone picker (emoji flags don't show on Windows) *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" />

<section class="auth-page">
    @* Decoration: sakura branch at the top right (hidden on small screens) *@
    <img class="auth-art auth-sakura" src="~/images/sakura-branch.png" alt="" aria-hidden="true" />

    @* Decoration: a few loose petals drifting down from the branch (hidden on small screens) *@
    <span class="auth-petal p1" aria-hidden="true"></span>
    <span class="auth-petal p2" aria-hidden="true"></span>
    <span class="auth-petal p3" aria-hidden="true"></span>
    <span class="auth-petal p4" aria-hidden="true"></span>

    <div class="container-xl">
        <div class="auth-wrap">
            @* Decoration: Fuji and the red sun at the card's bottom-left corner *@
            <img class="auth-art auth-fuji" src="~/images/fuji-sun.png" alt="" aria-hidden="true" />

            <div class="auth2">
                @* Left: welcome panel (hidden on small screens) *@
                <div class="auth2-side">
                    <img src="~/images/yoru-logo-dark.png" alt="YORU IZAKAYA" class="auth2-logo" />
                    <p class="auth2-jp">いらっしゃいませ</p>
                    <h2 class="auth2-headline">Your night<br />starts here.</h2>
                    <span class="auth2-bar" aria-hidden="true"></span>
                    <p class="auth2-lede">Good food, great drinks, and better company, all in one place.</p>

                    <ul class="auth2-features">
                        <li>
                            <span class="auth2-icon"><i class="bi bi-shop"></i></span>
                            <span><b>Reserve your table</b><small>Skip the wait, enjoy the night.</small></span>
                        </li>
                        <li>
                            <span class="auth2-icon"><i class="bi bi-cup-hot"></i></span>
                            <span><b>Order your favourites</b><small>Tasty dishes, just a tap away.</small></span>
                        </li>
                        <li>
                            <span class="auth2-icon"><i class="bi bi-calendar-check"></i></span>
                            <span><b>Keep track of bookings</b><small>Your plans, always in sight.</small></span>
                        </li>
                    </ul>
                </div>

                @* Right: the form *@
                <div class="auth2-form">
                    @* Gold line on the left, small gold 夜 on the right, on the same row above the title *@
                    <div class="auth2-head" aria-hidden="true">
                        <span class="auth2-rule"></span>
                        <span class="auth2-mark">夜</span>
                    </div>
                    <h1 class="auth2-title">Join the YORU family</h1>
                    <p class="auth2-sub">Create an account for a better night out.</p>

                    <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.FullName" class="visually-hidden"></label>
                            <i class="bi bi-person auth-field-icon" aria-hidden="true"></i>
                            <input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="Full name" />
                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.Email" class="visually-hidden"></label>
                            <i class="bi bi-envelope auth-field-icon" aria-hidden="true"></i>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="Email address" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Phone: country code dropdown + the number *@
                        <div class="auth-field auth-phone mb-3">
                            <div class="auth-phone-row">
                                @* Country picker: the real <select> is sent with the form; the button + search panel
                                   are drawn on top by the script below (if JavaScript is off, the plain select shows). *@
                                <div class="auth-phone-code cc" data-cc>
                                    <label asp-for="Input.CountryCode" class="visually-hidden"></label>
                                    <select asp-for="Input.CountryCode" class="form-select cc-native" autocomplete="tel-country-code">
                                        @foreach (var c in PhoneCountries.All)
                                        {
                                            <option value="@c.Iso" data-name="@c.Name" data-dial="@c.DialCode">@c.Iso @c.DialCode</option>
                                        }
                                    </select>

                                    <button type="button" class="cc-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Country code">
                                        <span class="cc-flag fi" aria-hidden="true"></span>
                                        <span class="cc-dial"></span>
                                        <i class="bi bi-chevron-down cc-caret" aria-hidden="true"></i>
                                    </button>

                                    <div class="cc-panel" hidden>
                                        <div class="cc-search">
                                            <i class="bi bi-search" aria-hidden="true"></i>
                                            <input type="text" class="cc-input" placeholder="Search country or code" aria-label="Search country or code" autocomplete="off" />
                                        </div>
                                        <ul class="cc-list" role="listbox" aria-label="Countries"></ul>
                                        <p class="cc-empty" hidden><i class="bi bi-globe2 me-1" aria-hidden="true"></i>No country found</p>
                                    </div>
                                </div>
                                <label asp-for="Input.PhoneNumber" class="visually-hidden"></label>
                                <input asp-for="Input.PhoneNumber" class="form-control" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="Phone number (e.g. 12-345 6789)" />
                            </div>
                            <span asp-validation-for="Input.CountryCode" class="text-danger small"></span>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.Password" class="visually-hidden"></label>
                            <i class="bi bi-lock auth-field-icon" aria-hidden="true"></i>
                            <input asp-for="Input.Password" class="form-control has-eye" autocomplete="new-password" placeholder="Password" />
                            <button type="button" class="auth-eye" data-eye-for="Input_Password" aria-label="Show password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="auth-field mb-3">
                            <label asp-for="Input.ConfirmPassword" class="visually-hidden"></label>
                            <i class="bi bi-lock auth-field-icon" aria-hidden="true"></i>
                            <input asp-for="Input.ConfirmPassword" class="form-control has-eye" autocomplete="new-password" placeholder="Confirm password" />
                            <button type="button" class="auth-eye" data-eye-for="Input_ConfirmPassword" aria-label="Show password">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <p class="auth2-hint">At least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol.</p>

                        <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg w-100 auth2-submit">
                            Create account <i class="bi bi-arrow-right ms-1"></i>
                        </button>

                        <div class="auth2-divider" aria-hidden="true"><span>✦</span></div>

                        <p class="auth2-switch">Already a member? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Eye button: closed eye = password hidden, open eye = password shown.
        document.querySelectorAll('[data-eye-for]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.eyeFor);
                var show = input.type === 'password';          // hidden now, so show it
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye' : 'bi bi-eye-slash';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        });

        // Country picker with search (phone number).
        document.querySelectorAll('[data-cc]').forEach(function (box) {
            var select = box.querySelector('.cc-native');
            var btn = box.querySelector('.cc-btn');
            var panel = box.querySelector('.cc-panel');
            var search = box.querySelector('.cc-input');
            var list = box.querySelector('.cc-list');
            var empty = box.querySelector('.cc-empty');
            var active = -1;   // highlighted row while using the arrow keys

            box.classList.add('cc-ready');   // hides the plain select, shows the button

            // One row per country: [MY]  Malaysia ............ +60
            var items = Array.prototype.map.call(select.options, function (opt) {
                var li = document.createElement('li');
                li.className = 'cc-item';
                li.setAttribute('role', 'option');
                li.dataset.value = opt.value;
                li.innerHTML = '<span class="cc-flag fi" aria-hidden="true"></span><span class="cc-name"><span></span><small class="cc-iso"></small></span><span class="cc-code"></span><i class="bi bi-check2 cc-tick" aria-hidden="true"></i>';
                li.querySelector('.cc-flag').classList.add('fi-' + opt.value.toLowerCase());
                li.querySelector('.cc-name span').textContent = opt.dataset.name;
                li.querySelector('.cc-iso').textContent = opt.value;
                li.querySelector('.cc-code').textContent = opt.dataset.dial;
                li.dataset.search = (opt.dataset.name + ' ' + opt.value + ' ' + opt.dataset.dial + ' ' + opt.dataset.dial.replace('+', '')).toLowerCase();
                li.addEventListener('click', function () { choose(opt.value); });
                list.appendChild(li);
                return li;
            });

            function current() { return select.options[select.selectedIndex]; }

            function render() {
                var opt = current();
                btn.querySelector('.cc-flag').className = 'cc-flag fi fi-' + opt.value.toLowerCase();
                btn.setAttribute('aria-label', 'Country code: ' + opt.dataset.name + ' ' + opt.dataset.dial);
                btn.querySelector('.cc-dial').textContent = opt.dataset.dial;
                items.forEach(function (li) {
                    var on = li.dataset.value === opt.value;
                    li.classList.toggle('is-selected', on);
                    li.setAttribute('aria-selected', on);
                });
            }

            function visible() { return items.filter(function (li) { return !li.hidden; }); }

            function highlight(i) {
                var rows = visible();
                rows.forEach(function (li) { li.classList.remove('is-active'); });
                if (!rows.length) { active = -1; return; }
                active = (i + rows.length) % rows.length;
                rows[active].classList.add('is-active');
                rows[active].scrollIntoView({ block: 'nearest' });
            }

            function filter() {
                var q = search.value.trim().toLowerCase().replace(/^\+/, '');
                items.forEach(function (li) { li.hidden = q !== '' && li.dataset.search.indexOf(q) === -1; });
                empty.hidden = visible().length > 0;
                highlight(0);
            }

            function open() {
                panel.hidden = false;
                btn.setAttribute('aria-expanded', 'true');
                box.classList.add('is-open');
                search.value = '';
                filter();
                var sel = list.querySelector('.is-selected');
                if (sel) { highlight(visible().indexOf(sel)); }
                search.focus();
            }

            function close(backToButton) {
                panel.hidden = true;
                btn.setAttribute('aria-expanded', 'false');
                box.classList.remove('is-open');
                if (backToButton) { btn.focus(); }
            }

            function choose(value) {
                select.value = value;
                select.dispatchEvent(new Event('change', { bubbles: true }));
                render();
                close(false);
                var phone = document.getElementById('Input_PhoneNumber');   // ready to type the number
                if (phone) { phone.focus(); }
            }

            btn.addEventListener('click', function () { panel.hidden ? open() : close(true); });
            search.addEventListener('input', filter);
            search.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); highlight(active + 1); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active - 1); }
                else if (e.key === 'Enter') {
                    e.preventDefault();   // don't submit the form
                    var rows = visible();
                    if (rows[active]) { choose(rows[active].dataset.value); }
                }
                else if (e.key === 'Escape') { close(true); }
            });
            document.addEventListener('click', function (e) { if (!box.contains(e.target)) { close(false); } });

            render();
        });
    </script>
}
