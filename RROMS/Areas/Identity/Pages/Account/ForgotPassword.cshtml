@page
@model RROMS.Areas.Identity.Pages.Account.ForgotPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // US52 (Member 1): step 1, ask for the email.
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["FullWidth"] = true;   // the scene goes edge to edge
    var signedIn = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = "Forgot password";
    ViewData["Kanji"] = "鍵";
    ViewData["ArtTitle"] = "Forgot<br />password?";
    ViewData["ArtJp"] = "パスワードをお忘れですか";
    ViewData["ArtText"] = "No problem. We'll email you a link to choose a new one.";
    ViewData["Step"] = 1;
    var error = ViewData.ModelState[nameof(Model.Email)]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<link rel="stylesheet" href="~/css/profile-security.css" asp-append-version="true" />
<partial name="_ResetIcons" />

<main class="sx-page sx-scene">
    <div class="sx-box" role="region" aria-labelledby="fpTitle">
        <partial name="_ResetArt" />

        <div class="sx-card">
            <form method="post" class="sx-form" novalidate data-sx-reset="email">
                <div class="sx-orn" aria-hidden="true"><i></i><span>✿</span><i></i></div>
                <div class="sx-head">
                    <h3 id="fpTitle">Reset your password</h3>
                    <p>Enter the email you use to log in.</p>
                </div>

                <div class="sx-field @(error is null ? "" : "bad")">
                    <label for="Email">Email</label>
                    <div class="sx-in">
                        <svg aria-hidden="true"><use href="#ri-mail" /></svg>
                        <input asp-for="Email" type="email" autocomplete="email" maxlength="256" placeholder="name@example.com" required autofocus />
                    </div>
                    <span class="sx-err" data-err>@error</span>
                </div>

                <div class="sx-note">
                    <svg aria-hidden="true"><use href="#ri-info" /></svg>
                    <div>If this email has a YORU account, we'll send a link to choose a new password. The link works <b>once</b>, for <b>1 hour</b>.</div>
                </div>

                <div class="sx-btns">
                    @* Logged in = came from "Forgot it?" on My profile, so go back there *@
                    <a class="sx-btn ghost" href="@(signedIn ? "/Identity/Account/Manage" : "/Identity/Account/Login")">@(signedIn ? "Back to my profile" : "Back to log in")</a>
                    <button type="submit" class="sx-btn main" data-sx-submit><span class="sx-spin" aria-hidden="true"></span>Send reset link <svg class="sx-arrow-ic" aria-hidden="true"><use href="#ri-arrow" /></svg></button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}
