@page
@model RROMS.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // US52 (Member 1): step 2, link sent. Same wording whether or not the email has an account.
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["FullWidth"] = true;   // the scene goes edge to edge
    var signedIn = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = "Check your inbox";
    ViewData["Kanji"] = "済";
    ViewData["Done"] = true;
    ViewData["ArtTitle"] = "Link<br />sent";
    ViewData["ArtJp"] = "メールを送信しました";
    ViewData["ArtText"] = "Almost there. Open the email and click the link within 1 hour.";
    ViewData["Step"] = 2;
}

<link rel="stylesheet" href="~/css/profile-security.css" asp-append-version="true" />
<partial name="_ResetIcons" />

<main class="sx-page sx-scene">
    <div class="sx-box" role="region" aria-labelledby="fpcTitle">
        <partial name="_ResetArt" />

        <div class="sx-card">
            <div class="sx-done">
                <div class="sx-orn" aria-hidden="true"><i></i><span>✿</span><i></i></div>
                <div class="sx-tick" aria-hidden="true"><svg><use href="#ri-mail" /></svg></div>
                <h3 id="fpcTitle">Check your inbox</h3>
                @if (!string.IsNullOrEmpty(Model.SentTo))
                {
                    <p>If an account uses this email, we've sent a reset link to</p>
                    <div class="sx-chip"><svg aria-hidden="true"><use href="#ri-mail" /></svg><span>@Model.SentTo</span></div>
                }
                else
                {
                    <p>If an account uses that email, we've sent a reset link to it.</p>
                }
                <p style="font-size:.86rem">The link works once, for 1 hour.<br />Not there? Check Spam, or send it again.</p>

                <div class="sx-btns">
                    @if (!string.IsNullOrEmpty(Model.SentTo))
                    {
                        <form method="post" asp-page="./ForgotPassword">
                            <input type="hidden" name="Email" value="@Model.SentTo" />
                            <button type="submit" class="sx-btn link">Send again</button>
                        </form>
                    }
                    else
                    {
                        <a class="sx-btn link" href="/Identity/Account/ForgotPassword">Try another email</a>
                    }
                    <a class="sx-btn main" href="@(signedIn ? "/Identity/Account/Manage" : "/Identity/Account/Login")">@(signedIn ? "Back to my profile" : "Back to log in")</a>
                </div>
            </div>
        </div>
    </div>
</main>
