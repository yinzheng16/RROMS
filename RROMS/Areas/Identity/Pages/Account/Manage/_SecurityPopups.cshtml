@model RROMS.Services.Interfaces.ProfileView
@{
    // US03 / US04 (Member 1): Change password + Change email pop-ups, opened from the Security section.
    // Styles: wwwroot/css/profile-security.css · Script: wwwroot/js/profile-security.js
    // The forms post with fetch() to ?handler=ChangePassword / ?handler=ChangeEmail (Index.cshtml.cs).
    const string Lock = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linejoin='round'><rect x='5' y='10' width='14' height='11' rx='2'/><path d='M8 10V7a4 4 0 0 1 8 0v3'/></svg>";
    const string Shield = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linejoin='round'><path d='M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z'/></svg>";
    const string Check = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='m5 12 5 5L20 7'/></svg>";
    const string Mail = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='m3 7 9 6 9-6'/></svg>";
    const string Info = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='9'/><path d='M12 8v5M12 16h.01'/></svg>";
    // Eye button: slashed eye while the password is hidden, open eye while shown (same as Login / Register).
    const string Eye = "<svg class='eye-shut' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round'><path d='M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.6 3.5M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7c1.9 0 3.6-.6 5-1.5'/><path d='M9.9 9.9a3 3 0 0 0 4.2 4.2'/><path d='M3 3l18 18'/></svg><svg class='eye-open' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8'><path d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z'/><circle cx='12' cy='12' r='3'/></svg>";
    // Caution sign: red triangle with a white "!" (same as the allergy alert on My profile).
    const string Caution = "<svg class='sx-caution' viewBox='0 0 24 22' aria-hidden='true'><path d='M10.3 1.6a2 2 0 0 1 3.4 0l9.7 16.8a2 2 0 0 1-1.7 3H2.3a2 2 0 0 1-1.7-3z' fill='#c83e2d'/><rect x='10.8' y='6.5' width='2.4' height='7.5' rx='1.2' fill='#fff'/><circle cx='12' cy='17.2' r='1.4' fill='#fff'/></svg>";
    const string Arrow = "<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:-3px;margin-left:.35rem'><path d='M5 12h14M13 6l6 6-6 6'/></svg>";
    const string Tick = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><path d='m5 12 5 5L20 7'/></svg>";
}

@* ================= Change password ================= *@
<div class="sx" id="sxPwd" role="dialog" aria-modal="true" aria-labelledby="sxPwdTitle" aria-hidden="true">
    <div class="sx-box">
        <aside class="sx-art">
            <div class="sx-stamp" data-sx-stamp><span class="jp" aria-hidden="true" data-sx-kanji>鍵</span></div>
            <h2 id="sxPwdTitle" data-sx-art-title data-done="Password&lt;br /&gt;changed">Change<br />password</h2>
            <div class="sx-jp jp" lang="ja" data-sx-art-jp data-done="パスワードを変更しました">パスワードの変更</div>
            <p data-sx-art-text data-done="All set. Your account is protected with your new password.">A new password keeps your bookings and orders safe.</p>
            <ol class="sx-steps" data-sx-steps>
                <li class="on">Your current password</li>
                <li>Choose a new one</li>
                <li>Confirmation email</li>
            </ol>
        </aside>

        <div class="sx-card">
            <button type="button" class="sx-x" data-sx-close aria-label="Close">✕</button>

            <form class="sx-form" data-sx-handler="ChangePassword" novalidate autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="sx-head"><h3>Set a new password</h3><p>Enter your current password first.</p></div>

                <div class="sx-field" data-field="CurrentPassword">
                    <label for="sxCurrent">Current password <a href="/Identity/Account/ForgotPassword">Forgot it?</a></label>
                    <div class="sx-in">@Html.Raw(Lock)<input id="sxCurrent" name="currentPassword" type="password" autocomplete="current-password" required /><button type="button" class="sx-eye" data-sx-eye aria-label="Show password">@Html.Raw(Eye)</button></div>
                    <span class="sx-err" data-err></span>
                </div>

                <div class="sx-note warn" data-sx-tries hidden>
                    @Html.Raw(Caution)
                    <div><b data-sx-tries-text></b><div class="sx-tries" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div><div style="margin-top:.35rem" data-sx-tries-help>After 5 wrong tries, your account is locked for 15 minutes.</div></div>
                </div>

                <div class="sx-field" data-field="NewPassword">
                    <label for="sxNew">New password</label>
                    <div class="sx-in">@Html.Raw(Shield)<input id="sxNew" name="newPassword" type="password" autocomplete="new-password" required /><button type="button" class="sx-eye" data-sx-eye aria-label="Show password">@Html.Raw(Eye)</button></div>
                    <div class="sx-meter" data-sx-meter aria-hidden="true"><b></b><b></b><b></b><b></b></div>
                    <div class="sx-mlabel"><span>Strength</span><span data-sx-strength>Start typing</span></div>
                    <span class="sx-err" data-err></span>
                </div>
                <ul class="sx-rules" data-sx-rules aria-label="Password rules">
                    <li data-rule="len">8+ characters</li>
                    <li data-rule="upper">A–Z</li>
                    <li data-rule="lower">a–z</li>
                    <li data-rule="digit">0–9</li>
                    <li data-rule="symbol">Symbol</li>
                    <li data-rule="diff">Not your current one</li>
                </ul>

                <div class="sx-field" data-field="ConfirmPassword">
                    <label for="sxConfirm">Confirm new password</label>
                    <div class="sx-in">@Html.Raw(Check)<input id="sxConfirm" name="confirmPassword" type="password" autocomplete="new-password" placeholder="Type it again" required /><button type="button" class="sx-eye" data-sx-eye aria-label="Show password">@Html.Raw(Eye)</button></div>
                    <span class="sx-ok" data-sx-match hidden>✓ Passwords match</span>
                    <span class="sx-err" data-err></span>
                </div>

                <div class="sx-note" data-sx-hint>@Html.Raw(Mail)<div>We'll email you when it's changed. You stay logged in on this device.</div></div>
                <div class="sx-err sx-general" data-sx-general role="alert"></div>

                <div class="sx-btns">
                    <button type="button" class="sx-btn ghost" data-sx-close>Cancel</button>
                    <button type="submit" class="sx-btn main" data-sx-submit><span class="sx-spin" aria-hidden="true"></span>Change password @Html.Raw(Arrow)</button>
                </div>
            </form>

            <div class="sx-done" data-sx-done hidden>
                <div class="sx-tick" aria-hidden="true">@Html.Raw(Tick)</div>
                <h3>Password changed</h3>
                <p>We've emailed <b data-sx-done-email></b> to confirm.<br />Use your new password next time you log in.</p>
                <div class="sx-btns"><button type="button" class="sx-btn main" data-sx-close>Done</button></div>
            </div>
        </div>
    </div>
</div>

@* ================= Change email ================= *@
<div class="sx" id="sxEmail" role="dialog" aria-modal="true" aria-labelledby="sxEmailTitle" aria-hidden="true">
    <div class="sx-box">
        <aside class="sx-art">
            <div class="sx-stamp" data-sx-stamp><span class="jp" aria-hidden="true" data-sx-kanji>便</span></div>
            <h2 id="sxEmailTitle" data-sx-art-title data-done="Link&lt;br /&gt;sent">Change<br />email</h2>
            <div class="sx-jp jp" lang="ja" data-sx-art-jp data-done="確認リンクを送信しました">メールアドレスの変更</div>
            <p data-sx-art-text data-done="Almost done. One click in your new inbox and it's yours.">This is the address you log in with and where your booking emails go.</p>
            <ol class="sx-steps" data-sx-steps>
                <li class="on">New email + your password</li>
                <li>Click the link we send</li>
                <li>Log in with the new email</li>
            </ol>
        </aside>

        <div class="sx-card">
            <button type="button" class="sx-x" data-sx-close aria-label="Close">✕</button>

            <form class="sx-form" data-sx-handler="ChangeEmail" novalidate autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="sx-head"><h3>Move to a new address</h3><p>We'll send a confirmation link to your new email.</p></div>

                <div class="sx-journey">
                    <div class="sx-jcard"><small>Now</small><b>@Model.Email</b></div>
                    <span class="sx-arrow" aria-hidden="true">→</span>
                    <div class="sx-jcard new"><small>New</small><b data-sx-new></b></div>
                </div>

                <div class="sx-field" data-field="NewEmail">
                    <label for="sxNewEmail">New email</label>
                    <div class="sx-in">@Html.Raw(Mail)<input id="sxNewEmail" name="newEmail" type="email" autocomplete="email" maxlength="256" placeholder="name@example.com" required /></div>
                    <span class="sx-err" data-err></span>
                </div>

                <div class="sx-field" data-field="Password">
                    <label for="sxEmailPwd">Your password <a href="/Identity/Account/ForgotPassword">Forgot it?</a></label>
                    <div class="sx-in">@Html.Raw(Lock)<input id="sxEmailPwd" name="password" type="password" autocomplete="current-password" required /><button type="button" class="sx-eye" data-sx-eye aria-label="Show password">@Html.Raw(Eye)</button></div>
                    <span class="sx-err" data-err></span>
                </div>

                <div class="sx-note warn" data-sx-tries hidden>
                    @Html.Raw(Caution)
                    <div><b data-sx-tries-text></b><div class="sx-tries" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b></div><div style="margin-top:.35rem" data-sx-tries-help>After 5 wrong tries, your account is locked for 15 minutes.</div></div>
                </div>

                <div class="sx-note" data-sx-hint>@Html.Raw(Info)<div>We'll send a link to the <b>new</b> address. Nothing changes until you click it. The link works for 24 hours.</div></div>
                <div class="sx-err sx-general" data-sx-general role="alert"></div>

                <div class="sx-btns">
                    <button type="button" class="sx-btn ghost" data-sx-close>Cancel</button>
                    <button type="submit" class="sx-btn main" data-sx-submit><span class="sx-spin" aria-hidden="true"></span>Send confirmation link @Html.Raw(Arrow)</button>
                </div>
            </form>

            <div class="sx-done" data-sx-done hidden>
                <div class="sx-tick" aria-hidden="true">@Html.Raw(Mail)</div>
                <h3>Check your new inbox</h3>
                <p>We sent a confirmation link to</p>
                <div class="sx-chip">@Html.Raw(Mail)<span data-sx-done-email></span></div>
                <p style="font-size:.86rem">Until you click it, keep logging in with <b>@Model.Email</b>.<br />Not there? Check Spam, or send it again.</p>
                <div class="sx-btns">
                    <button type="button" class="sx-btn link" data-sx-resend>Send again</button>
                    <button type="button" class="sx-btn main" data-sx-close>Done</button>
                </div>
                <span class="sx-resent" data-sx-resent aria-live="polite"></span>
            </div>
        </div>
    </div>
</div>
