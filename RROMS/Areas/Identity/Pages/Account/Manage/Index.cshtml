@page
@model RROMS.Areas.Identity.Pages.Account.Manage.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using RROMS.Models
@using RROMS.Services.Interfaces
@{
    // US03 / US04 (Owner: Member 1): My profile.
    Layout = "/Pages/Shared/_Layout.cshtml";   // our site layout, not Identity's "Manage your account" layout
    ViewData["Title"] = "My profile";
    ViewData["FullWidth"] = true;

    var p = Model.Profile;
    var isCustomer = p.Role == Roles.Customer;
    var words = p.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var seal = p.Role == Roles.Admin ? "管" : p.Role == Roles.Staff ? "職" : "客";
    var allergies = p.Preferences.Where(DiningOptions.Allergies.Contains).ToList();
    var diet = p.Preferences.Where(DiningOptions.Diet.Contains).ToList();
    bool Bad(string key) => ViewData.ModelState.TryGetValue(key, out var e) && e.Errors.Count > 0;
    bool Picked(string chip) => Model.Input.Preferences.Contains(chip);
}

@* Small inline icons (no icon font needed) *@
@functions {
    static string Icon(string name) => name switch
    {
        "home" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><path d='M3 11 12 4l9 7v9h-6v-6H9v6H3z'/></svg>",
        "user" => "<svg viewBox='0 0 24 24' fill='currentColor'><circle cx='12' cy='8' r='4'/><path d='M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7z'/></svg>",
        "mail" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='m3 7 9 6 9-6'/></svg>",
        "phone" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><path d='M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z'/></svg>",
        "fork" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round'><path d='M7 3v8M4.5 3v5a2.5 2.5 0 0 0 5 0V3M7 11v10M17 21V3c-2.5 1-4 3.5-4 7v4h4'/></svg>",
        "shield" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linejoin='round'><path d='M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z'/><path d='m8.5 12 2.5 2.5 4.5-5'/></svg>",
        "warn" => "<svg viewBox='0 0 24 24' fill='currentColor'><path d='M12 2 1 21h22L12 2Zm1 15h-2v2h2v-2Zm0-7h-2v5h2v-5Z'/></svg>",
        "leaf" => "<svg viewBox='0 0 24 24' fill='currentColor'><path d='M20 3C10 3 4 8 4 15c0 2 .5 3.5 1.2 4.6L3 22l1.4 1.4 2.3-2.3C8 21.6 9.5 22 11 22c6 0 10-6 9-19ZM7 19.5c2-5 5-8 9-10.5-3 3.5-5.3 6.5-7 11.2A6 6 0 0 1 7 19.5Z'/></svg>",
        "note" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><path d='M6 3h9l4 4v14H6z'/><path d='M9 11h7M9 15h7'/></svg>",
        "lock" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linejoin='round'><rect x='5' y='10' width='14' height='11' rx='2'/><path d='M8 10V7a4 4 0 0 1 8 0v3'/></svg>",
        "chev" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 5 7 7-7 7'/></svg>",
        "pen" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><path d='M4 20h4L19 9l-4-4L4 16z'/></svg>",
        "arrow" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14M13 6l6 6-6 6'/></svg>",
        "clock" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><circle cx='12' cy='13' r='8'/><path d='M12 9v4l2.5 2M9 3h6'/></svg>",
        "save" => "<svg viewBox='0 0 24 24' fill='currentColor'><path d='M5 3h11l3 3v15H5zM8 5v4h7V5zm4 8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z'/></svg>",
        "badge" => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linejoin='round'><rect x='4' y='3' width='16' height='18' rx='2'/><circle cx='12' cy='10' r='3'/><path d='M8 17c.6-1.8 2.1-3 4-3s3.4 1.2 4 3'/></svg>",
        _ => ""
    };
}

@* Small SVG country flags for the phone picker (same as Register) *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" />
<link rel="stylesheet" href="~/css/profile-security.css" asp-append-version="true" />

<main class="pf">
    @* Rough edge for the stamp icons *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="pfStamp"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="3.5" /></filter></svg>
    <span class="pf-header-art" aria-hidden="true"></span>
    <span class="pf-foot-art" aria-hidden="true"></span>
    <span class="pf-petal" style="left:6%;top:42%;transform:rotate(30deg)" aria-hidden="true"></span>
    <span class="pf-petal" style="left:3%;top:70%;transform:rotate(-20deg)" aria-hidden="true"></span>
    <span class="pf-petal" style="right:4%;top:55%" aria-hidden="true"></span>

    <div class="container-xl">
        <div class="pf-crumb">@Html.Raw(Icon("home")) My Account <span>›</span> <span class="jp">マイページ</span></div>
        <div class="pf-head">
            <h1>My profile</h1>
            <p>@(isCustomer ? "Keep your details up to date so we can welcome you properly." : "Keep your details up to date.")</p>
        </div>

        <form method="post" id="pfForm" novalidate>
            <div class="pf-grid">

                @* ---------- Member card ---------- *@
                <aside class="pf-card">
                    <img class="pf-card-sakura" src="~/images/profile/profile-card-sakura.webp" alt="" aria-hidden="true" />
                    <div class="pf-id">
                        <div class="pf-avatar" aria-hidden="true">
                            <img src="~/images/profile/profile-enso.webp" alt="" />
                            <b>@initials</b>
                        </div>
                        <h2 class="pf-name">@p.FullName</h2>
                        <div class="pf-email">@p.Email</div>
                        <span class="pf-role"><i class="jp">@seal</i>@p.Role</span>
                        @if (!isCustomer)
                        {
                            <div><a class="pf-ws" href="@Model.WorkspaceUrl">Go to my workspace @Html.Raw(Icon("arrow"))</a></div>
                        }
                    </div>

                    <div class="pf-progress">
                        <p>Profile <b>@p.PercentComplete%</b> complete@(p.PercentComplete == 100 ? " ✓" : "")</p>
                        <div class="pf-bar" role="progressbar" aria-valuenow="@p.PercentComplete" aria-valuemin="0" aria-valuemax="100"><i style="width:@(p.PercentComplete)%"></i></div>
                        @if (p.NextStepText is not null)
                        {
                            <a class="pf-next" href="@p.NextStepAnchor">@Html.Raw(Icon("pen")) @p.NextStepText @Html.Raw(Icon("arrow"))</a>
                        }
                    </div>

                    <ul class="pf-rows">
                        @if (isCustomer)
                        {
                            <li>@Html.Raw(Icon("clock"))<span>Member since</span>@p.MemberSince.ToString("MMM yyyy")</li>
                            <li>@Html.Raw(Icon("phone"))<span>Phone</span>@(p.PhoneDisplay ?? "—")</li>
                        }
                        else
                        {
                            <li>@Html.Raw(Icon("badge"))<span>Role</span>@p.Role</li>
                            <li>@Html.Raw(Icon("clock"))<span>Joined</span>@p.MemberSince.ToString("MMM yyyy")</li>
                            <li>@Html.Raw(Icon("shield"))<span>Status</span><b class="pf-status @(p.IsActive ? "is-on" : "is-off")">@(p.IsActive ? "Active" : "Inactive")</b></li>
                        }
                    </ul>

                    @if (isCustomer)
                    {
                        <div class="pf-see">
                            <img class="pf-see-lantern" src="~/images/profile/profile-lantern.webp" alt="" aria-hidden="true" />
                            <h3>What our staff will see</h3>
                            <div class="pf-tags">
                                @if (p.Preferences.Count == 0 && p.Notes is null)
                                {
                                    <em>Nothing yet. Tell us about allergies below.</em>
                                }
                                @foreach (var a in allergies) { <i class="al"><b class="pf-alert" aria-hidden="true">!</b> @a</i> }
                                @foreach (var d in diet) { <i>@d</i> }
                                @if (p.Preferences.Contains(DiningOptions.None)) { <i>@DiningOptions.None</i> }
                                @if (p.Notes is not null) { <i>+ notes</i> }
                            </div>
                        </div>
                    }
                </aside>

                <div class="pf-main">
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    @* ---------- Personal details ---------- *@
                    <section class="pf-sec pf-sec-top">
                        <img class="pf-sec-sakura" src="~/images/profile/profile-sprig.webp" alt="" aria-hidden="true" />
                        <div class="pf-sec-head">
                            <span class="pf-sec-ico">@Html.Raw(Icon("user"))</span>
                            <div><h2>Personal details</h2><p>Your name and how we can reach you.</p></div>
                        </div>
                        <div class="pf-fields">
                            <div class="full">
                                <label class="pf-label" asp-for="Input.FullName">Full name</label>
                                <div class="pf-input @(Bad("Input.FullName") ? "is-bad" : "")">
                                    <span>@Html.Raw(Icon("user"))</span>
                                    <input asp-for="Input.FullName" autocomplete="name" maxlength="100" />
                                </div>
                                <span asp-validation-for="Input.FullName" class="pf-err"></span>
                            </div>
                            <div>
                                <div class="pf-label">@Html.Raw(Icon("mail")) Email</div>
                                <div class="pf-input locked">
                                    <span>@Html.Raw(Icon("mail"))</span>
                                    <input value="@p.Email" readonly aria-label="Email (read only)" />
                                </div>
                                <div class="pf-hint">Used to log in. You can change it under Security.</div>
                            </div>
                            <div class="pf-split" id="pf-phone">
                                <label class="pf-label" asp-for="Input.PhoneNumber">@Html.Raw(Icon("phone")) Phone number</label>
                                <div class="pf-phone">
                                    @* Same country picker as Register (US01): flag, search box, keyboard support.
                                       The real <select> is sent with the form; the button + panel are drawn by the script below. *@
                                    <div class="cc" data-cc>
                                        <select asp-for="Input.CountryCode" class="form-select cc-native" aria-label="Country code" autocomplete="tel-country-code">
                                            @foreach (var c in PhoneCountries.All)
                                            {
                                                <option value="@c.Iso" data-name="@c.Name" data-dial="@c.DialCode">@c.Iso @c.DialCode</option>
                                            }
                                        </select>
                                        <button type="button" class="cc-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Country code">
                                            <span class="cc-flag fi" aria-hidden="true"></span>
                                            <span class="cc-dial"></span>
                                            <i class="bi bi-chevron-down cc-caret" aria-hidden="true"></i>
                                        </button>
                                        <div class="cc-panel" hidden>
                                            <div class="cc-search">
                                                <i class="bi bi-search" aria-hidden="true"></i>
                                                <input type="text" class="cc-input" placeholder="Search country or code" aria-label="Search country or code" autocomplete="off" />
                                            </div>
                                            <ul class="cc-list" role="listbox" aria-label="Countries"></ul>
                                            <p class="cc-empty" hidden><i class="bi bi-globe2 me-1" aria-hidden="true"></i>No country found</p>
                                        </div>
                                    </div>
                                    <input asp-for="Input.PhoneNumber" class="form-control @(Bad("Input.PhoneNumber") ? "is-bad" : "")" placeholder="12-345 6789" inputmode="tel" autocomplete="tel-national" />
                                </div>
                                <span asp-validation-for="Input.PhoneNumber" class="pf-err"></span>
                                <span asp-validation-for="Input.CountryCode" class="pf-err"></span>
                            </div>
                        </div>
                    </section>

                    @* ---------- Allergies & preferences (customers only) ---------- *@
                    @if (isCustomer)
                    {
                        <section class="pf-sec" id="prefs">
                            <img class="pf-sec-sakura" src="~/images/profile/profile-sprig2.webp" alt="" aria-hidden="true" />
                            <div class="pf-sec-head">
                                <span class="pf-sec-ico">@Html.Raw(Icon("fork"))</span>
                                <div><h2>Allergies &amp; preferences</h2><p>Save them once. We'll fill them in for you when you book a table or place an order.</p></div>
                            </div>

                            <div class="pf-group">
                                <div class="pf-label al"><i class="pf-alert" aria-hidden="true">!</i> Allergies</div>
                                <div class="pf-chips">
                                    @foreach (var a in DiningOptions.Allergies)
                                    {
                                        <label class="pf-chip al"><input type="checkbox" name="Input.Preferences" value="@a" checked="@Picked(a)" /><span>@a</span></label>
                                    }
                                </div>
                            </div>
                            <div class="pf-group">
                                <div class="pf-label">@Html.Raw(Icon("leaf")) Diet &amp; lifestyle</div>
                                <div class="pf-chips">
                                    @foreach (var d in DiningOptions.Diet)
                                    {
                                        <label class="pf-chip"><input type="checkbox" name="Input.Preferences" value="@d" checked="@Picked(d)" /><span>@d</span></label>
                                    }
                                    <label class="pf-chip none"><input type="checkbox" name="Input.Preferences" value="@DiningOptions.None" checked="@Picked(DiningOptions.None)" data-none /><span>@DiningOptions.None</span></label>
                                </div>
                            </div>

                            <label class="pf-label" asp-for="Input.Notes">@Html.Raw(Icon("note")) Other notes <span class="pf-count"><span id="pfNotesCount">@(Model.Input.Notes?.Length ?? 0)</span> / @DiningOptions.NotesMaxLength</span></label>
                            <textarea asp-for="Input.Notes" class="form-control @(Bad("Input.Notes") ? "is-bad" : "")" rows="2" maxlength="@DiningOptions.NotesMaxLength" placeholder="e.g. Mild sesame allergy, celebrating anniversaries often"></textarea>
                            <span asp-validation-for="Input.Notes" class="pf-err"></span>

                            <div class="pf-autofill">
                                @Html.Raw(Icon("leaf"))
                                <div>These are added to the <b>special request</b> when you book and to your <b>order remarks</b> when you order, and you can still change them each time.</div>
                            </div>
                        </section>
                    }

                    @* ---------- Security ---------- *@
                    <section class="pf-sec">
                        <div class="pf-sec-head">
                            <span class="pf-sec-ico">@Html.Raw(Icon("shield"))</span>
                            <div><h2>Security</h2><p>Keep your account safe.</p></div>
                        </div>
                        <div class="pf-links">
                            <button type="button" class="pf-link" data-sx-open="sxPwd"><i>@Html.Raw(Icon("lock"))</i><div><b>Change password</b><small>Choose a new password</small></div>@Html.Raw(Icon("chev"))</button>
                            <button type="button" class="pf-link" data-sx-open="sxEmail"><i>@Html.Raw(Icon("mail"))</i><div><b>Change email</b><small>We'll send a confirmation link</small></div>@Html.Raw(Icon("chev"))</button>
                        </div>
                        @if (!isCustomer)
                        {
                            <div class="pf-note">Your role and account status are managed by the Administrator. Ask an admin if something here is wrong.</div>
                        }
                    </section>

                    @* ---------- Save bar (shows only when something changed) ---------- *@
                    <div class="pf-save @(ViewData.ModelState.IsValid ? "is-clean" : "")" id="pfSave">
                        <span>You have unsaved changes</span>
                        <div>
                            <button type="button" class="btn btn-link btn-sm" id="pfDiscard">Discard</button>
                            <button type="submit" class="btn btn-primary">@Html.Raw(Icon("save")) Save changes</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @* "Leave without saving?" pop-up (shown instead of the browser's plain box when a link is clicked) *@
    <div class="pf-modal" id="pfLeave" role="dialog" aria-modal="true" aria-labelledby="pfLeaveTitle" aria-hidden="true">
        <div class="pf-modal-box">
            <span class="pf-modal-seal jp" aria-hidden="true">待</span>
            <h3 id="pfLeaveTitle">Leave without saving?</h3>
            <p>You have changes on your profile that haven't been saved yet.</p>
            <div class="pf-modal-btns">
                <button type="button" class="btn btn-primary" id="pfLeaveSave">Save changes</button>
                <button type="button" class="btn btn-outline-secondary" id="pfLeaveGo">Leave without saving</button>
                <button type="button" class="btn btn-link" id="pfLeaveStay">Keep editing</button>
            </div>
        </div>
    </div>

    @* US03 / US04: Change password + Change email pop-ups (outside the profile form) *@
    <partial name="_SecurityPopups" model="Model.Profile" />
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile-security.js" asp-append-version="true"></script>
    <script>
        // US03: save bar, "No allergies" chip, notes counter, warning before leaving with unsaved changes.
        (function () {
            var form = document.getElementById('pfForm'), bar = document.getElementById('pfSave');
            if (!form || !bar) return;
            var start = new URLSearchParams(new FormData(form)).toString();
            var dirty = !bar.classList.contains('is-clean');   // after a failed save, keep the bar visible

            function check() {
                dirty = new URLSearchParams(new FormData(form)).toString() !== start;
                bar.classList.toggle('is-clean', !dirty);
            }
            form.addEventListener('input', check);
            form.addEventListener('change', check);

            // "No allergies or preferences" can't be mixed with other chips.
            var none = form.querySelector('[data-none]');
            var chips = form.querySelectorAll('input[name="Input.Preferences"]:not([data-none])');
            if (none) {
                none.addEventListener('change', function () { if (none.checked) chips.forEach(function (c) { c.checked = false; }); check(); });
                chips.forEach(function (c) { c.addEventListener('change', function () { if (c.checked) none.checked = false; check(); }); });
            }

            var notes = document.getElementById('Input_Notes'), count = document.getElementById('pfNotesCount');
            if (notes && count) notes.addEventListener('input', function () { count.textContent = notes.value.length; });

            document.getElementById('pfDiscard').addEventListener('click', function () {
                dirty = false;
                location.href = location.pathname;   // reload the saved values
            });

            form.addEventListener('submit', function () { dirty = false; });

            // Clicking a link with unsaved changes -> our own pop-up.
            var modal = document.getElementById('pfLeave'), nextUrl = null;
            function openModal(url) { nextUrl = url; modal.classList.add('show'); modal.setAttribute('aria-hidden', 'false'); document.getElementById('pfLeaveStay').focus(); }
            function closeModal() { modal.classList.remove('show'); modal.setAttribute('aria-hidden', 'true'); }
            document.addEventListener('click', function (e) {
                var a = e.target.closest('a[href]');
                if (!a || !dirty || a.target === '_blank' || a.getAttribute('href').charAt(0) === '#') return;
                e.preventDefault();
                openModal(a.href);
            });
            document.getElementById('pfLeaveStay').addEventListener('click', closeModal);
            document.getElementById('pfLeaveGo').addEventListener('click', function () { dirty = false; location.href = nextUrl; });
            document.getElementById('pfLeaveSave').addEventListener('click', function () { closeModal(); form.requestSubmit(); });
            modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

            // Closing the tab or refreshing can only use the browser's own box (browsers don't allow a custom one).
            window.addEventListener('beforeunload', function (e) { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
        })();
    </script>

    <script>
        // Country picker with search (same as Register, US01).
        document.querySelectorAll('[data-cc]').forEach(function (box) {
            var select = box.querySelector('.cc-native'), btn = box.querySelector('.cc-btn'), panel = box.querySelector('.cc-panel');
            var search = box.querySelector('.cc-input'), list = box.querySelector('.cc-list'), empty = box.querySelector('.cc-empty');
            var active = -1;
            box.classList.add('cc-ready');

            var items = Array.prototype.map.call(select.options, function (opt) {
                var li = document.createElement('li');
                li.className = 'cc-item';
                li.setAttribute('role', 'option');
                li.dataset.value = opt.value;
                li.innerHTML = '<span class="cc-flag fi" aria-hidden="true"></span><span class="cc-name"><span></span><small class="cc-iso"></small></span><span class="cc-code"></span><i class="bi bi-check2 cc-tick" aria-hidden="true"></i>';
                li.querySelector('.cc-flag').classList.add('fi-' + opt.value.toLowerCase());
                li.querySelector('.cc-name span').textContent = opt.dataset.name;
                li.querySelector('.cc-iso').textContent = opt.value;
                li.querySelector('.cc-code').textContent = opt.dataset.dial;
                li.dataset.search = (opt.dataset.name + ' ' + opt.value + ' ' + opt.dataset.dial + ' ' + opt.dataset.dial.replace('+', '')).toLowerCase();
                li.addEventListener('click', function () { choose(opt.value); });
                list.appendChild(li);
                return li;
            });

            function current() { return select.options[select.selectedIndex]; }
            function render() {
                var opt = current();
                btn.querySelector('.cc-flag').className = 'cc-flag fi fi-' + opt.value.toLowerCase();
                btn.setAttribute('aria-label', 'Country code: ' + opt.dataset.name + ' ' + opt.dataset.dial);
                btn.querySelector('.cc-dial').textContent = opt.dataset.dial;
                items.forEach(function (li) {
                    var on = li.dataset.value === opt.value;
                    li.classList.toggle('is-selected', on);
                    li.setAttribute('aria-selected', on);
                });
            }
            function visible() { return items.filter(function (li) { return !li.hidden; }); }
            function highlight(i) {
                var rows = visible();
                rows.forEach(function (li) { li.classList.remove('is-active'); });
                if (!rows.length) { active = -1; return; }
                active = (i + rows.length) % rows.length;
                rows[active].classList.add('is-active');
                rows[active].scrollIntoView({ block: 'nearest' });
            }
            function filter() {
                var q = search.value.trim().toLowerCase().replace(/^\+/, '');
                items.forEach(function (li) { li.hidden = q !== '' && li.dataset.search.indexOf(q) === -1; });
                empty.hidden = visible().length > 0;
                highlight(0);
            }
            function open() {
                panel.hidden = false; btn.setAttribute('aria-expanded', 'true'); box.classList.add('is-open');
                search.value = ''; filter();
                var sel = list.querySelector('.is-selected');
                if (sel) { highlight(visible().indexOf(sel)); }
                search.focus();
            }
            function close(backToButton) {
                panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); box.classList.remove('is-open');
                if (backToButton) { btn.focus(); }
            }
            function choose(value) {
                select.value = value;
                select.dispatchEvent(new Event('change', { bubbles: true }));   // also shows the save bar
                render(); close(false);
                var phone = document.getElementById('Input_PhoneNumber');
                if (phone) { phone.focus(); }
            }

            btn.addEventListener('click', function () { panel.hidden ? open() : close(true); });
            search.addEventListener('input', function (e) { e.stopPropagation(); filter(); });   // typing a search is not a profile change
            search.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); highlight(active + 1); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active - 1); }
                else if (e.key === 'Enter') { e.preventDefault(); var rows = visible(); if (rows[active]) { choose(rows[active].dataset.value); } }
                else if (e.key === 'Escape') { close(true); }
            });
            document.addEventListener('click', function (e) { if (!box.contains(e.target)) { close(false); } });
            render();
        });
    </script>
}
