@{
    // US52 (Member 1): left art panel shared by the Forgot / Reset password pages.
    // Same look as the Security pop-ups on My profile (profile-security.css).
    // ViewData: Kanji, Done (bool), ArtTitle (HTML), ArtJp, ArtText, Step (1-3, 4 = all done)
    // Steps (string[3], optional): other step names, e.g. the US05 welcome link.
    var done = ViewData["Done"] as bool? ?? false;
    var steps = ViewData["Steps"] as string[] ?? new[] { "Enter your email", "Click the link we send", "Choose a new password" };
    var step = ViewData["Step"] as int? ?? 1;
    string State(int n) => n < step ? "done" : n == step ? "on" : "";
}
<aside class="sx-art">
    <div class="sx-stamp @(done ? "is-done" : "")"><span class="jp" aria-hidden="true">@ViewData["Kanji"]</span></div>
    <h2>@Html.Raw(ViewData["ArtTitle"])</h2>
    <div class="sx-jp jp" lang="ja">@ViewData["ArtJp"]</div>
    <p>@ViewData["ArtText"]</p>
    <ol class="sx-steps">
        <li class="@State(1)">@steps[0]</li>
        <li class="@State(2)">@steps[1]</li>
        <li class="@State(3)">@steps[2]</li>
    </ol>
</aside>
