@page
@model RROMS.Areas.Identity.Pages.Account.ResetPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // US52 (Member 1): step 3, choose a new password. Same rules as Register.
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["FullWidth"] = true;   // the scene goes edge to edge
    var signedIn = User.Identity?.IsAuthenticated == true;
    var ok = Model.Link.Valid;
    var welcome = Model.Welcome;   // US05: new account created by an Admin
    var heading = welcome ? "Set your password" : "Choose a new password";
    ViewData["Title"] = ok ? heading : "Link not valid";
    ViewData["Kanji"] = welcome ? "新" : "鍵";
    ViewData["ArtTitle"] = !ok ? "Link<br />not valid" : welcome ? "Welcome<br />to YORU" : "New<br />password";
    ViewData["ArtJp"] = !ok ? "リンクが無効です" : welcome ? "ようこそ" : "パスワードの再設定";
    ViewData["ArtText"] = !ok ? "No changes were made to your account."
                        : welcome ? "Choose a password to start using your new account."
                        : "Choose a strong password you haven't used here before.";
    if (welcome) ViewData["Steps"] = new[] { "Account created for you", "Open the link in the email", "Choose your password" };
    ViewData["Step"] = ok ? 3 : 2;
    var newErr = Model.ErrorFor(nameof(Model.NewPassword));
    var confErr = Model.ErrorFor(nameof(Model.ConfirmPassword));
}

<link rel="stylesheet" href="~/css/profile-security.css" asp-append-version="true" />
<partial name="_ResetIcons" />

<main class="sx-page sx-scene">
    <div class="sx-box" role="region" aria-labelledby="rpTitle">
        <partial name="_ResetArt" />

        <div class="sx-card">
            @if (ok)
            {
                <form method="post" class="sx-form" novalidate autocomplete="off" data-sx-reset="password">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Code" />
                    <input type="hidden" asp-for="Welcome" />
                    @* lets password managers save the new password against the right account *@
                    <input type="text" name="username" autocomplete="username" value="@Model.Link.MaskedEmail" hidden />

                    <div class="sx-orn" aria-hidden="true"><i></i><span>✿</span><i></i></div>
                    <div class="sx-head">
                        <h3 id="rpTitle">@heading</h3>
                        <p>For <b>@Model.Link.MaskedEmail</b></p>
                    </div>

                    <div class="sx-field @(newErr is null ? "" : "bad")">
                        <label for="NewPassword">New password</label>
                        <div class="sx-in">
                            <svg aria-hidden="true"><use href="#ri-shield" /></svg>
                            <input asp-for="NewPassword" type="password" autocomplete="new-password" required autofocus />
                            <button type="button" class="sx-eye" data-sx-eye aria-label="Show password"><svg class="eye-shut"><use href="#ri-eye-shut" /></svg><svg class="eye-open"><use href="#ri-eye-open" /></svg></button>
                        </div>
                        <div class="sx-meter" data-sx-meter aria-hidden="true"><b></b><b></b><b></b><b></b></div>
                        <div class="sx-mlabel"><span>Strength</span><span data-sx-strength>Start typing</span></div>
                        <span class="sx-err" data-err>@newErr</span>
                    </div>
                    <ul class="sx-rules" aria-label="Password rules">
                        <li data-rule="len">8+ characters</li>
                        <li data-rule="upper">A–Z</li>
                        <li data-rule="lower">a–z</li>
                        <li data-rule="digit">0–9</li>
                        <li data-rule="symbol">Symbol</li>
                    </ul>

                    <div class="sx-field @(confErr is null ? "" : "bad")">
                        <label for="ConfirmPassword">Confirm new password</label>
                        <div class="sx-in">
                            <svg aria-hidden="true"><use href="#ri-check" /></svg>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Type it again" required />
                            <button type="button" class="sx-eye" data-sx-eye aria-label="Show password"><svg class="eye-shut"><use href="#ri-eye-shut" /></svg><svg class="eye-open"><use href="#ri-eye-open" /></svg></button>
                        </div>
                        <span class="sx-ok" data-sx-match hidden>✓ Passwords match</span>
                        <span class="sx-err" data-err>@confErr</span>
                    </div>

                    <div class="sx-note">
                        <svg aria-hidden="true"><use href="#ri-mail" /></svg>
                        @if (welcome)
                        {
                            <div>After this, log in with your email and this password.</div>
                        }
                        else
                        {
                            <div>We'll email you when it's changed. If your account was locked after wrong tries, it's unlocked too.</div>
                        }
                    </div>

                    <div class="sx-btns">
                        <button type="submit" class="sx-btn main" data-sx-submit><span class="sx-spin" aria-hidden="true"></span>@(welcome ? "Save my password" : "Save new password") <svg class="sx-arrow-ic" aria-hidden="true"><use href="#ri-arrow" /></svg></button>
                    </div>
                </form>
            }
            else
            {
                <div class="sx-done">
                    <div class="sx-orn" aria-hidden="true"><i></i><span>✿</span><i></i></div>
                    <div class="sx-tick is-bad" aria-hidden="true"><svg viewBox="0 0 24 22"><use href="#ri-caution" /></svg></div>
                    <h3 id="rpTitle">This link can't be used</h3>
                    <p>@(Model.Link.Message ?? "This reset link has expired or was already used. Please ask for a new one.")</p>
                    <div class="sx-btns">
                        <a class="sx-btn link" href="@(signedIn ? "/Identity/Account/Manage" : "/Identity/Account/Login")">@(signedIn ? "Back to my profile" : "Back to log in")</a>
                        <a class="sx-btn main" href="/Identity/Account/ForgotPassword">Send a new link</a>
                    </div>
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/password-reset.js" asp-append-version="true"></script>
}
