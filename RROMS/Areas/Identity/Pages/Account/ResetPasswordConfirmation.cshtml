@page
@model RROMS.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // US52 (Member 1): all done.
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["FullWidth"] = true;   // the scene goes edge to edge
    var signedIn = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = "Password reset";
    ViewData["Kanji"] = "済";
    ViewData["Done"] = true;
    ViewData["ArtTitle"] = "All<br />set";
    ViewData["ArtJp"] = "再設定が完了しました";
    ViewData["ArtText"] = "Your account is safe and ready for your next night out.";
    ViewData["Step"] = 4;
}

<link rel="stylesheet" href="~/css/profile-security.css" asp-append-version="true" />
<partial name="_ResetIcons" />

<main class="sx-page sx-scene">
    <div class="sx-box" role="region" aria-labelledby="rpcTitle">
        <partial name="_ResetArt" />

        <div class="sx-card">
            <div class="sx-done">
                <div class="sx-orn" aria-hidden="true"><i></i><span>✿</span><i></i></div>
                <div class="sx-tick" aria-hidden="true"><svg><use href="#ri-tick" /></svg></div>
                <h3 id="rpcTitle">Password reset</h3>
                @if (!string.IsNullOrEmpty(Model.For))
                {
                    <p>The password for <b>@Model.For</b> has been changed.<br />We've sent an email to confirm.</p>
                }
                else
                {
                    <p>Your password has been changed.<br />We've sent an email to confirm.</p>
                }
                <div class="sx-btns"><a class="sx-btn main" href="/Identity/Account/Login">Log in</a></div>
            </div>
        </div>
    </div>
</main>
