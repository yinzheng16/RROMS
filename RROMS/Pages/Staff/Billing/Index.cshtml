@page
@model RROMS.Pages.Staff.Billing.IndexModel

@{
    ViewData["Title"] = "Billing & Payment Management";
}

<div class="container py-4 us32-billing">

    <!-- Find Order -->
    <div class="mb-4">
        <h2 class="mb-1">Billing & Payment Management</h2>
        <p class="text-muted mb-0">
            YORU IZAKAYA — Staff Billing & Payments
        </p>
    </div>

    <div class="card shadow-sm mb-4 billing-card">
        <div class="card-body">
            <h5 class="card-title billing-card-title mb-3">
                Find Order
            </h5>

            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label asp-for="OrderNo"
                               class="form-label billing-order-label">
                            Order Number
                        </label>

                        <input asp-for="OrderNo"
                               class="form-control"
                               placeholder="Enter Order Number"
                               maxlength="20"
                               required />
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-dark w-100">
                            Search Order
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Feedback messages -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    @if (Model.Bill != null)
    {
        <!-- Bill Details / Preview -->
        <div class="card shadow-sm mb-4 billing-card"
             id="printableBill">
            <div class="card-body">

                <!-- Print-only restaurant header -->
                <div class="yoru-print-header">
                    <div class="yoru-print-brand">
                        <img src="~/images/yoru-icon.png"
                             asp-append-version="true"
                             alt="YORU IZAKAYA Logo"
                             class="yoru-print-logo" />

                        <h1>YORU</h1>
                        <div class="yoru-print-subtitle">
                            I Z A K A Y A
                        </div>
                    </div>

                    <div class="yoru-print-divider"></div>

                    <h2>
                        @(Model.IsPreview
                            ? "BILL PREVIEW"
                            : "BILL DETAILS")
                    </h2>

                    <p>Japanese Dining</p>
                </div>

                <!-- Bill heading -->
                <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-2 bill-preview-heading">

                    <h5 class="card-title billing-card-title mb-0">
                        @(Model.IsPreview
                            ? "Bill Preview"
                            : "Bill Details")
                    </h5>
                </div>

                <p class="bill-order-number">
                    Order Number: @Model.Bill.OrderNo
                </p>

                <!-- Ordered items -->
                <h6>Ordered Items</h6>

                <div class="table-responsive">
                    <table class="table table-bordered
                        table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Menu Item</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">
                                    Unit Price (RM)
                                </th>
                                <th class="text-end">
                                    Line Total (RM)
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Bill.Items)
                            {
                                <tr>
                                    <td>@item.MenuItemName</td>
                                    <td class="text-center">
                                        @item.Quantity
                                    </td>
                                    <td class="text-end">
                                        @item.UnitPrice.ToString("F2")
                                    </td>
                                    <td class="text-end">
                                        @item.LineTotal.ToString("F2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bill totals -->
                <div class="row justify-content-end mt-4">
                    <div class="col-md-6 col-lg-5">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>
                                RM @Model.Bill.Subtotal.ToString("F2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                SST
                                (@Model.Bill.TaxRatePercent.ToString("0.##")%)
                            </span>
                            <span>
                                RM @Model.Bill.TaxAmount.ToString("F2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                Service Charge
                                (@Model.Bill.ServiceChargePercent.ToString("0.##")%)
                            </span>
                            <span>
                                RM @Model.Bill.ServiceCharge.ToString("F2")
                            </span>
                        </div>

                        <hr class="billing-total-divider" />

                        <div class="d-flex justify-content-between
                            align-items-center billing-final-total">
                            <strong>Final Total</strong>
                            <h4 class="mb-0">
                                RM @Model.Bill.TotalAmount.ToString("F2")
                            </h4>
                        </div>

                        <hr class="billing-actions-divider" />
                    </div>
                </div>

                <!-- Bill actions -->
                <div class="d-flex flex-wrap
                    align-items-center gap-2 billing-actions">

                    @if (Model.IsPreview && Model.CanGenerateBill)
                    {
                        <form method="post"
                              asp-page-handler="Generate"
                              class="mb-0">

                            <input type="hidden"
                                   name="orderNo"
                                   value="@Model.OrderNo" />

                            <button type="submit"
                                    class="btn btn-dark">
                                Confirm Bill
                            </button>
                        </form>
                    }

                    <button type="button"
                            class="btn btn-outline-dark"
                            onclick="window.print()">
                        Print Bill
                    </button>
                </div>

                <!-- Print-only footer -->
                <div class="yoru-print-footer">
                    <div class="yoru-print-divider"></div>

                    <p class="yoru-japanese">
                        ありがとうございます
                    </p>

                    <p>Thank you for dining with us.</p>
                    <strong>YORU IZAKAYA</strong>

                    @if (Model.IsPreview)
                    {
                        <p class="yoru-print-notice">
                            Preview only — not a payment receipt.
                        </p>
                    }
                    else
                    {
                        <p class="yoru-print-notice">
                            This bill is not proof of payment.
                        </p>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Management -->
        <div class="card shadow-sm mb-4
            billing-card payment-management-card">
            <div class="card-body">

                @{
                    var paymentStatus =
                        Model.LatestPayment?.Status.ToString()
                        ?? "No Payment";

                    var isPending = paymentStatus == "Pending";
                    var isPaid = paymentStatus == "Paid";
                    var isFailed = paymentStatus == "Failed";

                    var canRecordPayment =
                        !Model.IsPreview && !isPending && !isPaid;

                    var statusClass = isPaid
                        ? "bg-success"
                        : isPending
                            ? "bg-warning text-dark"
                            : isFailed
                                ? "bg-danger"
                                : "bg-secondary";
                }

                <div class="d-flex justify-content-between
                    align-items-center gap-2 mb-0">

                    <h5 class="card-title billing-card-title mb-0">
                        Payment Management
                    </h5>

                    <span class="badge @statusClass">
                        @paymentStatus
                    </span>
                </div>

                <!-- Pending / Failed / No Payment messages -->
                @if (isPending)
                {
                    <div class="payment-result
                        payment-result-pending mb-3"
                         role="status">
                        This payment is pending confirmation.
                        Confirm it only after verifying the payment,
                        or mark it as failed.
                    </div>
                }
                else if (isFailed)
                {
                    <div class="payment-result
                        payment-result-failed mb-3"
                         role="status">
                        This payment was marked as failed.
                        You can record a new payment below.
                    </div>
                }
                else if (!isPaid)
                {
                    <p class="text-muted payment-empty-message mb-3">
                        No payment transactions have been recorded
                        for this order.
                    </p>
                }

                <!-- Existing payment details -->
                @if (Model.LatestPayment != null)
                {
                    <div class="row g-3 payment-details">

                        <div class="col-md-6">
                            <div class="form-label">
                                Payment Method
                            </div>
                            <div class="payment-readonly-value">
                                @Model.LatestPayment.Method
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-label">
                                Payment Status
                            </div>
                            <div class="payment-readonly-value">
                                @paymentStatus
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-label">
                                Amount (RM)
                            </div>
                            <div class="payment-readonly-value">
                                @Model.LatestPayment.Amount.ToString("F2")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-label">
                                Transaction Reference
                            </div>
                            <div class="payment-readonly-value">
                                @(string.IsNullOrWhiteSpace(
                                    Model.LatestPayment.TransactionRef)
                                    ? "N/A"
                                    : Model.LatestPayment.TransactionRef)
                            </div>
                        </div>
                    </div>
                }

                <!-- Pending payment actions -->
                @if (isPending && Model.LatestPayment != null)
                {
                    <div class="row g-3 mt-2 payment-decision-actions">

                        <div class="col-md-6">
                            <form method="post"
                                  asp-page-handler="ConfirmPayment">

                                <input type="hidden"
                                       name="orderNo"
                                       value="@Model.OrderNo" />

                                <input type="hidden"
                                       name="paymentId"
                                       value="@Model.LatestPayment.Id" />

                                <button type="submit"
                                        class="btn btn-dark w-100">
                                    Confirm Payment
                                </button>
                            </form>
                        </div>

                        <div class="col-md-6">
                            <form method="post"
                                  asp-page-handler="MarkPaymentFailed">

                                <input type="hidden"
                                       name="orderNo"
                                       value="@Model.OrderNo" />

                                <input type="hidden"
                                       name="paymentId"
                                       value="@Model.LatestPayment.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100">
                                    Mark as Failed
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <!-- Record payment -->
                @if (canRecordPayment)
                {
                    <form method="post"
                          asp-page-handler="RecordPayment"
                          class="payment-record-form mt-3">

                        <input type="hidden"
                               name="orderNo"
                               value="@Model.OrderNo" />

                        @if (isFailed)
                        {
                            <h6 class="mb-3">
                                Record New Payment
                            </h6>
                        }

                        <fieldset class="payment-method-fieldset">
                            <legend class="form-label">
                                1. Select Payment Method
                            </legend>

                            <div class="row g-3">

                                <!-- Cash -->
                                <div class="col-sm-4">
                                    <input type="radio"
                                           class="visually-hidden payment-method-radio"
                                           name="method"
                                           id="paymentCash"
                                           value="Cash"
                                           required />

                                    <label class="payment-method-tile"
                                           for="paymentCash">
                                        <span class="payment-method-icon"
                                              aria-hidden="true">
                                            RM
                                        </span>
                                        <strong>Cash</strong>
                                    </label>
                                </div>

                                <!-- Card -->
                                <div class="col-sm-4">
                                    <input type="radio"
                                           class="visually-hidden payment-method-radio"
                                           name="method"
                                           id="paymentCard"
                                           value="Card"
                                           required />

                                    <label class="payment-method-tile"
                                           for="paymentCard">
                                        <span class="payment-method-icon"
                                              aria-hidden="true">
                                            ▭
                                        </span>
                                        <strong>Card</strong>
                                        <small>In-store</small>
                                    </label>
                                </div>

                                <!-- Online Payment -->
                                <div class="col-sm-4">
                                    @* Enable only when backend supports it. *@

                                    <input type="radio"
                                           class="visually-hidden payment-method-radio"
                                           name="method"
                                           id="paymentOnline"
                                           value="Online"
                                           disabled />

                                    <label class="payment-method-tile
                                        payment-method-tile-disabled"
                                           for="paymentOnline">
                                        <span class="payment-method-icon"
                                              aria-hidden="true">
                                            ▣
                                        </span>
                                        <strong>Online Payment</strong>
                                        <small>
                                            Coming soon
                                        </small>
                                    </label>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Payment amount -->
                        <div class="row g-3 mt-2">

                            <div class="col-md-6">
                                <div class="form-label">
                                    Amount (RM)
                                </div>
                                <div class="payment-readonly-value">
                                    @Model.Bill.TotalAmount.ToString("F2")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-label">
                                    Transaction Reference
                                </div>
                                <div class="payment-readonly-value text-muted">
                                    Assigned by payment processing
                                </div>
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100 mt-3">
                            Record Payment
                        </button>

                        <p class="text-muted small mt-2 mb-0">
                            This will record a pending payment
                            for the confirmed bill amount.
                        </p>
                    </form>
                }

                <!-- Paid: success message at the bottom -->
                @if (isPaid)
                {
                    <div class="payment-result
                        payment-result-success mt-3"
                         role="status">
                        <span aria-hidden="true">&#10003;</span>
                        Payment successfully confirmed.
                        No further action required.
                    </div>
                }
            </div>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Model.OrderNo))
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-4">
                <h5 class="mb-1">Bill Details</h5>
                <p class="text-muted mb-0">
                    Search for an order to view its bill.
                </p>
            </div>
        </div>
    }
</div>

<style>
    /* =====================================================
           YORU IZAKAYA — US32 SCREEN STYLES
           ===================================================== */

    @@media screen {

        .us32-billing .billing-card {
            margin-bottom: 24px !important;
            border-radius: 8px;
        }

            .us32-billing .billing-card > .card-body {
                padding: 24px;
            }

            .us32-billing .billing-card .billing-card-title {
                font-family: var(--font-display);
                font-size: 20px;
                font-weight: 600;
                line-height: 1.4;
                letter-spacing: 0;
                margin-bottom: 8px !important;
            }

            .us32-billing .billing-card h6 {
                font-family: var(--font-body);
                font-size: 15px;
                font-weight: 500;
                line-height: 1.5;
                margin-bottom: 12px;
            }

            .us32-billing .billing-card .form-label {
                font-family: var(--font-body);
                font-size: 14px;
                font-weight: 500;
                line-height: 1.5;
                margin-bottom: 8px;
            }

            .us32-billing .billing-card .billing-order-label {
                font-family: var(--font-body);
                font-size: 15px;
                font-weight: 500;
                line-height: 1.5;
            }

            .us32-billing .billing-card .form-control {
                font-family: var(--font-body);
                font-size: 14px;
                font-weight: 400;
                line-height: 1.5;
                min-height: 42px;
            }

            .us32-billing .billing-card p {
                font-family: var(--font-body);
                font-size: 13px;
                font-weight: 400;
                line-height: 1.65;
            }

            .us32-billing .billing-card table {
                font-family: var(--font-body);
            }

                .us32-billing .billing-card table th {
                    font-size: 11px;
                    font-weight: 600;
                    line-height: 1.5;
                    letter-spacing: .7px;
                    padding: 12px;
                }

                .us32-billing .billing-card table td {
                    font-size: 13px;
                    font-weight: 400;
                    line-height: 1.5;
                    padding: 13px 12px;
                }

            .us32-billing .billing-card
            .row.justify-content-end span {
                font-family: var(--font-body);
                font-size: 13px;
                line-height: 1.6;
            }

        .us32-billing #printableBill h4 {
            font-family: var(--font-body);
            font-size: 22px;
            font-weight: 700;
            line-height: 1.3;
        }

        .us32-billing .billing-card .btn {
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
            padding: 10px 18px;
        }

        .us32-billing .billing-card .badge {
            font-family: var(--font-body);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .3px;
        }
        /* Bill heading */
        .us32-billing #printableBill
        .bill-preview-heading {
            margin-bottom: 8px !important;
        }

            .us32-billing #printableBill
            .bill-preview-heading .billing-card-title {
                font-family: var(--font-display);
                font-size: 20px;
                font-weight: 600;
                line-height: 1.4;
                margin-bottom: 0 !important;
            }

        .us32-billing #printableBill
        .bill-order-number {
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 400;
            line-height: 1.5;
            margin-bottom: 22px !important;
        }
        /* Balanced Final Total spacing */
        .us32-billing #printableBill
        .billing-total-divider {
            margin-top: 12px !important;
            margin-bottom: 12px !important;
        }

        .us32-billing #printableBill
        .billing-final-total {
            margin: 0 !important;
            padding: 0 !important;
        }

        .us32-billing #printableBill
        .billing-actions-divider {
            margin-top: 12px !important;
            margin-bottom: 12px !important;
        }
    }

    @@media screen and (max-width: 576px) {
        .us32-billing .billing-card > .card-body {
            padding: 18px;
        }
    }

    /* =====================================================
           PAYMENT MANAGEMENT
           ===================================================== */

    /* Reduce spacing below Payment Management heading */
    .us32-billing .payment-management-card
    .payment-empty-message {
        margin-top: 0 !important;
        margin-bottom: 12px !important;
        line-height: 1.5;
    }

    .us32-billing .payment-method-fieldset {
        min-width: 0;
    }

        .us32-billing .payment-method-fieldset legend {
            float: none;
            width: auto;
        }

    .us32-billing .payment-method-tile {
        min-height: 112px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        text-align: center;
        cursor: pointer;
        padding: 14px 8px;
        border: 1px solid #d8cfc2;
        border-radius: 7px;
        background: #fffdf9;
        transition: border-color .15s, background-color .15s;
    }

        .us32-billing .payment-method-tile strong {
            font-size: 14px;
        }

        .us32-billing .payment-method-tile small {
            font-size: 11px;
            color: #746d63;
        }

    .us32-billing .payment-method-icon {
        font-size: 22px;
        font-weight: 700;
    }

    .us32-billing
    .payment-method-radio:checked + .payment-method-tile {
        border-color: #a67b3f;
        background: #fff0d3;
        box-shadow: inset 0 0 0 1px #a67b3f;
    }

    .us32-billing
    .payment-method-radio:focus-visible + .payment-method-tile {
        outline: 3px solid #896a42;
        outline-offset: 3px;
    }

    .us32-billing .payment-method-tile-disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .us32-billing .payment-readonly-value {
        min-height: 42px;
        display: flex;
        align-items: center;
        padding: 10px 12px;
        border: 1px solid #e0d8cc;
        border-radius: 6px;
        background: #faf8f4;
        font-size: 14px;
        overflow-wrap: anywhere;
    }

    .us32-billing .payment-result {
        border-radius: 6px;
        padding: 12px 14px;
        font-size: 13px;
    }

    .us32-billing .payment-result-success {
        background: #e8f6eb;
        color: #166534;
    }

    .us32-billing .payment-result-pending {
        background: #fff2d6;
        color: #845400;
    }

    .us32-billing .payment-result-failed {
        background: #fce8e7;
        color: #9b2823;
    }

    /* =====================================================
           PRINT-ONLY ELEMENTS
           ===================================================== */

    .yoru-print-header,
    .yoru-print-footer {
        display: none;
    }

    .yoru-print-logo {
        display: block;
        width: 100px;
        max-height: 85px;
        object-fit: contain;
        margin: 0 auto 12px;
    }

    /* =====================================================
           PRINT BILL — A4
           ===================================================== */

    @@media print {

        @@page {
            size: A4 portrait;
            margin: 18mm;
        }

        html, body {
            background: #fff !important;
            color: #24201c !important;
        }

            body * {
                visibility: hidden !important;
            }

        #printableBill,
        #printableBill * {
            visibility: visible !important;
        }

        #printableBill {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            font-family: var(--font-body) !important;
            font-weight: 400;
        }

            #printableBill .card-body {
                padding: 0 !important;
            }

            #printableBill .billing-actions,
            #printableBill .billing-actions-divider,
            .us32-billing .payment-management-card {
                display: none !important;
            }
            /* Restaurant branding */
            #printableBill .yoru-print-header {
                display: block !important;
                text-align: center;
                margin-bottom: 28px;
            }

                #printableBill .yoru-print-brand h1,
                #printableBill .yoru-print-header h2 {
                    font-family: var(--font-display) !important;
                    font-weight: 700;
                }

            #printableBill .yoru-print-brand h1 {
                margin: 0;
                font-size: 34px;
                letter-spacing: 3px;
            }

            #printableBill .yoru-print-subtitle {
                margin-top: 3px;
                color: #9b8062 !important;
                font-size: 11px;
                letter-spacing: 5px;
            }

            #printableBill .yoru-print-divider {
                width: 100%;
                height: 1px;
                background: #b49a76 !important;
                margin: 20px 0;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            #printableBill .yoru-print-header h2 {
                font-size: 15px;
                letter-spacing: 1px;
                margin: 14px 0 5px;
            }

            #printableBill .yoru-print-header p {
                color: #77716b !important;
                font-size: 11px;
                margin: 0;
            }
            /* Avoid duplicate headings */
            #printableBill .card-body >
            .yoru-print-header + .d-flex {
                display: none !important;
            }
            /* Item table */
            #printableBill .table-responsive {
                overflow: visible !important;
            }

            #printableBill table {
                width: 100% !important;
                border-collapse: collapse;
                font-size: 12px;
            }

            #printableBill th {
                background: #f7f3ed !important;
                color: #6f5b47 !important;
                font-size: 10px;
                letter-spacing: .7px;
