@page
@model RROMS.Pages.Staff.Billing.IndexModel
@using RROMS.Models

@{
    ViewData["Title"] = "Billing & Payment Management";
}

<div class="container py-4 us32-billing">

    <div class="mb-4">
        <h2 class="mb-1">Billing & Payment Management</h2>
        <p class="text-muted mb-0">
            @Brand.FullName — Staff Billing & Payments
        </p>
    </div>

    <!-- Feedback messages -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            @Model.SuccessMessage
        </div>
    }

    <!-- US32: Dine-in — tables with an open dining session -->
    <div class="card shadow-sm mb-4 billing-card">
        <div class="card-body">
            <h5 class="card-title billing-card-title mb-3">
                Dine-in · Open Tables
            </h5>

            @if (!Model.OpenTables.Any())
            {
                <p class="text-muted mb-0">
                    No tables are seated right now.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Table</th>
                                <th>Seated At</th>
                                <th>Bill</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in Model.OpenTables)
                            {
                                var selected = Model.SessionId == table.SessionId;

                                <tr class="@(selected ? "table-active" : "")">
                                    <td><strong>@table.TableNumber</strong></td>
                                    <td>@table.OpenedAt.ToString("h:mm tt")</td>
                                    <td>
                                        @if (table.BillStatus is BillStatus billStatus && table.BillId is int tableBillId)
                                        {
                                            <span class="status-badge status-@billStatus">@billStatus</span>
                                            <small class="text-muted ms-1">@Model.BillNo(tableBillId)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not billed</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm @(selected ? "btn-dark" : "btn-outline-dark")"
                                           asp-page="./Index"
                                           asp-route-sessionId="@table.SessionId">
                                            View Bill
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- US32: Takeaway — find the order -->
    <div class="card shadow-sm mb-4 billing-card">
        <div class="card-body">
            <h5 class="card-title billing-card-title mb-3">
                Takeaway · Find Order
            </h5>

            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label asp-for="OrderNo"
                               class="form-label billing-order-label">
                            Order Number
                        </label>

                        <input asp-for="OrderNo"
                               class="form-control"
                               placeholder="Enter Order Number"
                               maxlength="20"
                               required />
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-dark w-100">
                            Search Order
                        </button>
                    </div>
                </div>
                <p class="text-muted small mt-2 mb-0">
                    A dine-in order number opens its table's combined bill.
                </p>
            </form>
        </div>
    </div>

    @if (Model.HasBill)
    {
        decimal subtotal, taxAmount, serviceCharge, totalAmount, taxRate, serviceRate;

        if (Model.IsDineIn)
        {
            var preview = Model.SessionBill!;
            subtotal = preview.Subtotal;
            taxAmount = preview.TaxAmount;
            serviceCharge = preview.ServiceCharge;
            totalAmount = preview.TotalAmount;
            taxRate = preview.TaxRatePercent;
            serviceRate = preview.ServiceChargePercent;
        }
        else
        {
            var summary = Model.TakeawaySummary!;
            subtotal = summary.Subtotal;
            taxAmount = summary.TaxAmount;
            serviceCharge = summary.ServiceCharge;
            totalAmount = summary.TotalAmount;
            taxRate = summary.TaxRatePercent;
            serviceRate = summary.ServiceChargePercent;
        }

        // A confirmed bill always shows its own saved totals.
        if (!Model.IsPreview && Model.CurrentBill != null)
        {
            subtotal = Model.CurrentBill.Subtotal;
            taxAmount = Model.CurrentBill.TaxAmount;
            serviceCharge = Model.CurrentBill.ServiceCharge;
            totalAmount = Model.CurrentBill.TotalAmount;
        }

        var billTitle = Model.IsPreview || Model.CurrentBill == null
            ? "Bill Preview"
            : $"Bill {Model.BillNo(Model.CurrentBill.Id)}";

        var ordersInKitchen = Model.OrdersInKitchen;

        <!-- Bill Details / Preview -->
        <div class="card shadow-sm mb-4 billing-card"
             id="printableBill">
            <div class="card-body">

                <!-- Print-only restaurant header -->
                <div class="yoru-print-header">
                    <div class="yoru-print-brand">
                        <img src="~/images/yoru-icon.png"
                             asp-append-version="true"
                             alt="@Brand.FullName Logo"
                             class="yoru-print-logo" />

                        <h1>@Brand.Name</h1>
                        <div class="yoru-print-subtitle">
                            @(string.Join(" ", Brand.Sub.ToCharArray()))
                        </div>

                        @* US49: SST registration no. under the restaurant name *@
                        @if (!string.IsNullOrWhiteSpace(Model.SstRegistrationNo))
                        {
                            <p class="yoru-print-sst">
                                SST No. @Model.SstRegistrationNo
                            </p>
                        }
                    </div>

                    <div class="yoru-print-divider"></div>

                    <h2>
                        @(Model.IsPreview ? "BILL PREVIEW" : "BILL")
                    </h2>

                    <p>Japanese Dining</p>
                </div>

                <!-- Bill heading -->
                <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-2 bill-preview-heading">

                    <h5 class="card-title billing-card-title mb-0">
                        @billTitle
                    </h5>

                    @if (Model.CurrentBill != null && !Model.IsPreview)
                    {
                        <span class="status-badge status-@Model.CurrentBill.Status">
                            @Model.CurrentBill.Status
                        </span>
                    }
                </div>

                <p class="bill-order-number">
                    @if (Model.IsDineIn)
                    {
                        <span>Table @(Model.SessionBill!.TableNumber) · Dine-in</span>
                    }
                    else
                    {
                        <span>Takeaway · Order Number: @(Model.TakeawayOrder!.OrderNo)</span>
                    }

                    @if (Model.CurrentBill?.ConfirmedAt is DateTime confirmedAt && !Model.IsPreview)
                    {
                        <br />
                        <small class="text-muted">
                            Confirmed @confirmedAt.ToString("d MMM yyyy, h:mm tt")
                            @(Model.ConfirmedByName is null ? "" : $"by {Model.ConfirmedByName}")
                        </small>
                    }
                </p>

                <!-- Ordered items -->
                @if (Model.IsDineIn)
                {
                    if (!Model.SessionBill!.Orders.Any())
                    {
                        <p class="text-muted">No orders for this table yet.</p>
                    }

                    foreach (var order in Model.SessionBill.Orders)
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 mb-2">
                            <h6 class="mb-0">Order @order.OrderNo</h6>
                            <span class="status-badge status-@order.Status">@order.Status</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Menu Item</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Unit Price (RM)</th>
                                        <th class="text-end">Line Total (RM)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.Items)
                                    {
                                        <tr>
                                            <td>@item.MenuItemName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@item.UnitPrice.ToString("F2")</td>
                                            <td class="text-end">@item.LineTotal.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    <h6>Ordered Items</h6>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Menu Item</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price (RM)</th>
                                    <th class="text-end">Line Total (RM)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TakeawaySummary!.Items)
                                {
                                    <tr>
                                        <td>@item.MenuItemName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-end">@item.LineTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Bill totals (saved order amounts; SST is charged on subtotal + service) -->
                <div class="row justify-content-end mt-4">
                    <div class="col-md-6 col-lg-5">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>RM @subtotal.ToString("F2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Service Charge (@serviceRate.ToString("0.##")%)</span>
                            <span>RM @serviceCharge.ToString("F2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>SST (@taxRate.ToString("0.##")%)</span>
                            <span>RM @taxAmount.ToString("F2")</span>
                        </div>

                        <hr class="billing-total-divider" />

                        <div class="d-flex justify-content-between
                            align-items-center billing-final-total">
                            <strong>Final Total</strong>
                            <h4 class="mb-0">RM @totalAmount.ToString("F2")</h4>
                        </div>

                        <hr class="billing-actions-divider" />
                    </div>
                </div>

                <!-- US32: kitchen warning (warn, not block) -->
                @if (Model.CanConfirmDineIn && ordersInKitchen.Count > 0)
                {
                    <div class="alert alert-warning d-print-none" role="alert">
                        <strong>Some orders are still in the kitchen:</strong>
                        @(string.Join(", ", ordersInKitchen)).
                        Confirming the bill now locks this table, so no more orders can be added.
                    </div>
                }

                <!-- Bill actions -->
                <div class="d-flex flex-wrap
                    align-items-center gap-2 billing-actions">

                    @if (Model.CanConfirmDineIn)
                    {
                        <form method="post"
                              asp-page-handler="ConfirmSession"
                              class="mb-0">

                            <input type="hidden" name="sessionId" value="@(Model.SessionBill!.SessionId)" />
                            <input type="hidden" name="orderSnapshot" value="@(Model.SessionBill.OrderSnapshot)" />
                            <input type="hidden" name="acknowledgeKitchenWarning"
                                   value="@(ordersInKitchen.Count > 0 ? "true" : "false")" />

                            <button type="submit"
                                    class="btn btn-dark">
                                @(ordersInKitchen.Count > 0 ? "Confirm Anyway" : "Confirm Bill")
                            </button>
                        </form>
                    }
                    else if (Model.CanConfirmTakeaway)
                    {
                        <form method="post"
                              asp-page-handler="ConfirmTakeaway"
                              class="mb-0">

                            <input type="hidden" name="orderNo" value="@(Model.TakeawayOrder!.OrderNo)" />

                            <button type="submit"
                                    class="btn btn-dark">
                                Confirm Bill
                            </button>
                        </form>
                    }

                    <button type="button"
                            class="btn btn-outline-dark"
                            onclick="window.print()">
                        Print Bill
                    </button>
                </div>

                <!-- Print-only footer -->
                <div class="yoru-print-footer">
                    <div class="yoru-print-divider"></div>

                    <p class="yoru-japanese">
                        ありがとうございます
                    </p>

                    @* US49: receipt footer message from Restaurant Settings *@
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.ReceiptFooterNote)
                            ? "Thank you for dining with us."
                            : Model.ReceiptFooterNote)
                    </p>
                    <strong>@Brand.FullName</strong>

                    @if (Model.IsPreview)
                    {
                        <p class="yoru-print-notice">
                            Preview only — not a payment receipt.
                        </p>
                    }
                    else if (Model.IsPaid)
                    {
                        <p class="yoru-print-notice">
                            Payment received. Thank you!
                        </p>
                    }
                    else
                    {
                        <p class="yoru-print-notice">
                            This bill is not proof of payment.
                        </p>
                    }
                </div>
            </div>
        </div>

        <!-- Payment Management (confirmed bills only) -->
        @if (!Model.IsPreview && Model.CurrentBill != null)
        {
            <div class="card shadow-sm mb-4
                billing-card payment-management-card">
                <div class="card-body">

                    <div class="d-flex justify-content-between
                        align-items-center gap-2 mb-3">

                        <h5 class="card-title billing-card-title mb-0">
                            Payment Management
                        </h5>

                        @if (Model.IsPaid)
                        {
                            <span class="status-badge status-Paid">Paid</span>
                        }
                        else
                        {
                            <span class="status-badge status-Pending">Awaiting Payment</span>
                        }
                    </div>

                    <!-- US32: counter payment against the confirmed bill (one step) -->
                    @if (Model.IsConfirmed)
                    {
                        <form method="post"
                              asp-page-handler="RecordPayment"
                              class="payment-record-form">

                            <input type="hidden" name="billId" value="@Model.CurrentBill.Id" />

                            @if (Model.IsDineIn)
                            {
                                <input type="hidden" name="sessionId" value="@(Model.SessionBill!.SessionId)" />
                            }
                            else
                            {
                                <input type="hidden" name="orderNo" value="@(Model.TakeawayOrder!.OrderNo)" />
                            }

                            <fieldset class="payment-method-fieldset">
                                <legend class="form-label">
                                    1. Select Payment Method
                                </legend>

                                <div class="row g-3">

                                    <!-- Cash -->
                                    <div class="col-sm-4">
                                        <input type="radio"
                                               class="visually-hidden payment-method-radio"
                                               name="method"
                                               id="paymentCash"
                                               value="Cash"
                                               required />

                                        <label class="payment-method-tile"
                                               for="paymentCash">
                                            <span class="payment-method-icon"
                                                  aria-hidden="true">
                                                RM
                                            </span>
                                            <strong>Cash</strong>
                                        </label>
                                    </div>

                                    <!-- Card -->
                                    <div class="col-sm-4">
                                        <input type="radio"
                                               class="visually-hidden payment-method-radio"
                                               name="method"
                                               id="paymentCard"
                                               value="Card"
                                               required />

                                        <label class="payment-method-tile"
                                               for="paymentCard">
                                            <span class="payment-method-icon"
                                                  aria-hidden="true">
                                                ▭
                                            </span>
                                            <strong>Card</strong>
                                            <small>In-store</small>
                                        </label>
                                    </div>

                                    <!-- Online Payment (US33) -->
                                    <div class="col-sm-4">
                                        <input type="radio"
                                               class="visually-hidden payment-method-radio"
                                               name="method"
                                               id="paymentOnline"
                                               value="Online"
                                               disabled />

                                        <label class="payment-method-tile
                                            payment-method-tile-disabled"
                                               for="paymentOnline">
                                            <span class="payment-method-icon"
                                                  aria-hidden="true">
                                                ▣
                                            </span>
                                            <strong>Online Payment</strong>
                                            <small>Paid by the customer</small>
                                        </label>
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Amount and reference -->
                            <div class="row g-3 mt-2">

                                <div class="col-md-6">
                                    <div class="form-label">
                                        Amount (RM)
                                    </div>
                                    <div class="payment-readonly-value">
                                        @Model.CurrentBill.TotalAmount.ToString("F2")
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label for="transactionRef" class="form-label">
                                        Card Terminal Reference (optional)
                                    </label>
                                    <input id="transactionRef"
                                           name="transactionRef"
                                           class="form-control"
                                           maxlength="100"
                                           autocomplete="off"
                                           placeholder="e.g. approval code" />
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-dark w-100 mt-3">
                                Record Payment
                            </button>

                            <p class="text-muted small mt-2 mb-0">
                                Records the full bill amount as Paid.
                                Record a card payment only after the card terminal approves it;
                                if the card is declined, nothing is recorded and another method can be used.
                            </p>
                        </form>
                    }

                    <!-- Paid: details of the payment -->
                    @if (Model.IsPaid && Model.LatestPayment != null)
                    {
                        <div class="row g-3 payment-details">

                            <div class="col-md-6">
                                <div class="form-label">Payment Method</div>
                                <div class="payment-readonly-value">@Model.LatestPayment.Method</div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-label">Amount (RM)</div>
                                <div class="payment-readonly-value">@Model.LatestPayment.Amount.ToString("F2")</div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-label">Paid At</div>
                                <div class="payment-readonly-value">
                                    @(Model.LatestPayment.PaidAt?.ToString("d MMM yyyy, h:mm tt") ?? "N/A")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-label">Recorded By</div>
                                <div class="payment-readonly-value">
                                    @(Model.LatestPaymentRecordedByName ?? "N/A")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-label">Transaction Reference</div>
                                <div class="payment-readonly-value">
                                    @(string.IsNullOrWhiteSpace(Model.LatestPayment.TransactionRef)
                                        ? "N/A"
                                        : Model.LatestPayment.TransactionRef)
                                </div>
                            </div>
                        </div>

                        <div class="payment-result
                            payment-result-success mt-3"
                             role="status">
                            <span aria-hidden="true">&#10003;</span>
                            Payment received. No further action required.
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Payment history (bill payments and older order payments) -->
        @if (Model.Payments.Any())
        {
            <div class="card shadow-sm mb-4 billing-card">
                <div class="card-body">
                    <h5 class="card-title billing-card-title mb-3">
                        Payment History
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Method</th>
                                    <th>Status</th>
                                    <th class="text-end">Amount (RM)</th>
                                    <th>Reference</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.CreatedAt.ToString("d MMM yyyy, h:mm tt")</td>
                                        <td>@payment.Method</td>
                                        <td><span class="status-badge status-@payment.Status">@payment.Status</span></td>
                                        <td class="text-end">@payment.Amount.ToString("F2")</td>
                                        <td>@(string.IsNullOrWhiteSpace(payment.TransactionRef) ? "—" : payment.TransactionRef)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-4">
                <h5 class="mb-1">Bill Details</h5>
                <p class="text-muted mb-0">
                    Select a table or search a takeaway order to view its bill.
                </p>
            </div>
        </div>
    }
</div>

<style>
    /* =====================================================
               YORU IZAKAYA — US32 SCREEN STYLES
               ===================================================== */

    @@media screen {

        .us32-billing .billing-card {
            margin-bottom: 24px !important;
            border-radius: 8px;
        }

            .us32-billing .billing-card > .card-body {
                padding: 24px;
            }

            .us32-billing .billing-card .billing-card-title {
                font-family: var(--font-display);
                font-size: 20px;
                font-weight: 600;
                line-height: 1.4;
                letter-spacing: 0;
                margin-bottom: 8px !important;
            }

            .us32-billing .billing-card h6 {
                font-family: var(--font-body);
                font-size: 15px;
                font-weight: 500;
                line-height: 1.5;
                margin-bottom: 12px;
            }

            .us32-billing .billing-card .form-label {
                font-family: var(--font-body);
                font-size: 14px;
                font-weight: 500;
                line-height: 1.5;
                margin-bottom: 8px;
            }

            .us32-billing .billing-card .billing-order-label {
                font-family: var(--font-body);
                font-size: 15px;
                font-weight: 500;
                line-height: 1.5;
            }

            .us32-billing .billing-card .form-control {
                font-family: var(--font-body);
                font-size: 14px;
                font-weight: 400;
                line-height: 1.5;
                min-height: 42px;
            }

            .us32-billing .billing-card p {
                font-family: var(--font-body);
                font-size: 13px;
                font-weight: 400;
                line-height: 1.65;
            }

            .us32-billing .billing-card table {
                font-family: var(--font-body);
            }

                .us32-billing .billing-card table th {
                    font-size: 11px;
                    font-weight: 600;
                    line-height: 1.5;
                    letter-spacing: .7px;
                    padding: 12px;
                }

                .us32-billing .billing-card table td {
                    font-size: 13px;
                    font-weight: 400;
                    line-height: 1.5;
                    padding: 13px 12px;
                }

            .us32-billing .billing-card
            .row.justify-content-end span {
                font-family: var(--font-body);
                font-size: 13px;
                line-height: 1.6;
            }

        .us32-billing #printableBill h4 {
            font-family: var(--font-body);
            font-size: 22px;
            font-weight: 700;
            line-height: 1.3;
        }

        .us32-billing .billing-card .btn {
            font-family: var(--font-body);
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
            padding: 10px 18px;
        }

        .us32-billing .billing-card .badge {
            font-family: var(--font-body);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .3px;
        }
        /* Bill heading */
        .us32-billing #printableBill
        .bill-preview-heading {
            margin-bottom: 8px !important;
        }

            .us32-billing #printableBill
            .bill-preview-heading .billing-card-title {
                font-family: var(--font-display);
                font-size: 20px;
                font-weight: 600;
                line-height: 1.4;
                margin-bottom: 0 !important;
            }

        .us32-billing #printableBill
        .bill-order-number {
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 400;
            line-height: 1.5;
            margin-bottom: 22px !important;
        }
        /* Balanced Final Total spacing */
        .us32-billing #printableBill
        .billing-total-divider {
            margin-top: 12px !important;
            margin-bottom: 12px !important;
        }

        .us32-billing #printableBill
