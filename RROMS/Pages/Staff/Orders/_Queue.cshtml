@using RROMS.Models
@using RROMS.Services.Interfaces
@using System.Globalization
@model StaffOrderQueue
@{
    var details = ViewData["QueueDetails"] as StaffOrderDetails;
}
<section class="sq-queue" data-sq-panel
         data-stamp="@Model.Signal.Stamp" data-pending="@Model.Signal.Pending"
         data-dine-in="@Model.Signal.DineIn" data-takeaway="@Model.Signal.Takeaway"
         data-newest-id="@Model.Signal.NewestId" data-search="@Model.Search"
         data-dining="@Model.Dining" data-sort="@Model.Sort" data-page="@Model.PageNumber" data-show-all="@Model.ShowAll.ToString().ToLowerInvariant()">
    <h2 id="sq-queue-title" class="visually-hidden" tabindex="-1">Incoming orders</h2>
    <div class="sq-controls" data-sq-controls>
        <div class="sq-toolbar">
            <form method="get" asp-page="/Staff/Orders/Index" class="sq-search" data-sq-search>
                <label class="visually-hidden" for="sq-search-input">Search order number or customer name</label>
                <div class="input-group">
                    <input class="form-control" id="sq-search-input" name="search" value="@Model.Search"
                           type="search" placeholder="Search order number or customer name" maxlength="80" autocomplete="off" />
                    <button class="btn btn-outline-secondary" type="submit" aria-label="Search orders"><i class="bi bi-search" aria-hidden="true"></i></button>
                </div>
                <input type="hidden" name="dining" value="@Model.Dining" />
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="showAll" value="@Model.ShowAll.ToString().ToLowerInvariant()" />
            </form>
            <div class="sq-toolbar-actions">
                <form method="get" asp-page="/Staff/Orders/Index" class="sq-sort" data-sq-sort-form>
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="dining" value="@Model.Dining" />
                    <input type="hidden" name="showAll" value="@Model.ShowAll.ToString().ToLowerInvariant()" />
                    <label class="visually-hidden" for="sq-sort">Sort order queue</label>
                    <select class="form-select" id="sq-sort" name="sort" data-sq-sort>
                        <option value="newest" selected="@(Model.Sort == "newest")">Newest first</option>
                        <option value="oldest" selected="@(Model.Sort == "oldest")">Oldest first</option>
                    </select>
                    <div class="sq-sort-picker" data-sq-sort-picker hidden>
                        <button type="button" class="sq-sort-trigger" id="sq-sort-trigger" data-sq-sort-trigger
                                aria-label="Sort order queue: @(Model.Sort == "oldest" ? "Oldest first" : "Newest first")"
                                aria-haspopup="listbox" aria-expanded="false" aria-controls="sq-sort-options">
                            <i class="bi @(Model.Sort == "oldest" ? "bi-sort-up" : "bi-sort-down")" aria-hidden="true"></i>
                            <span>@(Model.Sort == "oldest" ? "Oldest first" : "Newest first")</span>
                            <i class="bi bi-chevron-down sq-sort-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="sq-sort-menu" data-sq-sort-menu hidden>
                            <p class="sq-sort-menu__caption" aria-hidden="true">Arrange orders</p>
                            <div id="sq-sort-options" role="listbox" aria-label="Sort order queue">
                                @foreach (var order in new[] { ("newest", "Newest first", "bi-sort-down"), ("oldest", "Oldest first", "bi-sort-up") })
                                {
                                    <button type="button" class="sq-sort-choice" role="option" tabindex="-1"
                                            data-sq-sort-option="@order.Item1" aria-selected="@(Model.Sort == order.Item1 ? "true" : "false")">
                                        <i class="bi @order.Item3" aria-hidden="true"></i><span>@order.Item2</span>
                                        <i class="bi bi-check2 sq-sort-check" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <noscript><button type="submit" class="btn btn-outline-secondary">Apply sort</button></noscript>
                </form>
                <button type="button" class="btn btn-outline-secondary sq-refresh" data-sq-refresh aria-label="Refresh order queue" title="Refresh queue">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    <span data-sq-update>Refresh queue</span>
                </button>
            </div>
        </div>
        <div class="sq-boardbar">
            <div class="sq-filters" role="group" aria-label="Filter by dining option">
                @foreach (var option in new[] { ("All", "All"), ("DineIn", "Dine-in"), ("Takeaway", "Takeaway") })
                {
                    var pendingCount = option.Item1 == "All" ? Model.Signal.Pending
                        : option.Item1 == "DineIn" ? Model.Signal.DineIn : Model.Signal.Takeaway;
                    <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@option.Item1" asp-route-sort="@Model.Sort" asp-route-showAll="@Model.ShowAll"
                       class="sq-filter @(Model.Dining == option.Item1 ? "is-active" : "")"
                       aria-current="@(Model.Dining == option.Item1 ? "true" : null)" data-sq-filter>@option.Item2 (@pendingCount)</a>
                }
            </div>
            <p class="sq-match-count">@Model.MatchingCount pending @(Model.MatchingCount == 1 ? "order" : "orders") <span aria-hidden="true">·</span>
                @if (Model.ShowAll) { <text>Showing all @Model.MatchingCount</text> }
                else { <text>Showing @Model.First–@Model.Last</text> }
            </p>
        </div>
        @if (Model.Search.Length > 0)
        {
            <div class="sq-applied"><span>Search: <strong>@Model.Search</strong></span></div>
        }
    </div>
    <div class="sq-workspace @(details is not null ? "is-open" : "")" data-sq-workspace>
        <div class="sq-board" data-sq-board>
            <div class="sq-ticket-grid" aria-label="Pending orders, @(Model.Sort == "oldest" ? "oldest first" : "newest first")">
                @foreach (var order in Model.Rows)
                {
                    long seconds = StaffQueueRules.WaitSeconds(order.CreatedAt, Model.ServerNow);
                    var preview = order.DishPreview ?? Array.Empty<StaffOrderPreview>();
                    <article class="sq-ticket" data-sq-row="@order.Id" data-sq-ticket aria-labelledby="sq-ticket-title-@order.Id">
                        <header class="sq-ticket__header">
                            <div class="sq-ticket__top"><h3 id="sq-ticket-title-@order.Id">@order.OrderNo</h3>
                                <span class="status-badge status-Pending">Pending</span></div>
                            <p class="sq-ticket__customer"><strong>@order.CustomerName</strong><span aria-hidden="true">·</span>
                                <time datetime="@order.CreatedAt.ToString("s", CultureInfo.InvariantCulture)">@order.CreatedAt.ToString("dd MMM · HH:mm", CultureInfo.InvariantCulture)</time></p>
                        </header>
                        <div class="sq-ticket__meta">
                            <span class="sq-dining sq-dining--@(order.Dining == OrderType.Takeaway ? "takeaway" : "dinein")"><i class="bi @(order.Dining == OrderType.Takeaway ? "bi-bag" : "bi-people")" aria-hidden="true"></i>@StaffQueueRules.DiningLabel(order.Dining)</span>
                            <span class="sq-wait sq-wait--@StaffQueueRules.WaitClass(seconds)" data-sq-wait="@seconds">
                                <span><i class="bi bi-clock" aria-hidden="true"></i><span data-sq-wait-label>@StaffQueueRules.WaitLabel(seconds)</span></span>
                                <small data-sq-long hidden="@(seconds < 1200)">Long wait</small>
                            </span>
                        </div>
                        <ul class="sq-ticket__dishes" aria-label="Dish preview">
                            @foreach (var dish in preview)
                            {
                                <li><strong>× @dish.Quantity</strong><span title="@dish.Name">@dish.Name</span></li>
                            }
                        </ul>
                        @if (order.DishLineCount > preview.Count)
                        {
                            <p class="sq-ticket__more">+ @(order.DishLineCount - preview.Count) more dishes</p>
                        }
                        <div class="sq-ticket__note-space">
                            @if (order.HasNotes)
                            {
                                <span class="sq-ticket__note"><i class="bi bi-journal-text" aria-hidden="true"></i>Kitchen notes</span>
                            }
                        </div>
                        <footer class="sq-ticket__footer">
                            <span>@order.Portions @(order.Portions == 1 ? "portion" : "portions")</span>
                            <a class="sq-view" asp-page="/Staff/Orders/Index" asp-route-orderId="@order.Id"
                               asp-route-search="@Model.Search" asp-route-dining="@Model.Dining" asp-route-sort="@Model.Sort" asp-route-showAll="@Model.ShowAll" asp-route-pageNumber="@Model.PageNumber"
                               data-sq-open="@order.Id" aria-label="View order @order.OrderNo"><span data-sq-view-label>View order</span><i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </footer>
                    </article>
                }
            </div>
            @if (Model.Rows.Count == 0)
            {
                <div class="sq-empty"><i class="bi bi-cup-hot" aria-hidden="true"></i>
                    <h3>@(Model.Search.Length == 0 && Model.Dining == "All" ? "All caught up" : "No matching orders")</h3>
                    <p>@(Model.Signal.Pending == 0 ? "New orders will appear here when customers place them." : "Try another order number, customer name or dining option.")</p>
                </div>
            }
            <footer class="sq-pagination">
                <nav aria-label="Order queue pages">
                    @if (Model.ShowAll)
                    {
                        <span class="sq-page-current" aria-current="true">All @Model.MatchingCount @(Model.MatchingCount == 1 ? "order" : "orders")</span>
                        <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@Model.Dining"
                           asp-route-sort="@Model.Sort" asp-route-pageNumber="1" asp-route-showAll="false"
                           class="sq-page-mode" data-sq-page>Show pages</a>
                    }
                    else
                    {
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@Model.Dining" asp-route-sort="@Model.Sort"
                               asp-route-pageNumber="@(Model.PageNumber - 1)" data-sq-page rel="prev">Previous</a>
                        }
                        else { <span class="sq-page-disabled" aria-disabled="true">Previous</span> }
                        @for (int number = Math.Max(1, Model.PageNumber - 2); number <= Math.Min(Model.TotalPages, Model.PageNumber + 2); number++)
                        {
                            if (number == Model.PageNumber)
                            {
                                <span class="sq-page-current" aria-current="page" aria-label="Page @number">@number</span>
                            }
                            else
                            {
                                <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@Model.Dining" asp-route-sort="@Model.Sort"
                                   asp-route-pageNumber="@number" data-sq-page aria-label="Page @number">@number</a>
                            }
                        }
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@Model.Dining" asp-route-sort="@Model.Sort"
                               asp-route-pageNumber="@(Model.PageNumber + 1)" data-sq-page rel="next">Next <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                        else { <span class="sq-page-disabled" aria-disabled="true">Next</span> }
                        <a asp-page="/Staff/Orders/Index" asp-route-search="@Model.Search" asp-route-dining="@Model.Dining"
                           asp-route-sort="@Model.Sort" asp-route-pageNumber="1" asp-route-showAll="true"
                           class="sq-page-mode" data-sq-page>Show all</a>
                    }
                </nav>
                <p>@(Model.Sort == "oldest" ? "Oldest orders appear first" : "Newest orders appear first")</p>
            </footer>
        </div>
        <aside class="sq-drawer" data-sq-drawer aria-label="Order details" hidden="@(details is null)">
            @if (details is not null)
            {
                <partial name="_OrderDetails" model="details" />
            }
        </aside>
    </div>
</section>
