@page
@model RROMS.Pages.Staff.Orders.IndexModel
@{
    ViewData["Title"] = "Order queue";
    ViewData["FullWidth"] = true;
    ViewData["QueueDetails"] = Model.Details;
}
<link rel="stylesheet" href="~/css/staff-order-queue.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/staff-order-queue-banner.css" asp-append-version="true" />
<script>
    // Run before the queue is painted so browser reload does not flash old results.
    (() => {
        const navigation = performance.getEntriesByType('navigation')[0];
        if (navigation?.type !== 'reload') return;
        const url = new URL(location.href);
        const resetKeys = new Set(['search', 'dining', 'pagenumber', 'sort', 'showall']);
        const viewKeys = [...url.searchParams.keys()].filter(key => resetKeys.has(key.toLowerCase()));
        if (!viewKeys.length) return;
        viewKeys.forEach(key => url.searchParams.delete(key));
        document.documentElement.classList.add('sq-resetting');
        location.replace(url.href);
    })();
</script>

<div class="staff-queue" data-staff-queue data-base-url="@Url.Page("/Staff/Orders/Index")">
    <header class="sq-masthead sq-masthead--dispenser sq-masthead--illustrated" aria-labelledby="sq-page-title">
        <div class="sq-hero-art" aria-hidden="true">
            <img src="~/images/staff/yoru-order-queue-banner.webp" asp-append-version="true" alt="" width="2048" height="682" decoding="async" fetchpriority="high" />
        </div>
        <div class="sq-masthead__inner container-xl container-wide">
            <div class="sq-masthead__title">
                <span class="sq-masthead__jp" lang="ja" aria-hidden="true">注文受付</span>
                <div class="sq-masthead__copy">
                    <p class="eyebrow">YORU IZAKAYA <span aria-hidden="true">/</span> STAFF WORKSPACE</p>
                    <h1 id="sq-page-title">Order queue</h1>
                    <p class="sq-masthead__intro">A clear view of every incoming order.</p>
                    <div class="sq-hero-rule" aria-hidden="true"><span></span><i class="bi bi-flower1"></i></div>
                </div>
            </div>
            <section class="sq-dispenser" aria-label="All pending order totals">
                <div class="sq-dispenser__caption">
                    <span>YORU / ORDER DESK</span>
                    <span class="sq-dispenser__state"><i aria-hidden="true"></i>Awaiting acceptance</span>
                </div>
                <div class="sq-dispenser__paper">
                    <div class="sq-dispenser__metric sq-dispenser__metric--pending">
                        <div class="sq-dispenser__label"><i class="bi bi-clipboard2-check" aria-hidden="true"></i><p>Pending orders</p></div>
                        <div class="sq-hero-number">
                            <svg class="sq-hero-emblem sq-hero-emblem--chopsticks" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 12 49 50M18 9 52 47M50 12 15 50M46 9 12 47" stroke-linecap="round" /></svg>
                            <strong data-sq-count="pending">@Model.Queue.Signal.Pending</strong>
                            <span class="sq-dispenser__stamp" aria-hidden="true">Pending</span>
                        </div>
                    </div>
                    <div class="sq-dispenser__metric">
                        <div class="sq-dispenser__label"><i class="bi bi-people" aria-hidden="true"></i><p>Dine-in</p></div>
                        <div class="sq-hero-number">
                            <strong data-sq-count="dineIn">@Model.Queue.Signal.DineIn</strong>
                            <svg class="sq-hero-emblem" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><ellipse cx="32" cy="31" rx="23" ry="5" /><path d="M9 31c2 15 10 22 23 22s21-7 23-22M23 54h18M26 53v4h12v-4M22 23c-7-6 7-8 0-15M33 23c-7-6 7-8 0-15M44 23c-7-6 7-8 0-15" stroke-linecap="round" /></svg>
                        </div>
                    </div>
                    <div class="sq-dispenser__metric">
                        <div class="sq-dispenser__label"><i class="bi bi-bag" aria-hidden="true"></i><p>Takeaway</p></div>
                        <div class="sq-hero-number">
                            <strong data-sq-count="takeaway">@Model.Queue.Signal.Takeaway</strong>
                            <svg class="sq-hero-emblem" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 22h34l3 34H12l3-34ZM23 26V15a9 9 0 0 1 18 0v11M19 29v21M45 29v21" stroke-linejoin="round" stroke-linecap="round" /></svg>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </header>

    <div class="sq-content container-xl container-wide">
        <div class="sq-connection" data-sq-connection hidden role="status">
            <i class="bi bi-wifi-off" aria-hidden="true"></i>
            <span>Live checks paused. Your displayed orders are unchanged.</span>
            <button type="button" data-sq-retry>Retry</button>
        </div>
        <partial name="_Queue" model="Model.Queue" />
        <button type="button" class="sq-backdrop" data-sq-backdrop aria-label="Close order details" hidden></button>
        <p class="visually-hidden" data-sq-live role="status" aria-live="polite"></p>
        <noscript><p class="small text-muted mt-3">Refresh this page to check for incoming orders. Waiting times update when the page reloads.</p></noscript>
    </div>
</div>

@section Scripts {
    <script src="~/js/staff-order-queue.js" asp-append-version="true" defer></script>
}
