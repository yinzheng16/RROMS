@using Microsoft.AspNetCore.Identity
@using RROMS.Models
@using RROMS.Services.Interfaces
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService Notifications
@*
    EN04 / US51 (Owner: Member 1): right side of the navbar.
    Visitor: Log in + Register. Signed in: notification bell (customers) and account menu.
*@
<ul class="navbar-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    var displayName = string.IsNullOrWhiteSpace(appUser?.FullName) ? User.Identity?.Name : appUser!.FullName;
    var isCustomer = User.IsInRole(Roles.Customer);

    if (isCustomer)
    {
        var unread = await Notifications.CountUnreadAsync(UserManager.GetUserId(User)!);

        <li class="nav-item">
            <a class="nav-link nav-icon" href="/Customer/Cart" title="My cart" aria-label="My cart">
                <i class="bi bi-bag"></i>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link nav-icon" href="/Customer/Notifications" title="Notifications"
               aria-label="Notifications, @unread unread">
                <i class="bi bi-bell"></i>
                @if (unread > 0)
                {
                    <span class="nav-badge">@(unread > 9 ? "9+" : unread.ToString())</span>
                }
            </a>
        </li>
    }

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle nav-account" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-1"></i>@displayName
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (isCustomer)
            {
                <li><a class="dropdown-item" href="/Customer/Reservations">My reservations</a></li>
                <li><a class="dropdown-item" href="/Customer/Orders">My orders</a></li>
                <li><a class="dropdown-item" href="/Customer/Payments">My payments</a></li>
                <li><hr class="dropdown-divider" /></li>
            }
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">My profile</a></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </li>

    if (isCustomer)
    {
        <li class="nav-item d-none d-lg-block">
            <a class="btn btn-primary btn-sm px-3" href="/Customer/Reservations/Create">Book a table</a>
        </li>
    }
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-outline-gold btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
}
</ul>
