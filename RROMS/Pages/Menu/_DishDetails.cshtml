@model RROMS.Services.Interfaces.MenuItemSummary
@using System.Globalization
<div class="dish-detail">
    <div class="dish-detail__photo">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Url.Content(Model.ImageUrl)" alt="@Model.Name" width="800" height="800" data-dish-photo />
        }
        else
        {

            <div class="menu-photo-placeholder"><span aria-hidden="true">夜</span><span>Photo coming soon</span></div>
        }
    </div>
    <div class="dish-detail__text">
        <p class="eyebrow">@Model.CategoryName</p>
        <p class="dish-detail__code">@Model.Code</p>
        <h2 id="dish-detail-title">@Model.Name</h2>
        <p class="dish-detail__description">@(string.IsNullOrWhiteSpace(Model.Description) ? "A little taste of YORU. Ask our team for more details about this dish." : Model.Description)</p>
        <p class="menu-availability dish-detail__availability"><span class="bg-success" aria-hidden="true"></span>Available</p>
        <div class="dish-detail__footer">
            <strong>RM @Model.Price.ToString("F2", CultureInfo.InvariantCulture)</strong>
            @* Future US24 quantity/Add to cart controls; nothing displayed before that story. *@
            <div data-menu-detail-actions hidden></div>
        </div>
    </div>
</div>
