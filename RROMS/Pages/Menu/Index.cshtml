@page
@model RROMS.Pages.Menu.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Menu";
}

<div class="d-flex align-items-end justify-content-between gap-3 flex-wrap mb-4">
    <div>
        <p class="eyebrow mb-2">YORU IZAKAYA</p>
        <h1 class="display-5 mb-2">Something for the table.</h1>
        <p class="text-body-secondary mb-0">Discover your next favourite, one dish at a time.</p>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-4" role="search" aria-label="Search the menu">
    <div class="col-12 col-md-6">
        <label asp-for="Search" class="form-label">Find a dish</label>
        <input asp-for="Search" type="search" maxlength="100" class="form-control" placeholder="Search by name or item code" />
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in Model.Menu.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (Model.Menu.Sections.Count == 0)
{
    <div class="card rounded-4 p-4 text-center">
        <h2 class="h4">No dishes found</h2>
        <p class="text-body-secondary mb-0">Try another search or check back for more dishes.</p>
    </div>
}
@foreach (var menuSection in Model.Menu.Sections)
{
    <section class="mb-5" aria-labelledby="menu-category-@menuSection.Category.Id">
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="badge rounded-pill border text-body font-monospace">@menuSection.Category.Code</span>
            <h2 id="menu-category-@menuSection.Category.Id" class="h3 mb-0">@menuSection.Category.Name</h2>
        </div>
        <div class="row g-4">
            @foreach (var item in menuSection.Items)
            {
                <div class="col-12 col-sm-6 col-xl-4">
                    <article class="card h-100 rounded-4 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <div class="ratio ratio-4x3">
                                <img src="@Url.Content(item.ImageUrl)" alt="@item.Name" class="w-100 h-100 object-fit-cover" loading="lazy" />
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <p class="small text-body-secondary font-monospace mb-2">@item.Code</p>
                            <h3 class="h5">@item.Name</h3>
                            <p class="small text-body-secondary text-break">@item.Description</p>
                            <p class="fw-semibold mt-auto mb-0">RM @item.Price.ToString("F2", CultureInfo.InvariantCulture)</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}
