@* Match the normal toolbar's intrinsic space at each responsive breakpoint.
   This inert visual sizer has no form, names, IDs or focusable controls. *@
<div class="yoru-menu-collection-tools yoru-category-reorder-intro">
    <div class="yoru-category-reorder-sizer" aria-hidden="true" inert>
        <div class="yoru-menu-toolbar">
            <div class="yoru-menu-search">
                <span class="form-label small fw-semibold d-block">Find a category</span>
                <span class="form-control d-block">Search by category name</span>
            </div>
            <span class="btn btn-primary rounded-pill d-inline-flex align-items-center justify-content-center gap-2">Search</span>
            <span class="btn btn-outline-secondary rounded-pill d-inline-flex align-items-center justify-content-center gap-2">Filter &amp; sort</span>
        </div>
        <div class="yoru-menu-search-feedback small text-body-secondary mt-2" data-search-hint="Enter a category name to search."></div>
        <div class="yoru-menu-current-view mt-3">
            <p class="small fw-semibold mb-2">Current view</p>
            <div class="yoru-menu-viewbar">
                <div class="yoru-menu-view-copy"><div class="yoru-menu-view-chips"><span>All categories</span><span>Display order: low to high</span></div></div>
                <div class="yoru-menu-view-actions"><span class="btn btn-outline-secondary rounded-pill d-inline-flex align-items-center justify-content-center gap-2">Reset filters</span></div>
            </div>
        </div>
    </div>
    <div class="yoru-category-reorder-copy">
        <h3 class="h5">Arrange your menu</h3>
        <p class="small text-body-secondary mb-0">Drag a row by its handle, or use the up and down buttons. Save when the sequence feels right.</p>
    </div>
</div>
