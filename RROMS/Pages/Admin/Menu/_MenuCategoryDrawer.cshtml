@model RROMS.Pages.Admin.Menu.IndexModel
@* Category editor: one-column paper pop-up (same look as the draft/delete pop-ups) with a live strip preview. Same form contract as before:
   handler "Save", Input.Id, Input.Name and the list state (SearchTerm, SortOrder, PageNumber, ShowAll). *@
@{
    bool editing = Model.Input.Id.HasValue;
    bool open = editing || Model.CategoryEditorHasErrors || Context.Request.Query.ContainsKey("New");
    string name = Model.Input.Name?.Trim() ?? string.Empty;
    var parts = name.Split('·', 2, StringSplitOptions.TrimEntries);
    string primary = string.IsNullOrEmpty(parts[0]) ? "Your category" : parts[0];
    string english = parts.Length > 1 ? parts[1] : string.Empty;
    var current = editing ? Model.Categories.FirstOrDefault(c => c.Id == Model.Input.Id) : null;
    string number = (current?.DisplayOrder ?? Model.TotalCategories + 1).ToString("D2");
    int dishes = current?.ItemCount ?? 0;
    bool summaryErrors = ViewData.ModelState.TryGetValue(string.Empty, out var summary) && summary is not null && summary.Errors.Count > 0;
}
<dialog class="ms-dialog ms-dialog--compact" data-ms-dialog data-ms-kind="category" data-ms-draft="@(editing ? $"cat-edit-{Model.Input.Id}" : "cat-new")"
        data-open="@(open ? "true" : "false")" aria-labelledby="ms-cat-title" open="@open">
    <form id="category-form" class="ms-dialog__form" method="post" asp-page="./Index" asp-page-handler="Save" data-ms-form novalidate>
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" /><input type="hidden" name="SortOrder" value="@Model.SortOrder" />
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" /><input type="hidden" name="ShowAll" value="@Model.ShowAll.ToString().ToLowerInvariant()" />

        <p class="ms-confirm__eyebrow">Shape your menu</p>
        <button type="button" class="ms-confirm__close" aria-label="Close" data-ms-close><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        <h2 id="ms-cat-title">@(editing ? "Edit category" : "New category")</h2>
        <p class="ms-draft-note" data-ms-draft-note hidden><i class="bi bi-journal-text" aria-hidden="true"></i>Draft restored. Save to keep it, or discard it.</p>

        <div asp-validation-summary="ModelOnly" data-valmsg-summary="false" class="ms-alert" role="alert" hidden="@(!summaryErrors)"></div>

        <label class="ms-label" for="Input_Name">Category name</label>
        <input asp-for="Input.Name" class="ms-input" maxlength="50" placeholder="e.g. Sarada · Salads" required autocomplete="off" data-ms-name />
        <div class="ms-hint"><span>Use “Japanese · English” for a two-line name.</span><span><span data-ms-count>@name.Length</span>/50</span></div>
        <span asp-validation-for="Input.Name" class="ms-error"></span>

        <p class="ms-dialog__preview-label">Live preview</p>
        <article class="ms-tile ms-strip ms-tile--preview" aria-label="Live preview">
            <div class="ms-strip__num">
                <span class="ms-tile__num">@number</span>
                <span class="ms-code">@(editing ? Model.CategoryEditorCode : "NEW")</span>
            </div>
            <div class="ms-strip__main">
                <h3 data-ms-preview-name>@primary</h3>
                <p class="ms-tile__sub" data-ms-preview-sub>@(string.IsNullOrEmpty(english) ? "\u00a0" : english)</p>
                @if (dishes == 0)
                {
                    <span class="ms-count is-empty"><i class="bi bi-inbox" aria-hidden="true"></i>No dishes yet</span>
                }
                else
                {
                    <span class="ms-count"><i class="bi bi-cup-hot" aria-hidden="true"></i>@dishes @(dishes == 1 ? "dish" : "dishes")</span>
                }
            </div>
            <div class="ms-strip__acts" aria-hidden="true">
                <span class="ms-btn ms-btn--edit ms-strip__edit"><i class="bi bi-pencil"></i></span>
                @if (dishes == 0)
                {
                    <span class="ms-icon-btn"><i class="bi bi-trash3"></i></span>
                }
                else
                {
                    <span class="ms-lock ms-lock--icon"><i class="bi bi-lock"></i></span>
                }
            </div>
        </article>
        <p class="ms-dialog__preview-note">@(editing ? "Dishes in this category keep their place." : "Next: add dishes to it in Menu items.")</p>

        <div class="ms-confirm__actions ms-dialog__actions">
            <button type="button" class="ms-confirm__back" data-ms-close>Cancel</button>
            <button type="submit" class="ms-confirm__ok" data-ms-save>@(editing ? "Save changes" : "Create category")</button>
        </div>
    </form>
</dialog>
