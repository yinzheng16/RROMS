@page
@model RROMS.Pages.Admin.Settings

@{
    ViewData["Title"] = "Restaurant Settings";
}

<div class="page-header">
    <div>
        <p class="eyebrow">ADMINISTRATION</p>
        <h1>Restaurant Settings</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">

        <form method="post" enctype="multipart/form-data">

            <input type="hidden" asp-for="RestaurantSetting.Id" />
            <input type="hidden" asp-for="RestaurantSetting.LogoPath" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <!-- LEFT COLUMN -->
                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.RestaurantName"
                               class="form-label">
                            Restaurant Name
                        </label>

                        <input asp-for="RestaurantSetting.RestaurantName"
                               class="form-control" />

                        <span asp-validation-for="RestaurantSetting.RestaurantName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="RestaurantSetting.Email"
                               class="form-control" />

                        <span asp-validation-for="RestaurantSetting.Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Restaurant Logo
                        </label>

                        <input asp-for="LogoFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />

                        <div class="form-text">
                            JPG, JPEG or PNG only. Maximum file size: 2 MB.
                        </div>
                        
                        <span asp-validation-for="LogoFile"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.TaxRatePercent"
                               class="form-label">
                            Tax Rate (%)
                        </label>

                        <input asp-for="RestaurantSetting.TaxRatePercent"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100" />

                        <span asp-validation-for="RestaurantSetting.TaxRatePercent"
                              class="text-danger"></span>
                    </div>

                </div>

                <!-- RIGHT COLUMN -->
                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.Phone"
                               class="form-label">
                            Phone
                        </label>

                        <input asp-for="RestaurantSetting.Phone"
                               class="form-control" />

                        <span asp-validation-for="RestaurantSetting.Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.Address"
                               class="form-label">
                            Address
                        </label>

                        <input asp-for="RestaurantSetting.Address"
                               class="form-control" />

                        <span asp-validation-for="RestaurantSetting.Address"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Current Logo
                        </label>

                        @if (!string.IsNullOrWhiteSpace(Model.RestaurantSetting.LogoPath))
                        {
                            <button type="button"
                                    class="form-control text-start"
                                    data-bs-toggle="modal"
                                    data-bs-target="#logoPreviewModal">

                                <img src="@Model.RestaurantSetting.LogoPath"
                                     alt="Current restaurant logo"
                                     style="width: 24px; height: 24px; object-fit: contain; margin-right: 8px;" />

                                View current logo
                            </button>

                            <div class="form-text">
                                Click the logo to view a larger preview.
                            </div>
                        }
                        else
                        {
                            <div class="form-control text-muted">
                                No logo uploaded
                            </div>

                            <div class="form-text">
                                Upload a JPG, JPEG or PNG restaurant logo.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="RestaurantSetting.ServiceChargePercent"
                               class="form-label">
                            Service Charge (%)
                        </label>

                        <input asp-for="RestaurantSetting.ServiceChargePercent"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100" />

                        <span asp-validation-for="RestaurantSetting.ServiceChargePercent"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

        </form>

    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.RestaurantSetting.LogoPath))
{
    <div class="modal fade"
         id="logoPreviewModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Restaurant Logo</h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body text-center">

                    <img src="@Model.RestaurantSetting.LogoPath"
                         alt="Restaurant logo"
                         class="img-fluid" />

                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}