            document.getElementById('yoruHoursOpenCount').textContent = `${openIdx.length} ${openIdx.length === 1 ? 'day' : 'days'}`;
            document.getElementById('yoruHoursOpenRange').textContent = openIdx.length === yoruHourRows.length ? 'Every day' : rangeText;
            document.getElementById('yoruHoursClosedCount').textContent = closedNames.length ? `${closedNames.length} ${closedNames.length === 1 ? 'day' : 'days'}` : 'None';
            document.getElementById('yoruHoursClosedList').textContent = closedNames.join(', ');
