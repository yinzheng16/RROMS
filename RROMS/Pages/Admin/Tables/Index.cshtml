            document.getElementById('tableSummaryCode').textContent =
                (d.prefix || '').toUpperCase();
            document.getElementById('tableSummaryArea').textContent =
                d.areaName || '-';
            document.getElementById('tableSummaryGuests').textContent =
                d.min ? (d.min === d.max ? d.min + ' guest' : d.min + '–' + d.max + ' guests') : '-';

            const spend = Number(d.spend || 0);
            document.getElementById('tableSummarySpend').textContent =
                !d.min ? '-' : spend > 0
                    ? 'RM ' + spend.toLocaleString('en-MY', { maximumFractionDigits: 0 })
                    : 'None';
        }

        function syncTableNumberDisplay() {
            const option = dynamicTypeField.selectedOptions[0];
                updateTableSummary(option);
            const code = (option?.dataset.prefix || '').toUpperCase();
            const padding = Number(option?.dataset.padding || 3);

            let fullNumber = (nameField.value || '').trim();

            if (!code) {
                tableCodePrefix.textContent = '---';
                tableNumberDigits.value = '';
                return;
            }

            if (!isEditing && !fullNumber) {
                fullNumber = nextLocalTableName(option);
                nameField.value = fullNumber;
            }

            let digits = '';

            if (fullNumber.toUpperCase().startsWith(code)) {
                digits = fullNumber.slice(code.length);
            } else {
                digits = fullNumber.replace(/^[A-Za-z]+/, '');
            }

            tableCodePrefix.textContent = code;
            tableNumberDigits.maxLength = padding;
            tableNumberDigits.placeholder = String(1).padStart(padding, '0');
            tableNumberDigits.value = digits;

            if (!isEditing && digits) {
                syncTableNumberValue();
            }
        }

        function syncTableNumberValue() {
            const option = dynamicTypeField.selectedOptions[0];
            const prefix = option?.dataset.prefix || '';
            const padding = Number(option?.dataset.padding || 3);

            const digits = tableNumberDigits.value.replace(/\D/g, '');
            tableNumberDigits.value = digits.slice(0, padding);

            if (!prefix || !digits) {
                nameField.value = '';
                return;
            }

            nameField.value = prefix + tableNumberDigits.value;

            tableNumberError.hidden = true;        }

        tableNumberDigits.addEventListener('input', syncTableNumberValue);
        const tableForm = nameField.closest('form');

        tableForm.addEventListener('submit', e => {
            const option = dynamicTypeField.selectedOptions[0];
            const padding = Number(option?.dataset.padding || 3);
            const digits = tableNumberDigits.value;

            if (!/^\d+$/.test(digits) || digits.length !== padding) {
                e.preventDefault();
                e.stopImmediatePropagation();

                tableNumberError.textContent =
                    `Please enter exactly ${padding} digits.`;
                tableNumberError.hidden = false;

                tableNumberDigits.focus();
                return;
            }

            syncTableNumberValue();
        }, true);
        const areaField = tableModal.querySelector('[name="TableForm.DiningAreaId"]');
            areaField.addEventListener('change', () => {
        const option = dynamicTypeField.selectedOptions[0];
        if (option) {
            areaField.value = option.dataset.area || '';
        }
    });
        const minField = tableModal.querySelector('[name="TableForm.MinGuests"]');
        const maxField = tableModal.querySelector('[name="TableForm.Capacity"]');
        const spendField = tableModal.querySelector('[name="TableForm.MinimumSpend"]');
        const activeField = tableModal.querySelector('[name="TableForm.IsActive"]');
        const descriptionField = tableModal.querySelector('[name="TableForm.Description"]');
        const existingTables = Array.from(document.querySelectorAll('.yoru-table-row') ).map(row => row.dataset.name.toUpperCase());
        let isEditing = false;
        let nameWasEdited = false;

        function nextLocalTableName(option) {
            const code = (option.dataset.prefix || '').toUpperCase();
            const padding = Number(option.dataset.padding || 3);

            if (!code) return '';

            const used = new Set(
                Array.from(document.querySelectorAll('.yoru-table-row'))
                    .map(row => (row.dataset.name || '').toUpperCase())
            );

            const maxNumber = Math.pow(10, padding) - 1;

            for (let number = 1; number <= maxNumber; number++) {
                const candidate =
                    code + String(number).padStart(padding, '0');

                if (!used.has(candidate)) {
                    return candidate;
                }
            }

            return '';
        }

        function applyDynamicTypeDefaults() {
            if (isEditing) return;

            const option = dynamicTypeField.selectedOptions[0];
            if (!option || !option.value) {
                nameField.value = '';
                return;
            }
            // Show the table list belonging to the selected type.
            const panelId = 'modal-tables-type-' + option.value;

            if (document.getElementById(panelId)) {
                showTablePanel(panelId);
                previousTablePanelId = panelId;
            }

            areaField.value = option.dataset.area || '';
            minField.value = option.dataset.min || '1';
            maxField.value = option.dataset.max || '2';
            spendField.value = option.dataset.spend || '0';
            descriptionField.value = '';
            activeField.checked = true;

            if (!nameWasEdited) {
                nameField.value = nextLocalTableName(option);
            }

            // Legacy enum remains for backward compatibility.
            // Dynamic TableTypeDefinitionId is the authoritative type.
            legacyTypeField.value = '2';
        }

