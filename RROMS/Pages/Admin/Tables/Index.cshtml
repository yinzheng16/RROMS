            if (!/^\d+$/.test(digits) || digits.length !== padding) {
                e.preventDefault();
                e.stopImmediatePropagation();

                tableNumberError.textContent =
                    `Please enter exactly ${padding} digits.`;
                tableNumberError.hidden = false;

                tableNumberDigits.focus();
