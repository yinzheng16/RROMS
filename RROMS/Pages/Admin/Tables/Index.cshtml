        function yoruBuildWheel(col, values, field) {
            col.innerHTML = '';
            const spacer1 = document.createElement('div'); spacer1.className = 'yoru-wheel-spacer'; col.appendChild(spacer1);
            values.forEach(value => {
                const item = document.createElement('div'); item.className = 'yoru-wheel-option'; item.dataset.value = value; item.textContent = value;
                item.addEventListener('click', () => { col.scrollTo({top:values.indexOf(value) * 44, behavior:'smooth'}); });
                col.appendChild(item);
            });
            const spacer2 = document.createElement('div'); spacer2.className = 'yoru-wheel-spacer'; col.appendChild(spacer2);
            let raf = 0;
            col.addEventListener('scroll', () => {
                cancelAnimationFrame(raf);
                raf = requestAnimationFrame(() => {
                    const index = Math.max(0, Math.min(values.length-1, Math.round(col.scrollTop / 44)));
                    yoruWheelValues[field] = values[index];
                    col.querySelectorAll('.yoru-wheel-option').forEach((el,i) => el.classList.toggle('selected', i === index));
                    yoruWheelPreview();
                });
            }, {passive:true});
            // One mouse-wheel notch moves exactly one option, a little slower.
            let lastStep = 0;
            col.addEventListener('wheel', e => {
                e.preventDefault();
                const now = performance.now();
                if (now - lastStep < 130 || !e.deltaY) return;
                lastStep = now;
                const current = Math.round(col.scrollTop / 44);
                const index = Math.max(0, Math.min(values.length - 1, current + Math.sign(e.deltaY)));
                col.scrollTo({top:index * 44, behavior:'smooth'});
            }, {passive:false});
        }
         function yoruWheelPreview() {
            const h = document.getElementById('yoruWheelHourInput');
            const m = document.getElementById('yoruWheelMinuteInput');
            const p = document.getElementById('yoruWheelPeriodBtn');
            if (!h || !m || !p) return;
            if (document.activeElement !== h) h.value = yoruWheelValues.hour;
            if (document.activeElement !== m) m.value = yoruWheelValues.minute;
            p.textContent = yoruWheelValues.period;
        }
        function yoruCommitManual() {
            const hi = document.getElementById('yoruWheelHourInput');
            const mi = document.getElementById('yoruWheelMinuteInput');
            let h = parseInt(hi.value, 10);
            let m = parseInt(mi.value, 10);
            if (Number.isFinite(h)) yoruSetWheel(yoruWheelHour, yoruPad(Math.min(12, Math.max(1, h))), 'hour');
            if (Number.isFinite(m)) yoruSetWheel(yoruWheelMinute, yoruPad(Math.min(59, Math.max(0, m))), 'minute');
            hi.value = yoruWheelValues.hour;
            mi.value = yoruWheelValues.minute;
            yoruWheelPreview();
        }
        function yoruSetWheel(col, value, field) {
            const index = Array.from(col.querySelectorAll('.yoru-wheel-option')).findIndex(el => el.dataset.value === value);
            col.scrollTop = Math.max(0,index) * 44;
            yoruWheelValues[field] = value;
            col.querySelectorAll('.yoru-wheel-option').forEach(el => el.classList.toggle('selected',el.dataset.value === value));
        }
        yoruBuildWheel(yoruWheelHour, Array.from({length:12},(_,i)=>yoruPad(i+1)), 'hour');
