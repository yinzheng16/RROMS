                row.querySelector('[data-hours-status]').textContent = isClosed ? 'Closed' : 'Open';
                row.querySelector('.yoru-hours-status').classList.toggle('is-closed', isClosed);
            });
            const yoruBreakRow = yoruHourRows.find(r => !r.querySelector('[name$=".IsClosed"]').checked && r.querySelector('[name$=".BreakStart"]')?.value && r.querySelector('[name$=".BreakEnd"]')?.value);
