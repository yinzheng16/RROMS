    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const section = document.getElementById('dining-areas-section');
        if (!section) return;

        const cards = Array.from(section.querySelectorAll('.yoru-area-card'));
        const search = document.getElementById('yoruAreaSearch');
        const filter = document.getElementById('yoruAreaStatusFilter');
        const clear = document.getElementById('yoruAreaClear');
        const count = document.getElementById('yoruAreaResultCount');
        const empty = document.getElementById('yoruAreaNoResults');
        const pagination = document.getElementById('yoruAreaPagination');
        const pageInfo = document.getElementById('yoruAreaPageInfo');
        const prev = document.getElementById('yoruAreaPrev');
        const next = document.getElementById('yoruAreaNext');

        const pageSize = 5;
        let currentPage = 1;

        function renderAreas() {
            const keyword = search.value.trim().toLowerCase();
            const selectedStatus = filter.value;

            const matching = cards.filter(card => {
                const name = (card.dataset.areaName || '').toLowerCase();
                const status = card.dataset.areaStatus || '';
                return name.includes(keyword) &&
                    (selectedStatus === 'all' || status === selectedStatus);
            });

            const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));
            currentPage = Math.min(Math.max(1, currentPage), totalPages);

            cards.forEach(card => {
                card.hidden = true;
            });

            const start = (currentPage - 1) * pageSize;

            matching.slice(start, start + pageSize).forEach(card => {
                card.hidden = false;
            });

            count.textContent = matching.length + ' dining area(s) found';
            empty.hidden = matching.length !== 0;
            pagination.hidden = matching.length <= pageSize;

            pageInfo.textContent = 'Page ' + currentPage +
                ' of ' + totalPages + ' · ' + matching.length + ' results';

            prev.disabled = currentPage <= 1;
            next.disabled = currentPage >= totalPages;
        }

        search.addEventListener('input', () => {
            currentPage = 1;
            renderAreas();
        });

        filter.addEventListener('change', () => {
            currentPage = 1;
            renderAreas();
        });

        clear.addEventListener('click', () => {
            search.value = '';
            filter.value = 'all';
            currentPage = 1;
            renderAreas();
        });

        prev.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                renderAreas();
            }
        });

        next.addEventListener('click', () => {
            currentPage++;
            renderAreas();
        });

        renderAreas();
    });
    </script>
    
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const overlay = document.getElementById('yoruAreaDrawerOverlay');
        const drawer = document.getElementById('areaModal');

        if (!overlay || !drawer) return;

        document.querySelectorAll('[data-area-drawer-open]').forEach(button => {
            button.addEventListener('click', function (event) {
                event.preventDefault();

                const data = button.dataset;
                const form = drawer.querySelector('form');

                form.querySelector('[name="AreaForm.Id"]').value = data.id || '0';
                form.querySelector('[name="AreaForm.Name"]').value = data.name || '';
                form.querySelector('[name="AreaForm.Description"]').value = data.desc || '';

                document.getElementById('areaTitle').textContent =
                    data.id ? 'Edit Dining Area' : 'Add Dining Area';

                const icon = data.icon || 'layout-grid';
                document.getElementById('yoruAreaIconName').value = icon;

                drawer.querySelectorAll('[data-icon-choice]').forEach(choice => {
                    choice.classList.toggle('selected', choice.dataset.iconChoice === icon);
                });

                const mode = document.getElementById('yoruAreaStatusMode');
                const status = document.getElementById('yoruAreaManualStatus');
                const wrapper = document.getElementById('yoruAreaManualStatusWrap');

                mode.value = data.statusMode === 'Manual' ? 'Manual' : 'Auto';
                status.value = data.manualStatus === 'Occupied' ? 'Occupied' : 'Available';
                wrapper.hidden = mode.value !== 'Manual';
                status.disabled = mode.value !== 'Manual';

                overlay.hidden = false;

                const workspace = document.getElementById('yoruAreaWorkspace');
                workspace.classList.add('drawer-open');

                requestAnimationFrame(() => {
                    overlay.classList.add('is-open');
                });
            });
        });

        drawer.querySelectorAll('[data-icon-choice]').forEach(choice => {
            choice.addEventListener('click', function () {
                document.getElementById('yoruAreaIconName').value = choice.dataset.iconChoice;

                drawer.querySelectorAll('[data-icon-choice]').forEach(btn => {
                    btn.classList.toggle('selected', btn === choice);
                });
            });
        });

        document.getElementById('yoruAreaStatusMode').addEventListener('change', function () {
            const manual = this.value === 'Manual';
            document.getElementById('yoruAreaManualStatusWrap').hidden = !manual;
            document.getElementById('yoruAreaManualStatus').disabled = !manual;
        });

        function closeAreaDrawer() {
            overlay.classList.remove('is-open');
            document.getElementById('yoruAreaWorkspace').classList.remove('drawer-open');
            overlay.hidden = true;
        }

        overlay.querySelectorAll('[data-area-drawer-close]').forEach(button => {
            button.addEventListener('click', closeAreaDrawer);
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !overlay.hidden) {
                closeAreaDrawer();
            }
        });
    });
    </script>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalElement = document.getElementById('yoruSpecialModal');
        const addButton = document.getElementById('yoruSpecialAdd');
        const idInput = document.getElementById('yoruSpecialId');
        const dateInput = document.getElementById('yoruSpecialDate');
        const nameInput = document.getElementById('yoruSpecialName');
        const closedInput = document.getElementById('yoruSpecialClosed');
        const openInput = document.getElementById('yoruSpecialOpen');
        const closeInput = document.getElementById('yoruSpecialClose');
        const timeFields = document.getElementById('yoruSpecialTimeFields');

        if (!modalElement || !addButton || typeof bootstrap === 'undefined') return;

        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

        function updateTimeFields() {
            timeFields.style.display = closedInput.checked ? 'none' : '';
            openInput.required = !closedInput.checked;
            closeInput.required = !closedInput.checked;
        }

        addButton.addEventListener('click', function () {
            idInput.value = '0';
            dateInput.value = '';
            nameInput.value = '';
            closedInput.checked = false;
            openInput.value = '11:00';
            closeInput.value = '23:00';
            document.getElementById('yoruSpecialModalTitle').textContent = 'Add Special Date';
            updateTimeFields();
            modal.show();
        });

        document.querySelectorAll('[data-special-edit]').forEach(function (button) {
            button.addEventListener('click', function () {
                idInput.value = button.dataset.id;
                dateInput.value = button.dataset.date;
                nameInput.value = button.dataset.name;
                closedInput.checked = button.dataset.closed === 'true';
                openInput.value = button.dataset.open || '11:00';
                closeInput.value = button.dataset.close || '23:00';
                document.getElementById('yoruSpecialModalTitle').textContent = 'Edit Special Date';
                updateTimeFields();
                modal.show();
            });
        });

        closedInput.addEventListener('change', updateTimeFields);
        updateTimeFields();
    });
    </script>
}
