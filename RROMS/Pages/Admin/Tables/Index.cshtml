            <input type="text" id="yoruWheelMinuteInput" class="yoru-wheel-input" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="Minute (0 to 59)" />
            <button type="button" id="yoruWheelPeriodBtn" class="yoru-wheel-period-btn" aria-label="Toggle AM or PM">AM</button>
        </div>
        <div class="d-flex justify-content-end gap-2"><button type="button" class="yoru-luxury-btn secondary" id="yoruWheelCancel">Cancel</button><button type="button" class="yoru-luxury-btn" id="yoruWheelConfirm">Confirm Time</button></div>
    </div>
</div>


<!-- Delete Table Type Confirmation -->
<div class="modal fade"
     id="deleteTableTypeModal"
     tabindex="-1"
     aria-labelledby="deleteTableTypeTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <form method="post"
              asp-page-handler="DeleteTableType"
              class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteTableTypeTitle">
                    Delete Table Type
                </h2>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden"
                       name="id"
                       id="deleteTableTypeId" />

                <p>
                    Are you sure you want to delete
                    <strong id="deleteTableTypeName"></strong>?
                </p>

                <p id="deleteTableTypeBlocked"
                   class="text-danger small d-none">
                    This table type still contains tables.
                    Delete or move its tables before deleting this type.
                </p>

                <p id="deleteTableTypeWarning"
                   class="text-danger small">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
