@page
@model RROMS.Pages.Admin.Tables.IndexModel
@using RROMS.Models
@{
    ViewData["Title"] = "Tables and opening hours";
}

<div class="page-header yoru-tables-page">
    <div><p class="eyebrow">Restaurant Management</p><h1>Tables & Opening hours</h1><p class="text-muted mb-0">Manage table types, seating areas and opening hours.</p></div>
</div>
<div class="yoru-summary mb-4">
    <div class="yoru-summary-item"> <strong>@Model.AllTables.Count</strong> <span>Total tables</span> </div>
    <div class="yoru-summary-item"> <strong>@(Enum.GetValues<TableType>().Length)</strong> <span>Table types</span> </div>
    <div class="yoru-summary-item"> <strong>@Model.Areas.Count</strong> <span>Dining areas</span> </div>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@{
    var typeNames = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "Counter seat",
        [TableType.Double] = "Table for two",
        [TableType.Standard] = "Standard table",
        [TableType.Vip] = "VIP room",
        [TableType.Vvip] = "VVIP room"
    };
    var sampleImages = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "/images/tables/counter.jpg",
        [TableType.Double] = "/images/tables/double.jpg",
        [TableType.Standard] = "/images/tables/standard.jpg",
        [TableType.Vip] = "/images/tables/vip.jpg",
        [TableType.Vvip] = "/images/tables/vvip.jpg"
    };
}
<style>
    body.back-office:has(.yoru-tables-page) .site-main > .container-wide {
        padding-top: 16px !important;
    }
    .yoru-workspace {display:grid; gap:24px; }
    .yoru-workspace-heading {display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .yoru-summary {display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .yoru-summary-item {background: #fffdfa; border: 1px solid #e5d9c9; border-radius: 12px; padding: 18px; }
    .yoru-summary-item strong {display: block; font-size: 1.6rem; color: #342820; }
    .yoru-summary-item span {color: #796e62; font-size: .85rem; }
    .yoru-type-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:14px; }
    .yoru-type-card { border:1px solid #e5d9c9; border-radius:12px; overflow:hidden; background:#fffdfa; display:flex; flex-direction:column; height:100%; transition:transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
    .yoru-type-card:hover {transform: translateY(-3px); border-color: #a83228; box-shadow: 0 10px 24px rgba(0, 0, 0, .12); }
    .yoru-type-card.yoru-selected {border-color: #a83228; box-shadow: 0 0 0 1px #a83228; }
    .yoru-type-card:focus-visible {outline: 3px solid #a83228; outline-offset: 3px; }
    .yoru-type-image-wrap { overflow: hidden; }
    .yoru-type-image { display: block; width:100%; height:145px; object-fit:cover; background:#eee8df; transition: transform 180ms ease; }
    .yoru-type-card:hover .yoru-type-image {transform: scale(1.03); }
    .yoru-type-body { padding:14px; display:flex; flex-direction:column; flex:1; }
    .yoru-type-title { font-weight:700; margin:0; }
    .yoru-type-meta { color:#796e62; font-size:.86rem; margin:7px 0 8px; }
    .yoru-type-spend { color:#8e2b24; font-size:.82rem; font-weight:600; margin:0 0 12px; }
    .yoru-type-actions { display:flex; flex-wrap:wrap; gap:7px; margin-top:auto; align-items:center; }
    .yoru-status-select { min-width:145px; }
    .yoru-search-toolbar {display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
    .yoru-search-toolbar .form-control { flex: 1; min-width: 160px; }
    .yoru-search-toolbar .form-select { width: auto; min-width: 150px; }
    .yoru-pagination { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 12px;}
    .yoru-type-detail .modal-body {flex:1 1 auto; min-height:0; display: flex; flex-direction: column; overflow:hidden; }
    .yoru-type-detail .table-responsive {flex: 1 1 0; min-height: 0; overflow:auto;}
    .yoru-type-detail .yoru-pagination {flex-shrink: 0; margin-top: 12px; }
    .yoru-type-detail .modal-dialog { height:580px !important; min-height: 0 !important; max-height: calc(100dvh - 32px); }
    .yoru-type-detail .modal-dialog-scrollable .modal-content {height: 100%; max-height: 100; display: flex; flex-direction: column;}
    .yoru-type-detail .modal-content { height: 100% !important; min-height: 0 !important;max-height: 100% !important; display: flex; flex-direction: column; }
    .yoru-type-detail .modal-header, .yoru-type-detail .modal-footer { flex: 0 0 auto; }
    .yoru-type-detail .yoru-search-toolbar { flex-shrink: 0;}
    .yoru-secondary-section {border: 1px solid #e5d9c9; border-radius: 12px; background: #fffdfa; padding: 20px;}
    @@media(max-width:1200px) { .yoru-type-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
    @@media(max-width:720px) { .yoru-type-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:450px) { .yoru-type-grid { grid-template-columns:1fr; } }
    @@media (prefers-reduced-motion: reduce) {.yoru-type-card, .yoru-type-image, .yoru-type-detail.collapsing {transition: none;} }

    #tableModal .yoru-advanced-field { display: none !important;}
    #tableModal.yoru-edit-mode .yoru-advanced-field { display: block !important;}
</style>
<div class="card mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h5 mb-1">Table types</h2>
                <p class="text-muted mb-0"> Select a table type to manage individual tables and their status.</p>
            </div>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#tableModal"> Add table </button>
        </div>

        

<div class="yoru-type-grid">
    @foreach (var type in Enum.GetValues<TableType>())
    {
        var tables = Model.AllTables
            .Where(t => t.Type == type)
            .ToList();

        var imagePath = tables
            .Select(t => t.PhotoPath)
            .FirstOrDefault(x => !string.IsNullOrEmpty(x))
            ?? sampleImages[type];

        var sectionId = $"tables-type-{(int)type}";

        var isRoom = type == TableType.Vip
                  || type == TableType.Vvip;

        var unit = isRoom
            ? (tables.Count == 1 ? "room" : "rooms")
            : (tables.Count == 1 ? "table" : "tables");

        var guestText = tables.Count == 0
            ? "No tables"
            : tables.Min(t => t.MinGuests) == tables.Max(t => t.Capacity)
                ? $"{tables.Min(t => t.MinGuests)} guest"
                : $"{tables.Min(t => t.MinGuests)}–{tables.Max(t => t.Capacity)} guests";

        <div class="yoru-type-card">

            <div class="yoru-type-image-wrap">
                <img class="yoru-type-image"
                     src="@imagePath"
                     alt="@typeNames[type]" />
            </div>

            <div class="yoru-type-body">
                <p class="yoru-type-title">
                    @typeNames[type]
                </p>

                <p class="yoru-type-meta">
                    @tables.Count @unit · @guestText
                </p>

                @if (isRoom && tables.Any())
                {
                    <p class="yoru-type-spend">
                        Minimum spend:
                        @TableTypeInfo.Rm(tables.Min(t => t.MinimumSpend))
                    </p>
                }

                <div class="yoru-type-actions">
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#modal-@(sectionId)">
                        @(isRoom ? "Manage rooms" : "Manage tables")
                    </button>

                    <form method="post"
                          asp-page-handler="TypePhoto"
                          enctype="multipart/form-data"
                          onclick="event.stopPropagation()">

                        <input type="hidden"
                               name="type"
                               value="@type" />

                        <label class="btn btn-outline-secondary btn-sm mb-0">
                            Change photo

                            <input type="file"
                                   name="photo"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   hidden
                                   onchange="this.form.submit()" />
                        </label>
                    </form>
                </div>
            </div>
        </div>
    }
</div>



        <div id="tableTypeAccordion">
        @foreach (var type in Enum.GetValues<TableType>())
        {
            var tables = Model.AllTables.Where(t => t.Type == type).ToList();
            var isRoom = type == TableType.Vip || type == TableType.Vvip;
            var unit = isRoom ? (tables.Count == 1 ? "room" : "rooms") : (tables.Count == 1 ? "table" : "tables");
            <div class="modal fade yoru-type-detail" id="modal-tables-type-@((int)type)" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class=" modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@typeNames[type] — Manage Tables </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-lable="Close"></button>
                        </div>
                
                        <div class="modal-body">
                            <div class="yoru-search-toolbar"> <input type="search" class="form-control yoru-table-search" placeholder="Search table name..." aria-label="Search tables" />
                                <select class="form-select yoru-table-status-filter" aria-label="Filter table status"> <option value="">All statuses</option>
                                    @foreach (var status in Enum.GetValues<TableStatus>())
                                    {<option value="@status"> @(status == TableStatus.OutOfService ? "Out of service" : status.ToString()) </option>}
                                </select>

                                <select class="form-select yoru-table-active-filter" aria-label="Filter active tables">
                                    <option value="">All tables</option> <option value="true">Active</option> <option value="false">Inactive</option>
                                </select>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle"> <thead><tr><th>Table</th><th>Area</th><th>Seats</th><th>Minimum spend</th><th>Status</th><th>Active</th><th>Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var t in tables)
                                            {
                                                <tr class="yoru-table-row" data-name="@t.TableNumber" data-status="@t.Status" data-active="@t.IsActive.ToString().ToLowerInvariant()">
                                                    <td class="fw-semibold">@t.TableNumber</td>
                                                    <td>@Model.Areas.First(a => a.Id == t.DiningAreaId).Name</td>
                                                    <td>@(t.MinGuests == t.Capacity ? t.Capacity.ToString() : $"{t.MinGuests}-{t.Capacity}")</td>
                                                    <td>@(t.MinimumSpend > 0 ? TableTypeInfo.Rm(t.MinimumSpend) : "–")</td>
                                                    <td>
                                                        <form method="post" asp-page-handler="Status" class="d-flex gap-2 align-items-center">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <select name="status" class="form-select form-select-sm yoru-status-select" aria-label="Status for @t.TableNumber">
                                                                @foreach (var status in Enum.GetValues<TableStatus>())
                                                                {
                                                                    <option value="@status" selected="@(t.Status == status)">@(status == TableStatus.OutOfService ? "Out of service" : status.ToString())</option>
                                                                }
                                                            </select>
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                                        </form>
                                                    </td>
                                                    <td>@(t.IsActive ? "Yes" : "No")</td>
                                                    <td class="text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#tableModal"
                                                                data-id="@t.Id" data-number="@t.TableNumber" data-type="@((int)t.Type)" data-area="@t.DiningAreaId"
                                                                data-min="@t.MinGuests" data-max="@t.Capacity" data-spend="@t.MinimumSpend.ToString("0")" data-desc="@t.Description" data-active="@t.IsActive.ToString().ToLower()">
                                                            Edit
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                data-bs-toggle="modal" data-bs-target="#deleteTableModal"
                                                                data-id="@t.Id" data-number="@t.TableNumber" data-kind="@(isRoom ? "room" : "table")">
                                                            Delete
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!tables.Any())
                                            { <tr><td colspan="7">No tables of this type yet.</td></tr> }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="yoru-pagination"> <small class="text-muted yoru-page-info"></small>
                                    <div class="btn-group" role="group"> <button type="button" class="btn btn-outline-secondary btn-sm yoru-prev"> Previous</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm yoru-next"> Next </button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"> Close </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Dining areas</h2>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#areaModal">Add area</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Area</th><th>Description</th><th>Tables</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var a in Model.Areas)
                            {
                                <tr>
                                    <td class="fw-semibold">@a.Name</td>
                                    <td>@a.Description</td>
                                    <td>@a.Tables.Count</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#areaModal"
                                                data-id="@a.Id" data-name="@a.Name" data-desc="@a.Description">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal" data-bs-target="#deleteAreaModal"
                                                data-id="@a.Id" data-name="@a.Name" data-has-tables="@(a.Tables.Any() ? "true" : "false")">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Areas.Any())
                            {
                                <tr><td colspan="4">No dining areas yet. Add one first, then add tables to it.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Opening hours</h2>

                <button type="submit"
                        form="hoursForm"
                        class="btn btn-primary btn-sm">
                    Save opening hours
                </button>
            </div>

            <form id="hoursForm" method="post" asp-page-handler="SaveHours">
                <div class="table-responsive">
                        <table class="table align-middle mb-3">
                            <thead><tr><th>Day</th><th>Opens</th><th>Closes</th><th>Closed</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < Model.Hours.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Model.Hours[i].Day
                                            <input type="hidden" asp-for="Hours[i].Id" />
                                            <input type="hidden" asp-for="Hours[i].Day" />
                                        </td>
                                        <td><input asp-for="Hours[i].OpenTime" type="time" class="form-control form-control-sm" /></td>
                                        <td><input asp-for="Hours[i].CloseTime" type="time" class="form-control form-control-sm" /></td>
                                        <td><input asp-for="Hours[i].IsClosed" class="form-check-input" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="areaModal" tabindex="-1" aria-labelledby="areaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveArea" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="areaTitle">Dining area</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="AreaForm.Id" />
                <label asp-for="AreaForm.Name" class="form-label">Name</label>
                <input asp-for="AreaForm.Name" class="form-control mb-3" required maxlength="60" />
                <label asp-for="AreaForm.Description" class="form-label">Description (optional)</label>
                <input asp-for="AreaForm.Description" class="form-control" maxlength="200" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary">Save area</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveTable" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="tableTitle">Table or room</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body row g-3"> <input type="hidden" asp-for="TableForm.Id" />           
                <div class="col-12"><label asp-for="TableForm.Type" class="form-label"> Table Type </label>
                    <select asp-for="TableForm.Type" asp-items="Html.GetEnumSelectList<TableType>()" class="form-select"> </select>
                </div>

                <div class="col-12"><label asp-for="TableForm.TableNumber" class="form-label"> Table Name </label>
                    <input asp-for="TableForm.TableNumber" class="form-control" required maxlength="10" />
                    <small class="text-muted"> Suggested automatically. You can change it. </small>
                </div>

                <div class="col-12 yoru-advanced-field">
                    <label asp-for="TableForm.DiningAreaId" class="form-label"> Dining Area</label>
                    <select asp-for="TableForm.DiningAreaId" class="form-select" asp-items="@(new SelectList(Model.Areas, "Id", "Name"))" required>
                        <option value="">Choose...</option></select>
                </div>

                <div class="col-4 yoru-advanced-field">
                    <label asp-for="TableForm.MinGuests" class="form-label"> Min Guests</label>
                    <input asp-for="TableForm.MinGuests" type="number" min="1" max="20" class="form-control" required />
                </div>

                <div class="col-4 yoru-advanced-field">
                    <label asp-for="TableForm.Capacity" class="form-label"> Max Guests </label>
                    <input asp-for="TableForm.Capacity" type="number" min="1" max="20" class="form-control" required />
                </div>

                <div class="col-4 yoru-advanced-field">
                    <label asp-for="TableForm.MinimumSpend" class="form-label"> Min Spend (RM)</label>
                    <input asp-for="TableForm.MinimumSpend" type="number" min="0" step="50" class="form-control" />
                </div>

                <div class="col-12 yoru-advanced-field">
                    <label asp-for="TableForm.Description" class="form-label"> Description </label>
                    <input asp-for="TableForm.Description" class="form-control" maxlength="300" />
                </div>

                <div class="col-12 yoru-advanced-field">
                    <div class="form-check">
                        <input asp-for="TableForm.IsActive" class="form-check-input" />
                        <label asp-for="TableForm.IsActive" class="form-check-label"> Active (can be booked by customers)</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"> Cancel </button>
                <button type="submit" class="btn btn-primary"> Save table </button>
            </div>
        </form>
    </div>
</div>



<!-- Delete table/room confirmation -->
<div class="modal fade" id="deleteTableModal" tabindex="-1" aria-labelledby="deleteTableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="DeleteTable" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteTableTitle">Confirm deletion</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteTableId" />
                <p>Are you sure you want to delete <strong id="deleteTableName"></strong>?</p>
                <p class="text-danger small mb-0">This action cannot be undone. Existing reservations may prevent deletion.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete dining area confirmation -->
<div class="modal fade" id="deleteAreaModal" tabindex="-1" aria-labelledby="deleteAreaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="DeleteArea" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteAreaTitle">Delete dining area</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteAreaId" />
                <p>Are you sure you want to delete <strong id="deleteAreaName"></strong>?</p>
                <p id="deleteAreaBlocked" class="text-danger small mb-0 d-none">This dining area still contains tables. Remove or move them before deleting the area.</p>
                <p id="deleteAreaWarning" class="text-danger small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger" id="confirmDeleteArea">Delete area</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Fill the modals: "Edit" buttons carry data-* values, "Add" buttons carry none (so the form is cleared).
        function bindModal(modalId, fields) {
            const m = document.getElementById(modalId);
            m.addEventListener('show.bs.modal', e => {
                const d = e.relatedTarget ? e.relatedTarget.dataset : {};
                for (const [name, key, fallback] of fields) {
                    const el = m.querySelector('[name="' + name + '"]');
                    if (!el) continue;
                    const v = d[key] !== undefined ? d[key] : fallback;
                    if (el.type === 'checkbox') el.checked = (v === 'true'); else el.value = v;
                }
            });
        }
        bindModal('areaModal', [['AreaForm.Id','id','0'], ['AreaForm.Name','name',''], ['AreaForm.Description','desc','']]);
        bindModal('tableModal', [['TableForm.Id','id','0'], ['TableForm.TableNumber','number',''], ['TableForm.Type','type','2'],
            ['TableForm.DiningAreaId','area',''], ['TableForm.MinGuests','min','1'], ['TableForm.Capacity','max','2'],
            ['TableForm.MinimumSpend','spend','0'], ['TableForm.Description','desc',''], ['TableForm.IsActive','active','true']]);
        
        // Apply defaults when adding a table or changing its type. Existing table values remain intact on Edit.
        const tableModal = document.getElementById('tableModal');
        const typeField = tableModal.querySelector('[name="TableForm.Type"]');
        const nameField = tableModal.querySelector('[name="TableForm.TableNumber"]');
        const areaField = tableModal.querySelector('[name="TableForm.DiningAreaId"]');
        const minField = tableModal.querySelector('[name="TableForm.MinGuests"]');
        const maxField = tableModal.querySelector('[name="TableForm.Capacity"]');
        const spendField = tableModal.querySelector('[name="TableForm.MinimumSpend"]');
        const activeField = tableModal.querySelector('[name="TableForm.IsActive"]');
        const existingTables = Array.from(document.querySelectorAll('.yoru-table-row') ).map(row => row.dataset.name);
        const defaults = {
            '0': { prefix: 'C', area: 'Bar Counter', min: 1, max: 1, spend: 0 },
            '1': { prefix: 'D', area: 'Main Hall', min: 1, max: 2, spend: 0 },
            '2': { prefix: 'T', area: 'Main Hall', min: 3, max: 6, spend: 0 },
            '3': { prefix: 'VIP', area: 'Private Rooms', min: 1, max: 10, spend: 500 },
            '4': { prefix: 'VVIP', area: 'Private Rooms', min: 1, max: 20, spend: 1000 }
        };
        let isEditing = false;
        function applyTypeDefaults() {
            if (isEditing) return;

            const config = defaults[typeField.value];
            if (!config) return;

            // Find the highest existing table number for this type.
            const numbers = existingTables
                .map(name => {
                    if (!name || !name.startsWith(config.prefix)) {
                        return null;
                    }

                    const suffix = name.slice(config.prefix.length);

                    return /^\d+$/.test(suffix)
                        ? Number(suffix)
                        : null;
                })
                .filter(number => number !== null);

            const nextNumber = numbers.length
                ? Math.max(...numbers) + 1
                : 1;

            nameField.value = config.prefix + nextNumber;

            minField.value = config.min;
            maxField.value = config.max;
            spendField.value = config.spend;
            activeField.checked = true;

            const matchingArea = Array.from(areaField.options)
                .find(option =>
                    option.text.trim().toLowerCase() ===
                    config.area.toLowerCase()
                );

            areaField.value = matchingArea ? matchingArea.value : '';
        }

        tableModal.addEventListener('show.bs.modal', e => {
            isEditing = !!(e.relatedTarget && e.relatedTarget.dataset.id);

            tableModal.classList.toggle('yoru-edit-mode', isEditing);
            tableModal.querySelectorAll('.yoru-advanced-field')
                .forEach(field => {
                    field.classList.toggle('d-none', !isEditing);
                });

            // bindModal was registered first and has already populated inputs.
            if (!isEditing) {
                applyTypeDefaults();
            }
        });

        typeField.addEventListener('change', applyTypeDefaults);

        document.getElementById('deleteTableModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;

                document.getElementById('deleteTableId').value = data.id;

                document.getElementById('deleteTableName').textContent =
                    `${data.kind} ${data.number}`;
            });

        document.getElementById('deleteAreaModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;
                const hasTables = data.hasTables === 'true';

                document.getElementById('deleteAreaId').value = data.id;
                document.getElementById('deleteAreaName').textContent = data.name;

                document.getElementById('deleteAreaBlocked')
                    .classList.toggle('d-none', !hasTables);

                document.getElementById('deleteAreaWarning')
                    .classList.toggle('d-none', hasTables);

                document.getElementById('confirmDeleteArea').disabled = hasTables;
            });

        function setupPagination(container, rowSelector, filterFunction) {
            const rows = Array.from(container.querySelectorAll(rowSelector));
            const info = container.querySelector('.yoru-page-info');
            const prev = container.querySelector('.yoru-prev');
            const next = container.querySelector('.yoru-next');

            if (!info || !prev || !next) return null;

            let page = 1;
            const pageSize = 5;

            function update(reset = false) {
                if (reset) page = 1;

                const matching = rows.filter(filterFunction);
                const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));

                page = Math.min(page, totalPages);

                rows.forEach(row => {
                    row.style.display = 'none';
                });

                matching
                    .slice((page - 1) * pageSize, page * pageSize)
                    .forEach(row => {
                        row.style.display = '';
                    });

                info.textContent = matching.length
                    ? `Page ${page} of ${totalPages} · ${matching.length} results`
                    : 'No matching results';

                prev.disabled = page <= 1;
                next.disabled = page >= totalPages;
            }

            prev.addEventListener('click', () => {
                if (page > 1) {
                    page--;
                    update();
                }
            });

            next.addEventListener('click', () => {
                page++;
                update();
            });

            update();

            return () => update(true);
        }

        document.querySelectorAll('.yoru-type-detail').forEach(panel => {
            const search = panel.querySelector('.yoru-table-search');
            const status = panel.querySelector('.yoru-table-status-filter');
            const active = panel.querySelector('.yoru-table-active-filter');

            if (!search || !status || !active) return;

            const refresh = setupPagination(
                panel,
                '.yoru-table-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(search.value.trim().toLowerCase());

                    const matchesStatus =
                        !status.value || row.dataset.status === status.value;

                    const matchesActive =
                        !active.value || row.dataset.active === active.value;

                    return matchesName && matchesStatus && matchesActive;
                }
            );

            if (!refresh) return;

            search.addEventListener('input', () => refresh(true));
            status.addEventListener('change', () => refresh(true));
            active.addEventListener('change', () => refresh(true));
        });

        const areaSearch = document.getElementById('areaSearch');
        const areaFilter = document.getElementById('areaFilter');
        const areaPagination = document.getElementById('areaPagination');

        if (areaSearch && areaFilter && areaPagination) {
            const areaSection = areaPagination.closest('.card');

            const refreshAreas = setupPagination(
                areaSection,
                '.yoru-area-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(areaSearch.value.trim().toLowerCase());

                    const count = Number(row.dataset.count);

                    const matchesFilter =
                        !areaFilter.value ||
                        (areaFilter.value === 'with' && count > 0) ||
                        (areaFilter.value === 'empty' && count === 0);

                    return matchesName && matchesFilter;
                }
            );

            if (refreshAreas) {
                areaSearch.addEventListener('input', refreshAreas);
                areaFilter.addEventListener('change', refreshAreas);
            }
        }

    </script>
}
