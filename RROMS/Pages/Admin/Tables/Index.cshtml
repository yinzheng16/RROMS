    <script>
        window.yoruRememberView = function (overrides = {}) {
            const activeTab = document.querySelector(
                '[data-yoru-tab].active'
            );

            const openPanel = document.querySelector(
                '.yoru-inline-table-panel:not([hidden])'
            );

            const state = {
                tab: activeTab?.dataset.yoruTab || 'tables',
                panelId: openPanel?.id || null,
                scrollY: window.scrollY,
                savedAt: Date.now(),
                ...overrides
            };

            try {
                sessionStorage.setItem(
                    'yoruTablesView:' + location.pathname,
                    JSON.stringify(state)
                );
            } catch {
                // Saving still works when browser storage is unavailable.
            }
        };

        // Ordinary POST forms: delete, dining areas, hours and special dates.
        document.addEventListener('submit', event => {
            const form = event.target;

            if (!(form instanceof HTMLFormElement) ||
                event.defaultPrevented ||
                form.method.toLowerCase() !== 'post') {
                return;
            }

            const submitter = event.submitter;

            const actionUrl = submitter?.hasAttribute('formaction')
                ? submitter.formAction
                : form.action;

            const action = new URL(actionUrl, location.href);

            if (action.origin !== location.origin ||
                action.pathname !== location.pathname ||
                !action.searchParams.has('handler')) {
                return;
            }

            window.yoruRememberView();
        });

        document.addEventListener('DOMContentLoaded', () => {
            const state = window.yoruPendingView;

            if (!state) {
                return;
            }

            delete window.yoruPendingView;

            try {
                const panel = typeof state.panelId === 'string'
                    ? document.getElementById(state.panelId)
                    : null;

                if (panel?.hidden) {
                    const button = Array.from(
                        document.querySelectorAll(
                            '.yoru-type-manage-btn[data-manage-panel]'
                        )
                    ).find(button =>
                        button.dataset.managePanel === state.panelId
                    );

                    button?.click();
                }
            } catch (error) {
                console.error('Unable to restore table list.', error);
            }

            function finishRestore() {
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        try {
                            window.scrollTo({
                                top: Number.isFinite(state.scrollY)
                                    ? state.scrollY
                                    : 0,
                                behavior: 'instant'
                            });
                        } finally {
                            document.documentElement.classList.remove(
                                'yoru-restoring-view'
                            );
                        }
                    });
                });
            }

            if (document.readyState === 'complete') {
                finishRestore();
            } else {
                window.addEventListener('load', finishRestore, {
                    once: true
                });
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const list = document.querySelector('.yoru-special-list');

            if (!list) {
                return;
            }

            const items = Array.from(
                list.querySelectorAll('.yoru-special-item')
            );

            if (!items.length) {
                return;
            }

            const nav = document.getElementById('yoruSpecialMonthNav');
            const label = document.getElementById('yoruSpecialMonthLabel');
            const count = document.getElementById('yoruSpecialMonthCount');
            const prev = document.getElementById('yoruSpecialMonthPrev');
            const next = document.getElementById('yoruSpecialMonthNext');

            const ranges = items.map(item => {
                const data = item.querySelector('[data-special-edit]').dataset;

                return {
                    item,
                    startMonth: data.date.slice(0, 7),
                    endMonth: (data.endDate || data.date).slice(0, 7)
                };
            });

            const monthSet = new Set();

            ranges.forEach(range => {
                const [startYear, startMonth] =
                    range.startMonth.split('-').map(Number);

                const [endYear, endMonth] =
                    range.endMonth.split('-').map(Number);

                const first = startYear * 12 + startMonth - 1;
                const last = endYear * 12 + endMonth - 1;

                for (let value = first; value <= last; value++) {
                    const year = Math.floor(value / 12);
                    const month = value % 12 + 1;

                    monthSet.add(
                        String(year).padStart(4, '0') + '-' +
                        String(month).padStart(2, '0')
                    );
                }
            });

            const months = Array.from(monthSet).sort();

            const today = new Date();

            const currentMonth =
                today.getFullYear() + '-' +
                String(today.getMonth() + 1).padStart(2, '0');

            // Start with this month or the next month containing entries.
            let index = months.findIndex(month => month >= currentMonth);

            if (index === -1) {
                index = months.length - 1;
            }

            function render() {
                const month = months[index];
                const [year, monthNumber] = month.split('-').map(Number);

                label.textContent = new Date(
                    year, monthNumber - 1, 1
                ).toLocaleDateString('en-MY', {
                    month: 'long',
                    year: 'numeric'
                });

                let total = 0;

                ranges.forEach(({ item, startMonth, endMonth }) => {
                    const visible =
                        startMonth <= month &&
                        endMonth >= month;

                    item.hidden = !visible;

                    item.style.setProperty(
                        'display',
                        visible ? 'flex' : 'none',
                        'important'
                    );

                    if (visible) total++;
                });

                count.textContent =
                    total + ' special date' + (total === 1 ? '' : 's');

                prev.disabled = index === 0;
                next.disabled = index === months.length - 1;

                list.scrollTop = 0;
            }

            prev.addEventListener('click', () => {
                if (index > 0) {
                    index--;
                    render();
                }
            });

            next.addEventListener('click', () => {
                if (index < months.length - 1) {
                    index++;
                    render();
                }
            });

            nav.hidden = false;

            render();
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalElement = document.getElementById(
                'yoruSpecialDetailsModal'
            );

            const modal = bootstrap.Modal.getOrCreateInstance(
                modalElement
            );

            let selectedCard = null;

            document.querySelectorAll(
                '#yoruSpecialDatesCard .yoru-special-item'
            ).forEach(card => {
                const originalEdit = card.querySelector(
                    '[data-special-edit]'
                );

                if (!originalEdit) return;

                card.setAttribute('role', 'button');
                card.setAttribute('tabindex', '0');
                card.setAttribute('aria-haspopup', 'dialog');
                card.setAttribute(
                    'aria-label',
                    'View ' + originalEdit.dataset.name + ' details'
                );

                function openDetails() {
                    selectedCard = card;

                    const data = originalEdit.dataset;
                    function formatDate(value) {
                        const [year, month, day] = value.split('-').map(Number);

                        return new Date(
                            year, month - 1, day
                        ).toLocaleDateString('en-MY', {
                            day: 'numeric',
                            month: 'short',
                            year: 'numeric'
                        });
                    }

                    const t12 = v => {
                        const [h, m] = String(v).split(':').map(Number);
                        return ((h + 11) % 12 + 1) + ':' + String(m).padStart(2, '0') + ' ' + (h >= 12 ? 'PM' : 'AM');
                    };

                    const endDate = data.endDate || data.date;

                    document.getElementById(
                        'yoruSpecialDetailsDate'
                    ).textContent = endDate === data.date
                        ? formatDate(data.date)
                        : formatDate(data.date) + ' – ' + formatDate(endDate);

                    document.getElementById(
                        'yoruSpecialDetailsTitle'
                    ).textContent = data.name;

                    document.getElementById(
                        'yoruSpecialDetailsStatus'
                    ).textContent = data.closed === 'true'
                        ? 'Closed for the whole day'
                        : 'Open ' + t12(data.open) + ' – ' +
                          t12(data.close) +
                          (data.close <= data.open ? ' (next day)' : '');

                    document.getElementById(
                        'yoruSpecialDetailsStatus'
                    ).classList.toggle('is-closed', data.closed === 'true');

                    modal.show();
                }

                card.addEventListener('click', event => {
                    // Ignore the original buttons when called by the modal.
                    if (event.target.closest('.yoru-special-actions')) {
                        return;
                    }

                    openDetails();
                });

                card.addEventListener('keydown', event => {
                    if (event.target !== card) return;

                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        openDetails();
                    }
                });
            });

            document.getElementById(
                'yoruSpecialDetailsEdit'
            ).addEventListener('click', () => {
                const originalEdit = selectedCard?.querySelector(
                    '[data-special-edit]'
                );

                if (!originalEdit) return;

                modalElement.addEventListener('hidden.bs.modal', () => {
                    originalEdit.click();
                }, { once: true });

                modal.hide();
            });

            document.getElementById(
                'yoruSpecialDetailsDelete'
            ).addEventListener('click', () => {
                const form = selectedCard?.querySelector(
                    '.yoru-special-actions form'
                );

                form?.requestSubmit();
            });

            modalElement.addEventListener('hidden.bs.modal', () => {
                selectedCard?.focus({ preventScroll: true });
            });

            // Replace text arrows with centered SVG icons.
            const prev = document.getElementById('yoruSpecialMonthPrev');
            const next = document.getElementById('yoruSpecialMonthNext');

            if (prev) {
                prev.innerHTML =
                    '<svg viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path d="m14 6-6 6 6 6"/></svg>';
            }

            if (next) {
                next.innerHTML =
                    '<svg viewBox="0 0 24 24" aria-hidden="true">' +
                    '<path d="m10 6 6 6-6 6"/></svg>';
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalElement = document.getElementById(
                'yoruTypeDetailsModal'
            );

            const modal = bootstrap.Modal.getOrCreateInstance(
                modalElement
            );

            const fields = document.getElementById(
                'yoruTypeDetailsFields'
            );

            // Click the photo in View details to enlarge it.
            document.getElementById('yoruTypeDetailsPhotoBtn')
                .addEventListener('click', () => {
                    const source = document.getElementById('yoruTypeDetailsPhoto');
                    const dialog = document.getElementById('yoruPhotoDialog');
                    const large = document.getElementById('yoruPhotoLarge');

                    if (!source.getAttribute('src')) return;

                    large.src = source.src;
                    dialog.showModal();
                });

            document.querySelectorAll('[data-type-details]')
                .forEach(button => {
                    button.addEventListener('click', () => {
                        const card = button.closest('.yoru-type-card');
                        const editButton = card.querySelector('.yoru-edit-type');

                        if (!editButton) return;

                        const data = editButton.dataset;

                        document.getElementById(
                            'yoruTypeDetailsTitle'
                        ).textContent = data.name;

                        const photo = document.getElementById(
                            'yoruTypeDetailsPhoto'
                        );

                        const photoWrap = document.getElementById(
                            'yoruTypeDetailsPhotoWrap'
                        );
                        const noPhoto = document.getElementById(
                            'yoruTypeDetailsNoPhoto'
                        );

                        if (data.photo) {
                            photo.src = data.photo;
                            photo.alt = data.name;
                            photo.hidden = false;
                            noPhoto.hidden = true;
                            photoWrap.classList.add('has-photo');
                        } else {
                            photo.removeAttribute('src');
                            photo.hidden = true;
                            noPhoto.hidden = false;
                            photoWrap.classList.remove('has-photo');
                        }

                        document.getElementById(
                            'yoruTypeDetailsCode'
                        ).textContent = data.prefix || '';

                        const amount = Number(data.spend || 0);

                        const spend = amount > 0
                            ? 'RM ' + amount.toLocaleString('en-MY', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            })
                            : 'None';

                        const guests = data.min === data.max
                            ? data.min + (data.min === '1' ? ' guest' : ' guests')
                            : data.min + '–' + data.max + ' guests';

                        const stats = [
                            ['armchair', button.dataset.count, button.dataset.count === '1' ? 'Table' : 'Tables'],
                            ['users', guests, 'Guests / table'],
                            ['wallet', spend, 'Min. spend'],
                            ['hash', (data.prefix || '-') + '-' + '0'.repeat(Math.max(0, Number(data.padding) - 1)) + '1', 'Number format']
                        ];

                        fields.replaceChildren();

                        stats.forEach(([icon, value, label]) => {
                            const tile = document.createElement('div');
                            tile.className = 'yoru-details-stat';

                            const i = document.createElement('i');
                            i.setAttribute('data-lucide', icon);

                            const strong = document.createElement('strong');
                            strong.textContent = value;

                            const small = document.createElement('small');
                            small.textContent = label;

                            tile.append(i, strong, small);
                            fields.appendChild(tile);
                        });

                        const badge = document.getElementById('yoruTypeDetailsBadge');
                        const isActive = data.active === 'true';
                        badge.textContent = isActive ? 'Active' : 'Inactive';
                        badge.classList.toggle('is-inactive', !isActive);

                        document.getElementById('yoruTypeDetailsHeroName').textContent = data.name;

                        const jpName = document.getElementById('yoruTypeDetailsJp');
                        jpName.textContent = (data.jp || '').trim();
                        jpName.hidden = !jpName.textContent;
                        document.getElementById('yoruTypeDetailsArea').textContent = button.dataset.areaName;

                        window.lucide?.createIcons();

                        document.getElementById(
                            'yoruTypeDetailsDescription'
                        ).textContent = data.desc?.trim() || 'No description.';

                        document.getElementById('yoruTypeDetailsIntro').textContent =
                            data.desc?.trim() || 'No description.';

                        modal.show();
                    });
                });
        });
    </script>
    <script>
        // Ask "Keep editing / Discard changes" before closing a form that has unsaved input.
        (() => {
            const dialog = document.getElementById('yoruDiscardDialog');
            const keepBtn = document.getElementById('yoruDiscardKeep');
            const discardBtn = document.getElementById('yoruDiscardConfirm');
            if (!dialog) return;

            const serialize = form => {
                if (!form) return '';
                const parts = [];
                new FormData(form).forEach((value, key) => {
                    if (key === '__RequestVerificationToken') return;
                    parts.push(key + '=' + (value instanceof File ? value.name + ':' + value.size : value));
                });
                return parts.join('&');
            };

            const guards = [
                {
                    name: 'type',
                    form: () => document.getElementById('tableTypeForm'),
                    open: () => document.getElementById('yoruTypeWorkspace')?.classList.contains('drawer-open'),
                    closers: '#yoruTypeDrawerClose, #yoruTypeDrawerCancel'
                },
                {
                    name: 'table',
                    form: () => document.getElementById('tableForm'),
                    open: () => document.getElementById('yoruTypeWorkspace')?.classList.contains('table-drawer-open'),
                    closers: '[data-close-table-drawer]'
                },
                {
                    name: 'area',
                    form: () => document.querySelector('#areaModal form'),
                    open: () => document.getElementById('yoruAreaWorkspace')?.classList.contains('drawer-open') &&
                        !document.getElementById('yoruAreaDrawerOverlay')?.hidden,
                    closers: '[data-area-drawer-close]'
                }
            ];

            let bypass = false;
            let pending = null;

            guards.forEach(g => { g.snapshot = null; g.timer = 0; g.wasOpen = false; });

            // Take the "clean" snapshot shortly after a drawer finishes opening.
            function watch() {
                guards.forEach(g => {
                    const isOpen = Boolean(g.open());
                    if (isOpen && !g.wasOpen) {
                        clearTimeout(g.timer);
                        g.timer = setTimeout(() => { g.snapshot = serialize(g.form()); }, 900);
                    }
                    if (!isOpen && g.wasOpen) {
                        clearTimeout(g.timer);
                        g.snapshot = null;
                    }
                    g.wasOpen = isOpen;
                });
            }

            const observer = new MutationObserver(watch);
            ['yoruTypeWorkspace', 'yoruAreaWorkspace'].forEach(id => {
                const el = document.getElementById(id);
                if (el) observer.observe(el, { attributes: true, attributeFilter: ['class'] });
            });
            const overlay = document.getElementById('yoruAreaDrawerOverlay');
            if (overlay) observer.observe(overlay, { attributes: true, attributeFilter: ['hidden'] });

            const isDirty = g => g.open() && g.snapshot !== null && serialize(g.form()) !== g.snapshot;

            function ask(proceed) {
                pending = proceed;
                if (!dialog.open) dialog.showModal();
            }

            keepBtn.addEventListener('click', () => { pending = null; dialog.close(); });
            discardBtn.addEventListener('click', () => {
                const run = pending;
                pending = null;
                dialog.close();
                if (run) { bypass = true; try { run(); } finally { bypass = false; } }
            });
            dialog.addEventListener('cancel', () => { pending = null; });

            document.addEventListener('click', e => {
                if (bypass) return;
                for (const g of guards) {
                    const closer = e.target.closest(g.closers);
                    if (closer && isDirty(g)) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        ask(() => closer.click());
                        return;
                    }
                }
            }, true);

            document.addEventListener('keydown', e => {
                if (bypass || e.key !== 'Escape' || dialog.open) return;
                for (const g of guards) {
                    if (isDirty(g)) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        const closer = document.querySelector(
                            g.closers.split(',')[0].trim());
                        ask(() => closer?.click());
                        return;
                    }
                }
            }, true);

            // Special date modal (Bootstrap)
            const specialModal = document.getElementById('yoruSpecialModal');
            if (specialModal) {
                const specialForm = specialModal.querySelector('form');
                let specialSnapshot = null;

                specialModal.addEventListener('shown.bs.modal', () => {
                    specialSnapshot = serialize(specialForm);
                });
                specialModal.addEventListener('hidden.bs.modal', () => { specialSnapshot = null; });
                specialModal.addEventListener('hide.bs.modal', e => {
                    if (bypass || specialSnapshot === null) return;
                    if (serialize(specialForm) === specialSnapshot) return;
                    e.preventDefault();
                    ask(() => bootstrap.Modal.getInstance(specialModal)?.hide());
                });
            }

            window.yoruAskDiscard = ask;
            window.yoruSerializeForm = serialize;
        })();
    </script>
    <script>
        // ===== Weekly schedule editor =====
        (() => {
            const overlay = document.getElementById('yoruSchedOverlay');
            const host = document.getElementById('yoruSchedBody');
            const errorBox = document.getElementById('yoruSchedError');
            if (!overlay || !host) return;

            const rows = () => Array.from(document.querySelectorAll('#hoursForm .yoru-hours-row'));
            const field = (row, name) => row.querySelector(`[name$=".${name}"]`);
            const hhmm = v => (v || '').slice(0, 5);
            const dayNames = () => rows().map(r => r.querySelector('.yoru-hours-day').firstChild.textContent.trim());
            const text = v => (window.yoruTimeText ? yoruTimeText(v) : v);
            const toMin = v => { const p = (v || '').split(':'); return Number(p[0]) * 60 + Number(p[1]); };

            let st = null;
            let initial = '';

            function readState() {
                const list = rows().map(r => ({
                    closed: field(r, 'IsClosed').checked,
                    open: hhmm(field(r, 'OpenTime').value) || '10:00',
                    close: hhmm(field(r, 'CloseTime').value) || '22:00'
                }));
                const openDays = list.filter(d => !d.closed);
                const same = openDays.every(d => d.open === openDays[0].open && d.close === openDays[0].close);
                const breakRow = rows().find(r => !field(r, 'IsClosed').checked && field(r, 'BreakStart')?.value && field(r, 'BreakEnd')?.value);

                return {
                    breakOn: Boolean(breakRow),
                    bStart: breakRow ? hhmm(field(breakRow, 'BreakStart').value) : '15:00',
                    bEnd: breakRow ? hhmm(field(breakRow, 'BreakEnd').value) : '17:00',
                    same,
                    open: openDays[0]?.open || '10:00',
                    close: openDays[0]?.close || '22:00',
                    days: list
                };
            }

            const seg = (name, on) => `<div class="yoru-seg" role="group">
                <button type="button" data-seg="${name}" data-val="1" class="${on ? 'on' : ''}">Yes</button>
                <button type="button" data-seg="${name}" data-val="0" class="${on ? '' : 'on'}">No</button></div>`;
            const tb = (key, label) => `<button type="button" class="yoru-time-btn" data-tb="${key}" data-title="${label}">${text(st[key])}</button>`;
            const tbd = (i, key, label) => `<button type="button" class="yoru-time-btn" data-tbd="${i}:${key}" data-title="${label}">${text(st.days[i][key])}</button>`;

            function render() {
                const names = dayNames();
                const kanji = n => ({ Monday: '月', Tuesday: '火', Wednesday: '水', Thursday: '木', Friday: '金', Saturday: '土', Sunday: '日' }[n] || '');
                const sameCard = `<div class="yoru-sched-card">
                    <div class="yoru-sched-times"><div><small>Opens</small><br>${tb('open', 'Opening time')}</div><span>→</span><div><small>Closes</small><br>${tb('close', 'Closing time')}</div></div></div>`;
                const daysSection = `<section class="yoru-sched-q">
                        <h4>Operating days</h4>
                        <p>Tap a day to mark it closed. Select the days the restaurant is open.</p>
                        <div class="yoru-chips">${names.map((n, i) => `<button type="button" class="yoru-chip ${st.days[i].closed ? 'off' : ''}" data-chip="${i}">${n.slice(0, 3)}</button>`).join('')}</div>
                    </section>`;

                const cards = `<div class="yoru-day-grid">${names.map((n, i) => `<div class="yoru-day-card ${st.days[i].closed ? 'is-closed' : ''}" >
                    <div class="yoru-day-head"><strong data-kanji="${kanji(n)}">${n}</strong>
                        <label class="yoru-mini-switch"><input type="checkbox" data-day-open="${i}" ${st.days[i].closed ? '' : 'checked'} /><span>${st.days[i].closed ? 'Closed' : 'Open'}</span></label></div>
                    <div class="yoru-day-times">${tbd(i, 'open', n + ' opens')}<span>→</span>${tbd(i, 'close', n + ' closes')}</div></div>`).join('')}</div>`;

                host.innerHTML = `
                    <section class="yoru-sched-q">
                        <h4>Do you take a break during service?</h4>
                        <p>One break a day, the same on every open day.</p>
                        ${seg('break', st.breakOn)}
                        ${st.breakOn ? `<div class="yoru-sched-break"><span>Break from</span>${tb('bStart', 'Break starts')}<span>to</span>${tb('bEnd', 'Break ends')}</div>` : ''}
                    </section>
                    <section class="yoru-sched-q">
                        <h4>Use the same hours every day?</h4>
                        <p>Choose one opening and closing time for the whole week, or set each day yourself.</p>
                        ${seg('same', st.same)}
                        ${st.same ? sameCard : cards}
                    </section>
                    ${st.same ? daysSection : ''}`;
            }

            function openWheel(key, dayIndex, button) {
                const proxy = document.createElement('input');
                proxy.type = 'time';
                proxy.dataset.wheelTitle = button.dataset.title;
                proxy.value = dayIndex === null ? st[key] : st.days[dayIndex][key];
                proxy.addEventListener('change', () => {
                    if (dayIndex === null) st[key] = proxy.value; else st.days[dayIndex][key] = proxy.value;
                    render();
                });
                yoruOpenWheel(proxy, button);
            }

            host.addEventListener('click', e => {
                const segBtn = e.target.closest('[data-seg]');
                if (segBtn) {
                    const on = segBtn.dataset.val === '1';
                    if (segBtn.dataset.seg === 'break') st.breakOn = on;
                    else if (on !== st.same) {
                        if (on) {
                            const first = st.days.find(d => !d.closed);
                            if (first) { st.open = first.open; st.close = first.close; }
                        } else {
                            st.days.forEach(d => { d.open = st.open; d.close = st.close; });
                        }
                        st.same = on;
                    }
                    render();
                    return;
                }
                const t = e.target.closest('[data-tb]');
                if (t) return openWheel(t.dataset.tb, null, t);
                const td = e.target.closest('[data-tbd]');
                if (td) { const [i, key] = td.dataset.tbd.split(':'); return openWheel(key, Number(i), td); }
                const chip = e.target.closest('[data-chip]');
                if (chip) { const d = st.days[Number(chip.dataset.chip)]; d.closed = !d.closed; render(); }
            });
            host.addEventListener('change', e => {
                const sw = e.target.closest('[data-day-open]');
                if (sw) { st.days[Number(sw.dataset.dayOpen)].closed = !sw.checked; render(); }
            });

            function validate() {
                const names = dayNames();
                const eff = st.days.map(d => st.same ? { closed: d.closed, open: st.open, close: st.close } : d);
                if (eff.every(d => d.closed)) return 'At least one day must be open.';
                for (let i = 0; i < eff.length; i++) {
                    const d = eff[i];
                    if (d.closed) continue;
                    if (d.open === d.close) return `${names[i]}: opening and closing times cannot be the same.`;
                    if (st.breakOn) {
                        const since = t => { const m = toMin(t) - toMin(d.open); return m < 0 ? m + 1440 : m; };
                        const len = since(d.close), a = since(st.bStart), b = since(st.bEnd);
                        if (a >= b) return 'The break must end after it starts.';
                        if (a <= 0 || b >= len) return `${names[i]}: the break must be inside the opening hours (${text(d.open)} – ${text(d.close)}).`;
                    }
                }
                return '';
            }

            function save() {
                const message = validate();
                errorBox.hidden = !message;
                errorBox.textContent = message;
                if (message) return;

                rows().forEach((row, i) => {
                    const d = st.same ? { closed: st.days[i].closed, open: st.open, close: st.close } : st.days[i];
                    field(row, 'IsClosed').checked = d.closed;
                    field(row, 'OpenTime').value = d.open;
                    field(row, 'CloseTime').value = d.close;
                    field(row, 'BreakStart').value = st.breakOn && !d.closed ? st.bStart : '';
                    field(row, 'BreakEnd').value = st.breakOn && !d.closed ? st.bEnd : '';
                });
                document.getElementById('hoursForm').requestSubmit();
            }

            function close() {
                if (overlay.hidden || overlay.classList.contains('is-closing')) return;
                overlay.classList.add('is-closing');
                document.body.style.overflow = '';
                setTimeout(() => { overlay.hidden = true; overlay.classList.remove('is-closing'); }, 240);
            }
            const isDirty = () => JSON.stringify(st) !== initial;
            const tryClose = () => { if (isDirty()) window.yoruAskDiscard(close); else close(); };

            window.yoruOpenScheduleEditor = () => {
                st = readState();
                initial = JSON.stringify(st);
                errorBox.hidden = true;
                render();
                overlay.hidden = false;
                document.body.style.overflow = 'hidden';
                window.lucide?.createIcons();
            };

            document.getElementById('yoruSchedSave').addEventListener('click', save);
            document.getElementById('yoruSchedCancel').addEventListener('click', tryClose);
            document.getElementById('yoruSchedClose').addEventListener('click', tryClose);
            overlay.addEventListener('mousedown', e => { if (e.target === overlay) tryClose(); });
            document.addEventListener('keydown', e => {
                if (e.key !== 'Escape' || overlay.hidden) return;
                if (document.getElementById('yoruWheelOverlay').classList.contains('show')) return;
                if (document.getElementById('yoruDiscardDialog').open) return;
                e.preventDefault();
                tryClose();
            });
        })();

        // ===== Special dates, enlarged =====
        (() => {
            const overlay = document.getElementById('yoruCalOverlay');
            if (!overlay) return;

            const grid = document.getElementById('yoruCalGrid');
            const list = document.getElementById('yoruCalList');
            const label = document.getElementById('yoruCalMonth');
            const sideTitle = document.getElementById('yoruCalSideTitle');
            const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

            const parse = v => { const [y, m, d] = v.split('-').map(Number); return new Date(y, m - 1, d); };
            const key = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            const clock = v => { if (!v) return ''; const [h, m] = v.split(':').map(Number); return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h >= 12 ? 'PM' : 'AM'}`; };
            const pretty = d => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

            const entries = () => Array.from(document.querySelectorAll('[data-special-edit]')).map(b => ({
                button: b,
                id: b.dataset.id,
                start: parse(b.dataset.date),
                end: parse(b.dataset.endDate || b.dataset.date),
                name: b.dataset.name,
                closed: b.dataset.closed === 'true',
                open: b.dataset.open,
                close: b.dataset.close
            }));

            let view = new Date();
            view = new Date(view.getFullYear(), view.getMonth(), 1);
            let focusId = null;

            const covers = (e, day) => e.start <= day && e.end >= day;
            const statusText = e => e.closed ? 'Closed all day' : `${clock(e.open)} – ${clock(e.close)}`;

            function render() {
                const all = entries();
                label.textContent = `${monthNames[view.getMonth()]} ${view.getFullYear()}`;

                const first = new Date(view.getFullYear(), view.getMonth(), 1);
                const offset = (first.getDay() + 6) % 7;
                const todayKey = key(new Date());
                grid.replaceChildren();

                for (let i = 0; i < 42; i++) {
                    const day = new Date(first.getFullYear(), first.getMonth(), 1 - offset + i);
                    const cell = document.createElement('div');
                    cell.className = 'yoru-cal-cell' + (day.getMonth() !== view.getMonth() ? ' is-other' : '') + (key(day) === todayKey ? ' is-today' : '');
                    const num = document.createElement('b');
                    num.textContent = day.getDate();
                    cell.appendChild(num);

                    const here = all.filter(e => covers(e, day));
                    here.slice(0, 2).forEach(e => {
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'yoru-cal-chip ' + (e.closed ? 'closed' : 'special');
                        chip.textContent = e.name;
                        chip.title = `${e.name} · ${statusText(e)}`;
                        chip.addEventListener('click', () => { focusId = e.id; renderList(all); });
                        cell.appendChild(chip);
                    });
                    if (here.length > 2) {
                        const more = document.createElement('button');
                        more.type = 'button';
                        more.className = 'yoru-cal-more';
                        more.textContent = `+${here.length - 2} more`;
                        more.addEventListener('click', () => { focusId = here[2].id; renderList(all); });
                        cell.appendChild(more);
                    }
                    grid.appendChild(cell);
                }
                renderList(all);
            }

            function renderList(all) {
                const monthStart = new Date(view.getFullYear(), view.getMonth(), 1);
                const monthEnd = new Date(view.getFullYear(), view.getMonth() + 1, 0);
                const inMonth = all.filter(e => e.start <= monthEnd && e.end >= monthStart)
                    .sort((a, b) => a.start - b.start);

                sideTitle.textContent = `${monthNames[view.getMonth()]} · ${inMonth.length} ${inMonth.length === 1 ? 'entry' : 'entries'}`;
                list.replaceChildren();

                if (!inMonth.length) {
                    const empty = document.createElement('p');
                    empty.className = 'text-muted small';
                    empty.textContent = 'No special dates this month.';
                    list.appendChild(empty);
                    return;
                }

                inMonth.forEach(e => {
                    const item = document.createElement('div');
                    item.className = 'yoru-cal-item' + (e.id === focusId ? ' is-focus' : '');
                    const range = e.start.getTime() === e.end.getTime() ? pretty(e.start) : `${pretty(e.start)} – ${pretty(e.end)}`;
                    item.innerHTML = '<strong></strong><small></small><small></small>';
                    item.children[0].textContent = e.name;
                    item.children[1].textContent = range;
                    item.children[2].textContent = statusText(e);

                    const actions = document.createElement('div');
                    actions.className = 'yoru-cal-item-actions';
                    const edit = document.createElement('button');
                    edit.type = 'button'; edit.textContent = 'Edit';
                    edit.addEventListener('click', () => { close(); e.button.click(); });
                    const del = document.createElement('button');
                    del.type = 'button'; del.textContent = 'Delete'; del.className = 'danger';
                    del.addEventListener('click', () => {
                        const submit = e.button.closest('.yoru-special-actions')?.querySelector('form button[type="submit"]');
                        if (submit) { close(); submit.click(); }
                    });
                    actions.append(edit, del);
                    item.appendChild(actions);
                    list.appendChild(item);
                });
            }

            function open() {
                const all = entries();
                const today = new Date(); today.setHours(0, 0, 0, 0);
                const next = all.filter(e => e.end >= today).sort((a, b) => a.start - b.start)[0];
                const base = next ? (next.start > today ? next.start : today) : today;
                view = new Date(base.getFullYear(), base.getMonth(), 1);
                focusId = null;
                render();
                overlay.hidden = false;
                document.body.style.overflow = 'hidden';
                window.lucide?.createIcons();
            }
            function close() {
                if (overlay.hidden || overlay.classList.contains('is-closing')) return;
                overlay.classList.add('is-closing');
                document.body.style.overflow = '';
                setTimeout(() => { overlay.hidden = true; overlay.classList.remove('is-closing'); }, 240);
            }

            document.getElementById('yoruSpecialExpand')?.addEventListener('click', open);
            document.getElementById('yoruCalClose').addEventListener('click', close);
            document.getElementById('yoruCalAdd').addEventListener('click', () => { close(); document.getElementById('yoruSpecialAdd')?.click(); });
            document.getElementById('yoruCalPrev').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); focusId = null; render(); });
            document.getElementById('yoruCalNext').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); focusId = null; render(); });
            document.getElementById('yoruCalToday').addEventListener('click', () => { const n = new Date(); view = new Date(n.getFullYear(), n.getMonth(), 1); focusId = null; render(); });
            overlay.addEventListener('mousedown', e => { if (e.target === overlay) close(); });
            document.addEventListener('keydown', e => { if (e.key === 'Escape' && !overlay.hidden) close(); });
        })();
    </script>
}