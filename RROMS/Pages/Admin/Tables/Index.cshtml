@page
@model RROMS.Pages.Admin.Tables.IndexModel
@using RROMS.Models
@{
    ViewData["Title"] = "Tables and opening hours";
}

<!-- Tables & Opening Hours Hero Header -->
<div class="yoru-tables-hero yoru-tables-page mb-4">

    <div class="yoru-tables-hero-content">

        <div class="yoru-tables-brand">
            <strong>YORU IZAKAYA</strong>
            <span class="yoru-brand-divider"></span>
            <span>TABLE MANAGEMENT</span>
        </div>

        <div class="yoru-tables-eyebrow">
            THE ART OF A PERFECT DINING SPACE
        </div>

        <h1 class="yoru-tables-hero-title">
            Tables &amp; Opening hours.
        </h1>

        <p class="yoru-tables-hero-description">
            Every table, every space. Curate the YORU dining experience.
        </p>

    </div>

    <div class="yoru-tables-hero-japanese">
        <span class="yoru-japanese-small">Y O R U</span>
        <span class="yoru-japanese-character">夜</span>
        <span class="yoru-japanese-line"></span>
        <span class="yoru-japanese-caption">CRAFTED FOR THE NIGHT</span>
    </div>

    <div class="yoru-hero-navigation">
        <div class="yoru-hero-nav-buttons">

            <a href="#tables-section" class="yoru-hero-nav-link active">
                Tables
            </a>

            <a href="#dining-areas-section" class="yoru-hero-nav-link">
                Dining Areas
            </a>

            <a href="#opening-hours-section" class="yoru-hero-nav-link">
                Opening Hours
            </a>

        </div>
    </div>
</div>

<div class="yoru-summary mb-4">

    <div class="yoru-summary-item yoru-summary-dark">
        <div class="yoru-summary-label">
            <i data-lucide="armchair"></i> THE COLLECTION
        </div>

        <div class="yoru-summary-number">
            @Model.AllTables.Count
        </div>

        <div class="yoru-summary-title">Total tables</div>
        <div class="yoru-summary-desc">
            Seating across the restaurant.
        </div>

        <div class="yoru-summary-decoration"><i data-lucide="armchair"></i></div>
    </div>

    <div class="yoru-summary-item yoru-summary-red">
        <div class="yoru-summary-label">
            <i data-lucide="layers-3"></i> TABLE COLLECTION
        </div>

        <div class="yoru-summary-number">
            @Model.TableTypes.Count
        </div>

        <div class="yoru-summary-title">Table types</div>
        <div class="yoru-summary-desc">
            Seating styles available.
        </div>

        <div class="yoru-summary-decoration"><i data-lucide="layers-3"></i></div>
    </div>

    <div class="yoru-summary-item yoru-summary-light">
        <div class="yoru-summary-label">
            <i data-lucide="door-open"></i> ROOM TO GATHER
        </div>

        <div class="yoru-summary-number">
            @Model.Areas.Count
        </div>

        <div class="yoru-summary-title">Dining areas</div>
        <div class="yoru-summary-desc">
            Spaces for every occasion.
        </div>

        <div class="yoru-summary-decoration"><i data-lucide="door-open"></i></div>
    </div>

</div>


@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@{
    var typeNames = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "Counter seat",
        [TableType.Double] = "Table for two",
        [TableType.Standard] = "Standard table",
        [TableType.Vip] = "VIP room",
        [TableType.Vvip] = "VVIP room"
    };
    var sampleImages = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "/images/tables/counter.jpg",
        [TableType.Double] = "/images/tables/double.jpg",
        [TableType.Standard] = "/images/tables/standard.jpg",
        [TableType.Vip] = "/images/tables/vip.jpg",
        [TableType.Vvip] = "/images/tables/vvip.jpg"
    };
}
<style>
    .yoru-tables-hero {position: relative; min-height: 310px; border-radius: 18px; overflow: hidden; padding: 52px 42px; display: flex; align-items: center; background:linear-gradient(90deg, rgba(10, 10, 10, 0.96) 0%, rgba(10, 10, 10, 0.86) 42%, rgba(10, 10, 10, 0.20) 100% ), url('/images/tables-hero.jpg') center / cover no-repeat; color: #fff; }
    .yoru-tables-hero-content { position: relative; z-index: 2; max-width: 720px; }
    .yoru-tables-brand {display: flex; align-items: center; gap: 14px; font-size: 11px; color: #b9b9b9; margin-bottom: 30px;}
    .yoru-tables-brand strong {color: #fff; font-weight: 700;}
    .yoru-brand-divider {width: 1px; height: 15px; background: #c43b2b;}
    .yoru-tables-eyebrow {font-size: 11px; font-weight: 700; letter-spacing: 3px; color: #c6c6c6; margin-bottom: 12px;}
    .yoru-tables-hero-title {font-family: Georgia, serif; font-size: clamp(32px, 3.4vw, 52px); font-weight: 500; line-height: 1.15; color: #fff; margin-bottom: 14px;}
    .yoru-tables-hero-description {font-size: 14px; color: #c5c5c5; line-height: 1.7; margin: 0;}
    .yoru-tables-hero-japanese {position: absolute; right: 55px; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; z-index: 2;}
    .yoru-japanese-small {font-size: 10px; letter-spacing: 5px; color: #ddd;}
    .yoru-japanese-character {font-family: Georgia, serif; font-size: 80px; line-height: 1.2; color: #fff;}
    .yoru-japanese-line {width: 35px; height: 3px; background: #c43b2b; margin: 8px 0 20px;}
    .yoru-japanese-caption {font-size: 10px; color: #ddd; white-space: nowrap;}
    @@media (max-width: 768px) {.yoru-tables-hero {padding: 35px 24px; min-height: 270px;} .yoru-tables-hero-japanese {display: none;} .yoru-tables-hero-title {font-size: 32px;}}
    body.back-office:has(.yoru-tables-page) .site-main > .container-wide {
        padding-top: 16px !important;
    }
    .yoru-workspace {display:grid; gap:24px; }
    .yoru-workspace-heading {display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .yoru-summary {display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .yoru-summary-item {position: relative; overflow: hidden; min-height: 165px;  border-radius: 16px; padding: 22px; display: flex; flex-direction: column; justify-content: center; cursor: default; transition:transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; animation: yoruCardAppear 0.55s ease both;}
    .yoru-summary-item strong {display: block; font-size: 1.6rem; color: #342820; }
    .yoru-summary-item span {color: #796e62; font-size: .85rem; }
    .yoru-summary-item:hover {transform: translateY(-8px); box-shadow: 0 16px 30px rgba(0, 0, 0, 0.16);}
    .yoru-summary-dark {background: #1c1c1c; color: #ffffff; border: 1px solid #333333;}
    .yoru-summary-red {background: #c43b2b; color: #ffffff; border: 1px solid #bd3425; }
    .yoru-summary-light {background: #faf8f3;color: #241e19;border: 1px solid #e6ddd0; }
    .yoru-summary-label {font-size: 11px; font-weight: 600; letter-spacing: 0.7px; text-transform: uppercase; opacity: 0.8; z-index: 1; display: flex; align-items: center; gap: 8px;}
    .yoru-summary-label svg {display: inline-block; width: 20px; height: 20px; flex-shrink: 0; stroke-width: 1.2;}
    .yoru-summary-label span {margin-right: 6px; }
    .yoru-summary-number {font-family: Georgia, serif; font-size: 46px; line-height: 1.1; margin-top: 14px; z-index: 1; }
    .yoru-summary-title {font-size: 15px; font-weight: 600; margin-top: 2px; z-index: 1; }
    .yoru-summary-desc {font-size: 12px; opacity: 0.7; margin-top: 4px; z-index: 1;}
    .yoru-summary-decoration {position: absolute; right: 22px; top: 50%; transform: translateY(-50%); opacity: 0.10; pointer-events: none; transition: transform 0.3s ease, opacity 0.3s ease;}
    .yoru-summary-decoration svg {width: 90px; height: 90px; stroke-width: 1.2;}
    .yoru-summary-item:hover .yoru-summary-decoration {transform: translateY(-50%) scale(1.15) rotate(-8deg); opacity: 0.05;}
    @@keyframes yoruCardAppear {from { opacity: 0; transform: translateY(18px);} to {opacity: 1; transform: translateY(0);} }
    .yoru-summary-item:nth-child(1) {animation-delay: 0.05s;}
    .yoru-summary-item:nth-child(2) {animation-delay: 0.15s;}
    .yoru-summary-item:nth-child(3) {animation-delay: 0.25s;}
    @@media (max-width: 720px) {.yoru-summary {grid-template-columns: 1fr;} .yoru-summary-item {min-height: 145px;} }
    @@media (prefers-reduced-motion: reduce) {.yoru-summary-item { animation: none; transition: none; } .yoru-summary-item:hover {transform: none;} .yoru-summary-decoration {transition: none;} } 
    .yoru-type-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:14px; }
    .yoru-type-card { border:1px solid #e5d9c9; border-radius:12px; overflow:hidden; background:#fffdfa; display:flex; flex-direction:column; height:100%; transition:transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
    .yoru-type-card:hover {transform: translateY(-3px); border-color: #a83228; box-shadow: 0 10px 24px rgba(0, 0, 0, .12); }
    .yoru-type-card.yoru-selected {border-color: #a83228; box-shadow: 0 0 0 1px #a83228; }
    .yoru-type-card:focus-visible {outline: 3px solid #a83228; outline-offset: 3px; }
    .yoru-type-image-wrap { overflow: hidden; }
    .yoru-type-image { display: block; width:100%; height:145px; object-fit:cover; background:#eee8df; transition: transform 180ms ease; }
    .yoru-type-card:hover .yoru-type-image {transform: scale(1.03); }
    .yoru-type-body { padding:14px; display:flex; flex-direction:column; flex:1; }
    .yoru-type-title { font-weight:700; margin:0; }
    .yoru-type-meta { color:#796e62; font-size:.86rem; margin:7px 0 8px; }
    .yoru-type-spend { color:#8e2b24; font-size:.82rem; font-weight:600; margin:0 0 12px; }
    .yoru-type-actions { display:flex; flex-wrap:wrap; gap:7px; margin-top:auto; align-items:center; }
    .yoru-status-select { min-width:145px; }
    .yoru-search-toolbar {display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
    .yoru-search-toolbar .form-control { flex: 1; min-width: 160px; }
    .yoru-search-toolbar .form-select { width: auto; min-width: 150px; }
    .yoru-pagination { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 12px;}
    .yoru-type-detail .modal-body {flex:1 1 auto; min-height:0; display: flex; flex-direction: column; overflow:hidden; }
    .yoru-type-detail .table-responsive {flex: 1 1 0; min-height: 0; overflow:auto;}
    .yoru-type-detail .yoru-pagination {flex-shrink: 0; margin-top: 12px; }
    .yoru-type-detail .modal-dialog { height:580px !important; min-height: 0 !important; max-height: calc(100dvh - 32px); }
    .yoru-type-detail .modal-dialog-scrollable .modal-content {height: 100%; max-height: 100%; display: flex; flex-direction: column;}
    .yoru-type-detail .modal-content { height: 100% !important; min-height: 0 !important;max-height: 100% !important; display: flex; flex-direction: column; }
    .yoru-type-detail .modal-header, .yoru-type-detail .modal-footer { flex: 0 0 auto; }
    .yoru-type-detail .yoru-search-toolbar { flex-shrink: 0;}
    .yoru-secondary-section {border: 1px solid #e5d9c9; border-radius: 12px; background: #fffdfa; padding: 20px;}
    @@media(max-width:1200px) { .yoru-type-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
    @@media(max-width:720px) { .yoru-type-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:450px) { .yoru-type-grid { grid-template-columns:1fr; } }
    @@media (prefers-reduced-motion: reduce) {.yoru-type-card, .yoru-type-image, .yoru-type-detail.collapsing {transition: none;} }

    #tableModal .yoru-advanced-field { display: none !important;}
    #tableModal.yoru-edit-mode .yoru-advanced-field { display: block !important;}
    /* Manage Table Types - compact layout */
    #manageTableTypesModal .modal-content {overflow: hidden;}
    #manageTableTypesModal .modal-body { padding-bottom: 16px;}
    #manageTableTypesModal .modal-footer {padding-top: 12px; padding-bottom: 12px;}
    /* Smooth transition between list and form */
    #manageTableTypesModal .yoru-type-view-enter {animation: yoruTypeViewEnter 220ms ease-out both;}
    @@keyframes yoruTypeViewEnter {
        from { opacity: 0; transform: translateY(10px);}
        to { opacity: 1; transform: translateY(0);}}
    @@media (prefers-reduced-motion: reduce) { #manageTableTypesModal .yoru-type-view-enter { animation: none;}}
    /* Fixed Manage Table Types modal */
    #manageTableTypesModal .modal-dialog { height: 600px; max-height: calc(100dvh - 32px);}
    #manageTableTypesModal .modal-content { height: 100%; overflow: hidden; }
    #manageTableTypesModal .modal-body { overflow-y: auto; min-height: 0; scrollbar-gutter: stable;}
    /* Only the content changes, not the modal */
    #manageTableTypesModal .modal-header,
    #manageTableTypesModal .modal-footer {
        flex-shrink: 0;
    }
    /* Manage Table Types column spacing */
    #manageTableTypesModal #tableTypesListView table {
        width: 100%;
        table-layout: fixed;
    }

    #manageTableTypesModal #tableTypesListView th:nth-child(1) { width: 28%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(2) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(3) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(4) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(5) { width: 21%; text-align: center;}
    #manageTableTypesModal #tableTypesListView th:last-child,
    #manageTableTypesModal #tableTypesListView td:last-child {
        text-align: center;
        white-space: nowrap;
    }
    .yoru-tables-hero {padding-bottom: 105px;}
    .yoru-hero-navigation {position: absolute; bottom: 25px; left: 42px; right: 42px; z-index: 3; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.2);}
    .yoru-hero-nav-buttons {display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid rgba(255,255,255,0.2); border-radius: 30px; background: rgba(10,10,10,0.65);}
    .yoru-hero-nav-link {display: inline-flex; align-items: center; justify-content: center; padding: 9px 18px; border-radius: 25px; color: #ddd; text-decoration: none; font-size: 12px; font-weight: 600; transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;}
    .yoru-hero-nav-link:hover {color: #fff; background: rgba(196,59,43,0.6); transform: translateY(-2px);}
    .yoru-hero-nav-link.active {background: #c43b2b; color: #fff;}
    html {scroll-behavior: smooth;}
    #tables-section, #dining-areas-section, #opening-hours-section {scroll-margin-top: 90px;}
    @@media (max-width: 768px) {.yoru-tables-hero {padding-bottom: 120px;} .yoru-hero-navigation {left: 24px; right: 24px; bottom: 20px;} .yoru-hero-nav-link {padding: 8px 12px; font-size: 11px;}}
    @@media (prefers-reduced-motion: reduce) {html {scroll-behavior: auto;}}
    .yoru-back-to-top {position: fixed; bottom: 60px; right: 30px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #c43b2b; color: #fff; border: 1px solid #a83228; border-radius: 50%; cursor: pointer; z-index: 1050; opacity: 0; visibility: hidden; transform: translateY(15px); transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease, background 0.3s ease; box-shadow: 0 6px 20px rgba(0,0,0,0.2);}
    .yoru-back-to-top.show {opacity: 1; visibility: visible; transform: translateY(0);}
    .yoru-back-to-top:hover {background: #a83228; transform: translateY(-5px);}
    .yoru-back-to-top svg {width: 22px; height: 22px; stroke-width: 2;}
    @@media (max-width: 768px) {.yoru-back-to-top {bottom: 20px; right: 20px; width: 42px; height: 42px;}}
    @@media (prefers-reduced-motion: reduce) {.yoru-back-to-top {transition: none;}}

    .yoru-luxury-card {height:100%; background:#fffdfa; border:1px solid #e7d9cc; border-radius:18px; padding:25px; box-shadow:0 5px 18px rgba(54,34,26,.035);}
    .yoru-luxury-head {display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;}
    .yoru-luxury-eyebrow {font-size:10px; font-weight:700; letter-spacing:2px; color:#a83228; margin-bottom:5px;}
    .yoru-luxury-title {font-family:Georgia,serif; font-size:26px; font-weight:500; color:#30231d; margin:0;}
    .yoru-luxury-subtitle {color:#89776d; font-size:12px; margin:5px 0 0;}
    .yoru-luxury-btn {display:inline-flex; align-items:center; justify-content:center; gap:7px; background:#a83228; color:#fff; border:1px solid #a83228; border-radius:9px; padding:10px 13px; font-size:12px; font-weight:600; transition:transform .2s ease,box-shadow .2s ease,background .2s ease;}
    .yoru-luxury-btn:hover {background:#8e281f; color:#fff; transform:translateY(-2px); box-shadow:0 8px 16px rgba(168,50,40,.22);}
    .yoru-luxury-btn svg {width:15px; height:15px;}
    .yoru-luxury-btn.secondary {background:#fffdfa; color:#715b51; border-color:#daccc0;}
    .yoru-luxury-btn.secondary:hover {background:#f4e9e2;}
    .yoru-area-list {display:grid; gap:11px;}
    .yoru-area-item {display:flex; align-items:center; gap:12px; padding:13px; border:1px solid #eee3db; border-radius:12px; background:#fbf8f5; transition:transform .24s ease,background .24s ease,border-color .24s ease,box-shadow .24s ease;}
    .yoru-area-item:hover {transform:translateY(-3px); background:#fff; border-color:#cfaa99; box-shadow:0 10px 24px rgba(67,40,30,.09);}
    .yoru-area-icon {display:grid; place-items:center; width:52px; height:52px; flex-shrink:0; background:#f3e5df; color:#a83228; border-radius:12px; transition:transform .28s ease,background .28s ease;}
    .yoru-area-icon svg {width:23px; height:23px;}
    .yoru-area-item:hover .yoru-area-icon {transform:scale(1.09) rotate(-5deg); background:#ecd5cb;}
    .yoru-area-info {flex:1; min-width:0;}
    .yoru-area-name {font-weight:700; color:#382821; font-size:14px;}
    .yoru-area-desc {color:#8b7c72; font-size:12px; margin:3px 0 0; overflow-wrap:anywhere;}
    .yoru-area-count {white-space:nowrap; color:#765b4b; background:#f2e8e0; border-radius:25px; padding:6px 9px; font-size:11px;}
    .yoru-area-actions {display:flex; gap:5px;}
    .yoru-area-action {display:grid; place-items:center; width:33px; height:33px; border:1px solid transparent; background:transparent; color:#7c6d64; border-radius:8px; transition:background .2s ease,color .2s ease,transform .2s ease;}
    .yoru-area-action:hover {background:#f1e0d7; color:#a83228; transform:translateY(-2px);}
    .yoru-area-action.delete:hover {background:#fce4e1; color:#ba3225;}
    .yoru-area-action svg {width:16px; height:16px;}
    .yoru-area-empty {text-align:center; padding:35px 12px; color:#8b7c72; font-size:13px;}
    .yoru-hours-summary {display:flex; align-items:center; gap:12px; background:#f5ebe2; color:#594337; border-radius:12px; padding:14px; margin-bottom:14px;}
    .yoru-hours-summary svg {width:23px; height:23px; color:#a83228;}
    .yoru-hours-summary strong {display:block; font-size:13px;}
    .yoru-hours-summary span {display:block; color:#826c5f; font-size:12px; margin-top:2px;}
    .yoru-hours-list {display:grid; gap:8px;}
    .yoru-hours-row {display:grid; grid-template-columns:minmax(95px,1fr) minmax(190px,1.8fr) minmax(70px,.7fr); align-items:center; gap:10px; background:#fbf8f5; border:1px solid #eee6df; border-radius:10px; padding:12px; transition:transform .24s ease,background .24s ease,box-shadow .24s ease,border-color .24s ease;}
    .yoru-hours-row:hover {transform:translateY(-2px); background:#fff; border-color:#d8b7a7; box-shadow:0 7px 18px rgba(65,40,29,.07);}
    .yoru-hours-day {font-size:13px; font-weight:700; color:#382b25;}
    .yoru-hours-time-group {display:flex; justify-content:center; align-items:center; gap:12px; min-width:0;}
    .yoru-hours-time {display:flex; flex-direction:column; align-items:center; text-align:center; gap:2px; min-width:0;}
    .yoru-hours-caption {font-size:10px; letter-spacing:.5px; color:#89776d;}
    .yoru-hours-value {font-size:13px; font-weight:700; color:#332722; white-space:nowrap;}
    .yoru-hours-arrow {color:#a99a91; font-size:16px;}
    .yoru-hours-status {display:flex; grid-column:3; grid-row:1; align-items:center; justify-content:flex-end; font-size:11px; color:#79685e; white-space:nowrap;}
    .yoru-hours-status.is-closed {color:#a83228;}
    .yoru-hours-time-btn {border:1px solid #decac0; background:#fff; border-radius:8px; padding:7px 8px; color:#a83228; font-size:12px; font-weight:700; white-space:nowrap; transition:background .2s ease,transform .2s ease;}
    .yoru-hours-time-btn:hover {background:#f5e9e2; transform:translateY(-2px);}
    .yoru-hours-row .yoru-edit-only {display:none;}
    .yoru-hours-editing .yoru-hours-row .yoru-edit-only {display:flex;}
    .yoru-hours-editing .yoru-hours-row .yoru-view-only {display:none;}
    .yoru-hours-editing .yoru-hours-row {border-color:#e7d5ca;}
    .yoru-hours-closed-check {display:flex; align-items:center; gap:5px; font-size:11px; cursor:pointer;}
    .yoru-hours-closed-check input {accent-color:#a83228;}
    .yoru-hours-closed-message {display:none; grid-column:2; grid-row:1; align-items:center; justify-content:center; gap:7px; color:#b83228; font-size:11px; font-weight:700; letter-spacing:.5px; text-align:center;}
    .yoru-hours-closed-message svg {width:16px; height:16px; flex-shrink:0; stroke-width:2;}
    .yoru-hours-closed-message span {white-space:nowrap;}
    .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {visibility:hidden;}
    .yoru-hours-row.yoru-day-closed .yoru-hours-closed-message {display:flex;}
    .yoru-hours-row.yoru-day-closed .yoru-hours-status {color:#b83228;}
    .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {visibility:visible;}
    .yoru-hours-editing .yoru-hours-row .yoru-hours-closed-message {display:none;}
    .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-time-btn {opacity:.55; pointer-events:none; cursor:not-allowed;}
    .yoru-hours-editing .yoru-hours-closed-check {display:flex; align-items:center; gap:6px; opacity:1; cursor:pointer; white-space:nowrap;}
    .yoru-hours-editing .yoru-hours-closed-check input {opacity:1; cursor:pointer; pointer-events:auto; accent-color:#a83228;}
    .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-closed-check {color:#a83228; font-weight:700;}
    .yoru-hours-edit-actions {display:flex; gap:8px; flex-wrap:wrap;}
    .yoru-icon-picker {display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px;}
    .yoru-icon-choice {display:flex; flex-direction:column; align-items:center; gap:7px; padding:12px 4px; border:1px solid #e6d9d0; border-radius:10px; background:#fffdfa; color:#77645a; font-size:11px; transition:transform .2s ease,border-color .2s ease,background .2s ease;}
    .yoru-icon-choice:hover {transform:translateY(-3px); border-color:#a83228;}
    .yoru-icon-choice.selected {background:#f5e6df; border-color:#a83228; color:#a83228; box-shadow:0 0 0 1px #a83228 inset;}
    .yoru-icon-choice svg {width:22px; height:22px;}
    .yoru-wheel-overlay {position:fixed; inset:0; z-index:1100; background:rgba(31,22,19,.48); display:none; align-items:center; justify-content:center; padding:15px;}
    .yoru-wheel-overlay.show {display:flex; animation:yoruFade .2s ease both;}
    .yoru-wheel-dialog {width:min(100%,390px); background:#fffdfa; border:1px solid #e5d7cc; border-radius:18px; padding:22px; box-shadow:0 25px 65px rgba(0,0,0,.22); animation:yoruWheelEnter .24s ease both;}
    .yoru-wheel-columns {display:grid; grid-template-columns:1fr 1fr .85fr; gap:9px; margin:15px 0;}
    .yoru-wheel-col {height:180px; overflow-y:auto; scroll-snap-type:y mandatory; overscroll-behavior:contain; scrollbar-width:none; border-radius:9px; background:linear-gradient(#faf4ef,#fffdfa 45%,#fffdfa 55%,#faf4ef);}
    .yoru-wheel-col::-webkit-scrollbar {display:none;}
    .yoru-wheel-option {height:44px; display:flex; align-items:center; justify-content:center; scroll-snap-align:center; font-size:16px; color:#a99a92; cursor:pointer; user-select:none; transition:color .12s ease,font-size .12s ease;}
    .yoru-wheel-option.selected {color:#a83228; font-size:21px; font-weight:700; background:#f6e7df; border-radius:8px;}
    .yoru-wheel-spacer {height:68px;}
    .yoru-wheel-preview {text-align:center; color:#5b4034; font-family:Georgia,serif; font-size:24px; margin:10px 0 15px;}
    @@keyframes yoruFade {from {opacity:0;} to {opacity:1;}}
    @@keyframes yoruWheelEnter {from {opacity:0; transform:translateY(16px) scale(.97);} to {opacity:1; transform:translateY(0) scale(1);}}
    #areaModal.fade .modal-dialog, #deleteAreaModal.fade .modal-dialog {transform:translateY(14px) scale(.97); opacity:0; transition:transform .28s ease,opacity .28s ease;}
    #areaModal.show .modal-dialog, #deleteAreaModal.show .modal-dialog {transform:translateY(0) scale(1); opacity:1;}
    @@media (max-width:650px) {.yoru-luxury-card {padding:16px;} .yoru-hours-row {grid-template-columns:minmax(80px,1fr) minmax(155px,1.7fr); gap:6px; padding:10px 8px;} .yoru-hours-status {grid-column:1/-1; justify-content:flex-end;} .yoru-hours-time-group {gap:6px;} .yoru-hours-value {font-size:12px;} .yoru-area-item {flex-wrap:wrap;} .yoru-area-count {margin-left:auto;} }
    @@media (prefers-reduced-motion:reduce) {.yoru-luxury-card,.yoru-area-item,.yoru-area-icon,.yoru-hours-row,.yoru-luxury-btn,.yoru-area-action,.yoru-hours-time-btn,.yoru-icon-choice,#areaModal.fade .modal-dialog,#deleteAreaModal.fade .modal-dialog {transition:none!important; animation:none!important;} .yoru-wheel-overlay.show,.yoru-wheel-dialog {animation:none!important;} }
    .yoru-hours-day {grid-column:1; grid-row:1;}
    .yoru-hours-time-group {grid-column:2; grid-row:1;}
    .yoru-hours-status {grid-column:3; grid-row:1;}
</style>
<div class="card mb-4" id="tables-section">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h5 mb-1">Table types</h2>
                <p class="text-muted mb-0"> Select a table type to manage individual tables and their status.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#manageTableTypesModal">
                    Manage Table Types
                </button>

                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#tableModal">
                    Add table
                </button>
            </div>
        </div>

        

<div class="yoru-type-grid">
    @foreach (var type in Model.TableTypes)
    {
        var tables = Model.AllTables
            .Where(t => t.TableTypeDefinitionId == type.Id)
            .ToList();

        var imagePath = type.PhotoPath
            ?? "/images/tables/standard.jpg";

        var sectionId = $"tables-type-{type.Id}";

        var isRoom = type.Name.Contains("room", StringComparison.OrdinalIgnoreCase);                

        var unit = isRoom
            ? (tables.Count == 1 ? "room" : "rooms")
            : (tables.Count == 1 ? "table" : "tables");

        var guestText = tables.Count == 0
            ? $"{type.DefaultMinGuests}–{type.DefaultMaxGuests} guests"
            : tables.Min(t => t.MinGuests) == tables.Max(t => t.Capacity)
                ? $"{tables.Min(t => t.MinGuests)} guest"
                : $"{tables.Min(t => t.MinGuests)}–{tables.Max(t => t.Capacity)} guests";

        <div class="yoru-type-card">

            <div class="yoru-type-image-wrap">
                <img class="yoru-type-image"
                     src="@imagePath"
                     alt="@type.Name" />
            </div>

            <div class="yoru-type-body">
                <p class="yoru-type-title">
                    @type.Name
                </p>

                <p class="yoru-type-meta">
                    @tables.Count @unit · @guestText
                </p>

                @if (type.DefaultMinimumSpend > 0)
                {
                    <p class="yoru-type-spend">
                        Minimum spend:
                        @TableTypeInfo.Rm(type.DefaultMinimumSpend.Value)
                    </p>
                }

                @if (!type.IsActive)
                {
                    <p class="text-muted small mb-2">
                        Inactive
                    </p>
                }

                <div class="yoru-type-actions">
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#modal-@(sectionId)">
                        @(isRoom ? "Manage rooms" : "Manage tables")
                    </button>

                </div>
            </div>
        </div>
    }
</div>



    <div id="tableTypeAccordion">
        @foreach (var type in Model.TableTypes)
        {
            var tables = Model.AllTables.Where(t => t.TableTypeDefinitionId == type.Id).ToList();
            var isRoom = type.Name.Contains("room", StringComparison.OrdinalIgnoreCase);
            <div class="modal fade yoru-type-detail" id="modal-tables-type-@(type.Id)" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class=" modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@type.Name — Manage Tables </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-lable="Close"></button>
                        </div>
                
                        <div class="modal-body">
                            <div class="yoru-search-toolbar"> <input type="search" class="form-control yoru-table-search" placeholder="Search table name..." aria-label="Search tables" />
                                <select class="form-select yoru-table-status-filter" aria-label="Filter table status"> 
                                    <option value="">All statuses</option>
                                    
                                    @foreach (var status in Enum.GetValues<TableStatus>())
                                    {<option value="@status"> @(status == TableStatus.OutOfService ? "Out of service" : status.ToString()) </option>}
                                </select>

                                <select class="form-select yoru-table-active-filter" aria-label="Filter active tables">
                                    <option value="">All tables</option> <option value="true">Active</option> <option value="false">Inactive</option>
                                </select>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle"> <thead><tr><th>Table</th><th>Area</th><th>Seats</th><th>Minimum spend</th><th>Status</th><th>Active</th><th>Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var t in tables)
                                            {
                                                <tr class="yoru-table-row" data-name="@t.TableNumber" data-status="@t.Status" data-active="@t.IsActive.ToString().ToLowerInvariant()">
                                                    <td class="fw-semibold">@t.TableNumber</td>
                                                    <td>@Model.Areas.First(a => a.Id == t.DiningAreaId).Name</td>
                                                    <td>@(t.MinGuests == t.Capacity ? t.Capacity.ToString() : $"{t.MinGuests}-{t.Capacity}")</td>
                                                    <td>@(t.MinimumSpend > 0 ? TableTypeInfo.Rm(t.MinimumSpend) : "–")</td>
                                                    <td>
                                                        <form method="post" asp-page-handler="Status" class="d-flex gap-2 align-items-center">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <select name="status" class="form-select form-select-sm yoru-status-select" aria-label="Status for @t.TableNumber">
                                                                @foreach (var status in Enum.GetValues<TableStatus>())
                                                                {
                                                                    <option value="@status" selected="@(t.Status == status)">@(status == TableStatus.OutOfService ? "Out of service" : status.ToString())</option>
                                                                }
                                                            </select>
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                                        </form>
                                                    </td>
                                                    <td>@(t.IsActive ? "Yes" : "No")</td>
                                                    <td class="text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#tableModal"
                                                                data-id="@t.Id" data-number="@t.TableNumber" data-type="@((int)t.Type)" data-dynamic-type="@t.TableTypeDefinitionId" data-area="@t.DiningAreaId"
                                                                data-min="@t.MinGuests" data-max="@t.Capacity" data-spend="@t.MinimumSpend.ToString("0")" data-desc="@t.Description" data-active="@t.IsActive.ToString().ToLower()">
                                                            Edit
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                data-bs-toggle="modal" data-bs-target="#deleteTableModal"
                                                                data-id="@t.Id" data-number="@t.TableNumber" data-kind="@(isRoom ? "room" : "table")">
                                                            Delete
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                            @if (!tables.Any())
                                            { <tr><td colspan="7">No tables of this type yet.</td></tr> }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="yoru-pagination"> <small class="text-muted yoru-page-info"></small>
                                    <div class="btn-group" role="group"> <button type="button" class="btn btn-outline-secondary btn-sm yoru-prev"> Previous</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm yoru-next"> Next </button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"> Close </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-6">
        <section class="yoru-luxury-card" id="dining-areas-section">
            <div class="yoru-luxury-head">
                <div><div class="yoru-luxury-eyebrow">THE DINING COLLECTION</div><h2 class="yoru-luxury-title">Dining Areas</h2><p class="yoru-luxury-subtitle">Curate every corner of the YORU experience.</p></div>
                <button type="button" class="yoru-luxury-btn" data-bs-toggle="modal" data-bs-target="#areaModal"><i data-lucide="plus"></i> Add Area</button>
            </div>
            <div class="yoru-area-list">
                @foreach (var a in Model.Areas)
                {
                    var areaName = (a.Name ?? "").ToLowerInvariant();
                    var autoIcon = areaName.Contains("bar") || areaName.Contains("counter") ? "wine" : areaName.Contains("private") || areaName.Contains("vip") || areaName.Contains("room") ? "door-closed" : areaName.Contains("outdoor") || areaName.Contains("garden") || areaName.Contains("terrace") ? "trees" : areaName.Contains("roof") ? "sunset" : areaName.Contains("cafe") || areaName.Contains("coffee") ? "coffee" : areaName.Contains("lounge") ? "sofa" : areaName.Contains("hall") || areaName.Contains("dining") ? "utensils-crossed" : "layout-grid";
                    // After adding DiningArea.IconName to the model, replace autoIcon below with: !string.IsNullOrWhiteSpace(a.IconName) ? a.IconName : autoIcon
                    <article class="yoru-area-item">
                        <div class="yoru-area-icon"><i data-lucide="@(string.IsNullOrWhiteSpace(a.IconName) ? autoIcon : a.IconName)"></i></div>
                        <div class="yoru-area-info"><div class="yoru-area-name">@a.Name</div><p class="yoru-area-desc">@a.Description</p></div>
                        <span class="yoru-area-count">@a.Tables.Count Tables</span>
                        <div class="yoru-area-actions">
                            <button type="button" class="yoru-area-action" title="Edit area" aria-label="Edit @a.Name" data-bs-toggle="modal" data-bs-target="#areaModal" data-id="@a.Id" data-name="@a.Name" data-desc="@a.Description" data-icon="@(string.IsNullOrWhiteSpace(a.IconName) ? autoIcon : a.IconName)"><i data-lucide="pencil"></i></button>
                            <button type="button" class="yoru-area-action delete" title="Delete area" aria-label="Delete @a.Name" data-bs-toggle="modal" data-bs-target="#deleteAreaModal" data-id="@a.Id" data-name="@a.Name" data-has-tables="@(a.Tables.Any() ? "true" : "false")"><i data-lucide="trash-2"></i></button>
                        </div>
                    </article>
                }
                @if (!Model.Areas.Any())
                {
                    <div class="yoru-area-empty">No dining areas yet. Add one to get started.</div>
                }
            </div>
        </section>
    </div>
    <div class="col-xl-6">
        <section class="yoru-luxury-card" id="opening-hours-section">
            <div class="yoru-luxury-head">
                <div><div class="yoru-luxury-eyebrow">YOUR DAILY RHYTHM</div><h2 class="yoru-luxury-title">Opening Hours</h2><p class="yoru-luxury-subtitle">Manage your weekly operating schedule.</p></div>
                <div class="yoru-hours-edit-actions">
                    <button type="button" id="yoruEditHours" class="yoru-luxury-btn"><i data-lucide="pencil"></i> Edit Schedule</button>
                    <button type="button" id="yoruCancelHours" class="yoru-luxury-btn secondary d-none">Cancel</button>
                    <button type="submit" form="hoursForm" id="yoruSaveHours" class="yoru-luxury-btn d-none"><i data-lucide="save"></i> Save Changes</button>
                </div>
            </div>
            <div class="yoru-hours-summary"><i data-lucide="clock-3"></i><div><strong>Weekly Operating Schedule</strong><span id="yoruHoursSummary"></span></div></div>
            <form id="hoursForm" method="post" asp-page-handler="SaveHours">
                <div class="yoru-hours-list">
                    @for (var i = 0; i < Model.Hours.Count; i++)
                    {
                        <div class="yoru-hours-row" data-hour-index="@i">
                            <div class="yoru-hours-day">@Model.Hours[i].Day<input type="hidden" asp-for="Hours[i].Id" /><input type="hidden" asp-for="Hours[i].Day" /></div>
                            <div class="yoru-hours-time-group">
                                <div class="yoru-hours-time">
                                    <span class="yoru-hours-caption">OPENS</span>
                                    <span class="yoru-hours-value yoru-view-only" data-time-view="open"></span>
                                    <button type="button" class="yoru-hours-time-btn yoru-edit-only" data-time-edit="open"></button>
                                </div>

                                <span class="yoru-hours-arrow">→</span>

                                <div class="yoru-hours-time">
                                    <span class="yoru-hours-caption">CLOSES</span>
                                    <span class="yoru-hours-value yoru-view-only" data-time-view="close"></span>
                                    <button type="button" class="yoru-hours-time-btn yoru-edit-only" data-time-edit="close"></button>
                                </div>
                            </div>

                            <div class="yoru-hours-closed-message">
                                <i data-lucide="calendar-x" aria-hidden="true"></i>
                                <span>CLOSED FOR THE DAY</span>
                            </div>

                            <div class="yoru-hours-status">
                                <span class="yoru-view-only" data-hours-status></span>

                                <label class="yoru-hours-closed-check yoru-edit-only">
                                    <input asp-for="Hours[i].IsClosed" class="form-check-input" />
                                    Closed
                                </label>
                            </div>
                            
                            <input asp-for="Hours[i].OpenTime" type="time" class="yoru-hour-native" hidden />
                            <input asp-for="Hours[i].CloseTime" type="time" class="yoru-hour-native" hidden />
                        </div>
                    }
                </div>
            </form>
        </section>
    </div>
</div>

<!-- Wheel Time Picker -->
<div class="yoru-wheel-overlay" id="yoruWheelOverlay" aria-hidden="true">
    <div class="yoru-wheel-dialog" role="dialog" aria-modal="true" aria-labelledby="yoruWheelTitle">
        <div class="d-flex align-items-center justify-content-between"><h3 class="h5 mb-0" id="yoruWheelTitle">Choose Time</h3><button type="button" class="btn-close" id="yoruWheelClose" aria-label="Close"></button></div>
        <p class="text-muted small mt-2 mb-0">Scroll to select hour, minute and AM/PM.</p>
        <div class="yoru-wheel-columns"><div><div class="text-center small text-muted">HOUR</div><div class="yoru-wheel-col" id="yoruWheelHour"></div></div><div><div class="text-center small text-muted">MINUTE</div><div class="yoru-wheel-col" id="yoruWheelMinute"></div></div><div><div class="text-center small text-muted">AM / PM</div><div class="yoru-wheel-col" id="yoruWheelPeriod"></div></div></div>
        <div class="yoru-wheel-preview" id="yoruWheelPreview">10:00 AM</div>
        <div class="d-flex justify-content-end gap-2"><button type="button" class="yoru-luxury-btn secondary" id="yoruWheelCancel">Cancel</button><button type="button" class="yoru-luxury-btn" id="yoruWheelConfirm">Confirm Time</button></div>
    </div>
</div>

<div class="modal fade" id="areaModal" tabindex="-1" aria-labelledby="areaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveArea" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="areaTitle">Dining area</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="AreaForm.Id" />
                <label asp-for="AreaForm.Name" class="form-label">Name</label>
                <input asp-for="AreaForm.Name" class="form-control mb-3" required maxlength="60" />
                <label asp-for="AreaForm.Description" class="form-label">Description (optional)</label>
                <input asp-for="AreaForm.Description" class="form-control" maxlength="200" />
                <div class="mt-3">
                    <label class="form-label">Area Icon</label><input type="hidden" name="AreaForm.IconName" id="yoruAreaIconName" value="layout-grid" /><div class="yoru-icon-picker" id="yoruIconPicker">
                    @foreach (var option in new[] { ("wine", "Bar"), ("utensils-crossed", "Dining"), ("door-closed", "Private"), ("trees", "Outdoor"), ("sunset", "Rooftop"), ("coffee", "Cafe"), ("sofa", "Lounge"), ("layout-grid", "General") })
                    {
                        <button type="button" class="yoru-icon-choice" data-icon-choice="@option.Item1"><i data-lucide="@option.Item1"></i><span>@option.Item2</span></button>
                    }
