    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('tableTypeForm');

        const minInput = form.querySelector(
            '[name="TableTypeForm.DefaultMinGuests"]'
        );

        const capacityInput = form.querySelector(
            '[name="TableTypeForm.DefaultMaxGuests"]'
        );

        const error = document.getElementById('tableTypeCapacityError');

        capacityInput.setAttribute(
            'aria-describedby',
            'tableTypeCapacityError'
        );

        function validateGuestRange() {
            const invalid =
                minInput.value !== '' &&
                capacityInput.value !== '' &&
                Number(minInput.value) > Number(capacityInput.value);

            const message = invalid
                ? 'Capacity must be at least the minimum guests.'
                : '';

            capacityInput.setCustomValidity(message);
            capacityInput.classList.toggle('is-invalid', invalid);
            capacityInput.setAttribute('aria-invalid', String(invalid));

            error.hidden = !invalid;
        }

        minInput.addEventListener('input', validateGuestRange);
        capacityInput.addEventListener('input', validateGuestRange);

        form.addEventListener('reset', () => {
            setTimeout(validateGuestRange, 0);
        });

        form.addEventListener('submit', event => {
            validateGuestRange();

            if (capacityInput.validity.customError) {
                event.preventDefault();
                event.stopImmediatePropagation();
                capacityInput.focus();
                capacityInput.reportValidity();
            }
        }, true);

        validateGuestRange();
    });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('tableTypeForm');
            const saveButton = document.getElementById('saveTableTypeBtn');
            const errorBox = document.getElementById('tableTypeSaveError');

            if (!form || !saveButton || !errorBox) {
                return;
            }

            let saving = false;

            form.addEventListener('reset', () => {
                errorBox.hidden = true;
                errorBox.textContent = '';
            });

            form.addEventListener('submit', async event => {
                // Respect the existing validation and bulk-update confirmation.
                if (event.defaultPrevented) {
                    return;
                }

                event.preventDefault();

                if (saving || !form.reportValidity()) {
                    return;
                }

                const formData = new FormData(form);

                saving = true;
                saveButton.disabled = true;
                errorBox.hidden = true;
                errorBox.textContent = '';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    });

                    const contentType =
                        response.headers.get('content-type') || '';

                    if (!contentType.includes('application/json')) {
                        throw new Error(
                            'The server returned an unexpected response. ' +
                            'Your entries are still here.'
                        );
                    }

                    const result = await response.json();

                    if (response.ok && result.success) {
                        window.yoruRememberView({
                            tab: 'tables',
                            panelId: null
                        });

                        window.location.reload();
                        return;
                    }

                    // The type was saved, but its photo upload failed.
                    if (result.savedId) {
                        form.querySelector(
                            '[name="TableTypeForm.Id"]'
                        ).value = result.savedId;

                        const createFirstTable = form.querySelector(
                            '[name="TableTypeForm.CreateFirstTable"]'
                        );

                        if (createFirstTable) {
                            createFirstTable.checked = false;
                        }

                        const createFirstSection =
                            document.getElementById('createFirstTableSection');

                        if (createFirstSection) {
                            createFirstSection.style.display = 'none';
                        }
                    }

                    errorBox.textContent =
                        result.message ||
                        'Unable to save. Please check your entries.';

                    errorBox.hidden = false;
                    errorBox.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });
                } catch (error) {
                    errorBox.textContent =
                        error.message ||
                        'Unable to connect. Your entries are still here.';

                    errorBox.hidden = false;
                } finally {
                    saving = false;
                    saveButton.disabled = false;
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const zoomButton =
                document.getElementById('tableTypePhotoZoomButton');

            const preview =
                document.getElementById('tableTypePhotoPreview');

            const dialog =
                document.getElementById('yoruPhotoDialog');

            const largePhoto =
                document.getElementById('yoruPhotoLarge');

            const closeButton =
                document.getElementById('yoruPhotoClose');

            zoomButton.addEventListener('click', () => {
                largePhoto.src = preview.currentSrc || preview.src;
                dialog.showModal();
            });

            closeButton.addEventListener('click', () => {
                dialog.close();
            });

            // Click outside the photo window to close.
            dialog.addEventListener('click', event => {
                if (event.target !== dialog) {
                    return;
                }

                const bounds = dialog.getBoundingClientRect();

                const outside =
                    event.clientX < bounds.left ||
                    event.clientX > bounds.right ||
                    event.clientY < bounds.top ||
                    event.clientY > bounds.bottom;

                if (outside) {
                    dialog.close();
                }
            });

            // Escape closes the photo without reaching drawer shortcuts.
            dialog.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    event.stopPropagation();
                }
            });

            dialog.addEventListener('close', () => {
                largePhoto.removeAttribute('src');
            });
        });
    </script>
