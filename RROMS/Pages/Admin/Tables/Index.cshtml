@page
@model RROMS.Pages.Admin.Tables.IndexModel
@using RROMS.Models
@{
    ViewData["Title"] = "Tables and opening hours";
}

<!-- Tables & Opening Hours Hero Header -->
<div class="yoru-tables-hero yoru-tables-page mb-4">

    <div class="yoru-tables-hero-content">

        <div class="yoru-tables-brand">
            <strong>YORU IZAKAYA</strong>
            <span class="yoru-brand-divider"></span>
            <span>TABLE MANAGEMENT</span>
        </div>

        <div class="yoru-tables-eyebrow">
            良い食事は、良い空間から
        </div>

        <h1 class="yoru-tables-hero-title">
            Restaurant Spaces
        </h1>

        <p class="yoru-tables-hero-description">
            Every table, every space. Curate the YORU dining experience.
        </p>

    </div>
</div>
<div class="yoru-hero-navigation">
    <div class="yoru-hero-nav-buttons" role="tablist" aria-label="Restaurant management sections">
        <button type="button" class="yoru-hero-nav-link active"
                data-yoru-tab="tables" role="tab"
                aria-selected="true" aria-controls="tables-section">
            <i data-lucide="layers-3"></i> Table Types
        </button>

        <button type="button" class="yoru-hero-nav-link"
                data-yoru-tab="areas" role="tab"
                aria-selected="false" aria-controls="dining-areas-section">
            <i data-lucide="door-open"></i> Dining Areas
        </button>

        <button type="button" class="yoru-hero-nav-link"
                data-yoru-tab="hours" role="tab"
                aria-selected="false" aria-controls="opening-hours-section">
            <i data-lucide="clock-3"></i> Opening Hours
        </button>
    </div>
</div>

<div class="yoru-summary mb-4">
 
    <div class="yoru-summary-item yoru-summary-dark">
        <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="armchair"></i></div>
        <div class="yoru-summary-number">
            @Model.AllTables.Count
        </div>

        <div class="yoru-summary-title">Total tables</div>
        <div class="yoru-summary-desc">
            Seating across the restaurant.
        </div>
    </div>
    
    <div class="yoru-summary-item yoru-summary-red">
        <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="layers-3"></i></div>
        <div class="yoru-summary-number">
            @Model.TableTypes.Count
        </div>

        <div class="yoru-summary-title">Table types</div>
        <div class="yoru-summary-desc">
            Seating styles available.
        </div>
    </div>

    <div class="yoru-summary-item yoru-summary-light">
            <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="door-open"></i></div>
        <div class="yoru-summary-number">
            @Model.Areas.Count
        </div>

        <div class="yoru-summary-title">Dining areas</div>
        <div class="yoru-summary-desc">
            Spaces for every occasion.
        </div>
    </div>

</div>

@{
    var typeNames = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "Counter seat",
        [TableType.Double] = "Table for two",
        [TableType.Standard] = "Standard table",
        [TableType.Vip] = "VIP room",
        [TableType.Vvip] = "VVIP room"
    };
    var sampleImages = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "/images/tables/counter.jpg",
        [TableType.Double] = "/images/tables/double.jpg",
        [TableType.Standard] = "/images/tables/standard.jpg",
        [TableType.Vip] = "/images/tables/vip.jpg",
        [TableType.Vvip] = "/images/tables/vvip.jpg"
    };
}
<style>
    /* Weekly Timeline — Compact Layout */
    #yoruWeeklyTimeline {display:grid; gap:5px;}
    .yoru-timeline-scale {display:flex; justify-content:space-between; margin:0 5px 2px 52px; color:#a39488; font-size:10px;}
    .yoru-timeline-row {display:grid; grid-template-columns:43px minmax(0,1fr); align-items:center; gap:9px; position:relative; padding:8px 9px; min-height:38px; border:1px solid #eee5dd; border-radius:8px; background:#fbf8f5; transition:transform .25s ease,background .25s ease,border-color .25s ease,box-shadow .25s ease;}
    .yoru-timeline-row:hover {transform:translateX(4px); background:#fff; border-color:#dfb9a9; box-shadow:0 4px 12px rgba(75,40,25,.07);}
    .yoru-timeline-day {color:#62544b; font-size:11px; font-weight:700;}
    .yoru-timeline-track {position:relative; height:12px; overflow:hidden; border-radius:20px; background:#eee7e0;}
    .yoru-timeline-bar {position:absolute; top:0; bottom:0; border-radius:20px; background:linear-gradient(90deg,#a83228,#d65c45); transition:left .3s ease,width .3s ease,filter .25s ease,box-shadow .25s ease;}
    .yoru-timeline-row:hover .yoru-timeline-bar {filter:brightness(1.15); box-shadow:0 0 10px rgba(183,47,37,.3);}
    .yoru-timeline-row.is-closed .yoru-timeline-track {display:flex; align-items:center; justify-content:center; background:#f4e9e5;}
    .yoru-timeline-closed {color:#b83228; font-size:9px; font-weight:700; letter-spacing:1px;}
    .yoru-timeline-tooltip {position:absolute; top:50%; right:14px; transform:translate(5px,-50%); grid-column:auto; padding:4px 8px; border-radius:5px; background:#fffdfa; color:#8a7467; font-size:10px; font-weight:600; white-space:nowrap; max-height:none; opacity:0; visibility:hidden; pointer-events:none; box-shadow:0 2px 8px rgba(60,40,25,.12); transition:opacity .2s ease,transform .2s ease,visibility .2s ease;}
    .yoru-timeline-row:hover .yoru-timeline-tooltip {opacity:1; visibility:visible; transform:translate(0,-50%);}
    /* Weekly Timeline — Heading Alignment */
    .yoru-hours-side-heading {display:flex; align-items:center; gap:10px; margin-bottom:8px;}
    .yoru-hours-side-heading i,.yoru-hours-side-heading svg {width:22px; height:22px; flex-shrink:0;}
    .yoru-hours-side-heading h3 {margin:0; line-height:1.2;}
    @@media (prefers-reduced-motion:reduce) {.yoru-timeline-row,.yoru-timeline-bar,.yoru-timeline-tooltip {transition:none;} .yoru-timeline-row:hover {transform:none;}}
    /* Opening Hours — Fixed Row Layout */
    #opening-hours-section .yoru-hours-row {grid-template-rows:auto; align-items:center; min-height:62px; box-sizing:border-box;}
    #opening-hours-section .yoru-hours-row .yoru-hours-day {grid-column:1; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-time-group {grid-column:2; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-status {grid-column:3; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-closed-message {grid-column:2; grid-row:1;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed {min-height:62px; box-sizing:border-box;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {display:none!important;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed .yoru-hours-closed-message {display:flex; align-self:center; margin:0;}
    #opening-hours-section .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {display:flex!important;}
    #opening-hours-section .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-closed-message {display:none!important;}
    #opening-hours-section .yoru-hour-native[hidden] {display:none!important;}
    /* Restaurant Spaces hero — no gradient, opacity overlay, or border line */
    .yoru-tables-hero {position:relative; display:flex; align-items:center; min-height:290px; padding:42px 48px 55px; overflow:hidden; border:none; border-radius:18px; background-color:#fcfaf5; background-image:url('/images/tables-hero.png'); background-position:center; background-size:cover; background-repeat:no-repeat; color:#29231e;}
    .yoru-tables-hero-content {position:relative; z-index:1; max-width:680px;}
    .yoru-tables-brand {display:flex; align-items:center; gap:14px; font-size:11px; color:#796e62; margin-bottom:20px;}
    .yoru-tables-brand strong {color:#29231e; font-weight:700;}
    .yoru-brand-divider {width:1px; height:15px; background:#c43b2b;}
    .yoru-tables-eyebrow {font-size:12px; font-weight:700; letter-spacing:2px; color:#a93324; margin-bottom:12px;}
    .yoru-tables-hero-title {font-family:Georgia,serif; font-size:clamp(32px,3.5vw,48px); font-weight:500; line-height:1.15; color:#29231e; margin-bottom:14px;}
    .yoru-tables-hero-description {font-size:14px; color:#655b52; max-width:520px; line-height:1.7; margin:0;}
    body.back-office:has(.yoru-tables-page) .site-main > .container-wide {padding-top:16px!important;}
    /* Navigation overlaps hero, without the former top border */
    .yoru-hero-navigation {position:relative; display:flex; justify-content:flex-start; margin:-48px 0 16px 48px; z-index:5; padding:0; border:0;}
    .yoru-hero-nav-buttons {display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:4px; width:min(100%,560px); padding:4px; border:1px solid #e7ded2; border-radius:10px; background:#f8f5ef; box-shadow:0 5px 16px rgba(60,40,25,.07);}
    .yoru-hero-nav-link {display:flex; align-items:center; justify-content:center; gap:9px; padding:13px 15px; border:0; border-radius:7px; background:transparent; color:#625d55; font-family:inherit; font-size:13px; font-weight:600; text-decoration:none; cursor:pointer; transition:background .2s,color .2s;}
    .yoru-hero-nav-link.active {background:#b72f25; color:#fff; box-shadow:0 3px 8px rgba(150,35,25,.16);}
    .yoru-hero-nav-link:hover:not(.active) {background:#eee7dc; color:#29231e;}
    .yoru-hero-nav-link svg {width:16px; height:16px;}
    /* Compact summary cards, full-card Sakura image */
    .yoru-summary {display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-top:0;}
    .yoru-summary-item {position:relative; isolation:isolate; overflow:hidden; display:flex; flex-direction:column; justify-content:center; min-height:105px; padding:15px 20px 15px 82px; border:1px solid #e8ded2; border-radius:12px; background:#fcfaf5; color:#29231e; box-shadow:0 3px 12px rgba(60,40,25,.035); cursor:default;}
    .yoru-summary-dark,.yoru-summary-red,.yoru-summary-light {background:#fcfaf5; color:#29231e; border-color:#e8ded2;}
    .yoru-summary-sakura {position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; opacity:.24; z-index:0; pointer-events:none;}
    .yoru-summary-icon {position:absolute; left:23px; top:50%; transform:translateY(-50%); color:#b72f25; z-index:2;}
    .yoru-summary-icon svg {width:36px; height:36px; stroke-width:1.8;}
    .yoru-summary-number {position:relative; z-index:1; font-family:Georgia,serif; font-size:30px; line-height:1; margin:0 0 4px;}
    .yoru-summary-title {position:relative; z-index:1; font-size:12px; font-weight:700; margin:0;}
    .yoru-summary-desc {position:relative; z-index:1; font-size:11px; margin-top:3px; color:#685b50; opacity:1;}
    .yoru-summary-item:hover {box-shadow:0 3px 12px rgba(60,40,25,.035); border-color:#e8ded2;}
    @@media (max-width:768px) {.yoru-tables-hero {min-height:240px; padding:30px 22px;} .yoru-tables-hero-title {font-size:34px;} .yoru-hero-navigation {margin-left:22px; margin-right:22px;}}
    @@media (max-width:720px) {.yoru-summary {grid-template-columns:1fr;} .yoru-summary-item {min-height:100px;}}
    @@media (max-width:600px) {.yoru-hero-nav-buttons {width:100%;} .yoru-hero-nav-link {padding:11px 6px; font-size:11px; gap:5px;}}
    .yoru-type-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:14px; }
    .yoru-type-card { border:1px solid #e5d9c9; border-radius:12px; overflow:hidden; background:#fffdfa; display:flex; flex-direction:column; height:100%; transition:transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
    .yoru-type-card:hover {transform: translateY(-3px); border-color: #a83228; box-shadow: 0 10px 24px rgba(0, 0, 0, .12); }
    .yoru-type-card.yoru-selected {border-color: #a83228; box-shadow: 0 0 0 1px #a83228; }
    .yoru-type-card:focus-visible {outline: 3px solid #a83228; outline-offset: 3px; }
    .yoru-type-image-wrap { overflow: hidden; }
    .yoru-type-image { display: block; width:100%; height:145px; object-fit:cover; background:#eee8df; transition: transform 180ms ease; }
    .yoru-type-card:hover .yoru-type-image {transform: scale(1.03); }
    .yoru-type-body { padding:14px; display:flex; flex-direction:column; flex:1; }
    .yoru-type-title { font-weight:700; margin:0; }
    .yoru-type-meta { color:#796e62; font-size:.86rem; margin:7px 0 8px; }
    .yoru-type-spend { color:#8e2b24; font-size:.82rem; font-weight:600; margin:0 0 12px; }
    .yoru-type-actions {display:flex; flex-wrap:nowrap; align-items:center; gap:5px; width:100%; margin-top:auto;}
    .yoru-type-icon-btn {display:grid; place-items:center; flex:0 0 30px; width:30px; height:36px; padding:0; border:1px solid #daccc0; border-radius:8px; background:#fffdfa; color:#a83228; cursor:pointer;}
    .yoru-type-icon-btn:hover {background:#f5e9e2;}
    .yoru-type-icon-btn svg {width:14px; height:14px;}
    .yoru-type-icon-delete {color:#b72f25; border-color:#ead0cd;}
    .yoru-type-icon-delete:hover {background:#fce9e6;}
    .yoru-type-manage-btn {display:flex; flex:1 1 auto; align-items:center; justify-content:center; min-width:0; width:auto; gap:5px; padding:10px 6px; font-size:10px; white-space:nowrap;}
    .yoru-type-manage-btn svg {flex-shrink:0; width:13px; height:13px;}
    .yoru-type-manage-btn svg:last-child {margin-left:auto;}
    .yoru-status-select { min-width:145px; }
    .yoru-search-toolbar {display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
    .yoru-search-toolbar .form-control { flex: 1; min-width: 160px; }
    .yoru-search-toolbar .form-select { width: auto; min-width: 150px; }
    .yoru-pagination { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 12px;}
    .yoru-type-detail .modal-body {flex:1 1 auto; min-height:0; display: flex; flex-direction: column; overflow:hidden; }
    .yoru-type-detail .table-responsive {flex: 1 1 0; min-height: 0; overflow:auto;}
    .yoru-type-detail .yoru-pagination {flex-shrink: 0; margin-top: 12px; }
    .yoru-type-detail .modal-dialog { height:580px !important; min-height: 0 !important; max-height: calc(100dvh - 32px); }
    .yoru-type-detail .modal-dialog-scrollable .modal-content {height: 100%; max-height: 100%; display: flex; flex-direction: column;}
    .yoru-type-detail .modal-content { height: 100% !important; min-height: 0 !important;max-height: 100% !important; display: flex; flex-direction: column; }
    .yoru-type-detail .modal-header, .yoru-type-detail .modal-footer { flex: 0 0 auto; }
    .yoru-type-detail .yoru-search-toolbar { flex-shrink: 0;}
    .yoru-secondary-section {border: 1px solid #e5d9c9; border-radius: 12px; background: #fffdfa; padding: 20px;}
    @@media(max-width:1200px) { .yoru-type-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
    @@media(max-width:720px) { .yoru-type-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:450px) { .yoru-type-grid { grid-template-columns:1fr; } }
    @@media (prefers-reduced-motion: reduce) {.yoru-type-card, .yoru-type-image, .yoru-type-detail.collapsing {transition: none;} }

    #tableModal .yoru-advanced-field { display: none !important;}
    #tableModal.yoru-edit-mode .yoru-advanced-field { display: block !important;}
    #manageTableTypesModal #tableTypesListView th:nth-child(1) { width: 28%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(2) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(3) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(4) { width: 17%; }
    #manageTableTypesModal #tableTypesListView th:nth-child(5) { width: 21%; text-align: center;}
    #manageTableTypesModal #tableTypesListView th:last-child,
    #manageTableTypesModal #tableTypesListView td:last-child {
        text-align: center;
        white-space: nowrap;
    }
    html {scroll-behavior: smooth;}
    #tables-section, #dining-areas-section, #opening-hours-section {scroll-margin-top: 0;}
    @@media (prefers-reduced-motion: reduce) {html {scroll-behavior: auto;}}
    .yoru-back-to-top {position: fixed; bottom: 60px; right: 30px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #c43b2b; color: #fff; border: 1px solid #a83228; border-radius: 50%; cursor: pointer; z-index: 1050; opacity: 0; visibility: hidden; transform: translateY(15px); transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease, background 0.3s ease; box-shadow: 0 6px 20px rgba(0,0,0,0.2);}
    .yoru-back-to-top.show {opacity: 1; visibility: visible; transform: translateY(0);}
    .yoru-back-to-top:hover {background: #a83228; transform: translateY(-5px);}
    .yoru-back-to-top svg {width: 22px; height: 22px; stroke-width: 2;}
    @@media (max-width: 768px) {.yoru-back-to-top {bottom: 20px; right: 20px; width: 42px; height: 42px;}}
    @@media (prefers-reduced-motion: reduce) {.yoru-back-to-top {transition: none;}}

    .yoru-luxury-card {height:100%; background:#fffdfa; border:1px solid #e7d9cc; border-radius:18px; padding:25px; box-shadow:0 5px 18px rgba(54,34,26,.035);}
    .yoru-luxury-head {display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;}
    .yoru-luxury-eyebrow {font-size:10px; font-weight:700; letter-spacing:2px; color:#a83228; margin-bottom:5px;}
    .yoru-luxury-title {font-family:Georgia,serif; font-size:26px; font-weight:500; color:#30231d; margin:0;}
    .yoru-luxury-subtitle {color:#89776d; font-size:12px; margin:5px 0 0;}
    .yoru-luxury-btn {display:inline-flex; align-items:center; justify-content:center; gap:7px; background:#a83228; color:#fff; border:1px solid #a83228; border-radius:9px; padding:10px 13px; font-size:12px; font-weight:600; transition:background .2s ease;}
    .yoru-luxury-btn:hover {background:#8e281f; color:#fff; transform:none; box-shadow:none;}     
    /* Unified Red Buttons */
    .yoru-luxury-btn,.yoru-type-manage-btn {display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:44px; padding:10px 15px; border:1px solid #b72f25; border-radius:9px; background:#b72f25; color:#fff; font-size:14px; font-weight:600; cursor:pointer; transition:background .2s ease,border-color .2s ease;}
    .yoru-luxury-btn:hover,.yoru-type-manage-btn:hover {background:#92271f; border-color:#92271f; color:#fff;}
    .yoru-luxury-btn svg,.yoru-type-manage-btn svg {width:15px; height:15px; flex-shrink:0;}
    .yoru-type-manage-btn {flex:1 1 auto; min-width:0; padding:10px 9px; white-space:nowrap;}
    .yoru-luxury-btn svg {width:15px; height:15px;}
    .yoru-luxury-btn.secondary {background:#fffdfa; color:#715b51; border-color:#daccc0;}
    .yoru-luxury-btn.secondary:hover {background:#f4e9e2;}
    .yoru-area-list {display:grid; gap:11px;}
    .yoru-area-item {display:flex; align-items:center; gap:12px; padding:13px; border:1px solid #eee3db; border-radius:12px; background:#fbf8f5; transition:transform .24s ease,background .24s ease,border-color .24s ease,box-shadow .24s ease;}
    .yoru-area-item:hover {transform:translateY(-3px); background:#fff; border-color:#cfaa99; box-shadow:0 10px 24px rgba(67,40,30,.09);}
    .yoru-area-icon {display:grid; place-items:center; width:52px; height:52px; flex-shrink:0; background:#f3e5df; color:#a83228; border-radius:12px; transition:transform .28s ease,background .28s ease;}
    .yoru-area-icon svg {width:23px; height:23px;}
    .yoru-area-item:hover .yoru-area-icon {transform:scale(1.09) rotate(-5deg); background:#ecd5cb;}
    .yoru-area-info {flex:1; min-width:0;}
    .yoru-area-name {font-weight:700; color:#382821; font-size:14px;}
    .yoru-area-desc {color:#8b7c72; font-size:12px; margin:3px 0 0; overflow-wrap:anywhere;}
    .yoru-area-count {white-space:nowrap; color:#765b4b; background:#f2e8e0; border-radius:25px; padding:6px 9px; font-size:11px;}
    .yoru-area-actions {display:flex; gap:5px;}
    .yoru-area-action {display:grid; place-items:center; width:38px; height:38px; border:1px solid transparent; background:transparent; color:#7c6d64; border-radius:8px; transition:background .2s ease,color .2s ease,transform .2s ease;}
    .yoru-area-action:hover {background:#f1e0d7; color:#a83228; transform:translateY(-2px);}
    .yoru-area-action.delete:hover {background:#fce4e1; color:#ba3225;}
    .yoru-area-action svg {width:19px; height:19px;}
    .yoru-area-empty {text-align:center; padding:35px 12px; color:#8b7c72; font-size:13px;}
    .yoru-hours-summary {display:flex; align-items:center; gap:12px; background:#f5ebe2; color:#594337; border-radius:12px; padding:14px; margin-bottom:14px;}
    .yoru-hours-summary svg {width:23px; height:23px; color:#a83228;}
    .yoru-hours-summary strong {display:block; font-size:13px;}
    .yoru-hours-summary span {display:block; color:#826c5f; font-size:12px; margin-top:2px;}
    .yoru-hours-list {display:grid; gap:8px;}
    .yoru-hours-row {display:grid; grid-template-columns:minmax(95px,1fr) minmax(190px,1.8fr) minmax(70px,.7fr); align-items:center; gap:10px; background:#fbf8f5; border:1px solid #eee6df; border-radius:10px; padding:12px; transition:transform .24s ease,background .24s ease,box-shadow .24s ease,border-color .24s ease;}
    .yoru-hours-row:hover {transform:translateY(-2px); background:#fff; border-color:#d8b7a7; box-shadow:0 7px 18px rgba(65,40,29,.07);}
    .yoru-hours-day {font-size:13px; font-weight:700; color:#382b25;}
    .yoru-hours-time-group {display:flex; justify-content:center; align-items:center; gap:12px; min-width:0;}
    .yoru-hours-time {display:flex; flex-direction:column; align-items:center; text-align:center; gap:2px; min-width:0;}
