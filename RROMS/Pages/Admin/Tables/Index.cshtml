<div id="yoruTypeWorkspace" class="yoru-type-workspace">
    <div class="card mb-4 yoru-tab-panel" id="tables-section" role="tabpanel" aria-label="Table Types">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h5 mb-1">Table types</h2>
                    <p class="text-muted mb-0"> Select a table type to manage individual tables and their status.</p>
                </div>

                <div class="d-flex gap-2 flex-wrap">             
                    <button type="button"
                            class="yoru-luxury-btn"
                            id="openAddTableTypeDrawer">
                        <i data-lucide="plus"></i>
                        Add Table Type
                    </button>

                    <button type="button"
                            class="yoru-luxury-btn"
                            id="openAddTableDrawer">
                        <i data-lucide="plus"></i>
                        Add table
                    </button>
                </div>

            </div>

<!-- Table Types Search & Filters -->
<div class="yoru-type-toolbar">

    <div class="yoru-type-search">
        <i data-lucide="search"></i>
        <input type="search"
               id="tableTypeSearch"
               placeholder="Search table types or table names..."
               aria-label="Search table types or table names" />
    </div>

    <select id="tableTypeStatusFilter"
            class="yoru-type-filter"
            aria-label="Filter by status">
        <option value="all">All Status</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
    </select>

    <select id="tableTypeAreaFilter"
            class="yoru-type-filter"
            aria-label="Filter by dining area">
        <option value="all">All Dining Areas</option>
        @foreach (var area in Model.Areas)
        {
            <option value="@area.Id">@area.Name</option>
        }
    </select>

    <button type="button" id="clearTableTypeFilters"
            class="yoru-clear-filters-btn">
        <i data-lucide="rotate-ccw"></i>
        Clear Filters
    </button>

</div>

<p id="tableTypeSearchCount" class="yoru-type-result-count"
   role="status" aria-live="polite"></p>
   

<div id="tableTypeNoResults" class="yoru-type-no-results" hidden>
    <i data-lucide="search-x"></i>
    <p>No matching table types found.</p>
</div>
        

<div class="yoru-type-grid">
    @foreach (var type in Model.TableTypes)
    {
        var tables = Model.AllTables
            .Where(t => t.TableTypeDefinitionId == type.Id)
            .ToList();

        var imagePath = type.PhotoPath;

        var sectionId = $"tables-type-{type.Id}";

        var isRoom = type.Name.Contains("room", StringComparison.OrdinalIgnoreCase);                

        var unit = isRoom
            ? (tables.Count == 1 ? "room" : "rooms")
            : (tables.Count == 1 ? "table" : "tables");

        var guestText = tables.Count == 0
            ? $"{type.DefaultMinGuests}–{type.DefaultMaxGuests} guests"
            : tables.Min(t => t.MinGuests) == tables.Max(t => t.Capacity)
                ? $"{tables.Min(t => t.MinGuests)} guest"
                : $"{tables.Min(t => t.MinGuests)}–{tables.Max(t => t.Capacity)} guests";

        
        
            <div class="yoru-type-card @(type.IsActive ? "" : "yoru-type-inactive")"
                 data-type-name="@type.Name"
                 data-table-names="@string.Join(" ", tables.Select(t => t.TableNumber))"
                 data-type-status="@(type.IsActive ? "active" : "inactive")"
                 data-area-id="@type.DefaultDiningAreaId">


            <div class="yoru-type-image-wrap">
                @if (string.IsNullOrWhiteSpace(imagePath))
                {
                    <div class="yoru-type-image yoru-no-photo">
                        <i data-lucide="image-off"></i>
                        <span>No photo</span>
                    </div>
                }
                else
                {
                    <img class="yoru-type-image"
                            src="@imagePath"
                            alt="@type.Name" />
                }

                
                @if (type.IsActive && tables.Any() && !tables.Any(t => t.Status == TableStatus.Available))
                {
                    <span class="yoru-type-badge yoru-type-badge-warn" title="Every table of this type is occupied, reserved or out of service right now.">
                        <span class="yoru-type-badge-text">No tables available</span>
                    </span>
                }

                <span class="yoru-type-badge @(type.IsActive ? "is-active" : "is-inactive")">
                    <span class="yoru-type-badge-text">
                        @(type.IsActive ? "Active" : "Inactive")
                    </span>
                </span>
            </div>

            <div class="yoru-type-body">

                <h3 class="yoru-type-title">@type.Name</h3>

                <div class="yoru-type-details">
                    <div>
                        <i data-lucide="armchair"></i>
                        <span>@tables.Count @unit</span>
                    </div>

                    <div>
                        <i data-lucide="@(string.IsNullOrWhiteSpace(type.DefaultDiningArea?.IconName) ? "map-pin" : type.DefaultDiningArea!.IconName)"></i>
                        <span>
                            @(type.DefaultDiningArea?.Name ?? "Not assigned")
                        </span>
                    </div>

                    <div>
                        <i data-lucide="users"></i>
                        <span>
                            @type.DefaultMinGuests–@type.DefaultMaxGuests guests
                        </span>
                    </div>

                    <div>
                        <i data-lucide="wallet"></i>
                        <span>
                            @(type.DefaultMinimumSpend.GetValueOrDefault() > 0
                                ? "Min. " + TableTypeInfo.Rm(type.DefaultMinimumSpend.GetValueOrDefault())
                                : "No minimum spend")
                        </span>
                    </div>
                </div>

                <button type="button"
                        class="yoru-type-view-details"
                        data-type-details
                        data-count="@tables.Count"
                        data-area-name="@(type.DefaultDiningArea?.Name ?? "Not assigned")"
                        aria-haspopup="dialog">
                    View more details
                    <span aria-hidden="true">↗</span>
                </button>
                <div class="yoru-type-actions">

                    <!-- Edit Icon -->
                    <button type="button"
                            class="yoru-type-icon-btn yoru-edit-type"
                            title="Edit Type"
                            aria-label="Edit @type.Name"
                            data-id="@type.Id"
                            data-name="@type.Name"
                            data-prefix="@type.Code"
                            data-padding="@type.NumberPadding"
                            data-area="@type.DefaultDiningAreaId"
                            data-min="@type.DefaultMinGuests"
                            data-max="@type.DefaultMaxGuests"
                            data-allow-below="@type.AllowBelowMinGuests.ToString().ToLowerInvariant()"
                            data-spend="@(type.DefaultMinimumSpend?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-desc="@type.Description"
                            data-active="@type.IsActive.ToString().ToLowerInvariant()"
                                        data-photo="@(type.PhotoPath ?? "")"
                                        data-icon="@(type.DefaultDiningArea?.IconName ?? "")">
                        <i data-lucide="pencil"></i>
                    </button>

                    <!-- Delete Icon -->
                    <button type="button"
                            class="yoru-type-icon-btn yoru-type-icon-delete"
                            title="Delete Type"
                            aria-label="Delete @type.Name"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteTableTypeModal"
                            data-id="@type.Id"
                            data-name="@type.Name"
                            data-has-tables="@tables.Any().ToString().ToLowerInvariant()">
                        <i data-lucide="trash-2"></i>
                    </button>

                    <!-- Manage Tables / Rooms -->
                    <button type="button"
                            class="yoru-type-manage-btn"
                            data-manage-panel="modal-@(sectionId)"
                            aria-expanded="false"
                            aria-controls="modal-@(sectionId)">
                        <i data-lucide="settings-2"></i>
                        @(isRoom ? "Manage Rooms" : "Manage Tables")
                        <i data-lucide="arrow-right"></i>
                    </button>

                </div>


            </div>
        </div>

    }
</div>


<div id="tableTypePagination" class="yoru-pagination" hidden>
    <span id="tableTypePageInfo" class="text-muted"></span>
    <div class="d-flex gap-2">
        <button type="button" id="tableTypeShowAll" class="btn btn-outline-secondary btn-sm" aria-pressed="false">Show all</button>
        <button type="button" id="tableTypePrevPage" class="btn btn-outline-secondary btn-sm">Previous</button>
        <button type="button" id="tableTypeNextPage" class="btn btn-outline-secondary btn-sm">Next</button>
    </div>
</div>

    <div id="tableTypeAccordion">
        @foreach (var type in Model.TableTypes)
        {
            var tables = Model.AllTables.Where(t => t.TableTypeDefinitionId == type.Id).ToList();
            var isRoom = type.Name.Contains("room", StringComparison.OrdinalIgnoreCase);
            <section class="yoru-type-detail yoru-inline-table-panel" id="modal-tables-type-@(type.Id)" hidden>
                <div class="yoru-inline-table-content">
                    <div class="yoru-inline-table-header">
                        <h5 class="modal-title">@type.Name — Manage Tables </h5>
                        <button type="button" class="yoru-inline-close" aria-label="Close"><i data-lucide="x"></i></button>                        
                    </div>
                        <div class="yoru-inline-table-body">
                        <div class="yoru-search-toolbar"> <input type="search" class="form-control yoru-table-search" placeholder="Search table name..." aria-label="Search tables" />
                            <select class="form-select yoru-table-status-filter" aria-label="Filter table status"> 
                                <option value="">All statuses</option>
                                    
                                @foreach (var status in Enum.GetValues<TableStatus>())
                                {<option value="@status"> @(status == TableStatus.OutOfService ? "Out of service" : status.ToString()) </option>}
                            </select>

                            <button type="button"
                                    class="btn btn-outline-danger yoru-delete-all-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteAllTablesModal"
                                    data-type-id="@type.Id"
                                    data-type-name="@type.Name"
                                    data-count="@tables.Count"
                                    @(tables.Any() ? "" : "disabled")>
                                <i data-lucide="trash-2"></i> Delete all
                            </button>

                        </div>

                        <div class="table-responsive">                         
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Table / Description</th>
                                        <th>Dining Area</th>
                                        <th>Min Guests</th>
                                        <th>Capacity</th>
                                        <th>Minimum Spend</th>
                                        <th>Live Status</th>
                                        <th class="text-center">Edit</th>
                                        <th class="text-center">Delete</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in tables)
                                    {
                                        <tr class="yoru-table-row"
                                            data-name="@t.TableNumber"
                                            data-status="@t.Status"
                                            data-active="@t.IsActive.ToString().ToLowerInvariant()">

                                            <td class="yoru-table-name-cell">
                                                <strong>@t.TableNumber</strong>

                                                <p class="yoru-table-description">
                                                    @(string.IsNullOrWhiteSpace(t.Description)
                                                        ? "No description."
                                                        : t.Description)
                                                </p>
                                            </td>

                                            <td>
                                                @(Model.Areas.FirstOrDefault(a => a.Id == t.DiningAreaId)?.Name
                                                    ?? "Not assigned")
                                            </td>

                                            <td>@t.MinGuests</td>

                                            <td>@t.Capacity</td>

                                            <td class="text-nowrap">
                                                @(t.MinimumSpend > 0
                                                    ? TableTypeInfo.Rm(t.MinimumSpend)
                                                    : "None")
                                            </td>

                                            <td>
                                                <span class="yoru-table-status-badge"
                                                      data-status="@t.Status">
                                                    @(t.Status == TableStatus.OutOfService
                                                        ? "Out of service"
                                                        : t.Status.ToString())
                                                </span>
                                            </td>

                                            <td class="text-center">
                                                <button type="button"
                                                        class="yoru-table-action-btn yoru-open-edit-table"
                                                        title="Edit Table"
                                                        aria-label="Edit @t.TableNumber"
                                                        data-id="@t.Id"
                                                        data-number="@t.TableNumber"
                                                        data-type="@((int)t.Type)"
                                                        data-dynamic-type="@t.TableTypeDefinitionId"
                                                        data-area="@t.DiningAreaId"
                                                        data-status="@t.Status"
                                                        data-min="@t.MinGuests"
                                                        data-max="@t.Capacity"
                                                        data-spend="@t.MinimumSpend.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                        data-desc="@t.Description"
                                                        data-active="@t.IsActive.ToString().ToLowerInvariant()">
                                                    <i data-lucide="pencil"></i>
                                                </button>
                                            </td>

                                            <td class="text-center">
                                                <button type="button"
                                                        class="yoru-table-action-btn yoru-table-action-delete"
                                                        title="Delete Table"
                                                        aria-label="Delete @t.TableNumber"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteTableModal"
                                                        data-id="@t.Id"
                                                        data-number="@t.TableNumber"
                                                        data-kind="@(isRoom ? "room" : "table")">
                                                    <i data-lucide="trash-2"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }

                                    @if (!tables.Any())
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted">
                                                No tables of this type yet.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            </div>
                            <div class="yoru-pagination"> <small class="text-muted yoru-page-info"></small>
                                <div class="btn-group" role="group"> <button type="button" class="btn btn-outline-secondary btn-sm yoru-prev"> Previous</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm yoru-next"> Next </button>
                                </div>
                            </div>
                        </div>
                        <div class="yoru-inline-table-footer">
                            <button type="button" class="btn btn-outline-secondary yoru-inline-close">Close</button>
                        </div>
                 </div>
            </section>
            }
        </div>
    </div>
</div>

<!-- Table Type Drawer -->
<aside id="yoruTypeDrawer"
       class="yoru-type-drawer"
       role="dialog"
       aria-labelledby="yoruTypeDrawerTitle"
       aria-hidden="true"
       tabindex="-1">

    <div class="yoru-type-drawer-header">
        <div>
            <div class="yoru-type-drawer-eyebrow">
                YORU IZAKAYA · TABLE MANAGEMENT
            </div>
            <h2 id="yoruTypeDrawerTitle">Add Table Type</h2>
            <p>Configure your restaurant seating experience.</p>
        </div>

        <button type="button"
                id="yoruTypeDrawerClose"
                class="yoru-type-drawer-close"
                aria-label="Close drawer">
            <i data-lucide="x"></i>
        </button>
    </div>


<div id="yoruTypeDrawerBody" class="yoru-type-drawer-body">
    <div id="tableTypeFormView">
        <h3 class="h6 mb-3" id="tableTypeFormTitle">
            Add New Table Type
        </h3>

        <form id="tableTypeForm"
              method="post"
              asp-page-handler="SaveTableType"
              enctype="multipart/form-data">
              <div id="tableTypeSaveError"
                 class="alert alert-danger py-2"
                 role="alert"
                 hidden>
            </div>

            <input type="hidden" asp-for="TableTypeForm.Id" />

                    <div class="row g-3 yoru-type-form-grid">

                        <div class="col-12 yoru-form-section"><span>Basic info</span></div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.Name" class="form-label">
                                Type Name
                            </label>
                            <input asp-for="TableTypeForm.Name"
                                   class="form-control"
                                   maxlength="50"
                                   required />
                        </div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.NumberPadding"
                                   class="form-label">
                                Number Padding
                            </label>

                            <select asp-for="TableTypeForm.NumberPadding"
                                    class="form-select"
                                    required>
                                <option value="1">1 Digit — 1</option>
                                <option value="2">2 Digits — 01</option>
                                <option value="3">3 Digits — 001</option>
                                <option value="4">4 Digits — 0001</option>
                            </select>

                            <small class="text-muted">
                                The table code is generated automatically.
                                Example: CS001.
                            </small>
                        </div>

                        <div class="col-12">
                            <div class="yoru-active-row">
                                <div>
                                    <div class="yoru-active-title">Active</div>
                                    <small class="text-muted">
                                        Inactive table types cannot be booked.
                                    </small>
                                </div>
                                <div class="form-check form-switch yoru-switch m-0">
                                    <input asp-for="TableTypeForm.IsActive"
                                           role="switch"
                                           aria-label="Active"
                                           class="form-check-input" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 yoru-form-section"><span>Seating &amp; pricing</span></div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.DefaultDiningAreaId"
                                   class="form-label">
                                Dining Area
                            </label>
                            <select asp-for="TableTypeForm.DefaultDiningAreaId"
                                    asp-items="@(new SelectList(Model.Areas, "Id", "Name"))"
                                    class="form-select"
                                    required>
                                <option value="">Choose an area...</option>
                            </select>
                        </div>

                        <div class="col-6">
                            <label asp-for="TableTypeForm.DefaultMinGuests" class="form-label">
                                Min Guests
                            </label>
                            <input asp-for="TableTypeForm.DefaultMinGuests"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-6">
                            <label asp-for="TableTypeForm.DefaultMaxGuests"
                                   class="form-label"
                                   title="Default maximum number of guests per table">
                                Capacity
                            </label>
                            <input asp-for="TableTypeForm.DefaultMaxGuests"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control"
                                   required />

                            <div id="tableTypeCapacityError"
                                 class="text-danger small mt-1"
                                 aria-live="polite"
                                 hidden>
                                Capacity must be at least the minimum guests.
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.DefaultMinimumSpend"
                                   class="form-label">
                                Minimum Spend (RM)
                            </label>
                            <input asp-for="TableTypeForm.DefaultMinimumSpend"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Optional" />
                            <div class="form-text">Leave blank for no minimum spend.</div>
                        </div>

                        <div class="col-12">
                            <div class="yoru-active-row">
                                <div>
                                    <div class="yoru-active-title">Allow smaller parties</div>
                                    <small class="text-muted">
                                        Off: customers with fewer guests than Min Guests cannot book this type.
                                        On: they can, but must accept the minimum spend.
                                    </small>
                                </div>
                                <div class="form-check form-switch yoru-switch m-0">
                                    <input asp-for="TableTypeForm.AllowBelowMinGuests"
                                           role="switch"
                                           aria-label="Allow smaller parties"
                                           class="form-check-input" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 yoru-form-section"><span>Description &amp; photo</span></div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.Description"
                                   class="form-label">
                                Description (optional)
                            </label>
                            <textarea asp-for="TableTypeForm.Description"
                                      class="form-control"
                                      rows="2"
                                      maxlength="300"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="TableTypeForm.Photo" class="form-label">
                                Table Type Photo (Optional)
                            </label>
                            <input asp-for="TableTypeForm.Photo"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   id="tableTypePhotoInput" />

                            <div class="form-text">
                                JPG, PNG or WEBP. Maximum 3 MB.
                                Leave empty to keep the existing photo.
                            </div>

                        <div class="yoru-photo-row">
                            <button type="button"
                                    class="yoru-photo-preview-button mt-2"
                                    id="tableTypePhotoZoomButton"
                                    aria-label="Enlarge table type photo">
                                <img id="tableTypePhotoPreview"
                                     src=""
                                     alt="Table type photo preview"
                                     hidden />
                                <div class="yoru-no-photo" id="tableTypeNoPhoto">
                                    <i data-lucide="image-off"></i>
                                    <span>No photo</span>
                                </div>

                                <span id="tableTypePhotoHint">Click to enlarge</span>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="tableTypeRemovePhoto"
                                    hidden>
                                Remove photo
                            </button>
                        </div>
                            <input type="hidden"
                                   name="TableTypeForm.RemoveTypePhoto"
                                   id="removeTypePhotoFlag"
                                   value="false" />
                        </div>

                        <div class="col-12" id="createFirstTableSection">
                            <div class="yoru-first-table-box">
                                <div class="form-check">
                                    <input asp-for="TableTypeForm.CreateFirstTable"
                                           class="form-check-input" />

                                    <label asp-for="TableTypeForm.CreateFirstTable"
                                           class="form-check-label">
                                        Create the first table automatically
                                    </label>
                                </div>

                                <small class="text-muted">
                                    The system will generate the first available
                                    table number using this table type's code.
                                </small>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>


<div id="yoruTypeDrawerFooter" class="yoru-type-drawer-footer">
    <button type="button"
            id="yoruTypeDrawerCancel"
            class="yoru-type-drawer-cancel">
        Cancel
    </button>
    <button type="submit"
            form="tableTypeForm"
            class="yoru-type-drawer-save"
            id="saveTableTypeBtn">
        <i data-lucide="save"></i>
        Save Table Type
    </button>
</div>
</aside>
    <aside id="tableModal" class="yoru-table-drawer" tabindex="-1" aria-label="Table editor" aria-hidden="true">
        <form id="tableForm" method="post" asp-page-handler="SaveTable" class="yoru-table-drawer-form">
            <div class="yoru-table-drawer-header">
                <h2 class="modal-title h5" id="tableTitle">Add New Table</h2>
                <button type="button" class="btn-close" data-close-table-drawer aria-label="Close"></button>
            </div>

            <div class="yoru-table-drawer-body row g-3">

                <div id="tableSaveError"
                     class="alert alert-danger py-2 mb-0"
                     role="alert"
                     hidden>
                </div>

                <input type="hidden" asp-for="TableForm.Id" />

                <div class="col-12">
                    <label asp-for="TableForm.TableTypeDefinitionId"
                           class="form-label">
                        Table Type
                    </label>

                    <select asp-for="TableForm.TableTypeDefinitionId"
                            class="form-select"
                            required>

                        <option value="">Choose a table type...</option>

                        @foreach (var type in Model.TableTypes)
                        {
                            <option value="@type.Id"
                                    disabled="@(!type.IsActive)"
                                    data-inactive="@(!type.IsActive).ToString().ToLowerInvariant()"
                                    data-prefix="@type.Code"
                                    data-padding="@type.NumberPadding"
                                    data-area="@type.DefaultDiningAreaId"
                                    data-area-name="@(type.DefaultDiningArea?.Name ?? "Not assigned")"
                                    data-photo="@(type.PhotoPath ?? "")"
                                    data-min="@type.DefaultMinGuests"
                                    data-max="@type.DefaultMaxGuests"
                                    data-spend="@(type.DefaultMinimumSpend?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                @type.Name @(type.IsActive ? "" : "(Inactive)")
                            </option>
                        }
                    </select>

                    <input type="hidden" asp-for="TableForm.Type" />
                </div>

                <div class="col-12">
                    <label class="form-label">Table Number</label>

                    <div class="input-group">
                        <span class="input-group-text"
                              id="tableCodePrefix">
                            ---
                        </span>

                        <input type="text"
                               id="tableNumberDigits"
                               class="form-control"
                               inputmode="numeric"
                               pattern="[0-9]+"
                               placeholder="001"
                               required />
                    </div>

                    <input asp-for="TableForm.TableNumber"
                           type="hidden" />

                    <small class="text-muted">
                        The table type code is fixed.
                        Only the numeric part can be changed.
                    </small>

                    <div id="tableNumberError"
                         class="text-danger small mt-1"
                         hidden>
                    </div>
                </div>

                <input type="hidden" asp-for="TableForm.DiningAreaId" />
                <input type="hidden" asp-for="TableForm.MinGuests" />
                <input type="hidden" asp-for="TableForm.Capacity" />
                <input type="hidden" asp-for="TableForm.MinimumSpend" />
                <input type="hidden" asp-for="TableForm.Description" />
                <input type="hidden" asp-for="TableForm.IsActive" />

                <div class="col-12 yoru-edit-status-field">
                    <label asp-for="TableForm.Status" class="form-label">Table Status</label>
                    <select asp-for="TableForm.Status"
                            asp-items="Html.GetEnumSelectList<TableStatus>()"
                            class="form-select">
                    </select>
                    <small class="text-muted">Update this table's current status.</small>
                </div>

                <div class="col-12" id="tableTypeSummary">
                    <div class="yoru-table-summary is-empty" id="yoruTableSummaryBox">
                        <div class="yoru-table-summary-empty">
                            <img src="~/images/decorations/sakura.png" alt="" aria-hidden="true" />
                            <i data-lucide="armchair"></i>
                            <strong>Pick a table type</strong>
                            <span>Its photo, dining area, guest range and minimum spend will appear here.</span>
                        </div>
                    <div class="yoru-table-summary-photo">
                        <img id="tableSummaryPhoto" alt="" hidden />
                            <div class="yoru-no-photo" id="tableSummaryNoPhoto">
                                <i data-lucide="image-off"></i><span>No photo</span>
                            </div>
                            <span class="yoru-table-summary-code" id="tableSummaryCode"></span>
                        </div>
                        <dl class="yoru-table-summary-list">
                            <div><dt>Dining area</dt><dd id="tableSummaryArea">-</dd></div>
                            <div><dt>Guests</dt><dd id="tableSummaryGuests">-</dd></div>
                            <div><dt>Minimum spend</dt><dd id="tableSummarySpend">-</dd></div>
                        </dl>
                        <p class="yoru-table-summary-note">
                            These details come from the table type.
                            Edit the table type to change them.
                        </p>
                    </div>
                </div>

            </div>
            <div class="yoru-table-drawer-footer">
                <button type="button" class="btn btn-outline-secondary" data-close-table-drawer>Cancel</button>
                <button type="submit" class="btn btn-primary"> Save table </button>
            </div>
        </form>
    </aside>
</div>
<div class="yoru-area-workspace" id="yoruAreaWorkspace">
    <section class="yoru-tab-panel mb-4" id="dining-areas-section"
             role="tabpanel" aria-label="Dining Areas" hidden>

        <div class="yoru-luxury-card">

            <div class="yoru-luxury-head">
                <div>
                    <div class="yoru-luxury-eyebrow">THE DINING COLLECTION</div>
                    <h2 class="yoru-luxury-title">Dining Areas</h2>
                    <p class="yoru-luxury-subtitle">
                        Curate every corner of the YORU experience.
                    </p>
                </div>

                <button type="button" class="yoru-luxury-btn"
                        data-area-drawer-open="true">
                    <i data-lucide="plus"></i> Add Area
                </button>
            </div>

            <div class="yoru-area-toolbar">
                <div class="yoru-area-search">
                    <i data-lucide="search"></i>
                    <input type="search" id="yoruAreaSearch"
                           placeholder="Search dining areas..."
                           aria-label="Search dining areas" />
                </div>

                <select id="yoruAreaStatusFilter"
                        class="yoru-area-filter"
                        aria-label="Filter dining area status">
                    <option value="all">All statuses</option>
                    <option value="available">Available</option>
                    <option value="occupied">Occupied</option>
                    <option value="no-tables">No Tables</option>
                </select>

                <button type="button" id="yoruAreaClear"
                        class="yoru-clear-filters-btn">
                    <i data-lucide="rotate-ccw"></i> Clear
                </button>
            </div>

            <p class="yoru-type-result-count" id="yoruAreaResultCount"
               aria-live="polite"></p>

            <div class="yoru-area-card-grid" id="yoruAreaCardGrid">
                @foreach (var a in Model.Areas)
                {
                    var hasAvailable = a.Tables.Any(t =>
                        t.Status == TableStatus.Available);

                    // Occupied switch wins; otherwise Available when at
                    // least one table can take guests.
                    var areaStatus = a.IsOccupied
                        ? "occupied"
                        : a.Tables.Count == 0
                            ? "no-tables"
                            : hasAvailable ? "available" : "occupied";

                    var statusText = areaStatus == "available"
                        ? "Available"
                        : areaStatus == "occupied" ? "Occupied" : "No Tables";

                    var areaName = (a.Name ?? "").ToLowerInvariant();
                    var autoIcon =
                        areaName.Contains("bar") || areaName.Contains("counter") ? "wine" :
                        areaName.Contains("private") || areaName.Contains("vip") || areaName.Contains("room") ? "door-closed" :
                        areaName.Contains("outdoor") || areaName.Contains("garden") || areaName.Contains("terrace") ? "trees" :
                        areaName.Contains("roof") ? "sunset" :
                        areaName.Contains("cafe") || areaName.Contains("coffee") ? "coffee" :
                        areaName.Contains("lounge") ? "sofa" :
                        areaName.Contains("hall") || areaName.Contains("dining") ? "utensils-crossed" :
                        "layout-grid";

                    var iconName = string.IsNullOrWhiteSpace(a.IconName)
                        ? autoIcon : a.IconName;

                    var tableTypes = Model.TableTypes
                        .Where(type => type.DefaultDiningAreaId == a.Id)
                        .Select(type => type.Name)
                        .Concat(
                            a.Tables.Select(t =>
                                t.TableTypeDefinition?.Name ?? t.Type.ToString())
                        )
                        .Where(name => !string.IsNullOrWhiteSpace(name))
                        .Distinct()
                        .OrderBy(name => name)
                        .ToList();

                    <article class="yoru-area-card"
                             data-area-name="@a.Name"
                             data-area-status="@areaStatus">

                        <div class="yoru-area-card-top">
                            <div class="yoru-area-icon">
                                <i data-lucide="@iconName"></i>
                            </div>

                            <span class="yoru-area-status @areaStatus">
                                @statusText
                            </span>
                        </div>

                        <h3 class="yoru-area-card-title">@a.Name</h3>

                        <p class="yoru-area-card-description">
                            @(string.IsNullOrWhiteSpace(a.Description)
                                ? "No description provided."
                                : a.Description)
                        </p>

                        <div class="yoru-area-card-meta">
                            <span>
                                <i data-lucide="armchair"></i>
                                @a.Tables.Count Tables
                            </span>
                            <span>
                                <i data-lucide="layers-3"></i>
                                @tableTypes.Count Types
                            </span>
                        </div>

                        <div class="yoru-area-card-types">
                            <div class="yoru-area-card-label">TABLE TYPES</div>

                            <div class="yoru-area-type-tags">
                                @if (tableTypes.Any())
                                {
                                    @foreach (var typeName in tableTypes)
                                    {
                                        <span class="yoru-area-type-tag">@typeName</span>
                                    }
                                }
                                else
                                {
                                    <span class="yoru-area-no-types">No table types yet</span>
                                }
                            </div>
                        </div>

                        <div class="yoru-area-card-footer">
                            <span class="yoru-area-mode"
                                  title="@(a.IsOccupied
                                      ? "Marked as Occupied: all tables are out of service."
                                      : "Tables in this area follow their own status.")">
                                <i data-lucide="@(a.IsOccupied ? "ban" : "check-circle-2")"></i>
                                @(a.IsOccupied ? "Occupied (closed)" : "Open")
                            </span>

                            <div class="yoru-area-actions">
                                <button type="button"
                                        class="yoru-area-action"
                                        title="Edit area"
                                        aria-label="Edit @a.Name"
                                        data-area-drawer-open="true"
                                        data-id="@a.Id"
                                        data-name="@a.Name"
                                        data-desc="@a.Description"
                                        data-icon="@iconName"
                                        data-manual-status="@(a.IsOccupied ? "Occupied" : "Available")">
                                    <i data-lucide="pencil"></i>
                                </button>

                                <button type="button"
                                        class="yoru-area-action delete"
                                        title="Delete area"
                                        aria-label="Delete @a.Name"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteAreaModal"
                                        data-id="@a.Id"
                                        data-name="@a.Name"
                                        data-has-tables="@(a.Tables.Any() ? "true" : "false")">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="yoru-area-no-results" id="yoruAreaNoResults" hidden>
                <i data-lucide="search-x"></i>
                <p>No dining areas found.</p>
            </div>

            <div class="yoru-area-pagination" id="yoruAreaPagination" hidden>
                <span id="yoruAreaPageInfo"></span>
                <div class="yoru-area-page-buttons">
                    <button type="button" id="yoruAreaShowAll" aria-pressed="false">Show all</button>
                    <button type="button" id="yoruAreaPrev">Previous</button>
                    <button type="button" id="yoruAreaNext">Next</button>
                </div>
            </div>

        </div>
    </section>

    <!-- Dining Area Add/Edit Drawer -->
    <div class="yoru-area-drawer-overlay" id="yoruAreaDrawerOverlay" hidden>
        <div class="yoru-area-drawer-backdrop" data-area-drawer-close="true"></div>

        <aside class="yoru-area-drawer" id="areaModal"
               role="dialog" aria-modal="true"
               aria-labelledby="areaTitle" tabindex="-1">

            <form method="post" asp-page-handler="SaveArea"
                  class="yoru-area-drawer-form">

                <div class="yoru-area-drawer-header">
                    <div>
                        <div class="yoru-luxury-eyebrow">THE DINING COLLECTION</div>
                        <h2 id="areaTitle">Add Dining Area</h2>
                    </div>
                    <button type="button" class="yoru-type-drawer-close"
                            data-area-drawer-close="true" aria-label="Close">
                        <i data-lucide="x"></i>
                    </button>
                </div>

                <div class="yoru-area-drawer-body">
                    <input type="hidden" asp-for="AreaForm.Id" />

                    <div class="mb-3">
                        <label asp-for="AreaForm.Name" class="form-label">Name</label>
                        <input asp-for="AreaForm.Name" class="form-control"
                               required maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AreaForm.Description" class="form-label">
                            Description (optional)
                        </label>
                        <textarea asp-for="AreaForm.Description"
                                  class="form-control" maxlength="200"
                                  rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Area Icon</label>
                        <input type="hidden" name="AreaForm.IconName"
                               id="yoruAreaIconName" value="layout-grid" />

                        <div class="yoru-icon-picker" id="yoruIconPicker">
                            @foreach (var option in new[] {
                                ("wine", "Bar"),
                                ("utensils-crossed", "Dining"),
                                ("door-closed", "Private"),
                                ("trees", "Outdoor"),
                                ("sunset", "Rooftop"),
                                ("coffee", "Cafe"),
                                ("sofa", "Lounge"),
                                ("layout-grid", "General")
                            })
                            {
                                <button type="button" class="yoru-icon-choice"
                                        data-icon-choice="@option.Item1">
                                    <i data-lucide="@option.Item1"></i>
                                    <span>@option.Item2</span>
                                </button>
                            }
                        </div>

                        <div class="form-text">
                            Suggested automatically from the name.
                            You can choose another.
                        </div>
                    </div>

                    <div class="form-check form-switch yoru-switch mb-3">
                        <input type="checkbox" role="switch"
                               class="form-check-input"
                               name="AreaForm.IsOccupied" value="true"
                               id="yoruAreaOccupied" />
                        <label class="form-check-label" for="yoruAreaOccupied">
                            Mark area as Occupied
                        </label>
                    </div>
                    <div class="form-text mb-3">
                        When on, every table in this area becomes
                        Out of service and cannot be booked. Turn it off to
                        restore their previous status.
                    </div>
                </div>

                <div class="yoru-area-drawer-footer">
                    <button type="button" class="yoru-type-drawer-cancel"
                            data-area-drawer-close="true">Cancel</button>
                    <button type="submit" class="yoru-type-drawer-save">
                        <i data-lucide="save"></i> Save Area
                    </button>
                </div>
            </form>
        </aside>
    </div>
</div>

    <section class="yoru-tab-panel mb-4" id="opening-hours-section"
             role="tabpanel" aria-label="Opening Hours" hidden>
            <div class="yoru-hours-workspace" style="display:grid; grid-template-columns:minmax(0,3fr) minmax(0,2fr); gap:18px; align-items:start; width:100%;">
        <div class="yoru-hours-main" style="min-width:0; padding:24px; background:#fffdfa; border:1px solid #e7d9cc; border-radius:16px; box-shadow:0 3px 12px rgba(54,34,26,.035);">
                    <div class="yoru-luxury-head">
                        <div>
                            <div class="yoru-luxury-eyebrow">YOUR DAILY RHYTHM</div>
                            <h2 class="yoru-luxury-title">Weekly Schedule</h2>
                            <p class="yoru-luxury-subtitle">Manage your weekly operating schedule.</p>
                        </div>
                        <div class="yoru-hours-edit-actions">
                            <button type="button" id="yoruEditHours" class="yoru-luxury-btn"><i data-lucide="pencil"></i> Edit Schedule</button>
                            <button type="button" id="yoruCancelHours" class="yoru-luxury-btn secondary d-none">Cancel</button>
                            <button type="submit" form="hoursForm" id="yoruSaveHours" class="yoru-luxury-btn d-none"><i data-lucide="save"></i> Save Changes</button>
                        </div>
                    </div>
                    <div class="yoru-hours-summary">
                        <i data-lucide="clock-3"></i>
                        <div>
                            <strong>Weekly Operating Schedule</strong>
                            <span id="yoruHoursSummary"></span>
                        </div>
                    </div>

                    <form id="hoursForm" method="post" asp-page-handler="SaveHours">
                <div class="yoru-hours-list">
                    @for (var i = 0; i < Model.Hours.Count; i++)
                    {
                        <div class="yoru-hours-row" data-hour-index="@i">
                            <div class="yoru-hours-day">@Model.Hours[i].Day<input type="hidden" asp-for="Hours[i].Id" /><input type="hidden" asp-for="Hours[i].Day" /></div>
                            <div class="yoru-hours-time-group">
                                <div class="yoru-hours-time">
                                    <span class="yoru-hours-caption">OPENS</span>
                                    <span class="yoru-hours-value yoru-view-only" data-time-view="open"></span>
                                    <button type="button" class="yoru-hours-time-btn yoru-edit-only" data-time-edit="open"></button>
                                </div>

                                <span class="yoru-hours-arrow">→</span>

                                <div class="yoru-hours-time">
                                    <span class="yoru-hours-caption">CLOSES</span>
                                    <span class="yoru-hours-value yoru-view-only" data-time-view="close"></span>
                                    <button type="button" class="yoru-hours-time-btn yoru-edit-only" data-time-edit="close"></button>
                                </div>
                            </div>

                            <div class="yoru-hours-closed-message">
                                <i data-lucide="calendar-x" aria-hidden="true"></i>
                                <span>CLOSED FOR THE DAY</span>
                            </div>

                            <div class="yoru-hours-status">
                                <span class="yoru-view-only" data-hours-status></span>

                                <label class="yoru-hours-closed-check yoru-edit-only">
                                    <input asp-for="Hours[i].IsClosed" class="form-check-input" />
                                    Closed
                                </label>
                            </div>
                            
                            <input asp-for="Hours[i].OpenTime" type="time" class="yoru-hour-native" hidden />
                            <input asp-for="Hours[i].CloseTime" type="time" class="yoru-hour-native" hidden />
                            <input asp-for="Hours[i].BreakStart" type="time" class="yoru-hour-native" hidden />
                            <input asp-for="Hours[i].BreakEnd" type="time" class="yoru-hour-native" hidden />
                        </div>
                    }
                </div>
        </form>
    </div>

    <aside class="yoru-hours-sidebar" style="display:grid!important; grid-template-columns:minmax(0,1fr); gap:18px; min-width:0;">
        <div class="yoru-hours-side-card" style="padding:22px; background:#fffdfa; border:1px solid #e7d9cc; border-radius:14px;">
            <div class="yoru-hours-side-heading">
                <i data-lucide="chart-no-axes-gantt"></i>
                <h3>Weekly Timeline</h3>
            </div>
            <p>Visual overview of weekly opening periods.</p>
            <div id="yoruWeeklyTimeline">
                <span class="yoru-hours-placeholder">Timeline coming next.</span>
            </div>
        </div>

            <div id="yoruSpecialDatesCard" class="yoru-hours-side-card" style="padding:22px; background:#fffdfa; border:1px solid #e7d9cc; border-radius:14px;">
                <div class="yoru-special-header">
                <div class="yoru-hours-side-heading">
                    <i data-lucide="calendar-days"></i>
                    <h3>Special Dates</h3>
                </div>

                <button type="button" id="yoruSpecialExpand" class="yoru-special-expand-btn" aria-label="Enlarge special dates" title="Enlarge">
                    <i data-lucide="maximize-2"></i>
                </button>

                <button type="button" id="yoruSpecialAdd" class="yoru-special-hover-btn" aria-label="Add Special Date" title="Add Special Date">
                    <i data-lucide="plus"></i>
                    <span> Add Special Date</span>
                </button>
            </div>

            <p>Manage holiday closures and special opening hours.</p>
            <div id="yoruSpecialMonthNav"
                 class="yoru-special-month-nav"
                 hidden>
                <button type="button"
                        id="yoruSpecialMonthPrev"
                        aria-label="Previous month with special dates">
                    &#8249;
                </button>

                <div>
                    <strong id="yoruSpecialMonthLabel"></strong>
                    <small id="yoruSpecialMonthCount"
                           aria-live="polite"></small>
                </div>

                <button type="button"
                        id="yoruSpecialMonthNext"
                        aria-label="Next month with special dates">
                    &#8250;
                </button>
            </div>

            @if (!Model.SpecialDates.Any())
            {
                <div class="yoru-hours-placeholder">
                    No special dates added yet.
                </div>
            }
            else
            {
                <div class="yoru-special-list">
                    @foreach (var special in Model.SpecialDates)
                    {
                        <div class="yoru-special-item" data-special-month="@special.Date.ToString("yyyy-MM")">
                            <div class="yoru-special-info">
                                <div class="yoru-special-date">
                                    @if ((special.EndDate ?? special.Date).Date == special.Date.Date)
                                    {
                                        @special.Date.ToString("dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span>
                                            @special.Date.ToString("dd MMM yyyy")
                                            –
                                            @special.EndDate?.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                </div>
                                <div class="yoru-special-name">@special.Name</div>

                                @if (special.IsClosed)
                                {
                                    <span class="yoru-special-status closed">Closed</span>
                                }
                                else
                                {
                                    <span class="yoru-special-status">
                                        @special.OpenTime?.ToString(@"hh\:mm") –
                                        @special.CloseTime?.ToString(@"hh\:mm")
                                    </span>
                                }
                            </div>

                            <div class="yoru-special-actions">
                                <button type="button"
                                        class="yoru-special-icon-btn"
                                        title="Edit"
                                        data-special-edit
                                        data-id="@special.Id"
                                        data-date="@special.Date.ToString("yyyy-MM-dd")"
                                        data-end-date="@((special.EndDate ?? special.Date).ToString("yyyy-MM-dd"))"
                                        data-name="@special.Name"
                                        data-closed="@special.IsClosed.ToString().ToLowerInvariant()"
                                        data-open="@special.OpenTime?.ToString(@"hh\:mm")"
                                        data-close="@special.CloseTime?.ToString(@"hh\:mm")">
                                    <i data-lucide="pencil"></i>
                                </button>

                                <form method="post" asp-page-handler="DeleteSpecialDate"
                                      onsubmit="return confirm('Delete this special date?');">
                                    <input type="hidden" name="DeleteSpecialDateId" value="@special.Id" />
                                    <button type="submit" class="yoru-special-icon-btn danger" title="Delete">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>
    </section>

<!-- Special Date Add / Edit Modal -->
<div class="modal fade" id="yoruSpecialModal" tabindex="-1" aria-labelledby="yoruSpecialModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="SaveSpecialDate" class="modal-content yoru-special-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="yoruSpecialModalTitle">Add Special Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" name="SpecialDateInput.Id" id="yoruSpecialId" value="0" />

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label for="yoruSpecialDate" class="form-label">
                            Start Date
                        </label>

                        <input type="date"
                               class="form-control"
                               name="SpecialDateInput.Date"
                               id="yoruSpecialDate"
                               required />
                    </div>

                    <div class="col-6">
                        <label for="yoruSpecialEndDate" class="form-label">
                            End Date
                        </label>

                        <input type="date"
                               class="form-control"
                               name="SpecialDateInput.EndDate"
                               id="yoruSpecialEndDate"
                               required />
                    </div>

                    <div class="col-12">
                        <small class="text-muted">
                            For one day, select the same start and end date.
                        </small>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="yoruSpecialName" class="form-label">Event / Holiday Name</label>
                    <input type="text" class="form-control" name="SpecialDateInput.Name" id="yoruSpecialName" maxlength="100" placeholder="e.g. Christmas Day" required />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" name="SpecialDateInput.IsClosed" value="true" id="yoruSpecialClosed" />
                    <label class="form-check-label" for="yoruSpecialClosed">Closed for the whole day</label>
                </div>

                <div id="yoruSpecialTimeFields">
                    <div class="row g-3">
                        <div class="col-6">
                            <label for="yoruSpecialOpen" class="form-label">Opening Time</label>
