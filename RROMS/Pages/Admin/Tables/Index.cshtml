    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('yoruSpecialModal');
        const startEl = document.getElementById('yoruSpecialDate');
        const endEl = document.getElementById('yoruSpecialEndDate');
        if (!modalEl || !startEl || !endEl) return;

        const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        const DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
        const pad = n => String(n).padStart(2, '0');
        const iso = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        const parse = v => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || ''); return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null; };

        const pop = document.createElement('div');
        pop.className = 'yoru-dp';
        pop.hidden = true;
        pop.setAttribute('role', 'dialog');
        pop.setAttribute('aria-label', 'Choose date');
        let active = null;
        let view = new Date();
        let menu = null;

        function minDate() {
            return active === endEl ? parse(startEl.value) : null;
        }

        function render() {
            const sel = parse(active.value);
            const min = minDate();
            const today = new Date();
            const y = view.getFullYear();
            const mo = view.getMonth();
            const thisYear = today.getFullYear();
            let years = '';
            for (let i = thisYear - 2; i <= thisYear + 8; i++) {
                years += '<button type="button" class="yoru-dp-opt' + (i === y ? ' is-on' : '') + '" data-year="' + i + '">' + i + '</button>';
            }
            const months = MONTHS.map((n, i) => '<button type="button" class="yoru-dp-opt' + (i === mo ? ' is-on' : '') + '" data-month="' + i + '">' + n.slice(0, 3) + '</button>').join('');
            const menuHtml = menu === 'month'
                ? '<div class="yoru-dp-menu is-months">' + months + '</div>'
                : menu === 'year' ? '<div class="yoru-dp-menu is-years">' + years + '</div>' : '';

            const first = new Date(y, mo, 1);
            const lead = (first.getDay() + 6) % 7;
            let cells = '';
            for (let i = 0; i < 42; i++) {
                const d = new Date(y, mo, 1 - lead + i);
                const cls = ['yoru-dp-day'];
                if (d.getMonth() !== mo) cls.push('is-out');
                if (iso(d) === iso(today)) cls.push('is-today');
                if (sel && iso(d) === iso(sel)) cls.push('is-selected');
                const off = min && d < min;
                if (off) cls.push('is-disabled');
                cells += '<button type="button" class="' + cls.join(' ') + '" data-date="' + iso(d) + '"' + (off ? ' disabled' : '') + '>' + d.getDate() + '</button>';
            }

            pop.innerHTML =
                '<div class="yoru-dp-head">' +
                '<button type="button" class="yoru-dp-nav" data-nav="-1" aria-label="Previous month"><svg viewBox="0 0 24 24"><path d="m14 6-6 6 6 6"/></svg></button>' +
                '<div class="yoru-dp-selects"><button type="button" class="yoru-dp-select' + (menu === 'month' ? ' is-open' : '') + '" data-menu="month" aria-haspopup="listbox" aria-label="Month">' + MONTHS[mo] + '</button>' +
                '<button type="button" class="yoru-dp-select' + (menu === 'year' ? ' is-open' : '') + '" data-menu="year" aria-haspopup="listbox" aria-label="Year">' + y + '</button></div>' +
                '<button type="button" class="yoru-dp-nav" data-nav="1" aria-label="Next month"><svg viewBox="0 0 24 24"><path d="m10 6 6 6-6 6"/></svg></button>' +
                '</div>' +
                '<div class="yoru-dp-week">' + DAYS.map(d => '<span>' + d + '</span>').join('') + '</div>' +
                '<div class="yoru-dp-grid">' + cells + '</div>' +
                '<div class="yoru-dp-foot"><button type="button" class="yoru-dp-link" data-today>Today</button><button type="button" class="yoru-dp-link" data-close>Close</button></div>' + menuHtml;
        }

        function open(input) {
            active = input;
            const base = parse(input.value) || minDate() || new Date();
            view = new Date(base.getFullYear(), base.getMonth(), 1);
            menu = null;
            input.closest('.yoru-dp-field').appendChild(pop);
            render();
            pop.hidden = false;
            input.setAttribute('aria-expanded', 'true');
        }

        function close() {
            pop.hidden = true;
            if (active) active.setAttribute('aria-expanded', 'false');
        }

        function checkRange() {
            const bad = startEl.value && endEl.value && endEl.value < startEl.value;
            endEl.setCustomValidity(bad ? 'End date must be on or after the start date.' : '');
        }

        function choose(value) {
            const input = active;
            input.value = value;
            if (input === startEl && (!endEl.value || endEl.value < value)) {
                endEl.value = value;
                endEl.dispatchEvent(new Event('input', { bubbles: true }));
            }
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
            checkRange();
            close();
            input.focus();
        }

        pop.addEventListener('click', function (e) {
            const day = e.target.closest('.yoru-dp-day');
            if (day && !day.disabled) { choose(day.dataset.date); return; }
            const mbtn = e.target.closest('[data-menu]');
            if (mbtn) { menu = menu === mbtn.dataset.menu ? null : mbtn.dataset.menu; render(); return; }
            const mo = e.target.closest('[data-month]');
            if (mo) { view = new Date(view.getFullYear(), Number(mo.dataset.month), 1); menu = null; render(); return; }
            const yr = e.target.closest('[data-year]');
            if (yr) { view = new Date(Number(yr.dataset.year), view.getMonth(), 1); menu = null; render(); return; }
            const nav = e.target.closest('[data-nav]');
            if (nav) { view = new Date(view.getFullYear(), view.getMonth() + Number(nav.dataset.nav), 1); render(); return; }
            if (e.target.closest('[data-today]')) {
                const t = new Date();
                const min = minDate();
                choose(iso(min && t < min ? min : t));
                return;
            }
            if (e.target.closest('[data-close]')) close();
        });

        [startEl, endEl].forEach(function (input) {
            input.setAttribute('aria-haspopup', 'dialog');
            input.setAttribute('aria-expanded', 'false');
            input.addEventListener('click', () => open(input));
            input.addEventListener('beforeinput', e => e.preventDefault());
            input.addEventListener('paste', e => e.preventDefault());
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !pop.hidden) { e.stopPropagation(); close(); return; }
                if (e.key === 'Tab') return;
                if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') { e.preventDefault(); open(input); return; }
                if (e.key === 'Backspace' || e.key === 'Delete') { e.preventDefault(); input.value = ''; checkRange(); return; }
                e.preventDefault();
            });
            input.addEventListener('input', checkRange);
        });

        document.addEventListener('mousedown', function (e) {
            if (!pop.hidden && !e.target.closest('.yoru-dp') && !e.target.closest('.yoru-dp-input')) close();
        });
        modalEl.addEventListener('hide.bs.modal', close);
        modalEl.addEventListener('shown.bs.modal', checkRange);
    });
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('tableTypeForm');

        const minInput = form.querySelector(
            '[name="TableTypeForm.DefaultMinGuests"]'
        );

        const capacityInput = form.querySelector(
            '[name="TableTypeForm.DefaultMaxGuests"]'
        );

        const error = document.getElementById('tableTypeCapacityError');

        capacityInput.setAttribute(
            'aria-describedby',
            'tableTypeCapacityError'
        );

        function validateGuestRange() {
            const MAX_GUESTS = 100;
            const tooMany =
                (capacityInput.value !== '' && Number(capacityInput.value) > MAX_GUESTS) ||
                (minInput.value !== '' && Number(minInput.value) > MAX_GUESTS);

            const belowMin =
                minInput.value !== '' &&
                capacityInput.value !== '' &&
                Number(minInput.value) > Number(capacityInput.value);

            const invalid = tooMany || belowMin;

            const message = tooMany
                ? 'A table can seat at most ' + MAX_GUESTS + ' guests.'
                : belowMin
                    ? 'Capacity must be at least the minimum guests.'
                    : '';

            error.textContent = message;

            capacityInput.setCustomValidity(message);
            minInput.classList.toggle('is-invalid', tooMany && Number(minInput.value) > MAX_GUESTS);
            capacityInput.classList.toggle('is-invalid', invalid);
            capacityInput.setAttribute('aria-invalid', String(invalid));

            error.hidden = !invalid;
        }

        minInput.addEventListener('input', validateGuestRange);
        capacityInput.addEventListener('input', validateGuestRange);

        form.addEventListener('reset', () => {
            setTimeout(validateGuestRange, 0);
        });

        form.addEventListener('submit', event => {
            validateGuestRange();

            if (capacityInput.validity.customError) {
                event.preventDefault();
                event.stopImmediatePropagation();
                capacityInput.focus();
                capacityInput.reportValidity();
            }
        }, true);

        validateGuestRange();
    });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('tableTypeForm');
            const saveButton = document.getElementById('saveTableTypeBtn');
            const errorBox = document.getElementById('tableTypeSaveError');

            if (!form || !saveButton || !errorBox) {
                return;
            }

            let saving = false;

            form.addEventListener('reset', () => {
                errorBox.hidden = true;
                errorBox.textContent = '';
            });

            form.addEventListener('submit', async event => {
                // Respect the existing validation and bulk-update confirmation.
                if (event.defaultPrevented) {
                    return;
                }

                event.preventDefault();

                if (saving || !form.reportValidity()) {
                    return;
                }

                const formData = new FormData(form);

                saving = true;
                saveButton.disabled = true;
                errorBox.hidden = true;
                errorBox.textContent = '';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    });

                    const contentType =
                        response.headers.get('content-type') || '';

                    if (!contentType.includes('application/json')) {
                        throw new Error(
                            'The server returned an unexpected response. ' +
                            'Your entries are still here.'
                        );
                    }

                    const result = await response.json();

                    if (response.ok && result.success) {
                        window.yoruRememberView({
                            tab: 'tables',
                            panelId: null
                        });

                        window.location.reload();
                        return;
                    }

                    // The type was saved, but its photo upload failed.
                    if (result.savedId) {
                        form.querySelector(
                            '[name="TableTypeForm.Id"]'
                        ).value = result.savedId;

                        const createFirstTable = form.querySelector(
                            '[name="TableTypeForm.CreateFirstTable"]'
                        );

                        if (createFirstTable) {
                            createFirstTable.checked = false;
                        }

                        const createFirstSection =
                            document.getElementById('createFirstTableSection');

                        if (createFirstSection) {
                            createFirstSection.style.display = 'none';
                        }
                    }

                    errorBox.textContent =
                        result.message ||
                        'Unable to save. Please check your entries.';

                    errorBox.hidden = false;
                    errorBox.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });
                } catch (error) {
                    errorBox.textContent =
                        error.message ||
                        'Unable to connect. Your entries are still here.';

                    errorBox.hidden = false;
                } finally {
                    saving = false;
                    saveButton.disabled = false;
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const zoomButton =
                document.getElementById('tableTypePhotoZoomButton');

            const preview =
                document.getElementById('tableTypePhotoPreview');

            const dialog =
                document.getElementById('yoruPhotoDialog');

            const largePhoto =
                document.getElementById('yoruPhotoLarge');

            const closeButton =
                document.getElementById('yoruPhotoClose');

            zoomButton.addEventListener('click', () => {
                largePhoto.src = preview.currentSrc || preview.src;
                dialog.showModal();
            });

            closeButton.addEventListener('click', () => {
                dialog.close();
            });

            // Click outside the photo window to close.
            dialog.addEventListener('click', event => {
                if (event.target !== dialog) {
                    return;
                }

                const bounds = dialog.getBoundingClientRect();

                const outside =
                    event.clientX < bounds.left ||
                    event.clientX > bounds.right ||
                    event.clientY < bounds.top ||
                    event.clientY > bounds.bottom;

                if (outside) {
                    dialog.close();
                }
            });

            // Escape closes the photo without reaching drawer shortcuts.
            dialog.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    event.stopPropagation();
                }
            });

            dialog.addEventListener('close', () => {
                largePhoto.removeAttribute('src');
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const selectors = [
                'select.yoru-type-filter',
                'select.yoru-area-filter',
                'select.yoru-table-status-filter',
                '#yoruTypeDrawer select',
                '#tableModal select',
                '#areaModal select'
            ].join(',');

            const filters = [];

            document.querySelectorAll(selectors).forEach(select => {
                const wrapper = document.createElement('div');
                wrapper.className = 'dropdown yoru-custom-filter';

                const trigger = document.createElement('button');
                trigger.type = 'button';
                trigger.className = 'yoru-custom-filter-button';
                trigger.dataset.bsToggle = 'dropdown';
                trigger.setAttribute('aria-expanded', 'false');

                const label =
                    select.getAttribute('aria-label') ||
                    select.labels?.[0]?.textContent.trim();

                if (label) {
                    trigger.setAttribute('aria-label', label);
                }

                const menu = document.createElement('ul');
                menu.className = 'dropdown-menu';

                const error = document.createElement('div');
                error.className = 'yoru-custom-filter-error';
                error.setAttribute('aria-live', 'polite');
                error.hidden = true;

                select.before(wrapper);

                wrapper.appendChild(trigger);
                wrapper.appendChild(menu);
                wrapper.appendChild(select);
                wrapper.appendChild(error);

                select.style.display = 'none';

                let choices = [];

                function buildOptions() {
                    menu.replaceChildren();
                    choices = [];

                    if (select.dataset.search) {
                        const box = document.createElement('li');
                        box.className = 'yoru-menu-search';
                        const input = document.createElement('input');
                        input.type = 'search';
                        input.placeholder = select.dataset.search;
                        input.setAttribute('aria-label', select.dataset.search);
                        input.autocomplete = 'off';
                        const none = document.createElement('li');
                        none.className = 'yoru-menu-empty';
                        none.textContent = 'No match found';
                        none.hidden = true;

                        input.addEventListener('input', () => {
                            const q = input.value.trim().toLowerCase();
                            let shown = 0;
                            choices.forEach(({ option, button }) => {
                                const hit = option.value !== '' && button.dataset.label.includes(q);
                                button.parentElement.hidden = option.value === '' ? q !== '' : !hit;
                                if (!button.parentElement.hidden) shown++;
                            });
                            none.hidden = shown > 0;
                        });
                        input.addEventListener('keydown', e => {
                            if (e.key === 'Enter') e.preventDefault();
                            e.stopPropagation();
                        });
                        wrapper.addEventListener('shown.bs.dropdown', () => input.focus());
                        wrapper.addEventListener('hide.bs.dropdown', () => {
                            input.value = '';
                            input.dispatchEvent(new Event('input'));
                        });

                        box.appendChild(input);
                        menu.appendChild(box);
                        menu.appendChild(none);
                    }

                    Array.from(select.options).forEach(option => {
                        const item = document.createElement('li');
                        const button = document.createElement('button');

                        button.type = 'button';
                        button.className = 'dropdown-item' +
                            (option.value === '' ? ' is-placeholder' : '');
                        button.dataset.label = option.textContent.trim().toLowerCase();
                        button.textContent = option.textContent;

                        button.addEventListener('click', () => {
                            select.value = option.value;

                            select.dispatchEvent(
                                new Event('change', { bubbles: true })
                            );

                            sync();
                        });

                        item.appendChild(button);
                        menu.appendChild(item);

                        choices.push({ option, button });
                    });

                    sync();
                }

                function sync() {
                    const selected = select.selectedOptions[0];

                    trigger.textContent = selected
                        ? selected.textContent
                        : 'Choose an option';

                    trigger.disabled = select.disabled;

                    choices.forEach(({ option, button }) => {
                        button.classList.toggle(
                            'active',
                            option.selected
                        );

                        // "Choose …" is a hint on a required field, not something to pick.
                        button.disabled =
                            option.disabled ||
                            (option.value === '' && select.required) ||
                            (
                                option.parentElement.tagName === 'OPTGROUP' &&
                                option.parentElement.disabled
                            );

                        button.hidden = option.hidden;

                        button.setAttribute(
                            'aria-current',
                            String(option.selected)
                        );
                    });

                    if (select.validity.valid || select.disabled) {
                        trigger.classList.remove('is-invalid');
                        trigger.removeAttribute('aria-invalid');
                        error.hidden = true;
                    } else if (!error.hidden) {
                        error.textContent = select.validationMessage;
                    }
                }

                select.addEventListener('change', sync);

                // Keep required-field validation working.
                select.addEventListener('invalid', event => {
                    event.preventDefault();

                    trigger.classList.add('is-invalid');
                    trigger.setAttribute('aria-invalid', 'true');

                    error.textContent = select.validationMessage;
                    error.hidden = false;

                    const firstInvalid = select.form
                        ? Array.from(select.form.elements).find(
                            field => field.willValidate &&
                                !field.validity.valid
                        )
                        : select;

                    if (firstInvalid === select) {
                        trigger.focus();
                    }
                });

                // Refresh when Add/Edit changes the available options.
                const observer = new MutationObserver(buildOptions);

                observer.observe(select, {
                    childList: true,
                    subtree: true,
                    characterData: true,
                    attributes: true,
                    attributeFilter: [
                        'disabled',
                        'hidden',
                        'label',
                        'value',
                        'selected',
                        'required'
                    ]
                });

                filters.push(sync);

                buildOptions();
            });

            function syncAll() {
                filters.forEach(sync => sync());
            }

            // Sync values assigned by Add, Edit and Clear Filters.
            document.addEventListener('click', () => {
                queueMicrotask(syncAll);
            });

            document.addEventListener('change', () => {
                queueMicrotask(syncAll);
            });

            document.addEventListener('reset', () => {
                setTimeout(syncAll, 0);
            }, true);
        });
    </script>
