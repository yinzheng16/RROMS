</div>

<div class="yoru-summary mb-4">
 
    <div class="yoru-summary-item yoru-summary-dark">
        <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="armchair"></i></div>
        <div class="yoru-summary-number">
            @Model.AllTables.Count
        </div>

        <div class="yoru-summary-title">Total tables</div>
        <div class="yoru-summary-desc">
            Seating across the restaurant.
        </div>
    </div>
    
    <div class="yoru-summary-item yoru-summary-red">
        <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="layers-3"></i></div>
        <div class="yoru-summary-number">
            @Model.TableTypes.Count
        </div>

        <div class="yoru-summary-title">Table types</div>
        <div class="yoru-summary-desc">
            Seating styles available.
        </div>
    </div>

    <div class="yoru-summary-item yoru-summary-light">
            <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="door-open"></i></div>
        <div class="yoru-summary-number">
            @Model.Areas.Count
        </div>

        <div class="yoru-summary-title">Dining areas</div>
        <div class="yoru-summary-desc">
            Spaces for every occasion.
        </div>
    </div>

    @{
        // Today's opening hours for the 4th summary card.
        var todayDate = DateTime.Now.Date;
        var todayHours = Model.Hours.FirstOrDefault(h => h.Day == todayDate.DayOfWeek);
        var todaySpecial = Model.SpecialDates.FirstOrDefault(sd =>
            sd.Date.Date <= todayDate && (sd.EndDate ?? sd.Date).Date >= todayDate);

        string FormatSpan(TimeSpan? t) =>
            t.HasValue ? DateTime.Today.Add(t.Value).ToString("h:mm tt") : "-";

        string FormatOnly(TimeOnly? t) =>
            t.HasValue ? DateTime.Today.Add(t.Value.ToTimeSpan()).ToString("h:mm tt") : "-";

        bool openToday;
        string todayText;
        string? breakToday = null;

        if (todaySpecial != null)
        {
            openToday = !todaySpecial.IsClosed;
            todayText = todaySpecial.IsClosed
                ? "Closed today · " + todaySpecial.Name
                : todaySpecial.Name + " · " + FormatSpan(todaySpecial.OpenTime) + " – " + FormatSpan(todaySpecial.CloseTime);
        }
        else if (todayHours == null || todayHours.IsClosed)
        {
            openToday = false;
            todayText = "Closed for the day.";
        }
        else
        {
            openToday = true;
            todayText = "Today · " + FormatOnly(todayHours.OpenTime) + " – " + FormatOnly(todayHours.CloseTime);
             if (todayHours.BreakStart.HasValue && todayHours.BreakEnd.HasValue)
            {
                breakToday = "Break · " + FormatOnly(todayHours.BreakStart) + " – " + FormatOnly(todayHours.BreakEnd);
            }
        }
    }
    <div class="yoru-summary-item yoru-summary-light yoru-summary-hours @(openToday ? "is-open" : "is-closed")">
        <img src="~/images/decorations/sakura.png" class="yoru-summary-sakura" alt="" aria-hidden="true" />
        <div class="yoru-summary-icon"><i data-lucide="clock-3"></i></div>
        <div class="yoru-summary-number">
            @(openToday ? "Open" : "Closed")
        </div>

        <div class="yoru-summary-title">Opening hours</div>
        <div class="yoru-summary-desc">
            @todayText
            @if (breakToday != null)
            {
                <br /><span class="yoru-summary-break">@breakToday</span>
            }
        </div>
    </div>

</div>

@{
