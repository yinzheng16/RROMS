        function showTablePanel(panelId) {
            const panels = document.querySelectorAll('.yoru-inline-table-panel');
            const currentPanel = Array.from(panels).find(panel => !panel.hidden);

            const finishChange = () => {
                panels.forEach(panel => {
                    panel.classList.remove('yoru-list-closing');
                    panel.hidden = panel.id !== panelId;
                });

                document.querySelectorAll('.yoru-type-manage-btn[data-manage-panel]').forEach(button => {
                    button.setAttribute('aria-expanded', String(button.dataset.managePanel === panelId));
                });

                tableWorkspace.classList.toggle('managing-tables', Boolean(panelId));
            };

            if (!panelId && currentPanel) {
                if (currentPanel.classList.contains('yoru-list-closing')) return;

                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    finishChange();
                    return;
                }

                currentPanel.classList.add('yoru-list-closing');

                currentPanel.addEventListener('animationend', event => {
                    if (event.target !== currentPanel) return;
                    if (event.animationName !== 'yoruTableListExit') return;

                    // Do not restore Table List while Type Drawer is open.
                    if (tableWorkspace.classList.contains('drawer-open')) {
                        return;
                    }

                    finishChange();
                }, { once: true });

                return;
            }

            finishChange();
        }


        function openTableDrawer(trigger) {
            tableDrawerPreviousFocus = document.activeElement;
            tableWorkspace.scrollIntoView({ block: 'start', behavior: 'smooth' });
            
            if (tableWorkspace.classList.contains('drawer-open')) {
                closeTypeDrawer();
            }

            const openPanel = tableAccordion.querySelector('.yoru-inline-table-panel:not([hidden])');
            previousTablePanelId = openPanel?.id || null;

            if (trigger?.dataset.id) {
                const matchingPanel = trigger.closest('.yoru-inline-table-panel');
                if (matchingPanel) showTablePanel(matchingPanel.id);
            } else if (!openPanel) {
                const firstPanel = tableAccordion.querySelector('.yoru-inline-table-panel');
                if (firstPanel) showTablePanel(firstPanel.id);
            }

            // Reuse existing Add/Edit form-population logic.
            const event = new Event('show.bs.modal');
            Object.defineProperty(event, 'relatedTarget', { value: trigger || null });
            tableDrawer.dispatchEvent(event);
            syncTableNumberDisplay();

            const editing = Boolean(trigger?.dataset.id);
            
            tableDrawer.classList.toggle('yoru-edit-mode', editing);
            // Lock Table Type when editing an existing table
            dynamicTypeField.disabled = editing;
            dynamicTypeField.classList.toggle('yoru-locked-field', editing);

            const statusSelect = tableDrawer.querySelector('[name="TableForm.Status"]');

            if (statusSelect) {
                statusSelect.value = editing
                    ? (trigger.dataset.status || 'Available')
                    : 'Available';

                if (editing && !Array.from(statusSelect.options).some(option => option.value === statusSelect.value)) {
                    const selectedOption = Array.from(statusSelect.options)
                        .find(option => option.text.trim() === trigger.dataset.status);

                    if (selectedOption) statusSelect.value = selectedOption.value;
                }
            }
            const title = document.getElementById('tableTitle');
            title.textContent = editing ? 'Edit Table — ' + trigger.dataset.number : 'Add New Table';

            const submit = tableDrawer.querySelector('button[type="submit"]');
            if (submit) submit.textContent = editing ? 'Save Changes' : 'Create Table';

            tableDrawer.setAttribute('aria-hidden', 'false');
            tableWorkspace.classList.add('table-drawer-open');

            requestAnimationFrame(() => tableDrawer.focus({ preventScroll: true }));
        }

        function closeTableDrawer() {
            tableWorkspace.classList.remove('table-drawer-open');
            tableDrawer.setAttribute('aria-hidden', 'true');

            if (previousTablePanelId) {
                showTablePanel(previousTablePanelId);
            } else {
                showTablePanel(null);
            }

            if (tableDrawerPreviousFocus?.isConnected) {
                tableDrawerPreviousFocus.focus({ preventScroll: true });
            }
