        #yoruCalOverlay .yoru-cal-weekdays span {font-size:10px; letter-spacing:.02em;}
        #yoruCalOverlay .yoru-cal-cell {min-width:0; min-height:54px; padding:3px; border-radius:8px;}
        #yoruCalOverlay .yoru-cal-cell > b {font-size:11px;}
        #yoruCalOverlay .yoru-cal-cell [class*="event"],#yoruCalOverlay .yoru-cal-cell span {max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
        #yoruCalOverlay .yoru-sched-head {flex-wrap:wrap; gap:10px; padding:16px 16px 6px;}
        #yoruCalOverlay .yoru-sched-head h2 {font-size:24px;}
        #yoruSchedOverlay .yoru-sched-head {padding:16px 16px 6px;}
        #yoruSchedOverlay .yoru-sched-head h2 {font-size:24px;}
