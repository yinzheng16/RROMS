@section Scripts {
    <script>
        // Fill the modals: "Edit" buttons carry data-* values, "Add" buttons carry none (so the form is cleared).
        function bindModal(modalId, fields) {
            const m = document.getElementById(modalId);
            m.addEventListener('show.bs.modal', e => {
                const d = e.relatedTarget ? e.relatedTarget.dataset : {};
                for (const [name, key, fallback] of fields) {
                    const el = m.querySelector('[name="' + name + '"]');
                    if (!el) continue;
                    const v = d[key] !== undefined ? d[key] : fallback;
                    if (el.type === 'checkbox') el.checked = (v === 'true'); else el.value = v;
                }
            });
        }
        // Manage Table Types: Create / Edit
        const manageTypesModal = document.getElementById('manageTableTypesModal');
        const tableTypesListView = document.getElementById('tableTypesListView');
        const tableTypeFormView = document.getElementById('tableTypeFormView');
        const addNewTableTypeBtn = document.getElementById('addNewTableTypeBtn');
        const backToTableTypesBtn = document.getElementById('backToTableTypesBtn');
        const saveTableTypeBtn = document.getElementById('saveTableTypeBtn');

        function showTableTypesList() {
            tableTypeFormView.classList.add('d-none');
            tableTypesListView.classList.remove('d-none');

            saveTableTypeBtn.classList.add('d-none');

            tableTypesListView.classList.remove('yoru-type-view-enter');
            void tableTypesListView.offsetWidth;
            tableTypesListView.classList.add('yoru-type-view-enter');
            manageTypesModal.querySelector('.modal-body').scrollTop = 0;
        }

        function showTableTypeForm() {
            tableTypesListView.classList.add('d-none');
            tableTypeFormView.classList.remove('d-none');

            saveTableTypeBtn.classList.remove('d-none');

            tableTypeFormView.classList.remove('yoru-type-view-enter');
            void tableTypeFormView.offsetWidth;
            tableTypeFormView.classList.add('yoru-type-view-enter');
            manageTypesModal.querySelector('.modal-body').scrollTop = 0;
        }
        const tableTypeForm = document.getElementById('tableTypeForm');
        const typeFormTitle = document.getElementById('tableTypeFormTitle');
        const firstTableCheckbox = tableTypeForm.querySelector('[name="TableTypeForm.CreateFirstTable"]');
        const firstTableSection = document.getElementById('firstTableNameSection');
        const createFirstSection = document.getElementById('createFirstTableSection');
        const bulkUpdateSection = document.getElementById('bulkUpdateSection');
        const bulkUpdateChoice = document.getElementById('bulkUpdateChoice');

        function setTypeFormValue(field, value) {
            const input = tableTypeForm.querySelector(
                '[name="TableTypeForm.' + field + '"]');

            if (!input) return;

            if (input.type === 'checkbox') {
                input.checked = String(value) === 'true';
            } else {
                input.value = value ?? '';
            }
        }

        const tableTypePhotoInput =
            document.getElementById('tableTypePhotoInput');

        const tableTypePhotoPreview =
            document.getElementById('tableTypePhotoPreview');

        const defaultTableTypePhoto = '/images/tables/standard.jpg';

        let tableTypePhotoPreviewUrl = null;
        let originalTableTypePhoto = defaultTableTypePhoto;

        function setTableTypePhotoPreview(path) {
            if (tableTypePhotoPreviewUrl) {
                URL.revokeObjectURL(tableTypePhotoPreviewUrl);
                tableTypePhotoPreviewUrl = null;
            }

            tableTypePhotoPreview.src = path || defaultTableTypePhoto;
        }

        tableTypePhotoInput.addEventListener('change', function () {
            const file = this.files?.[0];

            if (!file) {
                setTableTypePhotoPreview(originalTableTypePhoto);
                return;
            }

            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

            if (!allowedTypes.includes(file.type) ||
                file.size > 3 * 1024 * 1024) {
                alert('Please choose a JPG, PNG or WEBP image under 3 MB.');
                this.value = '';
                setTableTypePhotoPreview(originalTableTypePhoto);
                return;
            }

            setTableTypePhotoPreview(URL.createObjectURL(file));
            tableTypePhotoPreviewUrl = tableTypePhotoPreview.src;
        });

        function resetTableTypeForm() {
            tableTypeForm.reset();

            setTypeFormValue('Id', '0');
            setTypeFormValue('Name', '');
            setTypeFormValue('Prefix', '');
            setTypeFormValue('StartingNumber', '1');
            setTypeFormValue('NumberPadding', '1');
            setTypeFormValue('DefaultDiningAreaId', '');
            setTypeFormValue('DefaultMinGuests', '1');
            setTypeFormValue('DefaultMaxGuests', '2');
            setTypeFormValue('DefaultMinimumSpend', '0');
            setTypeFormValue('Description', '');
            setTypeFormValue('IsActive', 'true');
            setTypeFormValue('CreateFirstTable', 'false');
            setTypeFormValue('FirstTableName', '');
            setTypeFormValue('ApplyToExistingTables', 'false');

            typeFormTitle.textContent = 'Add New Table Type';

            createFirstSection.classList.remove('d-none');
            firstTableSection.classList.add('d-none');
            bulkUpdateSection.classList.add('d-none');
            tableTypePhotoInput.value = '';
            originalTableTypePhoto = defaultTableTypePhoto;
            setTableTypePhotoPreview(originalTableTypePhoto);
        }

        function editTableType(button) {
            const d = button.dataset;

            resetTableTypeForm();

            setTypeFormValue('Id', d.id);
            setTypeFormValue('Name', d.name);
            setTypeFormValue('Prefix', d.prefix);
            setTypeFormValue('StartingNumber', d.start);
            setTypeFormValue('NumberPadding', d.padding);
            setTypeFormValue('DefaultDiningAreaId', d.area);
            setTypeFormValue('DefaultMinGuests', d.min);
            setTypeFormValue('DefaultMaxGuests', d.max);
            setTypeFormValue('DefaultMinimumSpend', d.spend);
            setTypeFormValue('Description', d.desc);
            setTypeFormValue('IsActive', d.active);

            tableTypePhotoInput.value = '';
            originalTableTypePhoto = d.photo || defaultTableTypePhoto;
            setTableTypePhotoPreview(originalTableTypePhoto);
            typeFormTitle.textContent = 'Edit Table Type: ' + d.name;

            createFirstSection.classList.add('d-none');
            firstTableSection.classList.add('d-none');
            bulkUpdateSection.classList.remove('d-none');
        }

        manageTypesModal.addEventListener('show.bs.modal', () => {
            resetTableTypeForm();
            showTableTypesList();
        });

        document.querySelectorAll('.yoru-edit-type').forEach(button => {
            button.addEventListener('click', () => {
                editTableType(button);

                showTableTypeForm();
            });
        });
        addNewTableTypeBtn.addEventListener('click', () => {
            resetTableTypeForm();
            showTableTypeForm();
        });

        backToTableTypesBtn.addEventListener('click', () => {
            resetTableTypeForm();
            showTableTypesList();
        });

        firstTableCheckbox.addEventListener('change', () => {
            const isChecked = firstTableCheckbox.checked;
            firstTableSection.classList.toggle( 'd-none', !isChecked);
            if (isChecked) {
                requestAnimationFrame(() => {
                    const modalBody = manageTypesModal.querySelector('.modal-body');

                    modalBody.scrollTo({
                        top: modalBody.scrollHeight,
                        behavior: 'smooth'
                    });
                });
            }
        });

        // Confirm bulk update before submitting the form.
        tableTypeForm.addEventListener('submit', e => {
            const isEditingType =
                Number(tableTypeForm.querySelector('[name="TableTypeForm.Id"]').value) > 0;

            if (isEditingType && bulkUpdateChoice.value === 'true') {
                const confirmed = window.confirm(
                    'Apply the new dining area, guest capacity and minimum spend ' +
                    'to ALL existing tables of this type? ' +
                    'This may affect existing reservations.'
                );

                if (!confirmed) {
                    e.preventDefault();
                }
            }
        });
        bindModal('areaModal', [['AreaForm.Id','id','0'], ['AreaForm.Name','name',''], ['AreaForm.Description','desc','']]);
        bindModal('tableModal', [['TableForm.Id','id','0'], ['TableForm.TableNumber','number',''], ['TableForm.Type','type','2'], ['TableForm.TableTypeDefinitionId', 'dynamicType', ''],
            ['TableForm.DiningAreaId','area',''], ['TableForm.MinGuests','min','1'], ['TableForm.Capacity','max','2'],
            ['TableForm.MinimumSpend','spend','0'], ['TableForm.Description','desc',''], ['TableForm.IsActive','active','true']]);
        
        // Apply defaults when adding a table or changing its type. Existing table values remain intact on Edit.
        const tableModal = document.getElementById('tableModal');
        const dynamicTypeField = tableModal.querySelector('[name="TableForm.TableTypeDefinitionId"]');
        const legacyTypeField = tableModal.querySelector('[name="TableForm.Type"]');
        const nameField = tableModal.querySelector('[name="TableForm.TableNumber"]');
        const areaField = tableModal.querySelector('[name="TableForm.DiningAreaId"]');
        const minField = tableModal.querySelector('[name="TableForm.MinGuests"]');
        const maxField = tableModal.querySelector('[name="TableForm.Capacity"]');
        const spendField = tableModal.querySelector('[name="TableForm.MinimumSpend"]');
        const activeField = tableModal.querySelector('[name="TableForm.IsActive"]');
        const descriptionField = tableModal.querySelector('[name="TableForm.Description"]');
        const existingTables = Array.from(document.querySelectorAll('.yoru-table-row') ).map(row => row.dataset.name.toUpperCase());
        let isEditing = false;
        let nameWasEdited = false;
        function nextLocalTableName(option) {
            const prefix = option.dataset.prefix || '';
            const start = Number(option.dataset.start || 1);
            const padding = Number(option.dataset.padding || 1);

            const used = new Set(existingTables);
            let number = start;

            while (used.has(
                (prefix + String(number).padStart(padding, '0')).toUpperCase()
            )) {
                number++;
            }

            return prefix + String(number).padStart(padding, '0');
        }
        function applyDynamicTypeDefaults() {
            if (isEditing) return;

            const option = dynamicTypeField.selectedOptions[0];
            if (!option || !option.value) {
                nameField.value = '';
                return;
            }

            areaField.value = option.dataset.area || '';
            minField.value = option.dataset.min || '1';
            maxField.value = option.dataset.max || '2';
            spendField.value = option.dataset.spend || '0';
            descriptionField.value = '';
            activeField.checked = true;

            if (!nameWasEdited) {
                nameField.value = nextLocalTableName(option);
            }

            // Legacy enum remains for backward compatibility.
            // Dynamic TableTypeDefinitionId is the authoritative type.
            legacyTypeField.value = '2';
        }

        tableModal.addEventListener('show.bs.modal', e => {
            const data = e.relatedTarget?.dataset || {};

            isEditing = !!data.id;
            nameWasEdited = isEditing;

            tableModal.classList.toggle('yoru-edit-mode', isEditing);

            tableModal.querySelectorAll('.yoru-advanced-field')
                .forEach(field => {
                    field.classList.toggle('d-none', !isEditing);
                });

            if (isEditing) {
                // An inactive type must still be visible for an existing table.
                const selectedId = String(data.dynamicType || '');

                if (selectedId && !Array.from(dynamicTypeField.options)
                    .some(option => option.value === selectedId)) {

                    const option = document.createElement('option');
                    option.value = selectedId;
                    option.textContent = 'Current inactive table type';
                    dynamicTypeField.appendChild(option);
                }

                Array.from(dynamicTypeField.options).forEach(option => {
                    option.disabled = option.dataset.inactive === 'true';
                });
                
                const currentOption = Array.from(dynamicTypeField.options)
                    .find(option => option.value === selectedId);

                if (currentOption) {
                    currentOption.disabled = false;
                }
                
                dynamicTypeField.value = selectedId;
            } else {
                Array.from(dynamicTypeField.options).forEach(option => {
                    option.disabled = option.dataset.inactive === 'true';
                });

                nameWasEdited = false;

                const firstActiveOption = Array.from(dynamicTypeField.options)
                    .find(option => option.value && !option.disabled);

                dynamicTypeField.value = firstActiveOption
                    ? firstActiveOption.value
                    : '';

                applyDynamicTypeDefaults();
            }
        });

        dynamicTypeField.addEventListener('change', () => {
            if (!isEditing) {
                nameWasEdited = false;
                applyDynamicTypeDefaults();
            }
        });

        nameField.addEventListener('input', () => {
            if (!isEditing) {
                nameWasEdited = true;
            }
        });

        // Delete Table Type confirmation
        document.getElementById('deleteTableTypeModal')
            .addEventListener('show.bs.modal', e => {

                const data = e.relatedTarget.dataset;
                const hasTables = data.hasTables === 'true';

                document.getElementById('deleteTableTypeId').value = data.id;

                document.getElementById('deleteTableTypeName').textContent =
                    data.name;

                document.getElementById('deleteTableTypeBlocked')
                    .classList.toggle('d-none', !hasTables);

                document.getElementById('deleteTableTypeWarning')
                    .classList.toggle('d-none', hasTables);

                document.getElementById('confirmDeleteTableType').disabled =
                    hasTables;
            });

        document.getElementById('deleteTableModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;

                document.getElementById('deleteTableId').value = data.id;

                document.getElementById('deleteTableName').textContent =
                    `${data.kind} ${data.number}`;
            });

        document.getElementById('deleteAreaModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;
                const hasTables = data.hasTables === 'true';

                document.getElementById('deleteAreaId').value = data.id;
                document.getElementById('deleteAreaName').textContent = data.name;

                document.getElementById('deleteAreaBlocked')
                    .classList.toggle('d-none', !hasTables);

                document.getElementById('deleteAreaWarning')
                    .classList.toggle('d-none', hasTables);

                document.getElementById('confirmDeleteArea').disabled = hasTables;
            });

        function setupPagination(container, rowSelector, filterFunction) {
            const rows = Array.from(container.querySelectorAll(rowSelector));
            const info = container.querySelector('.yoru-page-info');
            const prev = container.querySelector('.yoru-prev');
            const next = container.querySelector('.yoru-next');

            if (!info || !prev || !next) return null;

            let page = 1;
            const pageSize = 5;

            function update(reset = false) {
                if (reset) page = 1;

                const matching = rows.filter(filterFunction);
                const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));

                page = Math.min(page, totalPages);

                rows.forEach(row => {
                    row.style.display = 'none';
                });

                matching
                    .slice((page - 1) * pageSize, page * pageSize)
                    .forEach(row => {
                        row.style.display = '';
                    });

                info.textContent = matching.length
                    ? `Page ${page} of ${totalPages} · ${matching.length} results`
                    : 'No matching results';

                prev.disabled = page <= 1;
                next.disabled = page >= totalPages;
            }

            prev.addEventListener('click', () => {
                if (page > 1) {
                    page--;
                    update();
                }
            });

            next.addEventListener('click', () => {
                page++;
                update();
            });

            update();

            return () => update(true);
        }

        document.querySelectorAll('.yoru-type-detail').forEach(panel => {
            const search = panel.querySelector('.yoru-table-search');
            const status = panel.querySelector('.yoru-table-status-filter');
            const active = panel.querySelector('.yoru-table-active-filter');

            if (!search || !status || !active) return;

            const refresh = setupPagination(
                panel,
                '.yoru-table-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(search.value.trim().toLowerCase());

                    const matchesStatus =
                        !status.value || row.dataset.status === status.value;

                    const matchesActive =
                        !active.value || row.dataset.active === active.value;

                    return matchesName && matchesStatus && matchesActive;
                }
            );

            if (!refresh) return;

            search.addEventListener('input', () => refresh(true));
            status.addEventListener('change', () => refresh(true));
            active.addEventListener('change', () => refresh(true));
        });

        const areaSearch = document.getElementById('areaSearch');
        const areaFilter = document.getElementById('areaFilter');
        const areaPagination = document.getElementById('areaPagination');

        if (areaSearch && areaFilter && areaPagination) {
            const areaSection = areaPagination.closest('.card');

            const refreshAreas = setupPagination(
                areaSection,
                '.yoru-area-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(areaSearch.value.trim().toLowerCase());

                    const count = Number(row.dataset.count);

                    const matchesFilter =
                        !areaFilter.value ||
                        (areaFilter.value === 'with' && count > 0) ||
                        (areaFilter.value === 'empty' && count === 0);

                    return matchesName && matchesFilter;
                }
            );

            if (refreshAreas) {
                areaSearch.addEventListener('input', refreshAreas);
                areaFilter.addEventListener('change', refreshAreas);
            }
        }

    </script>
}
