    <script>     
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('[data-yoru-tab]');
            const panels = {
                tables: document.getElementById('tables-section'),
                areas: document.getElementById('dining-areas-section'),
                hours: document.getElementById('opening-hours-section')
            };

            function activateTab(name) {
                if (!panels[name]) return;

                if (name !== 'areas') window.yoruCloseAreaDrawer?.();

                sessionStorage.setItem('yoruActiveTab', name);
                Object.entries(panels).forEach(([key, panel]) => {
                    const active = key === name;
                    panel.hidden = !active;
                    panel.classList.toggle('yoru-tab-panel', true);
                    panel.classList.remove('yoru-tab-enter');
                });

                tabs.forEach(tab => {
                    const active = tab.dataset.yoruTab === name;
                    tab.classList.toggle('active', active);
                    tab.setAttribute('aria-selected', String(active));
                    tab.tabIndex = active ? 0 : -1;
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', (event) => {
                    event.preventDefault();

                    const name = tab.dataset.yoruTab;
                    activateTab(name);

                    const target = panels[name];
                    if (!target) return;

                    const top = target.getBoundingClientRect().top + window.scrollY;

                    window.scrollTo({
                        top: Math.max(0, top),
                        behavior: 'smooth'
                    });                  
                });
            });

            const savedTab = sessionStorage.getItem('yoruActiveTab') || 'tables';
            activateTab(panels[savedTab] ? savedTab : 'tables');
        });

    </script>
    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const section = document.getElementById('dining-areas-section');
        if (!section) return;

        const cards = Array.from(section.querySelectorAll('.yoru-area-card'));
        const search = document.getElementById('yoruAreaSearch');
        const filter = document.getElementById('yoruAreaStatusFilter');
        const clear = document.getElementById('yoruAreaClear');
        const count = document.getElementById('yoruAreaResultCount');
        const empty = document.getElementById('yoruAreaNoResults');
        const pagination = document.getElementById('yoruAreaPagination');
        const pageInfo = document.getElementById('yoruAreaPageInfo');
        const prev = document.getElementById('yoruAreaPrev');
        const next = document.getElementById('yoruAreaNext');
        const showAllButton = document.getElementById('yoruAreaShowAll');
        let showAllAreas = false;

        const pageSize = 5;
        let currentPage = 1;

        function renderAreas() {
            const keyword = search.value.trim().toLowerCase();
            const selectedStatus = filter.value;

            const matching = cards.filter(card => {
                const name = (card.dataset.areaName || '').toLowerCase();
                const status = card.dataset.areaStatus || '';
                return name.includes(keyword) &&
                    (selectedStatus === 'all' || status === selectedStatus);
            });

            const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));
            currentPage = Math.min(Math.max(1, currentPage), totalPages);

            cards.forEach(card => {
                card.hidden = true;
            });

            const start = (currentPage - 1) * pageSize;

            const visibleAreas = showAllAreas
                ? matching
                : matching.slice(start, start + pageSize);

            visibleAreas.forEach(card => {
                card.hidden = false;
            });

            count.textContent =`Showing ${visibleAreas.length} of ${matching.length} dining areas`;
            empty.hidden = matching.length !== 0;
            pagination.hidden = matching.length <= pageSize;

            pageInfo.textContent = showAllAreas
                ? `All ${matching.length} dining areas`
                : `Page ${currentPage} of ${totalPages} · ${matching.length} results`;

            prev.hidden = showAllAreas;
            next.hidden = showAllAreas;

            showAllButton.textContent = showAllAreas
                ? 'Show less'
                : 'Show all';

            showAllButton.setAttribute('aria-pressed', String(showAllAreas));

            prev.disabled = currentPage <= 1;
            next.disabled = currentPage >= totalPages;
        }

        search.addEventListener('input', () => {
            currentPage = 1;
            renderAreas();
        });

        filter.addEventListener('change', () => {
            currentPage = 1;
            renderAreas();
        });

        clear.addEventListener('click', () => {
            search.value = '';
            filter.value = 'all';
            currentPage = 1;
            renderAreas();
        });

        prev.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                renderAreas();
            }
        });

        next.addEventListener('click', () => {
            currentPage++;
            renderAreas();
        });

        showAllButton.addEventListener('click', () => {
            showAllAreas = !showAllAreas;
            currentPage = 1;
            renderAreas();
        });

        renderAreas();
    });
    </script>
    
    <script>
