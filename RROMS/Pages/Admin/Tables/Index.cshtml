    };
    var sampleImages = new Dictionary<TableType, string>
    {
        [TableType.Counter] = "/images/tables/counter.jpg",
        [TableType.Double] = "/images/tables/double.jpg",
        [TableType.Standard] = "/images/tables/standard.jpg",
        [TableType.Vip] = "/images/tables/vip.jpg",
        [TableType.Vvip] = "/images/tables/vvip.jpg"
    };
}
<style>
    .yoru-type-card .yoru-type-badge {display:inline-flex; align-items:center; justify-content:center; height:26px; min-width:72px; padding:0 12px; box-sizing:border-box; font-size:14px; line-height:1; text-align:center;}
    /* Weekly Timeline — Compact Layout */
    #yoruWeeklyTimeline {display:grid; gap:5px;}
    .yoru-timeline-scale {display:flex; justify-content:space-between; margin:0 5px 2px 52px; color:#a39488; font-size:10px;}
    .yoru-timeline-row {display:grid; grid-template-columns:43px minmax(0,1fr); align-items:center; gap:9px; position:relative; padding:8px 9px; min-height:38px; border:1px solid #eee5dd; border-radius:8px; background:#fbf8f5; transition:transform .25s ease,background .25s ease,border-color .25s ease,box-shadow .25s ease;}
    .yoru-timeline-row:hover {transform:translateX(4px); background:#fff; border-color:#dfb9a9; box-shadow:0 4px 12px rgba(75,40,25,.07);}
    .yoru-timeline-day {color:#62544b; font-size:11px; font-weight:700;}
    .yoru-timeline-track {position:relative; height:12px; overflow:hidden; border-radius:20px; background:#eee7e0;}
    .yoru-timeline-bar {position:absolute; top:0; bottom:0; border-radius:20px; background:linear-gradient(90deg,#a83228,#d65c45); transition:left .3s ease,width .3s ease,filter .25s ease,box-shadow .25s ease;}
    .yoru-timeline-row:hover .yoru-timeline-bar {filter:brightness(1.15); box-shadow:0 0 10px rgba(183,47,37,.3);}
    .yoru-timeline-row.is-closed .yoru-timeline-track {display:flex; align-items:center; justify-content:center; background:#f4e9e5;}
    .yoru-timeline-closed {color:#b83228; font-size:9px; font-weight:700; letter-spacing:1px;}
    .yoru-timeline-tooltip {position:absolute; top:50%; right:14px; transform:translate(5px,-50%); grid-column:auto; padding:4px 8px; border-radius:5px; background:#fffdfa; color:#8a7467; font-size:10px; font-weight:600; white-space:nowrap; max-height:none; opacity:0; visibility:hidden; pointer-events:none; box-shadow:0 2px 8px rgba(60,40,25,.12); transition:opacity .2s ease,transform .2s ease,visibility .2s ease;}
    .yoru-timeline-row:hover .yoru-timeline-tooltip {opacity:1; visibility:visible; transform:translate(0,-50%);}
    /* Weekly Timeline — Heading Alignment */
    .yoru-hours-side-heading {display:flex; align-items:center; gap:10px; margin-bottom:8px;}
    .yoru-hours-side-heading i,.yoru-hours-side-heading svg {width:22px; height:22px; flex-shrink:0;}
    .yoru-hours-side-heading h3 {margin:0; line-height:1.2;}
    @@media (prefers-reduced-motion:reduce) {.yoru-timeline-row,.yoru-timeline-bar,.yoru-timeline-tooltip {transition:none;} .yoru-timeline-row:hover {transform:none;}}
    /* Opening Hours — Fixed Row Layout */
    #opening-hours-section .yoru-hours-row {grid-template-rows:auto; align-items:center; min-height:62px; box-sizing:border-box;}
    #opening-hours-section .yoru-hours-row .yoru-hours-day {grid-column:1; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-time-group {grid-column:2; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-status {grid-column:3; grid-row:1;}
    #opening-hours-section .yoru-hours-row .yoru-hours-closed-message {grid-column:2; grid-row:1;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed {min-height:62px; box-sizing:border-box;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {display:none!important;}
    #opening-hours-section .yoru-hours-row.yoru-day-closed .yoru-hours-closed-message {display:flex; align-self:center; margin:0;}
    #opening-hours-section .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-time-group {display:flex!important;}
    #opening-hours-section .yoru-hours-editing .yoru-hours-row.yoru-day-closed .yoru-hours-closed-message {display:none!important;}
    #opening-hours-section .yoru-hour-native[hidden] {display:none!important;}
    /* Restaurant Spaces hero — no gradient, opacity overlay, or border line */
    .yoru-tables-hero {position:relative; display:flex; align-items:center; min-height:290px; padding:42px 48px 55px; overflow:hidden; border:none; border-radius:18px; background-color:#fcfaf5; background-image:url('/images/tables-hero.png'); background-position:center; background-size:cover; background-repeat:no-repeat; color:#29231e;}
    .yoru-tables-hero-content {position:relative; z-index:1; max-width:680px;}
    .yoru-tables-brand {display:flex; align-items:center; gap:14px; font-size:11px; color:#796e62; margin-bottom:20px;}
    .yoru-tables-brand strong {color:#29231e; font-weight:700;}
    .yoru-brand-divider {width:1px; height:15px; background:#c43b2b;}
    .yoru-tables-eyebrow {font-size:12px; font-weight:700; letter-spacing:2px; color:#a93324; margin-bottom:12px;}
    .yoru-tables-hero-title {font-family:Georgia,serif; font-size:clamp(32px,3.5vw,48px); font-weight:500; line-height:1.15; color:#29231e; margin-bottom:14px;}
    .yoru-tables-hero-description {font-size:14px; color:#655b52; max-width:520px; line-height:1.7; margin:0;}
    body.back-office:has(.yoru-tables-page) .site-main > .container-wide {padding-top:16px!important;}
    /* Navigation overlaps hero, without the former top border */
    .yoru-hero-navigation {position:relative; display:flex; justify-content:flex-start; margin:-48px 0 16px 48px; z-index:5; padding:0; border:0;}
    .yoru-hero-nav-buttons {display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:4px; width:min(100%,560px); padding:4px; border:1px solid #e7ded2; border-radius:10px; background:#f8f5ef; box-shadow:0 5px 16px rgba(60,40,25,.07);}
    .yoru-hero-nav-link {display:flex; align-items:center; justify-content:center; gap:9px; padding:13px 15px; border:0; border-radius:7px; background:transparent; color:#625d55; font-family:inherit; font-size:13px; font-weight:600; text-decoration:none; cursor:pointer; transition:background .2s,color .2s;}
    .yoru-hero-nav-link.active {background:#b72f25; color:#fff; box-shadow:0 3px 8px rgba(150,35,25,.16);}
    .yoru-hero-nav-link:hover:not(.active) {background:#eee7dc; color:#29231e;}
    .yoru-hero-nav-link svg {width:16px; height:16px;}
    /* Compact summary cards, full-card Sakura image */
    .yoru-summary {display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-top:0;}
    .yoru-summary-item {position:relative; isolation:isolate; overflow:hidden; display:flex; flex-direction:column; justify-content:center; min-height:105px; padding:15px 20px 15px 82px; border:1px solid #e8ded2; border-radius:12px; background:#fcfaf5; color:#29231e; box-shadow:0 3px 12px rgba(60,40,25,.035); cursor:default;}
    .yoru-summary-dark,.yoru-summary-red,.yoru-summary-light {background:#fcfaf5; color:#29231e; border-color:#e8ded2;}
    .yoru-summary-sakura {position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; opacity:.24; z-index:0; pointer-events:none;}
    .yoru-summary-icon {position:absolute; left:23px; top:50%; transform:translateY(-50%); color:#b72f25; z-index:2;}
    .yoru-summary-icon svg {width:36px; height:36px; stroke-width:1.8;}
    .yoru-summary-number {position:relative; z-index:1; font-family:Georgia,serif; font-size:30px; line-height:1; margin:0 0 4px;}
    .yoru-summary-title {position:relative; z-index:1; font-size:12px; font-weight:700; margin:0;}
    .yoru-summary-desc {position:relative; z-index:1; font-size:11px; margin-top:3px; color:#685b50; opacity:1;}
    .yoru-summary-item:hover {box-shadow:0 3px 12px rgba(60,40,25,.035); border-color:#e8ded2;}
    @@media (max-width:768px) {.yoru-tables-hero {min-height:240px; padding:30px 22px;} .yoru-tables-hero-title {font-size:34px;} .yoru-hero-navigation {margin-left:22px; margin-right:22px;}}
    @@media (max-width:1000px) {.yoru-summary {grid-template-columns:repeat(2,minmax(0,1fr));}}
    @@media (max-width:720px) {.yoru-summary {grid-template-columns:1fr;} .yoru-summary-item {min-height:100px;}}
    @@media (max-width:600px) {.yoru-hero-nav-buttons {width:100%;} .yoru-hero-nav-link {padding:11px 6px; font-size:11px; gap:5px;}}
