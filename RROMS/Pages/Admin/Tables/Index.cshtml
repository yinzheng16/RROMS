        <div class="yoru-wheel-preview" id="yoruWheelPreview">10:00 AM</div>
        <div class="d-flex justify-content-end gap-2"><button type="button" class="yoru-luxury-btn secondary" id="yoruWheelCancel">Cancel</button><button type="button" class="yoru-luxury-btn" id="yoruWheelConfirm">Confirm Time</button></div>
    </div>
</div>


<!-- Delete Table Type Confirmation -->
<div class="modal fade"
     id="deleteTableTypeModal"
     tabindex="-1"
     aria-labelledby="deleteTableTypeTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <form method="post"
              asp-page-handler="DeleteTableType"
              class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteTableTypeTitle">
                    Delete Table Type
                </h2>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden"
                       name="id"
                       id="deleteTableTypeId" />

                <p>
                    Are you sure you want to delete
                    <strong id="deleteTableTypeName"></strong>?
                </p>

                <p id="deleteTableTypeBlocked"
                   class="text-danger small d-none">
                    This table type still contains tables.
                    Delete or move its tables before deleting this type.
                </p>

                <p id="deleteTableTypeWarning"
                   class="text-danger small">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-danger"
                        id="confirmDeleteTableType">
                    Delete Table Type
                </button>
            </div>

        </form>
    </div>
</div>

<!-- Delete table/room confirmation -->
<div class="modal fade" id="deleteTableModal" tabindex="-1" aria-labelledby="deleteTableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="DeleteTable" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteTableTitle">Confirm deletion</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteTableId" />
                <p>Are you sure you want to delete <strong id="deleteTableName"></strong>?</p>
                <p class="text-danger small mb-0">This action cannot be undone. Existing reservations may prevent deletion.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete dining area confirmation -->
<div class="modal fade" id="deleteAreaModal" tabindex="-1" aria-labelledby="deleteAreaTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="DeleteArea" class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteAreaTitle">Delete dining area</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" id="deleteAreaId" />
                <p>Are you sure you want to delete <strong id="deleteAreaName"></strong>?</p>
                <p id="deleteAreaBlocked" class="text-danger small mb-0 d-none">This dining area still contains tables. Remove or move them before deleting the area.</p>
                <p id="deleteAreaWarning" class="text-danger small mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger" id="confirmDeleteArea">Delete area</button>
            </div>
        </form>
    </div>
</div>

<button type="button" id="backToTopBtn" class="yoru-back-to-top" aria-label="Back to top" title="Back to top">
    <i data-lucide="arrow-up"></i>
</button>

@section Scripts {
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script>
        // Fill the modals: "Edit" buttons carry data-* values, "Add" buttons carry none (so the form is cleared).
        function bindModal(modalId, fields) {
            const m = document.getElementById(modalId);
            m.addEventListener('show.bs.modal', e => {
                const d = e.relatedTarget ? e.relatedTarget.dataset : {};
                for (const [name, key, fallback] of fields) {
                    const el = m.querySelector('[name="' + name + '"]');
                    if (!el) continue;
                    const v = d[key] !== undefined ? d[key] : fallback;
                    if (el.type === 'checkbox') el.checked = (v === 'true'); else el.value = v;
                }
            });
        }
        
        
        /* Table Type Drawer controls */
        const typeWorkspace = document.getElementById('yoruTypeWorkspace');
        const typeDrawer = document.getElementById('yoruTypeDrawer');
        const typeDrawerClose = document.getElementById('yoruTypeDrawerClose');
        const typeDrawerCancel = document.getElementById('yoruTypeDrawerCancel');
        let typeDrawerPreviousFocus = null;
        
        function openTypeDrawer() {
            if (typeWorkspace.classList.contains('drawer-open')) {
                return;
            }

            // Close the Table List immediately before opening Type Drawer.
            const panels = document.querySelectorAll('.yoru-inline-table-panel');

            panels.forEach(panel => {
                panel.classList.remove('yoru-list-closing');
                panel.hidden = true;
            });

            document.querySelectorAll('.yoru-type-manage-btn[data-manage-panel]').forEach(button => {
                button.setAttribute('aria-expanded', 'false');
            });

            typeWorkspace.classList.remove('managing-tables');

            // Close the Table Drawer without restoring the previous Table List.
            if (typeWorkspace.classList.contains('table-drawer-open')) {
                previousTablePanelId = null;
                typeWorkspace.classList.remove('table-drawer-open');
                tableDrawer.setAttribute('aria-hidden', 'true');
            }

            typeDrawerPreviousFocus = document.activeElement;

            typeDrawer.setAttribute('aria-hidden', 'false');
            typeWorkspace.classList.add('drawer-open');

            requestAnimationFrame(() => {
                typeDrawer.classList.add('is-open');
                typeDrawer.focus({ preventScroll: true });
            });
        }


        function closeTypeDrawer() {
            if (!typeWorkspace.classList.contains('drawer-open')) {
                return;
            }

            typeDrawer.classList.remove('is-open');
            typeWorkspace.classList.remove('drawer-open');
            typeDrawer.setAttribute('aria-hidden', 'true');

            if (typeDrawerPreviousFocus && typeDrawerPreviousFocus.isConnected) {
                typeDrawerPreviousFocus.focus({ preventScroll: true });
            }
        }

        typeDrawerClose.addEventListener('click', closeTypeDrawer);
        typeDrawerCancel.addEventListener('click', closeTypeDrawer);


        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && typeDrawer.classList.contains('is-open')) {
                closeTypeDrawer();
            }
        });

        
        // Table Type Drawer: Create / Edit
        const tableTypeFormView = document.getElementById('tableTypeFormView');
        const saveTableTypeBtn = document.getElementById('saveTableTypeBtn');

        function showTableTypeForm() {
            tableTypeFormView.classList.remove('d-none');
            saveTableTypeBtn.classList.remove('d-none');
            openTypeDrawer();
        }

        const tableTypeForm = document.getElementById('tableTypeForm');
        const typeFormTitle = document.getElementById('tableTypeFormTitle');
        const firstTableCheckbox = tableTypeForm.querySelector('[name="TableTypeForm.CreateFirstTable"]');
        const firstTableSection = document.getElementById('firstTableNameSection');
        const createFirstSection = document.getElementById('createFirstTableSection');
        const bulkUpdateSection = document.getElementById('bulkUpdateSection');
        const bulkUpdateChoice = document.getElementById('bulkUpdateChoice');

        function setTypeFormValue(field, value) {
            const input = tableTypeForm.querySelector(
                '[name="TableTypeForm.' + field + '"]');

            if (!input) return;

            if (input.type === 'checkbox') {
                input.checked = String(value) === 'true';
            } else {
                input.value = value ?? '';
            }
        }

        const tableTypePhotoInput =
            document.getElementById('tableTypePhotoInput');

        const tableTypePhotoPreview =
            document.getElementById('tableTypePhotoPreview');

        const defaultTableTypePhoto = '/images/tables/standard.jpg';

        let tableTypePhotoPreviewUrl = null;
        let originalTableTypePhoto = defaultTableTypePhoto;

        function setTableTypePhotoPreview(path) {
            if (tableTypePhotoPreviewUrl) {
                URL.revokeObjectURL(tableTypePhotoPreviewUrl);
                tableTypePhotoPreviewUrl = null;
            }

            tableTypePhotoPreview.src = path || defaultTableTypePhoto;
        }

        tableTypePhotoInput.addEventListener('change', function () {
            const file = this.files?.[0];

            if (!file) {
                setTableTypePhotoPreview(originalTableTypePhoto);
                return;
            }

            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

            if (!allowedTypes.includes(file.type) ||
                file.size > 3 * 1024 * 1024) {
                alert('Please choose a JPG, PNG or WEBP image under 3 MB.');
                this.value = '';
                setTableTypePhotoPreview(originalTableTypePhoto);
                return;
            }

            setTableTypePhotoPreview(URL.createObjectURL(file));
            tableTypePhotoPreviewUrl = tableTypePhotoPreview.src;
        });

        function resetTableTypeForm() {
            tableTypeForm.reset();

            setTypeFormValue('Id', '0');
            setTypeFormValue('Name', '');
            setTypeFormValue('Prefix', '');
            setTypeFormValue('StartingNumber', '1');
            setTypeFormValue('NumberPadding', '1');
            setTypeFormValue('DefaultDiningAreaId', '');
            setTypeFormValue('DefaultMinGuests', '1');
            setTypeFormValue('DefaultMaxGuests', '2');
            setTypeFormValue('DefaultMinimumSpend', '');
            setTypeFormValue('Description', '');
            setTypeFormValue('IsActive', 'true');
            setTypeFormValue('CreateFirstTable', 'false');
            setTypeFormValue('FirstTableName', '');
            setTypeFormValue('ApplyToExistingTables', 'false');

            typeFormTitle.textContent = 'Add New Table Type';

            createFirstSection.classList.remove('d-none');
            firstTableSection.classList.add('d-none');
            bulkUpdateSection.classList.add('d-none');
            tableTypePhotoInput.value = '';
            originalTableTypePhoto = defaultTableTypePhoto;
            setTableTypePhotoPreview(originalTableTypePhoto);
        }

        function editTableType(button) {
            const d = button.dataset;

            resetTableTypeForm();

            setTypeFormValue('Id', d.id);
            setTypeFormValue('Name', d.name);
            setTypeFormValue('Prefix', d.prefix);
            setTypeFormValue('StartingNumber', d.start);
            setTypeFormValue('NumberPadding', d.padding);
            setTypeFormValue('DefaultDiningAreaId', d.area);
            setTypeFormValue('DefaultMinGuests', d.min);
            setTypeFormValue('DefaultMaxGuests', d.max);
            setTypeFormValue('DefaultMinimumSpend', d.spend);
            setTypeFormValue('Description', d.desc);
            setTypeFormValue('IsActive', d.active);

            tableTypePhotoInput.value = '';
            originalTableTypePhoto = d.photo || defaultTableTypePhoto;
            setTableTypePhotoPreview(originalTableTypePhoto);
            typeFormTitle.textContent = 'Edit Table Type: ' + d.name;

            createFirstSection.classList.add('d-none');
            firstTableSection.classList.add('d-none');
            bulkUpdateSection.classList.remove('d-none');
        }
        
        document.querySelectorAll('.yoru-edit-type').forEach(button => {
            button.addEventListener('click', () => {
                editTableType(button);

                document.getElementById('yoruTypeDrawerTitle').textContent =
                    'Edit Table Type';

                showTableTypeForm();
            });
        });
        
        document.getElementById('openAddTableTypeDrawer')
            .addEventListener('click', () => {
                resetTableTypeForm();

                document.getElementById('yoruTypeDrawerTitle').textContent =
                    'Add Table Type';

                showTableTypeForm();
            });
       
        firstTableCheckbox.addEventListener('change', () => {
            const isChecked = firstTableCheckbox.checked;

            firstTableSection.classList.toggle('d-none', !isChecked);

            if (isChecked) {
                requestAnimationFrame(() => {
                    const drawerBody = document.getElementById('yoruTypeDrawerBody');

                    drawerBody.scrollTo({
                        top: drawerBody.scrollHeight,
                        behavior: 'smooth'
                    });
                });
            }
        });

        // Confirm bulk update before submitting the form.
        tableTypeForm.addEventListener('submit', e => {
            const isEditingType =
                Number(tableTypeForm.querySelector('[name="TableTypeForm.Id"]').value) > 0;

            if (isEditingType && bulkUpdateChoice.value === 'true') {
                const confirmed = window.confirm(
                    'Apply the new dining area, guest capacity and minimum spend ' +
                    'to ALL existing tables of this type? ' +
                    'This may affect existing reservations.'
                );

                if (!confirmed) {
                    e.preventDefault();
                }
            }
        });

        // Dining Area Drawer - independent of Table Types
        const yoruAreaOverlay = document.getElementById('yoruAreaDrawerOverlay');
        const yoruAreaModal = document.getElementById('areaModal');
        const yoruAreaIconField = document.getElementById('yoruAreaIconName');
        const yoruAreaNameField = yoruAreaModal.querySelector('[name="AreaForm.Name"]');
        const yoruAreaStatusMode = document.getElementById('yoruAreaStatusMode');
        const yoruAreaManualStatus = document.getElementById('yoruAreaManualStatus');
        const yoruAreaManualWrap = document.getElementById('yoruAreaManualStatusWrap');

        let yoruIconManuallyChosen = false;
        let yoruAreaPreviousFocus = null;

        function yoruSuggestIcon(name) {
            name = (name || '').toLowerCase();
            if (/bar|counter/.test(name)) return 'wine';
            if (/private|vip|room/.test(name)) return 'door-closed';
            if (/outdoor|garden|terrace/.test(name)) return 'trees';
            if (/roof/.test(name)) return 'sunset';
            if (/cafe|coffee/.test(name)) return 'coffee';
            if (/lounge/.test(name)) return 'sofa';
            if (/hall|dining/.test(name)) return 'utensils-crossed';
            return 'layout-grid';
        }

        function yoruSelectIcon(icon, manual = false) {
            yoruAreaIconField.value = icon;
            if (manual) yoruIconManuallyChosen = true;

            yoruAreaModal.querySelectorAll('[data-icon-choice]').forEach(btn => {
                const selected = btn.dataset.iconChoice === icon;
                btn.classList.toggle('selected', selected);
                btn.setAttribute('aria-pressed', String(selected));
            });
        }

        function yoruSyncAreaStatus() {
            const manual = yoruAreaStatusMode.value === 'Manual';
            yoruAreaManualWrap.hidden = !manual;
            yoruAreaManualStatus.disabled = !manual;
        }

        function yoruOpenAreaDrawer(trigger) {
            const data = trigger.dataset;
            const isEdit = Boolean(data.id);

            yoruAreaPreviousFocus = trigger;

            yoruAreaModal.querySelector('[name="AreaForm.Id"]').value = data.id || '0';
            yoruAreaNameField.value = data.name || '';
            yoruAreaModal.querySelector('[name="AreaForm.Description"]').value = data.desc || '';

            document.getElementById('areaTitle').textContent =
                isEdit ? 'Edit Dining Area' : 'Add Dining Area';

            yoruIconManuallyChosen = isEdit;
            yoruSelectIcon(data.icon || yoruSuggestIcon(data.name || ''));

            yoruAreaStatusMode.value =
                data.statusMode === 'Manual' ? 'Manual' : 'Auto';

            yoruAreaManualStatus.value =
                data.manualStatus === 'Occupied' ? 'Occupied' : 'Available';

            yoruSyncAreaStatus();

            yoruAreaOverlay.hidden = false;
            document.body.classList.add('yoru-area-drawer-active');

            requestAnimationFrame(() => {
                yoruAreaOverlay.classList.add('is-open');
                yoruAreaNameField.focus();
            });
        }

        function yoruCloseAreaDrawer() {
            if (yoruAreaOverlay.hidden) return;

            yoruAreaOverlay.classList.remove('is-open');
            document.body.classList.remove('yoru-area-drawer-active');

            const drawer = yoruAreaModal;
            const finishClose = () => {
                yoruAreaOverlay.hidden = true;
                yoruAreaPreviousFocus?.focus();
            };

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                finishClose();
            } else {
                drawer.addEventListener('transitionend', finishClose, { once: true });
            }
        }

        document.addEventListener('keydown', e => {
            if (yoruAreaOverlay.hidden) return;

            if (e.key === 'Escape') {
                e.preventDefault();
                yoruCloseAreaDrawer();
            }

            if (e.key === 'Tab') {
                const controls = Array.from(
                    yoruAreaModal.querySelectorAll(
                        'button:not([disabled]), input:not([disabled]):not([type="hidden"]), textarea:not([disabled]), select:not([disabled])'
                    )
                ).filter(el => el.getClientRects().length);

                const first = controls[0];
                const last = controls[controls.length - 1];

                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault();
                    first.focus();
                }
            }
        });


        // Weekly schedule: view/edit, rollback, wheel picker
        const yoruHoursForm = document.getElementById('hoursForm');
        const yoruHoursSection = document.getElementById('opening-hours-section');
        const yoruHourRows = Array.from(yoruHoursForm.querySelectorAll('.yoru-hours-row'));
        const yoruEditHours = document.getElementById('yoruEditHours');
        const yoruCancelHours = document.getElementById('yoruCancelHours');
        const yoruSaveHours = document.getElementById('yoruSaveHours');
        const yoruWheelOverlay = document.getElementById('yoruWheelOverlay');
        const yoruWheelHour = document.getElementById('yoruWheelHour');
        const yoruWheelMinute = document.getElementById('yoruWheelMinute');
        const yoruWheelPeriod = document.getElementById('yoruWheelPeriod');
        let yoruOriginalHours = [];
        let yoruActiveTimeInput = null;
        let yoruLastFocus = null;
        let yoruWheelValues = {hour:'10', minute:'00', period:'AM'};
        const yoruPad = n => String(n).padStart(2, '0');
        function yoruTimeText(value) {
            if (!value) return '—';
            const parts = value.split(':');
            const h = Number(parts[0]);
            if (!Number.isFinite(h)) return value;
            return `${h % 12 || 12}:${parts[1] || '00'} ${h >= 12 ? 'PM' : 'AM'}`;
        }
        
        function yoruRenderTimeline() {
            const container = document.getElementById('yoruWeeklyTimeline');
            if (!container) return;

            const toMinutes = value => {
                const parts = (value || '').split(':');
                if (parts.length < 2) return NaN;
                return Number(parts[0]) * 60 + Number(parts[1]);
            };

            const scale = document.createElement('div');
            scale.className = 'yoru-timeline-scale';
            ['00:00', '06:00', '12:00', '18:00', '24:00'].forEach(label => {
                const span = document.createElement('span');
                span.textContent = label;
                scale.appendChild(span);
            });

            container.replaceChildren(scale);

            yoruHourRows.forEach(row => {
                const day = row.querySelector('.yoru-hours-day')
                    .firstChild.textContent.trim();

                const open = row.querySelector('[name$=".OpenTime"]').value;
                const close = row.querySelector('[name$=".CloseTime"]').value;
                const closed = row.querySelector('[name$=".IsClosed"]').checked;

                const item = document.createElement('div');
                item.className = 'yoru-timeline-row' + (closed ? ' is-closed' : '');

                const dayLabel = document.createElement('span');
                dayLabel.className = 'yoru-timeline-day';
                dayLabel.textContent = day.slice(0, 3);

                const track = document.createElement('div');
                track.className = 'yoru-timeline-track';

                const tooltip = document.createElement('div');
                tooltip.className = 'yoru-timeline-tooltip';

                if (closed) {
                    const closedLabel = document.createElement('span');
                    closedLabel.className = 'yoru-timeline-closed';
                    closedLabel.textContent = 'CLOSED';
                    track.appendChild(closedLabel);
                    tooltip.textContent = 'Closed for the day';
                } else {
                    const start = toMinutes(open);
                    const end = toMinutes(close);

                    if (Number.isFinite(start) && Number.isFinite(end)) {
                        const duration = end > start
                            ? end - start
                            : end < start
                                ? 1440 - start + end
                                : 1440;

                        const bar = document.createElement('div');
                        bar.className = 'yoru-timeline-bar';

                        // A bar crossing midnight is split into two parts.
                        const firstDuration = Math.min(duration, 1440 - start);
                        bar.style.left = `${start / 1440 * 100}%`;
                        bar.style.width = `${firstDuration / 1440 * 100}%`;
                        track.appendChild(bar);

                        if (duration > firstDuration) {
                            const secondBar = document.createElement('div');
                            secondBar.className = 'yoru-timeline-bar';
                            secondBar.style.left = '0%';
                            secondBar.style.width =
                                `${(duration - firstDuration) / 1440 * 100}%`;
                            track.appendChild(secondBar);
                        }
                    }

                    tooltip.textContent = `${yoruTimeText(open)} – ${yoruTimeText(close)}`;
                }

                item.title = `${day}: ${tooltip.textContent}`;
                item.append(dayLabel, track, tooltip);
                container.appendChild(item);
            });
        }
        function yoruRefreshHours() {
            let closed = 0;
            yoruHourRows.forEach(row => {
                const open = row.querySelector('[name$=".OpenTime"]');
                const close = row.querySelector('[name$=".CloseTime"]');
                const check = row.querySelector('[name$=".IsClosed"]');
                const isClosed = check.checked;
                if (isClosed) closed++;
                row.classList.toggle('yoru-day-closed', isClosed);
                row.querySelector('[data-time-view="open"]').textContent = yoruTimeText(open.value);
                row.querySelector('[data-time-view="close"]').textContent = yoruTimeText(close.value);
                row.querySelector('[data-time-edit="open"]').textContent = yoruTimeText(open.value);
                row.querySelector('[data-time-edit="close"]').textContent = yoruTimeText(close.value);
                row.querySelector('[data-hours-status]').textContent = isClosed ? 'Closed' : 'Open';
                row.querySelector('.yoru-hours-status').classList.toggle('is-closed', isClosed);
            });
            document.getElementById('yoruHoursSummary').textContent = `${yoruHourRows.length - closed} operating days · ${closed} closed days`;
            yoruRenderTimeline();
        }
        function yoruToggleEdit(on) {
            yoruHoursSection.classList.toggle('yoru-hours-editing', on);
            yoruEditHours.classList.toggle('d-none', on);
            yoruCancelHours.classList.toggle('d-none', !on);
            yoruSaveHours.classList.toggle('d-none', !on);
        }
        yoruEditHours.addEventListener('click', () => {
            yoruOriginalHours = yoruHourRows.map(row => ({open:row.querySelector('[name$=".OpenTime"]').value, close:row.querySelector('[name$=".CloseTime"]').value, closed:row.querySelector('[name$=".IsClosed"]').checked}));
            yoruToggleEdit(true);
        });
        yoruCancelHours.addEventListener('click', () => {
            yoruHourRows.forEach((row, i) => {
                row.querySelector('[name$=".OpenTime"]').value = yoruOriginalHours[i].open;
                row.querySelector('[name$=".CloseTime"]').value = yoruOriginalHours[i].close;
                row.querySelector('[name$=".IsClosed"]').checked = yoruOriginalHours[i].closed;
            });
            yoruCloseWheel(); yoruRefreshHours(); yoruToggleEdit(false);
        });
        yoruHourRows.forEach(row => {
            row.querySelector('[name$=".IsClosed"]').addEventListener('change', yoruRefreshHours);
            row.querySelectorAll('[data-time-edit]').forEach(button => button.addEventListener('click', () => {
                const field = button.dataset.timeEdit === 'open' ? '.OpenTime' : '.CloseTime';
                yoruOpenWheel(row.querySelector(`[name$="${field}"]`), button);
            }));
        });
        function yoruBuildWheel(col, values, field) {
            col.innerHTML = '';
            const spacer1 = document.createElement('div'); spacer1.className = 'yoru-wheel-spacer'; col.appendChild(spacer1);
            values.forEach(value => {
                const item = document.createElement('div'); item.className = 'yoru-wheel-option'; item.dataset.value = value; item.textContent = value;
                item.addEventListener('click', () => { col.scrollTo({top:values.indexOf(value) * 44, behavior:'smooth'}); });
                col.appendChild(item);
            });
            const spacer2 = document.createElement('div'); spacer2.className = 'yoru-wheel-spacer'; col.appendChild(spacer2);
            let raf = 0;
            col.addEventListener('scroll', () => {
                cancelAnimationFrame(raf);
                raf = requestAnimationFrame(() => {
                    const index = Math.max(0, Math.min(values.length-1, Math.round(col.scrollTop / 44)));
                    yoruWheelValues[field] = values[index];
                    col.querySelectorAll('.yoru-wheel-option').forEach((el,i) => el.classList.toggle('selected', i === index));
                    yoruWheelPreview();
                });
            }, {passive:true});
        }
        function yoruWheelPreview() { document.getElementById('yoruWheelPreview').textContent = `${yoruWheelValues.hour}:${yoruWheelValues.minute} ${yoruWheelValues.period}`; }
        function yoruSetWheel(col, value, field) {
            const index = Array.from(col.querySelectorAll('.yoru-wheel-option')).findIndex(el => el.dataset.value === value);
            col.scrollTop = Math.max(0,index) * 44;
            yoruWheelValues[field] = value;
            col.querySelectorAll('.yoru-wheel-option').forEach(el => el.classList.toggle('selected',el.dataset.value === value));
        }
        yoruBuildWheel(yoruWheelHour, Array.from({length:12},(_,i)=>yoruPad(i+1)), 'hour');
        yoruBuildWheel(yoruWheelMinute, Array.from({length:60},(_,i)=>yoruPad(i)), 'minute');
        yoruBuildWheel(yoruWheelPeriod, ['AM','PM'], 'period');
        function yoruOpenWheel(input, trigger) {
            yoruActiveTimeInput = input; yoruLastFocus = trigger;
            const parts = (input.value || '10:00').split(':');
            const h = Number(parts[0]);
            yoruWheelOverlay.classList.add('show'); yoruWheelOverlay.setAttribute('aria-hidden','false');
            document.getElementById('yoruWheelTitle').textContent = input.name.endsWith('.OpenTime') ? 'Opening Time' : 'Closing Time';
            yoruSetWheel(yoruWheelHour, yoruPad(h % 12 || 12), 'hour');
            yoruSetWheel(yoruWheelMinute, parts[1] || '00', 'minute');
            yoruSetWheel(yoruWheelPeriod, h >= 12 ? 'PM' : 'AM', 'period');
            yoruWheelPreview(); document.getElementById('yoruWheelClose').focus();
        }
        function yoruCloseWheel() { yoruWheelOverlay.classList.remove('show'); yoruWheelOverlay.setAttribute('aria-hidden','true'); yoruActiveTimeInput = null; if (yoruLastFocus) yoruLastFocus.focus(); }
        document.getElementById('yoruWheelClose').addEventListener('click', yoruCloseWheel);
        document.getElementById('yoruWheelCancel').addEventListener('click', yoruCloseWheel);
        yoruWheelOverlay.addEventListener('click', e => { if (e.target === yoruWheelOverlay) yoruCloseWheel(); });
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && yoruWheelOverlay.classList.contains('show')) { e.stopPropagation(); yoruCloseWheel(); } });
        document.getElementById('yoruWheelConfirm').addEventListener('click', () => {
            if (!yoruActiveTimeInput) return;
            let h = Number(yoruWheelValues.hour) % 12;
            if (yoruWheelValues.period === 'PM') h += 12;
            yoruActiveTimeInput.value = `${yoruPad(h)}:${yoruWheelValues.minute}`;
            yoruCloseWheel(); yoruRefreshHours();
        });
        yoruRefreshHours();
        
        
        // Table List + Table Drawer
        const tableWorkspace = document.getElementById('yoruTypeWorkspace');
        const tableDrawer = document.getElementById('tableModal');
        const tableAccordion = document.getElementById('tableTypeAccordion');
        let previousTablePanelId = null;
        let tableDrawerPreviousFocus = null; 
        
        
        function showTablePanel(panelId) {
            const panels = document.querySelectorAll('.yoru-inline-table-panel');
            const currentPanel = Array.from(panels).find(panel => !panel.hidden);

            const finishChange = () => {
                panels.forEach(panel => {
                    panel.classList.remove('yoru-list-closing');
                    panel.hidden = panel.id !== panelId;
                });

                document.querySelectorAll('.yoru-type-manage-btn[data-manage-panel]').forEach(button => {
                    button.setAttribute('aria-expanded', String(button.dataset.managePanel === panelId));
                });

                tableWorkspace.classList.toggle('managing-tables', Boolean(panelId));
            };

            if (!panelId && currentPanel) {
                if (currentPanel.classList.contains('yoru-list-closing')) return;

                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    finishChange();
                    return;
                }

                currentPanel.classList.add('yoru-list-closing');

                currentPanel.addEventListener('animationend', event => {
                    if (event.target !== currentPanel) return;
                    if (event.animationName !== 'yoruTableListExit') return;

                    // Do not restore Table List while Type Drawer is open.
                    if (tableWorkspace.classList.contains('drawer-open')) {
                        return;
                    }

                    finishChange();
                }, { once: true });

                return;
            }

            finishChange();
        }


        function openTableDrawer(trigger) {
            tableDrawerPreviousFocus = document.activeElement;

            if (tableWorkspace.classList.contains('drawer-open')) {
                closeTypeDrawer();
            }

            const openPanel = tableAccordion.querySelector('.yoru-inline-table-panel:not([hidden])');
            previousTablePanelId = openPanel?.id || null;

            if (trigger?.dataset.id) {
                const matchingPanel = trigger.closest('.yoru-inline-table-panel');
                if (matchingPanel) showTablePanel(matchingPanel.id);
            } else if (!openPanel) {
                const firstPanel = tableAccordion.querySelector('.yoru-inline-table-panel');
                if (firstPanel) showTablePanel(firstPanel.id);
            }

            // Reuse existing Add/Edit form-population logic.
            const event = new Event('show.bs.modal');
            Object.defineProperty(event, 'relatedTarget', { value: trigger || null });
            tableDrawer.dispatchEvent(event);

            const editing = Boolean(trigger?.dataset.id);
            
            tableDrawer.classList.toggle('yoru-edit-mode', editing);
            const statusSelect = tableDrawer.querySelector('[name="TableForm.Status"]');

            if (statusSelect) {
                statusSelect.value = editing
                    ? (trigger.dataset.status || 'Available')
                    : 'Available';

                if (editing && !Array.from(statusSelect.options).some(option => option.value === statusSelect.value)) {
                    const selectedOption = Array.from(statusSelect.options)
                        .find(option => option.text.trim() === trigger.dataset.status);

                    if (selectedOption) statusSelect.value = selectedOption.value;
                }
            }
            const title = document.getElementById('tableTitle');
            title.textContent = editing ? 'Edit Table — ' + trigger.dataset.number : 'Add New Table';

            const submit = tableDrawer.querySelector('button[type="submit"]');
            if (submit) submit.textContent = editing ? 'Save Changes' : 'Create Table';

            tableDrawer.setAttribute('aria-hidden', 'false');
            tableWorkspace.classList.add('table-drawer-open');

            requestAnimationFrame(() => tableDrawer.focus({ preventScroll: true }));
        }

        function closeTableDrawer() {
            tableWorkspace.classList.remove('table-drawer-open');
            tableDrawer.setAttribute('aria-hidden', 'true');

            if (previousTablePanelId) {
                showTablePanel(previousTablePanelId);
            } else {
                showTablePanel(null);
            }

            if (tableDrawerPreviousFocus?.isConnected) {
                tableDrawerPreviousFocus.focus({ preventScroll: true });
            }
        }

        document.querySelectorAll('.yoru-type-manage-btn[data-manage-panel]').forEach(button => {
            button.addEventListener('click', () => {
                const panel = document.getElementById(button.dataset.managePanel);
                if (!panel) return;

                const shouldOpen = panel.hidden;

                if (tableWorkspace.classList.contains('drawer-open')) {
                    closeTypeDrawer();
                }

                if (tableWorkspace.classList.contains('table-drawer-open')) {
                    previousTablePanelId = null;
                    tableWorkspace.classList.remove('table-drawer-open');
                    tableDrawer.setAttribute('aria-hidden', 'true');
                }

                showTablePanel(shouldOpen ? panel.id : null);
            });
        });
             
        document.querySelectorAll('.yoru-inline-close').forEach(button => {
            button.addEventListener('click', () => {
                if (tableWorkspace.classList.contains('table-drawer-open')) {
                    previousTablePanelId = null;
                    closeTableDrawer();
                }

                showTablePanel(null);
            });
        });

        document.getElementById('openAddTableDrawer')?.addEventListener('click', event => {
            openTableDrawer(event.currentTarget);
        });

        document.querySelectorAll('.yoru-open-edit-table').forEach(button => {
            button.addEventListener('click', () => openTableDrawer(button));
        });

        tableDrawer.querySelectorAll('[data-close-table-drawer]').forEach(button => {
            button.addEventListener('click', closeTableDrawer);
        });

        bindModal('tableModal', [['TableForm.Id','id','0'], ['TableForm.TableNumber','number',''], ['TableForm.Type','type','2'], ['TableForm.TableTypeDefinitionId', 'dynamicType', ''],
            ['TableForm.DiningAreaId','area',''], ['TableForm.MinGuests','min','1'], ['TableForm.Capacity','max','2'],
            ['TableForm.MinimumSpend','spend','0'], ['TableForm.Description','desc',''], ['TableForm.IsActive','active','true']]);
        
        // Apply defaults when adding a table or changing its type. Existing table values remain intact on Edit.
        const tableModal = document.getElementById('tableModal');
        const dynamicTypeField = tableModal.querySelector('[name="TableForm.TableTypeDefinitionId"]');
        const legacyTypeField = tableModal.querySelector('[name="TableForm.Type"]');
        const nameField = tableModal.querySelector('[name="TableForm.TableNumber"]');
        const areaField = tableModal.querySelector('[name="TableForm.DiningAreaId"]');
        const minField = tableModal.querySelector('[name="TableForm.MinGuests"]');
        const maxField = tableModal.querySelector('[name="TableForm.Capacity"]');
        const spendField = tableModal.querySelector('[name="TableForm.MinimumSpend"]');
        const activeField = tableModal.querySelector('[name="TableForm.IsActive"]');
        const descriptionField = tableModal.querySelector('[name="TableForm.Description"]');
        const existingTables = Array.from(document.querySelectorAll('.yoru-table-row') ).map(row => row.dataset.name.toUpperCase());
        let isEditing = false;
        let nameWasEdited = false;
        function nextLocalTableName(option) {
            const prefix = option.dataset.prefix || '';
            const start = Number(option.dataset.start || 1);
            const padding = Number(option.dataset.padding || 1);

            const used = new Set(existingTables);
            let number = start;

            while (used.has(
                (prefix + String(number).padStart(padding, '0')).toUpperCase()
            )) {
                number++;
            }

            return prefix + String(number).padStart(padding, '0');
        }
        function applyDynamicTypeDefaults() {
            if (isEditing) return;

            const option = dynamicTypeField.selectedOptions[0];
            if (!option || !option.value) {
                nameField.value = '';
                return;
            }

            areaField.value = option.dataset.area || '';
            minField.value = option.dataset.min || '1';
            maxField.value = option.dataset.max || '2';
            spendField.value = option.dataset.spend || '0';
            descriptionField.value = '';
            activeField.checked = true;

            if (!nameWasEdited) {
                nameField.value = nextLocalTableName(option);
            }

            // Legacy enum remains for backward compatibility.
            // Dynamic TableTypeDefinitionId is the authoritative type.
            legacyTypeField.value = '2';
        }

        tableModal.addEventListener('show.bs.modal', e => {
            const data = e.relatedTarget?.dataset || {};

            isEditing = !!data.id;
            nameWasEdited = isEditing;

            tableModal.classList.toggle('yoru-edit-mode', isEditing);

            if (isEditing) {
                // An inactive type must still be visible for an existing table.
                const selectedId = String(data.dynamicType || '');

                if (selectedId && !Array.from(dynamicTypeField.options)
                    .some(option => option.value === selectedId)) {

                    const option = document.createElement('option');
                    option.value = selectedId;
                    option.textContent = 'Current inactive table type';
                    dynamicTypeField.appendChild(option);
                }

                Array.from(dynamicTypeField.options).forEach(option => {
                    option.disabled = option.dataset.inactive === 'true';
                });
                
                const currentOption = Array.from(dynamicTypeField.options)
                    .find(option => option.value === selectedId);

                if (currentOption) {
                    currentOption.disabled = false;
                }
                
                dynamicTypeField.value = selectedId;
            } else {
                Array.from(dynamicTypeField.options).forEach(option => {
                    option.disabled = option.dataset.inactive === 'true';
                });

                nameWasEdited = false;

                
                const openPanel = tableAccordion.querySelector('.yoru-inline-table-panel:not([hidden])');

                const selectedTypeId = openPanel
                    ? openPanel.id.replace('modal-tables-type-', '')
                    : '';

                const matchingOption = Array.from(dynamicTypeField.options)
                    .find(option => option.value === selectedTypeId && !option.disabled);

                const firstActiveOption = Array.from(dynamicTypeField.options)
                    .find(option => option.value && !option.disabled);

                dynamicTypeField.value = matchingOption
                    ? matchingOption.value
                    : (firstActiveOption ? firstActiveOption.value : '');

                applyDynamicTypeDefaults();

            }
        });

        dynamicTypeField.addEventListener('change', () => {
            if (!isEditing) {
                nameWasEdited = false;
                applyDynamicTypeDefaults();
            }
        });

        nameField.addEventListener('input', () => {
            if (!isEditing) {
                nameWasEdited = true;
            }
        });

        // Delete Table Type confirmation
        document.getElementById('deleteTableTypeModal')
            .addEventListener('show.bs.modal', e => {

                const data = e.relatedTarget.dataset;
                const hasTables = data.hasTables === 'true';

                document.getElementById('deleteTableTypeId').value = data.id;

                document.getElementById('deleteTableTypeName').textContent =
                    data.name;

                document.getElementById('deleteTableTypeBlocked')
                    .classList.toggle('d-none', !hasTables);

                document.getElementById('deleteTableTypeWarning')
                    .classList.toggle('d-none', hasTables);

                document.getElementById('confirmDeleteTableType').disabled =
                    hasTables;
            });

        document.getElementById('deleteTableModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;

                document.getElementById('deleteTableId').value = data.id;

                document.getElementById('deleteTableName').textContent =
                    `${data.kind} ${data.number}`;
            });

        document.getElementById('deleteAreaModal')
            .addEventListener('show.bs.modal', e => {
                const data = e.relatedTarget.dataset;
                const hasTables = data.hasTables === 'true';

                document.getElementById('deleteAreaId').value = data.id;
                document.getElementById('deleteAreaName').textContent = data.name;

                document.getElementById('deleteAreaBlocked')
                    .classList.toggle('d-none', !hasTables);

                document.getElementById('deleteAreaWarning')
                    .classList.toggle('d-none', hasTables);

                document.getElementById('confirmDeleteArea').disabled = hasTables;
            });

        function setupPagination(container, rowSelector, filterFunction) {
            const rows = Array.from(container.querySelectorAll(rowSelector));
            const info = container.querySelector('.yoru-page-info');
            const prev = container.querySelector('.yoru-prev');
            const next = container.querySelector('.yoru-next');

            if (!info || !prev || !next) return null;

            let page = 1;
            const pageSize = 5;

            function update(reset = false) {
                if (reset) page = 1;

                const matching = rows.filter(filterFunction);
                const totalPages = Math.max(1, Math.ceil(matching.length / pageSize));

                page = Math.min(page, totalPages);

                rows.forEach(row => {
                    row.style.display = 'none';
                });

                matching
                    .slice((page - 1) * pageSize, page * pageSize)
                    .forEach(row => {
                        row.style.display = '';
                    });

                info.textContent = matching.length
                    ? `Page ${page} of ${totalPages} · ${matching.length} results`
                    : 'No matching results';

                prev.disabled = page <= 1;
                next.disabled = page >= totalPages;
            }

            prev.addEventListener('click', () => {
                if (page > 1) {
                    page--;
                    update();
                }
            });

            next.addEventListener('click', () => {
                page++;
                update();
            });

            update();

            return () => update(true);
        }

        document.querySelectorAll('.yoru-type-detail').forEach(panel => {
            const search = panel.querySelector('.yoru-table-search');
            const status = panel.querySelector('.yoru-table-status-filter');
            const active = panel.querySelector('.yoru-table-active-filter');

            if (!search || !status || !active) return;

            const refresh = setupPagination(
                panel,
                '.yoru-table-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(search.value.trim().toLowerCase());

                    const matchesStatus =
                        !status.value || row.dataset.status === status.value;

                    const matchesActive =
                        !active.value || row.dataset.active === active.value;

                    return matchesName && matchesStatus && matchesActive;
                }
            );

            if (!refresh) return;

            search.addEventListener('input', () => refresh(true));
            status.addEventListener('change', () => refresh(true));
            active.addEventListener('change', () => refresh(true));
        });

        const areaSearch = document.getElementById('areaSearch');
        const areaFilter = document.getElementById('areaFilter');
        const areaPagination = document.getElementById('areaPagination');

        if (areaSearch && areaFilter && areaPagination) {
            const areaSection = areaPagination.closest('.card');

            const refreshAreas = setupPagination(
                areaSection,
                '.yoru-area-row',
                row => {
                    const matchesName = (row.dataset.name || '')
                        .toLowerCase()
                        .includes(areaSearch.value.trim().toLowerCase());

                    const count = Number(row.dataset.count);

                    const matchesFilter =
                        !areaFilter.value ||
                        (areaFilter.value === 'with' && count > 0) ||
                        (areaFilter.value === 'empty' && count === 0);

                    return matchesName && matchesFilter;
                }
            );

            if (refreshAreas) {
                areaSearch.addEventListener('input', refreshAreas);
                areaFilter.addEventListener('change', refreshAreas);
            }
        }
        
        /* Table Types: Search and Filters */     
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('tableTypeSearch');
            const statusFilter = document.getElementById('tableTypeStatusFilter');
            const areaFilter = document.getElementById('tableTypeAreaFilter');
            const resultCount = document.getElementById('tableTypeSearchCount');
            const noResults = document.getElementById('tableTypeNoResults');
            const clearButton = document.getElementById('clearTableTypeFilters');

            const pagination = document.getElementById('tableTypePagination');
            const pageInfo = document.getElementById('tableTypePageInfo');
            const prevButton = document.getElementById('tableTypePrevPage');
            const nextButton = document.getElementById('tableTypeNextPage');

            const cards = Array.from(
                document.querySelectorAll('#tables-section .yoru-type-grid > .yoru-type-card')
            );

            if (!searchInput || !statusFilter || !areaFilter) return;

            const pageSize = 5;
            let currentPage = 1;

            function applyTableTypeFilters(resetPage = false) {
                if (resetPage) currentPage = 1;

                const query = searchInput.value.trim().toLocaleLowerCase();
                const status = statusFilter.value;
                const area = areaFilter.value;

                const filteredCards = cards.filter(card => {
                    const typeName = (card.dataset.typeName || '').toLocaleLowerCase();
                    const tableNames = (card.dataset.tableNames || '').toLocaleLowerCase();

                    const matchesSearch = !query ||
                        typeName.includes(query) ||
                        tableNames.includes(query);

                    const matchesStatus = status === 'all' ||
                        card.dataset.typeStatus === status;

                    const matchesArea = area === 'all' ||
                        card.dataset.areaId === area;

                    return matchesSearch && matchesStatus && matchesArea;
                });

                const totalPages = Math.max(1, Math.ceil(filteredCards.length / pageSize));
                currentPage = Math.min(currentPage, totalPages);

                cards.forEach(card => {
                    card.hidden = true;
                });

                const start = (currentPage - 1) * pageSize;

                filteredCards.slice(start, start + pageSize).forEach(card => {
                    card.hidden = false;
                });

                resultCount.textContent =
                    `Showing ${filteredCards.length} of ${cards.length} table types`;

                noResults.hidden = filteredCards.length !== 0;

                pagination.hidden = filteredCards.length <= pageSize;

                pageInfo.textContent =
                    `Page ${currentPage} of ${totalPages} · ${filteredCards.length} results`;

                prevButton.disabled = currentPage === 1;
                nextButton.disabled = currentPage === totalPages;
            }

            searchInput.addEventListener('input', () => applyTableTypeFilters(true));
            statusFilter.addEventListener('change', () => applyTableTypeFilters(true));
            areaFilter.addEventListener('change', () => applyTableTypeFilters(true));

            clearButton.addEventListener('click', () => {
                searchInput.value = '';
                statusFilter.value = 'all';
                areaFilter.value = 'all';
                applyTableTypeFilters(true);
                searchInput.focus();
            });

            prevButton.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    applyTableTypeFilters();
                }
            });

            nextButton.addEventListener('click', () => {
                currentPage++;
                applyTableTypeFilters();
            });

            applyTableTypeFilters();
        });

    </script>

    <script>
        if (window.lucide) {
            lucide.createIcons();
        } else {
            console.error("Lucide Icons failed to load.");
