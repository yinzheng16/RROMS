@page
@model RROMS.Pages.Admin.Tables.IndexModel
@using RROMS.Models
@{
    ViewData["Title"] = "Tables and opening hours";
}
<style>
    html.yoru-restoring-view {visibility:hidden;}
</style>

<script>
    (() => {
        const key = 'yoruTablesView:' + location.pathname;

        try {
            const raw = sessionStorage.getItem(key);

            sessionStorage.removeItem(key);

            if (!raw) {
                return;
            }

            const state = JSON.parse(raw);

            if (!state ||
                !Number.isFinite(state.savedAt) ||
                Date.now() - state.savedAt > 60000) {
                return;
            }

            window.yoruPendingView = state;

            if (['tables', 'areas', 'hours'].includes(state.tab)) {
                sessionStorage.setItem('yoruActiveTab', state.tab);
            }

            document.documentElement.classList.add(
                'yoru-restoring-view'
            );

            // Avoid leaving the page hidden if another script fails.
            setTimeout(() => {
                document.documentElement.classList.remove(
                    'yoru-restoring-view'
                );
            }, 4000);
        } catch {
            document.documentElement.classList.remove(
                'yoru-restoring-view'
            );
        }
    })();
</script>
<!-- Tables & Opening Hours Hero Header -->
<div class="yoru-tables-hero yoru-tables-page mb-4">

