        function updateTableSummary(option) {
            const photo = document.getElementById('tableSummaryPhoto');
            const noPhoto = document.getElementById('tableSummaryNoPhoto');
            const d = option?.value ? option.dataset : {};
            const hasPhoto = Boolean(d.photo);

            document.getElementById('yoruTableSummaryBox')
                ?.classList.toggle('is-empty', !option?.value);

            if (hasPhoto) photo.src = d.photo; else photo.removeAttribute('src');
            photo.hidden = !hasPhoto;
