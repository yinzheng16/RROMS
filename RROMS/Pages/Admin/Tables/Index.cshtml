            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-danger"
                        id="confirmDeleteTableType">
                    Delete Table Type
                </button>
            </div>

        </form>
    </div>
</div>

