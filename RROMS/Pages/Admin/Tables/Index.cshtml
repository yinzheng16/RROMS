                    <input type="text" class="form-control" name="SpecialDateInput.Name" id="yoruSpecialName" maxlength="100" placeholder="e.g. Christmas Day" required />
                </section>

                <div class="form-check yoru-sd-closed">
                    <input type="checkbox" class="form-check-input" name="SpecialDateInput.IsClosed" value="true" id="yoruSpecialClosed" />
                    <label class="form-check-label" for="yoruSpecialClosed">Closed for the whole day</label>
                </div>

                <section id="yoruSpecialTimeFields" class="yoru-sd-card">
                    <div class="yoru-sd-sechead"><span class="yoru-sd-ico wine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span><h4 class="yoru-sd-tag">Special Opening Hours</h4></div>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label for="yoruSpecialOpen" class="form-label">Opening Time</label>
                            <input type="time" class="form-control" name="SpecialDateInput.OpenTime" id="yoruSpecialOpen" value="11:00" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label for="yoruSpecialClose" class="form-label">Closing Time</label>
                            <input type="time" class="form-control" name="SpecialDateInput.CloseTime" id="yoruSpecialClose" value="23:00" />
                        </div>
                    </div>
                    <div class="yoru-sd-hint mt-2">Overnight hours are supported, e.g. 18:00 – 02:00.</div>
                </section>
            </div>

            <div class="modal-footer">
                <button type="button" class="yoru-luxury-btn secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="yoru-luxury-btn yoru-sd-save"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11l3 3v13H5z"/><path d="M8 4v5h7V4M8 20v-6h8v6"/></svg><span id="yoruSpecialSaveText">Save Special Date</span></button>
            </div>
        </form>
    </div>
</div>

