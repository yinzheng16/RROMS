                const label =
                    select.getAttribute('aria-label') ||
                    select.labels?.[0]?.textContent.trim();

                if (label) {
                    trigger.setAttribute('aria-label', label);
                }

                const menu = document.createElement('ul');
                menu.className = 'dropdown-menu';

                const error = document.createElement('div');
                error.className = 'yoru-custom-filter-error';
                error.setAttribute('aria-live', 'polite');
                error.hidden = true;

                select.before(wrapper);

                wrapper.appendChild(trigger);
                wrapper.appendChild(menu);
                wrapper.appendChild(select);
                wrapper.appendChild(error);

                select.style.display = 'none';

                let choices = [];

                function buildOptions() {
                    menu.replaceChildren();
                    choices = [];

                    Array.from(select.options).forEach(option => {
                        const item = document.createElement('li');
                        const button = document.createElement('button');

                        button.type = 'button';
                        button.className = 'dropdown-item' +
                            (option.value === '' ? ' is-placeholder' : '');
                        button.textContent = option.textContent;

                        button.addEventListener('click', () => {
                            select.value = option.value;

                            select.dispatchEvent(
                                new Event('change', { bubbles: true })
                            );

                            sync();
                        });

                        item.appendChild(button);
                        menu.appendChild(item);

                        choices.push({ option, button });
                    });

                    sync();
                }

                function sync() {
                    const selected = select.selectedOptions[0];

                    trigger.textContent = selected
                        ? selected.textContent
                        : 'Choose an option';

                    trigger.disabled = select.disabled;

                    choices.forEach(({ option, button }) => {
                        button.classList.toggle(
                            'active',
                            option.selected
                        );

                        button.disabled =
                            option.disabled ||
                            (
                                option.parentElement.tagName === 'OPTGROUP' &&
                                option.parentElement.disabled
                            );

                        button.hidden = option.hidden;

                        button.setAttribute(
                            'aria-current',
                            String(option.selected)
                        );
                    });

                    if (select.validity.valid || select.disabled) {
                        trigger.classList.remove('is-invalid');
                        trigger.removeAttribute('aria-invalid');
                        error.hidden = true;
                    } else if (!error.hidden) {
                        error.textContent = select.validationMessage;
                    }
                }

                select.addEventListener('change', sync);

                // Keep required-field validation working.
                select.addEventListener('invalid', event => {
                    event.preventDefault();

                    trigger.classList.add('is-invalid');
                    trigger.setAttribute('aria-invalid', 'true');

                    error.textContent = select.validationMessage;
                    error.hidden = false;

                    const firstInvalid = select.form
                        ? Array.from(select.form.elements).find(
                            field => field.willValidate &&
                                !field.validity.valid
                        )
                        : select;

                    if (firstInvalid === select) {
                        trigger.focus();
                    }
                });

                // Refresh when Add/Edit changes the available options.
                const observer = new MutationObserver(buildOptions);

                observer.observe(select, {
                    childList: true,
                    subtree: true,
                    characterData: true,
                    attributes: true,
                    attributeFilter: [
                        'disabled',
                        'hidden',
                        'label',
                        'value',
                        'selected',
                        'required'
                    ]
                });

                filters.push(sync);

                buildOptions();
            });

            function syncAll() {
                filters.forEach(sync => sync());
            }

            // Sync values assigned by Add, Edit and Clear Filters.
            document.addEventListener('click', () => {
                queueMicrotask(syncAll);
            });

            document.addEventListener('change', () => {
                queueMicrotask(syncAll);
            });

            document.addEventListener('reset', () => {
                setTimeout(syncAll, 0);
            }, true);
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('tableForm');

            const minInput = form.querySelector(
                '[name="TableForm.MinGuests"]'
            );

            const capacityInput = form.querySelector(
                '[name="TableForm.Capacity"]'
            );

            const capacityError =
                document.getElementById('tableCapacityError');

            const saveError =
                document.getElementById('tableSaveError');

            const saveButton =
                form.querySelector('button[type="submit"]');

            let saving = false;

            if (capacityError) {
                capacityInput.setAttribute('aria-describedby', 'tableCapacityError');
            }

            function validateGuestRange() {
                const invalid =
                    minInput.value !== '' &&
                    capacityInput.value !== '' &&
                    Number(minInput.value) > Number(capacityInput.value);

                capacityInput.classList.toggle('is-invalid', invalid);
                capacityInput.setAttribute('aria-invalid', String(invalid));
                if (capacityError) capacityError.hidden = !invalid;

                return !invalid;
            }

            minInput.addEventListener('input', validateGuestRange);
            capacityInput.addEventListener('input', validateGuestRange);

            // Refresh validation after Add/Edit assigns field values.
            document.addEventListener('click', () => {
                queueMicrotask(validateGuestRange);
            });

            form.addEventListener('reset', () => {
                saveError.hidden = true;
                saveError.textContent = '';

                setTimeout(validateGuestRange, 0);
            });

            form.addEventListener('submit', async event => {
                if (event.defaultPrevented) {
                    return;
                }

                event.preventDefault();

                if (saving) {
                    return;
                }

                saveError.hidden = true;
                saveError.textContent = '';

                if (!validateGuestRange()) {
                    saveError.textContent =
                        'Capacity must be at least the minimum guests.';

                    saveError.hidden = false;

                    if (capacityInput.getClientRects().length) {
                        capacityInput.focus();
                    }

                    return;
                }

                if (!form.reportValidity()) {
                    return;
                }

                const formData = new FormData(form);

                saving = true;
                saveButton.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    });

                    const contentType =
                        response.headers.get('content-type') || '';

                    if (!contentType.includes('application/json')) {
                        throw new Error(
                            'The server returned an unexpected response. ' +
                            'Your entries are still here.'
                        );
                    }

                    const result = await response.json();

                    if (response.ok && result.success) {
                        const tableTypeId = form.querySelector(
                            '[name="TableForm.TableTypeDefinitionId"]'
                        ).value;

                        window.yoruRememberView({
                            tab: 'tables',
                            panelId: 'modal-tables-type-' + tableTypeId
                        });

                        window.location.reload();
                        return;
                    }

                    saveError.textContent =
                        result.message ||
                        'Unable to save. Please check your entries.';

                    saveError.hidden = false;

                    saveError.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });
                } catch (error) {
                    saveError.textContent =
                        error.message ||
                        'Unable to connect. Your entries are still here.';

                    saveError.hidden = false;
                } finally {
                    saving = false;
                    saveButton.disabled = false;
                }
            });
        });
    </script>
    <script>
        window.yoruRememberView = function (overrides = {}) {
            const activeTab = document.querySelector(
                '[data-yoru-tab].active'
            );

            const openPanel = document.querySelector(
                '.yoru-inline-table-panel:not([hidden])'
            );

            const state = {
                tab: activeTab?.dataset.yoruTab || 'tables',
                panelId: openPanel?.id || null,
                scrollY: window.scrollY,
                savedAt: Date.now(),
                ...overrides
            };

            try {
                sessionStorage.setItem(
                    'yoruTablesView:' + location.pathname,
                    JSON.stringify(state)
                );
            } catch {
                // Saving still works when browser storage is unavailable.
            }
        };

        // Ordinary POST forms: delete, dining areas, hours and special dates.
        document.addEventListener('submit', event => {
            const form = event.target;

            if (!(form instanceof HTMLFormElement) ||
                event.defaultPrevented ||
                form.method.toLowerCase() !== 'post') {
                return;
            }

            const submitter = event.submitter;

            const actionUrl = submitter?.hasAttribute('formaction')
                ? submitter.formAction
                : form.action;

            const action = new URL(actionUrl, location.href);

            if (action.origin !== location.origin ||
                action.pathname !== location.pathname ||
                !action.searchParams.has('handler')) {
                return;
            }

            window.yoruRememberView();
        });

        document.addEventListener('DOMContentLoaded', () => {
            const state = window.yoruPendingView;

            if (!state) {
                return;
            }

            delete window.yoruPendingView;

            try {
                const panel = typeof state.panelId === 'string'
                    ? document.getElementById(state.panelId)
                    : null;

                if (panel?.hidden) {
                    const button = Array.from(
                        document.querySelectorAll(
                            '.yoru-type-manage-btn[data-manage-panel]'
                        )
                    ).find(button =>
                        button.dataset.managePanel === state.panelId
                    );

                    button?.click();
                }
            } catch (error) {
                console.error('Unable to restore table list.', error);
            }

            function finishRestore() {
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        try {
                            window.scrollTo({
                                top: Number.isFinite(state.scrollY)
                                    ? state.scrollY
                                    : 0,
                                behavior: 'instant'
                            });
                        } finally {
                            document.documentElement.classList.remove(
                                'yoru-restoring-view'
                            );
                        }
                    });
                });
            }

            if (document.readyState === 'complete') {
                finishRestore();
            } else {
                window.addEventListener('load', finishRestore, {
                    once: true
                });
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const list = document.querySelector('.yoru-special-list');

            if (!list) {
                return;
            }

            const items = Array.from(
                list.querySelectorAll('.yoru-special-item')
            );

            if (!items.length) {
                return;
            }

            const nav = document.getElementById('yoruSpecialMonthNav');
            const label = document.getElementById('yoruSpecialMonthLabel');
            const count = document.getElementById('yoruSpecialMonthCount');
            const prev = document.getElementById('yoruSpecialMonthPrev');
            const next = document.getElementById('yoruSpecialMonthNext');

            const ranges = items.map(item => {
                const data = item.querySelector('[data-special-edit]').dataset;

                return {
                    item,
                    startMonth: data.date.slice(0, 7),
                    endMonth: (data.endDate || data.date).slice(0, 7)
                };
            });

            const monthSet = new Set();

            ranges.forEach(range => {
                const [startYear, startMonth] =
                    range.startMonth.split('-').map(Number);

                const [endYear, endMonth] =
                    range.endMonth.split('-').map(Number);

                const first = startYear * 12 + startMonth - 1;
                const last = endYear * 12 + endMonth - 1;

                for (let value = first; value <= last; value++) {
                    const year = Math.floor(value / 12);
                    const month = value % 12 + 1;

                    monthSet.add(
                        String(year).padStart(4, '0') + '-' +
                        String(month).padStart(2, '0')
                    );
                }
            });

            const months = Array.from(monthSet).sort();

            const today = new Date();

            const currentMonth =
                today.getFullYear() + '-' +
                String(today.getMonth() + 1).padStart(2, '0');

            // Start with this month or the next month containing entries.
            let index = months.findIndex(month => month >= currentMonth);

            if (index === -1) {
                index = months.length - 1;
            }

            function render() {
                const month = months[index];
                const [year, monthNumber] = month.split('-').map(Number);

                label.textContent = new Date(
                    year, monthNumber - 1, 1
                ).toLocaleDateString('en-MY', {
                    month: 'long',
                    year: 'numeric'
                });

                let total = 0;

                ranges.forEach(({ item, startMonth, endMonth }) => {
                    const visible =
                        startMonth <= month &&
                        endMonth >= month;

                    item.hidden = !visible;

                    item.style.setProperty(
                        'display',
                        visible ? 'flex' : 'none',
                        'important'
                    );

                    if (visible) total++;
                });

                count.textContent =
                    total + ' special date' + (total === 1 ? '' : 's');

                prev.disabled = index === 0;
                next.disabled = index === months.length - 1;

                list.scrollTop = 0;
            }

            prev.addEventListener('click', () => {
                if (index > 0) {
                    index--;
                    render();
                }
            });

            next.addEventListener('click', () => {
                if (index < months.length - 1) {
                    index++;
                    render();
                }
            });

            nav.hidden = false;

            render();
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalElement = document.getElementById(
