                        </div>
                    </div>
                    <div class="form-text mt-2">Overnight hours are supported, e.g. 18:00 – 02:00.</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="yoru-luxury-btn secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="yoru-luxury-btn">Save Special Date</button>
            </div>
        </form>
    </div>
</div>

<!-- Wheel Time Picker -->
<div class="yoru-wheel-overlay" id="yoruWheelOverlay" aria-hidden="true">
    <div class="yoru-wheel-dialog" role="dialog" aria-modal="true" aria-labelledby="yoruWheelTitle">
        <div class="d-flex align-items-center justify-content-between"><h3 class="h5 mb-0" id="yoruWheelTitle">Choose Time</h3><button type="button" class="btn-close" id="yoruWheelClose" aria-label="Close"></button></div>
        <p class="text-muted small mt-2 mb-0">Scroll slowly, or type the time directly.</p>
        <div class="yoru-wheel-columns"><div><div class="text-center small text-muted">HOUR</div><div class="yoru-wheel-col" id="yoruWheelHour"></div></div><div><div class="text-center small text-muted">MINUTE</div><div class="yoru-wheel-col" id="yoruWheelMinute"></div></div><div><div class="text-center small text-muted">AM / PM</div><div class="yoru-wheel-col" id="yoruWheelPeriod"></div></div></div>
        <div class="yoru-wheel-preview yoru-wheel-manual" id="yoruWheelPreview">
            <input type="text" id="yoruWheelHourInput" class="yoru-wheel-input" inputmode="numeric" maxlength="2" autocomplete="off" aria-label="Hour (1 to 12)" />
