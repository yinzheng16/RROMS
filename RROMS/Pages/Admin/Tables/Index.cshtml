    <script>
    // Dining Area drawer (Step 3): mode icon/title, card theme, Automatic / Manual status.
    // Works next to the existing open/close handlers; it only adds on top of them.
    document.addEventListener('DOMContentLoaded', function () {
        const drawer = document.getElementById('areaModal');
        if (!drawer) return;

        const themeField = document.getElementById('yoruAreaThemeKey');
        const swatches = Array.from(drawer.querySelectorAll('[data-theme-choice]'));
        const saveLabel = document.getElementById('yoruAreaSaveLabel');

        function selectTheme(key) {
            const valid = swatches.some(s => s.dataset.themeChoice === key);
            const value = valid ? key : themeField.dataset.defaultTheme;
            themeField.value = value;
            swatches.forEach(s => s.setAttribute('aria-pressed', String(s.dataset.themeChoice === value)));
        }

        swatches.forEach(s => s.addEventListener('click', () => selectTheme(s.dataset.themeChoice)));

        // Runs after the existing handler has already filled the form.
        document.querySelectorAll('[data-area-drawer-open]').forEach(button => {
            button.addEventListener('click', () => {
                const isEdit = Boolean(button.dataset.id);
                drawer.dataset.mode = isEdit ? 'edit' : 'add';
                if (saveLabel) saveLabel.textContent = isEdit ? 'Save Changes' : 'Save Area';
                selectTheme(isEdit ? button.dataset.theme : themeField.dataset.defaultTheme);
            });
        });

        selectTheme(themeField.value);
    });
