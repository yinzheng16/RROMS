@page
@model RROMS.Pages.Admin.Index

@{
    ViewData["Title"] = "Admin Overview";
    ViewData["FullWidth"] = true;
}

<style>
    .overview-page {
        position: relative;
        padding: 28px 0 48px;
    }

    .overview-container {
        position: relative;
        z-index: 1;
        width: 94vw;
        max-width: none;
        margin-left: calc(50% - 47vw);
        margin-right: calc(50% - 47vw);
    }

    /* =========================
       TABLET
       ========================= */

    @@media (max-width: 991px) {
        .overview-container {
            width: calc(100vw - 48px);
            margin-left: calc(50% - 50vw + 24px);
            margin-right: 0;
        }
    }

    /* =========================
       MOBILE
       ========================= */

    @@media (max-width: 768px) {
        .overview-page {
            padding-top: 20px;
        }

        .overview-container {
            width: calc(100vw - 32px);
            margin-left: calc(50% - 50vw + 16px);
            margin-right: 0;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 16px;
        }

        .page-header .text-md-end {
            text-align: left !important;
        }

        .card-body {
            padding: 18px !important;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table {
            min-width: 600px;
        }
    }
</style>

<div class="overview-page">
<div class="overview-container">

<div class="page-header">
    <div>
        <p class="eyebrow">Admin Overview ・ 管理</p>
        <h1>Today's Overview</h1>
        <p class="text-muted mb-0 mt-2">
            Here's what's happening at YORU IZAKAYA today.
        </p>
    </div>

    <div class="text-md-end">
        <p class="text-muted mb-1 small">Today's Date</p>
        <strong>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</strong>
    </div>
</div>

<div class="row g-3 mb-4">

    <!-- Reservations -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">予約 ・ Reservations</p>
                        <p class="text-muted mb-0 small">Today's Reservations</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayReservationCount
                </h2>

                <p class="text-muted small mb-0">
                    Reservations scheduled today
                </p>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">注文 ・ Orders</p>
                        <p class="text-muted mb-0 small">Today's Orders</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-receipt"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayOrderCount
                </h2>

                <p class="text-muted small mb-0">
                    Orders created today
                </p>
            </div>
        </div>
    </div>

    <!-- Payments -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">支払 ・ Payments</p>
                        <p class="text-muted mb-0 small">Today's Payments</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-credit-card"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayPaymentCount
                </h2>

                <p class="text-muted small mb-0">
                    Payments received today
                </p>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">売上 ・ Revenue</p>
                        <p class="text-muted mb-0 small">Today's Revenue</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-cash-stack"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    RM @Model.Overview.TodayPaymentTotal.ToString("N2")
                </h2>

                <p class="text-muted small mb-0">
                    Total collected today
                </p>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Latest Reservations</h3>
                    <a class="btn btn-outline-secondary btn-sm disabled"
                       href="#"
                       aria-disabled="true">
                        View All
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Time</th>
                            <th>Guests</th>
                            <th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Overview.LatestReservations.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">
                                    No reservations found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var reservation in Model.Overview.LatestReservations)
                            {
                                <tr>
                                    <td>@reservation.ReferenceNo</td>
                                    <td>@reservation.ReservedAt.ToString("dd MMM, h:mm tt")</td>
                                    <td>@reservation.Guests</td>
                                    <td>
                                        <span class="status-badge status-@reservation.Status">
                                            @reservation.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Latest Orders</h3>
                    <a class="btn btn-outline-secondary btn-sm disabled"
                       href="#"
                       aria-disabled="true">
                        View All
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr>
                            <th>Order</th>
                            <th>Type</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Overview.LatestOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">
                                    No orders found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.Overview.LatestOrders)
                            {
                                <tr>
                                    <td>@order.OrderNo</td>
                                    <td>@order.OrderType</td>
                                    <td>RM @order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <span class="status-badge status-@order.Status">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Latest Payments</h3>
            <a class="btn btn-outline-secondary btn-sm disabled"
               href="#"
               aria-disabled="true">
                View All
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th>Order</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Paid At</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Overview.LatestPayments.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted">
                            No payments found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var payment in Model.Overview.LatestPayments)
                    {
                        <tr>
                            <td>@payment.Order.OrderNo</td>
                            <td>RM @payment.Amount.ToString("N2")</td>
                            <td>@payment.Method</td>
                            <td>
                                <span class="status-badge status-@payment.Status">
                                    @payment.Status
                                </span>
                            </td>
                            <td>
                                @(payment.PaidAt.HasValue
                                    ? payment.PaidAt.Value.ToString("dd MMM yyyy, h:mm tt")
                                    : "-")
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
</div>