@page
@model RROMS.Pages.Admin.Index
@using RROMS.Models
@using RROMS.Services.Interfaces
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

@{
    // US41 Admin Overview (Member 5)
    // Design: same family as the Business Dashboard and Restaurant Settings
    // (night header with a lantern, round section icons, cream cards).
    // Styles: wwwroot/css/admin-overview.css
    ViewData["Title"] = "Admin Overview";

    var o = Model.Overview;
    var now = o.GeneratedAt;

    // ---------- Links to other members' pages ----------
    // null = that page is not on develop yet, so the link is shown as disabled.
    // When the page is merged, replace null with the address in the comment.
    string? reservationsUrl = "/Staff";         // US16, Member 2
    string? ordersUrl = "/Staff/Orders";        // US25, Member 3
    string? paymentsUrl = "/Admin/Payments";    // US40, Member 4
    string? reportsUrl = null;      // "/Admin/Reports"  (US44, Member 5)

    // ---------- Greeting ----------
    var me = await UserManager.GetUserAsync(User);
    var adminName = string.IsNullOrWhiteSpace(me?.FullName) ? "Admin" : me!.FullName;
    var greeting = now.Hour < 12 ? "Good morning" : now.Hour < 18 ? "Good afternoon" : "Good evening";

    // ---------- Opening status ----------
    var isOpenNow = false;
    var openStatus = "Closed today";
    string? closesIn = null;
    var dayProgress = 0;
    var hoursPercent = 0;          // where "now" sits on the opening-hours line
    string? serviceLength = null;  // e.g. "12 h 0 min"

    if (!o.IsClosedToday && o.TodayOpenTime.HasValue && o.TodayCloseTime.HasValue)
    {
        var open = o.TodayOpenTime.Value.ToTimeSpan();
        var close = o.TodayCloseTime.Value.ToTimeSpan();
        var time = now.TimeOfDay;

        if (close > open) serviceLength = Duration(close - open);

        if (close <= open)
        {
            isOpenNow = true;
            openStatus = "Open today";
        }
        else if (time < open)
        {
            openStatus = "Opens at " + o.TodayOpenTime.Value.ToString("h:mm tt");
        }
        else if (time >= close)
        {
            openStatus = "Closed for today";
            hoursPercent = 100;
        }
        else
        {
            isOpenNow = true;
            openStatus = "Open now";
            closesIn = "Closes in " + Duration(close - time);
            dayProgress = (int)Math.Round((time - open).TotalMinutes * 100 / (close - open).TotalMinutes);
            hoursPercent = dayProgress;
        }
    }

    // Lantern: 営 (open), 準 (not open yet / finished), 休 (closed all day)
    var lanternText = isOpenNow ? "営" : (o.IsClosedToday ? "休" : "準");

    // ---------- Period words ----------
    var periodWord = o.Period switch
    {
        OverviewPeriod.Week => "this week",
        OverviewPeriod.Month => "this month",
        _ => "today"
    };
    var periodLabel = RangeLabel(o.PeriodStart, o.PeriodEnd);

    // ---------- Today's reservations ----------
    var coverPercent = o.TotalSeatCount > 0
        ? Math.Min(100, (int)Math.Round(o.TodayGuestCount * 100.0 / o.TotalSeatCount))
        : 0;
    var upcoming = o.UpcomingReservations.Take(3).ToList();
    var nextGuest = upcoming.FirstOrDefault();
    var latestOrders = o.LatestOrders.Take(3).ToList();
    var latestPayments = o.LatestPayments.Take(3).ToList();
    var menuPercent = o.TotalMenuItemCount > 0
        ? (int)Math.Round(o.AvailableMenuItemCount * 100.0 / o.TotalMenuItemCount)
        : 0;
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700;900&family=Josefin+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
}

<div class="ov">

    <!-- Shared drawings: a cherry blossom and a petal -->
    <svg class="ov-defs" aria-hidden="true" focusable="false">
        <symbol id="ov-bl" viewBox="-12 -12 24 24">
            <g fill="#F7C4CB" stroke="#E79AA6" stroke-width=".6">
                <path d="M0 -1 C -4 -4,-4 -9,-1.2 -10.5 L0 -9.2 L1.2 -10.5 C 4 -9,4 -4,0 -1Z" />
                <path transform="rotate(72)" d="M0 -1 C -4 -4,-4 -9,-1.2 -10.5 L0 -9.2 L1.2 -10.5 C 4 -9,4 -4,0 -1Z" />
                <path transform="rotate(144)" d="M0 -1 C -4 -4,-4 -9,-1.2 -10.5 L0 -9.2 L1.2 -10.5 C 4 -9,4 -4,0 -1Z" />
                <path transform="rotate(216)" d="M0 -1 C -4 -4,-4 -9,-1.2 -10.5 L0 -9.2 L1.2 -10.5 C 4 -9,4 -4,0 -1Z" />
                <path transform="rotate(288)" d="M0 -1 C -4 -4,-4 -9,-1.2 -10.5 L0 -9.2 L1.2 -10.5 C 4 -9,4 -4,0 -1Z" />
            </g>
            <circle r="2.2" fill="#C9392B" />
        </symbol>
        <symbol id="ov-pt" viewBox="-6 -4 12 8"><path d="M-5 0 C -3 -4,3 -4,5 0 C 3 3,-3 3,-5 0Z" fill="#F4AEB8" /></symbol>
    </svg>

    <!-- ===== 1. Header: night scene with a lantern (same as the dashboard) ===== -->
    <header class="ov-hero">
        <div class="ov-moon" aria-hidden="true"></div>
        <svg class="ov-art" viewBox="0 0 560 300" preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="ov-lg" cx="40%" cy="40%" r="70%"><stop offset="0" stop-color="#FF8A5C" /><stop offset=".55" stop-color="#D93B26" /><stop offset="1" stop-color="#8E1F14" /></radialGradient>
                <radialGradient id="ov-glow"><stop offset="0" stop-color="rgba(255,150,80,.55)" /><stop offset="1" stop-color="rgba(255,150,80,0)" /></radialGradient>
                <radialGradient id="ov-sl" cx="45%" cy="40%" r="70%"><stop offset="0" stop-color="#FFE3A6" /><stop offset=".6" stop-color="#F2A957" /><stop offset="1" stop-color="#B8662B" /></radialGradient>
            </defs>
            <g opacity=".9">
                <line x1="150" y1="0" x2="150" y2="70" stroke="#2A1A12" stroke-width="2" /><circle cx="150" cy="100" r="60" fill="url(#ov-glow)" />
                <rect x="134" y="66" width="32" height="7" rx="2" fill="#1B1210" /><ellipse cx="150" cy="100" rx="22" ry="28" fill="url(#ov-sl)" /><rect x="134" y="126" width="32" height="7" rx="2" fill="#1B1210" />
                <line x1="230" y1="0" x2="230" y2="40" stroke="#2A1A12" stroke-width="2" /><circle cx="230" cy="68" r="50" fill="url(#ov-glow)" />
                <rect x="216" y="36" width="28" height="6" rx="2" fill="#1B1210" /><ellipse cx="230" cy="66" rx="19" ry="24" fill="url(#ov-sl)" /><rect x="216" y="88" width="28" height="6" rx="2" fill="#1B1210" />
            </g>
            <line x1="430" y1="0" x2="430" y2="40" stroke="#2A1A12" stroke-width="3" /><circle cx="430" cy="140" r="150" fill="url(#ov-glow)" />
            <rect x="392" y="36" width="76" height="16" rx="5" fill="#1B1210" />
            <path d="M392 52 C 340 80,340 210,392 236 L468 236 C 520 210,520 80,468 52Z" fill="url(#ov-lg)" />
            <g stroke="rgba(60,10,5,.28)" stroke-width="2" fill="none">
                <path d="M370 80 Q430 92 490 80" /><path d="M360 110 Q430 124 500 110" /><path d="M358 142 Q430 156 502 142" /><path d="M360 174 Q430 188 500 174" /><path d="M370 206 Q430 218 490 206" />
            </g>
            <text x="430" y="172" text-anchor="middle" font-family="Noto Serif JP, serif" font-weight="900" font-size="86" fill="#1B1210">@lanternText</text>
            <rect x="392" y="236" width="76" height="16" rx="5" fill="#1B1210" />
            <line x1="430" y1="252" x2="430" y2="290" stroke="#C9A26A" stroke-width="3" /><path d="M422 280 L438 280 L434 300 L426 300Z" fill="#C9392B" />
            <path d="M560 0 C 520 30,500 40,470 30" stroke="#5A3322" stroke-width="5" fill="none" /><path d="M300 0 C 320 30,350 35,360 20" stroke="#5A3322" stroke-width="4" fill="none" />
            <use href="#ov-bl" x="520" y="5" width="34" height="34" /><use href="#ov-bl" x="490" y="22" width="28" height="28" />
            <use href="#ov-bl" x="460" y="12" width="24" height="24" /><use href="#ov-bl" x="340" y="10" width="26" height="26" />
            <use href="#ov-bl" x="310" y="-2" width="22" height="22" /><use href="#ov-bl" x="530" y="40" width="22" height="22" />
            <use href="#ov-pt" x="300" y="200" width="16" height="10" /><use href="#ov-pt" x="520" y="200" width="14" height="9" />
            <use href="#ov-pt" x="270" y="120" width="12" height="8" /><use href="#ov-pt" x="540" y="120" width="16" height="10" />
        </svg>

        <div class="ov-eyebrow">ADMIN OVERVIEW · <b lang="ja">本日の概要</b></div>
        <h1 class="ov-title">@greeting, <em>@adminName.</em></h1>
        <p class="ov-sub">
            <b>@now.ToString("dddd, d MMMM yyyy")</b>
            @{ var wareki = Wareki(now); }
            @if (!string.IsNullOrEmpty(wareki))
            {
                <span class="ov-wareki" lang="ja"> · @wareki</span>
            }
        </p>
        <div class="ov-chips">
            <span class="ov-chip @(isOpenNow ? "is-open" : "is-closed")"><i aria-hidden="true"></i>@(openStatus + (closesIn != null ? " · " + closesIn : ""))</span>
            <span class="ov-chip">To check <b>@o.AttentionCount</b></span>
            <span class="ov-chip">
                Updated <b>@now.ToString("h:mm tt")</b>
                <a class="ov-refresh" asp-page="/Admin/Index" asp-route-period="@Model.Period">↻ Refresh</a>
            </span>
        </div>
    </header>

    <!-- ===== 2. Today's service ===== -->
    <div class="ov-sec">
        <div class="ov-sec-ic is-green" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V9l7-5 7 5v12M10 21v-6h4v6" /></svg>
        </div>
        <div>
            <h2>Today's Service <small lang="ja">本日の営業</small></h2>
            <p>Opening hours, tables and menu for @now.ToString("ddd, d MMM").</p>
        </div>
        <div class="ov-rule"></div>
    </div>

    <section class="ov-svc" aria-label="Today's service">
        <!-- Opening hours -->
        <div class="ov-svc-col">
            <span class="ov-svc-tag @(isOpenNow ? "is-open" : "")">@(isOpenNow ? "Open now" : (o.IsClosedToday ? "Closed" : "Not open"))</span>
            <div class="ov-svc-k">Opening hours <b lang="ja">営業時間</b></div>
            @if (o.IsClosedToday || !o.TodayOpenTime.HasValue || !o.TodayCloseTime.HasValue)
            {
                <div class="ov-svc-v">Closed today</div>
                <div class="ov-svc-bar"><u style="width:0"></u></div>
                <div class="ov-svc-cap"><span>The restaurant does not open today</span></div>
            }
            else
            {
                <div class="ov-svc-v">@o.TodayOpenTime.Value.ToString("h:mm")<small>@o.TodayOpenTime.Value.ToString("tt")</small><i>—</i>@o.TodayCloseTime.Value.ToString("h:mm")<small>@o.TodayCloseTime.Value.ToString("tt")</small></div>
                <div class="ov-svc-bar" role="progressbar" aria-label="Today's service" aria-valuenow="@hoursPercent" aria-valuemin="0" aria-valuemax="100">
                    <u style="width:@(hoursPercent)%"></u>
                    @if (serviceLength != null)
                    {
                        <b style="left:@(hoursPercent)%"></b>
                    }
                </div>
                <div class="ov-svc-cap">
                    <span>@(closesIn ?? openStatus)</span>
                    @if (serviceLength != null)
                    {
                        <span>@serviceLength service</span>
                    }
                </div>
            }
            <span class="ov-svc-wm" lang="ja" aria-hidden="true">時</span>
        </div>

        <!-- Tables and seats -->
        <div class="ov-svc-col">
            <div class="ov-svc-k">Tables &amp; seats <b lang="ja">お席</b></div>
            <div class="ov-svc-v">@o.ActiveTableCount<small>tables</small> @o.TotalSeatCount<small>seats</small></div>
            <div class="ov-svc-bar"><u style="width:@(coverPercent)%"></u></div>
            <div class="ov-svc-cap">
                <span>@(o.TodayGuestCount > 0 ? $"{o.TodayGuestCount} guests booked today" : "No guests booked yet")</span>
                <span>@coverPercent% booked</span>
            </div>
            <span class="ov-svc-wm" lang="ja" aria-hidden="true">席</span>
        </div>

        <!-- Menu items -->
        <div class="ov-svc-col">
            <div class="ov-svc-k">Menu items <b lang="ja">お品書き</b></div>
            <div class="ov-svc-v">@o.AvailableMenuItemCount<small>/ @o.TotalMenuItemCount</small></div>
            <div class="ov-svc-bar is-green"><u style="width:@(menuPercent)%"></u></div>
            <div class="ov-svc-cap">
                <span>@(o.UnavailableMenuItemCount > 0 ? "Some dishes are switched off" : "Every dish can be ordered")</span>
                <span class="@(o.UnavailableMenuItemCount > 0 ? "is-warn" : "")">@o.UnavailableMenuItemCount unavailable</span>
            </div>
            <span class="ov-svc-wm" lang="ja" aria-hidden="true">品</span>
        </div>
    </section>

    <!-- ===== 3. Overview numbers (Today / This week / This month) ===== -->
    <section id="tickets" aria-label="Overview numbers">
        <div class="ov-sec">
            <div class="ov-sec-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
            </div>
            <div>
                <h2>Overview <small lang="ja">伝票</small></h2>
                <p>@(char.ToUpper(periodWord[0]) + periodWord[1..]) · @periodLabel</p>
            </div>
            <div class="ov-rule"></div>
            <nav class="ov-seg" aria-label="Period">
                <a asp-page="/Admin/Index" asp-fragment="tickets" class="@(o.Period == OverviewPeriod.Today ? "active" : null)">Today</a>
                <a asp-page="/Admin/Index" asp-route-period="week" asp-fragment="tickets" class="@(o.Period == OverviewPeriod.Week ? "active" : null)">This week</a>
                <a asp-page="/Admin/Index" asp-route-period="month" asp-fragment="tickets" class="@(o.Period == OverviewPeriod.Month ? "active" : null)">This month</a>
            </nav>
        </div>

        <div class="ov-kpis">
            <a class="ov-kpi is-dark" href="@reportsUrl">
                <div class="ov-card-top"><span class="ov-card-l">Revenue</span><span class="ov-card-jp" lang="ja">売上</span></div>
                <div class="ov-kpi-v"><small>RM</small>@o.PeriodPaymentTotal.ToString("N2")</div>
                <div class="ov-kpi-d">Payments received @periodWord</div>
            </a>
            <a class="ov-kpi" href="@reservationsUrl">
                <div class="ov-card-top"><span class="ov-card-l">Reservations</span><span class="ov-card-jp" lang="ja">予約数</span></div>
                <div class="ov-kpi-v">@o.PeriodReservationCount</div>
                <div class="ov-kpi-d">Scheduled @periodWord</div>
            </a>
            <a class="ov-kpi" href="@ordersUrl">
                <div class="ov-card-top"><span class="ov-card-l">Orders</span><span class="ov-card-jp" lang="ja">注文数</span></div>
                <div class="ov-kpi-v">@o.PeriodOrderCount</div>
                <div class="ov-kpi-d">Created @periodWord</div>
            </a>
            <a class="ov-kpi" href="@paymentsUrl">
                <div class="ov-card-top"><span class="ov-card-l">Payments</span><span class="ov-card-jp" lang="ja">支払</span></div>
                <div class="ov-kpi-v">@o.PeriodPaymentCount</div>
                <div class="ov-kpi-d">Paid @periodWord</div>
            </a>
        </div>
    </section>

    <!-- ===== 4. Today's activity ===== -->
    <div class="ov-sec">
        <div class="ov-sec-ic is-dark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" /></svg>
        </div>
        <div>
            <h2>Today's Activity <small lang="ja">本日の動き</small></h2>
            <p>Who is coming next, the newest orders and payments.</p>
        </div>
        <div class="ov-rule"></div>
    </div>

    <section class="ov-activity" aria-label="Today's activity">

        <!-- Today's reservations -->
        <div class="ov-card ov-card-list">
            <div class="ov-list-head">
                <h3>Today's Reservations <small lang="ja">本日の予約</small></h3>
                @LinkOrDisabled(reservationsUrl, "View all →")
            </div>

            @if (upcoming.Count == 0)
            {
                <div class="ov-empty">
                    <span class="ov-empty-stamp" lang="ja" aria-hidden="true"><span>予約</span><span>なし</span></span>
                    <div>
                        <b>@(o.TodayReservationCount == 0 ? "No bookings for today yet" : "No more guests to arrive")</b>
                        <span>@(o.TodayReservationCount == 0 ? "New reservations will appear here as guests book." : "Every booking for today has been seated or closed.")</span>
                    </div>
                </div>
            }
            else
            {
                <div class="ov-list">
                    @foreach (var r in upcoming)
                    {
                        var hasRequest = !string.IsNullOrWhiteSpace(r.SpecialRequest);
                        var tableText = r.Table != null ? "Table " + r.Table.TableNumber : "No table yet";
                        <div class="ov-row @(r == nextGuest ? "is-next" : null)">
                            <span class="ov-time">@r.ReservedAt.ToString("h:mm")<small>@r.ReservedAt.ToString("tt")</small></span>
                            <span class="ov-row-main">
                                <b>@(r.User?.FullName ?? "Guest") · @r.Guests @(r.Guests == 1 ? "guest" : "guests")</b>
                                <em class="@(hasRequest ? "req" : null)">@tableText · @(hasRequest ? r.SpecialRequest : "No special request")</em>
                            </span>
                            <span class="status-badge status-@r.Status">@Label(r.Status)</span>
                        </div>
                    }
                </div>
            }

            <div class="ov-list-foot">
                @if (nextGuest != null)
                {
                    <text>Next guest in @Duration(nextGuest.ReservedAt - now) · @o.RemainingReservationCount of @o.TodayReservationCount still to arrive</text>
                }
                else
                {
                    <text>@o.TodayReservationCount @(o.TodayReservationCount == 1 ? "reservation" : "reservations") today</text>
                }
            </div>
        </div>

        <!-- Latest orders -->
        <div class="ov-card ov-card-list">
            <div class="ov-list-head">
                <h3>Latest Orders <small lang="ja">注文</small></h3>
                @LinkOrDisabled(ordersUrl, "View all →")
            </div>

            @if (latestOrders.Count == 0)
            {
                <div class="ov-empty">
                    <span class="ov-empty-stamp" lang="ja" aria-hidden="true"><span>注文</span><span>なし</span></span>
                    <div><b>No orders yet</b><span>New orders will appear here when guests order.</span></div>
                </div>
            }
            else
            {
                <div class="ov-list">
                    @foreach (var order in latestOrders)
                    {
                        <div class="ov-row ov-tk @TicketClass(order.Status)">
                            <span class="ov-code">@order.OrderNo</span>
                            <span class="ov-row-main">
                                <b>@Label(order.OrderType)</b>
                                <em>RM @order.TotalAmount.ToString("N2")</em>
                            </span>
                            <span class="status-badge status-@order.Status">@Label(order.Status)</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Latest payments -->
        <div class="ov-card ov-card-list">
            <div class="ov-list-head">
                <h3>Payments <small lang="ja">支払</small></h3>
                @LinkOrDisabled(paymentsUrl, "View all →")
            </div>

            @if (latestPayments.Count == 0)
            {
                <div class="ov-empty">
                    <span class="ov-empty-stamp" lang="ja" aria-hidden="true"><span>会計</span><span>なし</span></span>
                    <div><b>No payments yet today</b><span>Paid bills will appear here.</span></div>
                </div>
            }
            else
            {
                <div class="ov-list">
                    @foreach (var p in latestPayments)
                    {
                        <div class="ov-row">
                            <span class="ov-code">@(p.Order?.OrderNo ?? "Bill")</span>
                            <span class="ov-row-main">
                                <b>RM @p.Amount.ToString("N2")</b>
                                <em>@p.Method · @(p.PaidAt?.ToString("h:mm tt") ?? "not paid")</em>
                            </span>
                            <span class="status-badge status-@p.Status">@p.Status</span>
                        </div>
                    }
                </div>
            }

            <div class="ov-total"><span>Total today</span><b>RM @o.TodayPaymentTotal.ToString("N2")</b></div>
        </div>
    </section>
</div>

<script>
    // Today / This week / This month: swap only the overview section, no page reload.
    document.addEventListener("click", async function (e) {
        var link = e.target.closest("#tickets .ov-seg a");
        if (!link) return;
        e.preventDefault();

        var url = link.getAttribute("href");
        try {
            var res = await fetch(url);
            var html = await res.text();
            var fresh = new DOMParser().parseFromString(html, "text/html").getElementById("tickets");
            var current = document.getElementById("tickets");

            if (fresh && current) {
                current.innerHTML = fresh.innerHTML;
                history.replaceState(null, "", url.split("#")[0]);
            } else {
                window.location.href = url;
            }
        } catch {
            window.location.href = url;
        }
    });
</script>

@functions {
    // Shows a link, or a greyed-out label when the target page does not exist yet.
    static Microsoft.AspNetCore.Html.IHtmlContent LinkOrDisabled(string? url, string text)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        return url == null
            ? new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"ov-link disabled\" aria-disabled=\"true\">{enc.Encode(text)}</span>")
            : new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"ov-link\" href=\"{enc.Encode(url)}\">{enc.Encode(text)}</a>");
    }

    // Uses the [Display(Name = "...")] label if the enum value has one, e.g. "Ready to Serve".
    static string Label(Enum value)
    {
        var member = value.GetType().GetMember(value.ToString()).FirstOrDefault();
        var display = member?
            .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .OfType<System.ComponentModel.DataAnnotations.DisplayAttribute>()
            .FirstOrDefault();
        return display?.GetName() ?? value.ToString();
    }

    static string TicketClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "k-pend",
        OrderStatus.Preparing or OrderStatus.ReadyToServe => "k-prep",
        OrderStatus.Served or OrderStatus.Completed => "k-done",
        _ => ""
    };

    // "1 h 15 min" or "45 min".
    static string Duration(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours} h {span.Minutes} min"
            : $"{span.Minutes} min";
    }

    // "25 OCT", "19–25 OCT" or "28 SEP – 1 OCT".
    static string RangeLabel(DateTime start, DateTime end)
    {
        var endText = end.ToString("d MMM").ToUpperInvariant();
        if (start.Date == end.Date) return endText;
        if (start.Month == end.Month) return $"{start.Day}–{endText}";
        return $"{start.ToString("d MMM").ToUpperInvariant()} – {endText}";
    }

    // Japanese calendar date, e.g. 令和8年10月26日（月）. Returns "" if the system can't format it.
    static string Wareki(DateTime date)
    {
        try
        {
            var jp = new System.Globalization.CultureInfo("ja-JP");
            jp.DateTimeFormat.Calendar = new System.Globalization.JapaneseCalendar();
            return date.ToString("gg y年M月d日", jp) + "（" + jp.DateTimeFormat.GetShortestDayName(date.DayOfWeek) + "）";
        }
        catch
        {
            return "";
        }
    }
}