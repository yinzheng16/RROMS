@page
@model RROMS.Pages.Admin.Index

@{
    ViewData["Title"] = "Admin Overview";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
}

<div class="overview-page">
<div class="overview-container">

<div class="page-header">
    <div>
        <h1>Admin Overview</h1>
        <p class="text-muted mb-0 mt-2">
            Here's what's happening at YORU IZAKAYA today.
        </p>
    </div>

    <div class="text-md-end">
        <p class="text-muted mb-1 small">Today's Date</p>
        <strong>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</strong>
    </div>
</div>

    
    <div class="quick-actions-section mb-4">
        <p class="eyebrow mb-2">Quick Actions ・ クイック操作</p>

        <div class="quick-actions-grid">
            <a asp-page="/Admin/Tables/Index" class="quick-action-card">
                <span class="quick-action-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </span>

                <span>
                    <strong>Manage Tables</strong>
                    <small>View tables and dining areas</small>
                </span>

                <i class="bi bi-arrow-right quick-action-arrow"></i>
            </a>

            <a asp-page="/Admin/Menu/Index" class="quick-action-card">
                <span class="quick-action-icon">
                    <i class="bi bi-journal-text"></i>
                </span>

                <span>
                    <strong>Menu Items</strong>
                    <small>Manage restaurant menu</small>
                </span>

                <i class="bi bi-arrow-right quick-action-arrow"></i>
            </a>
        </div>
    </div>
<p class="eyebrow mb-2">Today's Overview ・ 本日の概要</p>

<div class="row g-3 mb-4">
    <!-- Reservations -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">Reservations ・ 予約</p>
                        <p class="text-muted mb-0 small">Today's Reservations</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayReservationCount
                </h2>

                <p class="text-muted small mb-0">
                    Reservations scheduled today
                </p>
            </div>
        </div>
    </div>

    <!-- Orders -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">Orders ・ 注文</p>
                        <p class="text-muted mb-0 small">Today's Orders</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-receipt"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayOrderCount
                </h2>

                <p class="text-muted small mb-0">
                    Orders created today
                </p>
            </div>
        </div>
    </div>

    <!-- Payments -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">Payments ・ 支払</p>
                        <p class="text-muted mb-0 small">Today's Payments</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-credit-card"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    @Model.Overview.TodayPaymentCount
                </h2>

                <p class="text-muted small mb-0">
                    Payments received today
                </p>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="eyebrow mb-1">Revenue ・ 売上</p>
                        <p class="text-muted mb-0 small">Today's Revenue</p>
                    </div>

                    <span class="fs-4 text-secondary">
                        <i class="bi bi-cash-stack"></i>
                    </span>
                </div>

                <h2 class="display-6 mb-1">
                    RM @Model.Overview.TodayPaymentTotal.ToString("N2")
                </h2>

                <p class="text-muted small mb-0">
                    Total collected today
                </p>
            </div>
        </div>
    </div>

</div>

<div class="mb-4">
    <p class="eyebrow mb-2">Restaurant Status ・ 店舗状況</p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Today's Opening Hours</p>

                    @if (Model.Overview.IsClosedToday)
                    {
                        <strong>Closed Today</strong>
                    }
                    else
                    {
                        <strong>
                            @Model.Overview.TodayOpenTime?.ToString("hh:mm tt")
                            –
                            @Model.Overview.TodayCloseTime?.ToString("hh:mm tt")
                        </strong>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Active Tables</p>
                    <strong>
                        @Model.Overview.ActiveTableCount active ·
                        @Model.Overview.TotalSeatCount seats
                    </strong>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Available Menu Items</p>
                    <strong>@Model.Overview.AvailableMenuItemCount available</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Latest Reservations</h3>
                    @* View All will be linked when the dedicated page becomes available. *@
                    <a class="btn btn-outline-secondary btn-sm disabled"
                       href="#"
                       aria-disabled="true">
                        View All
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr class="text-center">
                            <th class="text-center">Reference</th>
                            <th class="text-center">Time</th>
                            <th class="text-center">Guests</th>
                            <th class="text-center">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Overview.LatestReservations.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <i class="bi bi-calendar-check fs-4 text-secondary"></i>
                                    <p class="mb-1 mt-2 fw-semibold">No reservations yet</p>
                                    <small class="text-muted">
                                        New reservations will appear here when they are available.
                                    </small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var reservation in Model.Overview.LatestReservations)
                            {
                                <tr>
                                    <td>@reservation.ReferenceNo</td>
                                    <td>@reservation.ReservedAt.ToString("dd MMM, h:mm tt")</td>
                                    <td>@reservation.Guests</td>
                                    <td>
                                        <span class="status-badge status-@reservation.Status">
                                            @reservation.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Latest Orders</h3>
                    <a class="btn btn-outline-secondary btn-sm disabled"
                       href="#"
                       aria-disabled="true">
                        View All
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr>
                            <th class="text-center">Order</th>
                            <th class="text-center">Type</th>
                            <th class="text-center">Total</th>
                            <th class="text-center">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Overview.LatestOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <i class="bi bi-receipt fs-4 text-secondary"></i>
                                    <p class="mb-1 mt-2 fw-semibold">No orders yet</p>
                                    <small class="text-muted">
                                        New orders will appear here when they are placed.
                                    </small>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.Overview.LatestOrders)
                            {
                                <tr class="text-center">
                                    <td>@order.OrderNo</td>
                                    <td>@order.OrderType</td>
                                    <td>RM @order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <span class="status-badge status-@order.Status">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Latest Payments</h3>
            <a class="btn btn-outline-secondary btn-sm disabled"
               href="#"
               aria-disabled="true">
                View All
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th class="text-center">Order</th>
                    <th class="text-center">Amount</th>
                    <th class="text-center">Method</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Paid At</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Overview.LatestPayments.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4">
                            <i class="bi bi-credit-card fs-4 text-secondary"></i>
                            <p class="mb-1 mt-2 fw-semibold">No payments yet</p>
                            <small class="text-muted">
                                Completed payments will appear here when they are received.
                            </small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var payment in Model.Overview.LatestPayments)
                    {
                        <tr class="text-center">
                            <td>@payment.Order.OrderNo</td>
                            <td>RM @payment.Amount.ToString("N2")</td>
                            <td>@payment.Method</td>
                            <td>
                                <span class="status-badge status-@payment.Status">
                                    @payment.Status
                                </span>
                            </td>
                            <td>
                                @(payment.PaidAt.HasValue
                                    ? payment.PaidAt.Value.ToString("dd MMM yyyy, h:mm tt")
                                    : "-")
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
</div>