@page
@model IndexModel
@using System.Text.Json
@{
    // US50 (Owner: Member 1): public Home page.
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;   // sections go edge to edge
    
    // Link to the dish on Member 3's menu page (opens its details pop-up). No ID -> the full menu.
    string DishUrl(int? id) => id is null
        ? Url.Page("/Menu/Index")!
        : Url.Page("/Menu/Index", null, new { ItemId = id }, null, null, "dish-details")!;

    // A kanji for each card, picked from the category name (shown until the dish has a photo).
    // Checks Japanese and English words, e.g. "Sashimi · Raw Seafood" -> 刺 (from 刺身, sashimi).
    string Kanji(string category)
    {
        var c = category.ToLowerInvariant();
        bool Has(params string[] words) => words.Any(c.Contains);

        if (Has("non-alcoholic", "soft", "dorinku", "tea", "juice", "coffee")) return "茶";   // soft drinks, tea
        if (Has("sake", "beer", "biru", "whisky", "highball", "shochu", "cocktail", "wine", "alcohol")) return "酒";   // alcohol
        if (Has("sashimi", "raw")) return "刺";                       // sashimi
        if (Has("sushi", "nigiri", "maki")) return "寿";              // sushi
        if (Has("menmono", "noodle", "ramen", "udon", "soba")) return "麺";   // noodles
        if (Has("yakimono", "yakitori", "kushi", "grill", "skewer")) return "焼";   // grilled
        if (Has("agemono", "fried", "karaage", "tempura")) return "揚";       // deep-fried
        if (Has("nimono", "simmer", "stew")) return "煮";              // simmered
        if (Has("nabe", "hot pot", "hotpot")) return "鍋";             // hot pot
        if (Has("gohan", "donburi", "rice", "don ")) return "飯";      // rice dishes
        if (Has("soup", "shiru", "miso")) return "汁";                 // soup
        if (Has("sarada", "salad", "vegetable", "yasai")) return "菜";  // salads, vegetables
        if (Has("otsumami", "small bite", "appetiser", "appetizer", "starter", "snack")) return "肴";   // bites to go with drinks
        if (Has("dessert", "amami", "sweet")) return "甘";             // desserts
        if (Has("drink", "beverage", "nomimono")) return "飲";         // other drinks
        return "食";                                                   // anything else: "food"
    }
    string[] colours = { "#E07A5F", "#C2553A", "#A8763E", "#7C8F5A" };

    string Price(decimal price, decimal? off) =>
        off is decimal p ? (price * (100 - p) / 100).ToString("0.00") : price.ToString("0.00");

    string EndsText(DateTime end)
    {
        var days = (end.Date - DateTime.Today).Days;
        return days <= 0 ? "Last day today" : days == 1 ? "Ends tomorrow" : $"Until {end:d MMM}";
    }

    // Hero words for each mood (the mood comes from today's opening hours).
    var (eyebrow, title) = Model.Info.Mood switch
    {
        "before" when Model.Info.MoodText.StartsWith("On a short break") => ("休憩 · Short break", "Back in a<br /><em>moment.</em>"),
        "before" => ("夕暮れ · Opening soon", "Tokyo wakes up<br /><em>soon.</em>"),
        "last" => ("ラストオーダー · Last orders", "One more<br /><em>round?</em>"),
        "closed" => ("お休み · Resting tonight", "Resting tonight,<br />back <em>tomorrow.</em>"),
        _ => ("居酒屋 · YORU Izakaya", "Where Tokyo<br />comes <em>alive.</em>")
    };
    if (Model.CustomerName is not null && Model.Info.Mood is "open" or "last")
    {
        eyebrow = $"おかえりなさい · Welcome back, {Model.CustomerName}";
    }

    var mapsUrl = "https://www.google.com/maps/search/?api=1&query="
    + Uri.EscapeDataString(RROMS.Models.Brand.FullName + " " + Model.Info.Address.Replace("\r", "").Replace("\n", ", "));
    var telLink = "tel:" + new string(Model.Info.Phone.Where(ch => char.IsDigit(ch) || ch == '+').ToArray());
}

<div class="hm">

@* US39 (Member 4): one-line announcement banner; shows nothing when there is no live announcement. *@
@await Component.InvokeAsync("AnnouncementBanner")

@* ---------- 1. Hero (the mood follows today's opening hours) ---------- *@
<section class="hm-hero" data-mood="@Model.Info.Mood">
    <div class="hm-photo" aria-hidden="true"><span class="hm-lamp"></span></div>
    <span class="hm-petal p1" aria-hidden="true"></span><span class="hm-petal p2" aria-hidden="true"></span>
    <span class="hm-petal p3" aria-hidden="true"></span><span class="hm-petal p4" aria-hidden="true"></span>
    <span class="hm-petal p5" aria-hidden="true"></span><span class="hm-petal p6" aria-hidden="true"></span>
    <span class="hm-vert jp" aria-hidden="true">ようこそ、夜の東京へ</span>

    <div class="container-xl hm-inner">
        <div class="hm-hero-copy">
            <span class="hm-eyebrow jp">@eyebrow</span>
            <h1 class="hm-title">@Html.Raw(title)</h1>
            <p class="hm-lede">Good food, great drinks and unforgettable nights. YORU brings the spirit of a Tokyo izakaya to the heart of Bukit Bintang.</p>
            <div class="hm-cta">
                <a class="btn btn-primary btn-lg px-4" href="/Customer/Reservations/Create">
                    Book a table <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
                <a class="hm-play" href="#story"><span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" /></svg></span><b class="jp">物語</b>Our story</a>
            </div>
            <p class="hm-chip"><i aria-hidden="true"></i>@Model.Info.MoodText</p>
        </div>
    </div>
    <div class="hm-scroll" aria-hidden="true"><b>SCROLL</b></div>
</section>

@* ---------- 2. Signature menu (Member 3's menu, most ordered first) ---------- *@
<section class="hm-sig hm-paper">
    <div class="container-xl hm-sig-grid">
        <div>
            <span class="hm-eyebrow">Our signature menu · 名物</span>
            <h2 class="hm-h2">Taste the authentic<br />flavours of <em>Japan.</em></h2>
            <span class="hm-rule" aria-hidden="true"></span>
            <p class="hm-text mb-4">From fresh sashimi to flame-grilled favourites, these are the dishes our guests order again and again.</p>
            <a class="hm-link" href="/Menu">View full menu <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="hm-dishes count-@Model.Dishes.Count">
            @for (var i = 0; i < Model.Dishes.Count; i++)
            {
                var d = Model.Dishes[i];
                var hasPhoto = !string.IsNullOrEmpty(d.ImageUrl);
                <a class="hm-card hm-dish" href="@DishUrl(d.Id)" style="--pc:@(colours[i % colours.Length])">
                    @* Kanji first; the photo (if Member 3 added one) covers it. If the photo file is missing, it removes itself. *@
                    <span class="hm-card-kanji jp" aria-hidden="true">@Kanji(d.CategoryName)</span>
                    @* Member 3 stores "~/menu-images/abc.png"; Url.Content turns "~/" into the real address, same as the Menu page. *@
                    @if (hasPhoto)
                    {
                        <img class="hm-card-img" src="@Url.Content(d.ImageUrl)" alt="@d.Name" loading="lazy" onerror="this.remove()" />
                    }
                    @if (d.DiscountPercent is decimal off)
                    {
                        <span class="hm-tag">@off.ToString("0.#")% off</span>
                    }
                    else if (d.IsPopular)
                    {
                        <span class="hm-tag">Popular</span>
                    }
                    <span class="hm-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
                    <div class="hm-card-foot">
                        <div><h3>@d.Name</h3><small>@d.CategoryName</small></div>
                        <span class="hm-price">
                            @if (d.DiscountPercent is not null)
                            {
                                <s>RM @d.Price.ToString("0.00")</s>
                            }
                            RM @Price(d.Price, d.DiscountPercent)
                        </span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@* ---------- 3. Our story + numbers ---------- *@
<section class="hm-story hm-dark" id="story">
    <div class="hm-story-photo" role="img" aria-label="Inside YORU Izakaya"></div>
    <div class="hm-story-copy">
        <span class="hm-eyebrow">Our story · 物語</span>
        <h2 class="hm-h2">A little Tokyo<br /><em>after dark.</em></h2>
        <p class="hm-text">YORU means "night". We bring the warm, lively izakaya feeling of Tokyo to Kuala Lumpur: small plates to share, good drinks, and nobody rushing you home.</p>

        @* Numbers come from the database (menu, categories, opening hours) *@
        <div class="hm-stats">
            @if (Model.Info.DishCount > 0)
            {
                <div class="hm-stat"><b>@Model.Info.DishCount</b><span>Dishes</span></div>
            }
            @if (Model.Info.CategoryCount > 0)
            {
                <div class="hm-stat"><b>@Model.Info.CategoryCount</b><span>Categories</span></div>
            }
            <div class="hm-stat"><b>@Model.Info.OpenDays</b><span>Nights a week</span></div>
            <div class="hm-stat"><b>@Model.Info.LastOrders</b><span>Closing today</span></div>
        </div>

        <a class="btn btn-outline-gold px-4" href="/About">Learn more about us <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
    </div>
    <span class="hm-vert jp" aria-hidden="true">夜は、まだ終わらない</span>
    <span class="hm-waves" aria-hidden="true"></span>
</section>

@* ---------- 4. The YORU experience + omikuji ---------- *@
<section class="hm-exp hm-paper">
    <div class="container-xl">
        <div class="hm-center">
            <span class="hm-eyebrow">The YORU experience</span>
            <h2 class="hm-h2">More than just a meal</h2>
        </div>
        <div class="hm-feats">
            <div class="hm-feat">
                <div class="hm-feat-icon"><i class="bi bi-water" aria-hidden="true"></i></div>
                <h3>Fresh ingredients</h3><p>Fish delivered every morning, sliced to order.</p>
            </div>
            <div class="hm-feat">
                <div class="hm-feat-icon"><i class="bi bi-fire" aria-hidden="true"></i></div>
                <h3>Authentic taste</h3><p>Traditional recipes, grilled over real charcoal.</p>
            </div>
            <div class="hm-feat">
                <div class="hm-feat-icon"><i class="bi bi-cup-straw" aria-hidden="true"></i></div>
                <h3>Crafted drinks</h3><p>Sake, Japanese whisky and crisp highballs.</p>
            </div>
            <div class="hm-feat">
                <div class="hm-feat-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
                <h3>Warm atmosphere</h3><p>A cosy space for friends, family and late nights.</p>
            </div>
        </div>

        <div class="hm-omikuji">
            <div>
                <span class="hm-eyebrow">Omikuji · おみくじ</span>
                <h2 class="hm-h2">Can't decide?<br />Ask the <em>gods.</em></h2>
                <span class="hm-rule" aria-hidden="true"></span>
                <p class="hm-text">Shake the box and let fortune pick your dish for tonight, from what's on our menu right now.</p>
            </div>
                        <div class="hm-omi-left">
                <div class="hm-omi-stage">
                    @* Back: the painted circle, clouds and sakura (one image) *@
                    <img class="hm-omi-bg" src="~/images/home/omikuji-bg.webp" alt="" aria-hidden="true" />

                    <button type="button" class="hm-omi-box" id="omiBox" aria-label="Shake the omikuji box">
                        <span class="hm-omi-shadow" aria-hidden="true"></span>
                        <span class="hm-omi-wrap" aria-hidden="true">
                            <span class="hm-omi-sticks"><i></i><i></i><i></i></span>
                            <span class="hm-omi-stick"><b class="jp" id="omiNo">七番</b></span>
                            <span class="hm-omi-body">
                                <span class="hm-omi-rope"></span>
                                <span class="hm-omi-shide l"></span><span class="hm-omi-shide r"></span>
                                <span class="hm-omi-label jp">御神籤</span>
                                <i class="hm-omi-seal jp">吉</i>
                            </span>
                        </span>
                    </button>
                    @* Front: the two big flowers only (transparent image), so they sit in front of the box *@
                    <img class="hm-omi-bg hm-omi-bg-front" src="~/images/home/omikuji-front.webp" alt="" aria-hidden="true" />
                </div>

                <button type="button" class="hm-omi-btn" id="omiShake">
                    <svg class="hm-omi-dice" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5 3.5 7v10l8.5 4.5 8.5-4.5V7Z" fill="#fff" fill-opacity=".14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M3.8 7.2 12 11.6l8.2-4.4M12 11.6v9.6" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="6.9" r="1.2" fill="currentColor" /><circle cx="7.6" cy="12.6" r="1.1" fill="currentColor" /><circle cx="16.4" cy="12.6" r="1.1" fill="currentColor" /><circle cx="16.4" cy="16.4" r="1.1" fill="currentColor" /></svg>
                    <span><span class="jp">振る</span> · Shake the box</span>
                    <svg class="hm-omi-chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <p class="hm-omi-hint">Tap the box or the button</p>
            </div>
            <div class="hm-slip is-empty" id="omiSlip" aria-live="polite">
                <div><span class="hm-slip-big jp" aria-hidden="true">運</span>Your fortune will appear here.</div>
            </div>
        </div>
    </div>
</section>

@* ---------- 5. Limited time only (active promotions; hidden when there are none) ---------- *@
@if (Model.Offers.Count > 0)
{
    <section class="hm-specials hm-dark">
        <div class="container-xl hm-specials-grid">
            <div>
                <span class="hm-eyebrow">Right now at YORU · 今だけ</span>
                <h2 class="hm-h2">Limited time<br /><em>only.</em></h2>
                <p class="hm-text mb-4">Our current deals, straight from the kitchen. Catch them before they're gone.</p>
                <a class="btn btn-outline-gold px-4" href="/Menu">Explore the menu <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
            </div>
            <div class="hm-offers count-@Model.Offers.Count">
                @for (var i = 0; i < Model.Offers.Count; i++)
                {
                    var o = Model.Offers[i];
                    var hasPhoto = !string.IsNullOrEmpty(o.ImageUrl);
                    <a class="hm-card" href="@DishUrl(o.MenuItemId)" style="--pc:@(colours[i % colours.Length])">
                        <span class="hm-card-kanji jp" aria-hidden="true">@Kanji(o.CategoryName + " " + o.DishName)</span>
                        @if (hasPhoto)
                        {
                            <img class="hm-card-img" src="@Url.Content(o.ImageUrl)" alt="@o.DishName" loading="lazy" onerror="this.remove()" />
                        }
                        @if (i == 0)
                        {
                            <span class="hm-offer-badge"><b>@o.DiscountPercent.ToString("0.#")%</b><span>OFF</span></span>
                        }
                        <span class="hm-ends">@EndsText(o.EndDate)</span>
                        <div class="hm-card-foot">
                            <div><h3>@o.Title</h3><small>@o.DishName</small></div>
                            <span class="hm-price"><s>RM @o.Price.ToString("0.00")</s>RM @Price(o.Price, o.DiscountPercent)</span>
                        </div>
                    </a>
                }
            </div>
        </div>
        <span class="hm-waves" aria-hidden="true"></span>
    </section>
}

@* ---------- 6. Visit us (Member 5's settings + Member 2's hours) + quick booking ---------- *@
<section class="hm-visit hm-paper" id="visit">
    <img class="hm-torii" src="~/images/home/torii.webp" alt="" aria-hidden="true" />
    <div class="container-xl hm-visit-grid">
        <img class="hm-ink" src="~/images/home/ink-landscape.webp" alt="" aria-hidden="true" />

        <div>
            <span class="hm-eyebrow">Visit us · ご来店</span>
            <h2 class="hm-h2">Find your seat<br />at <em>YORU.</em></h2>
            <div class="hm-info-row">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <div>
                        <b>Address</b><span style="white-space:pre-line">@Model.Info.Address</span><br />
                    <a class="hm-link mt-1" href="@mapsUrl" target="_blank" rel="noopener">Open in Google Maps <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <div class="hm-info-row">
                <i class="bi bi-telephone" aria-hidden="true"></i>
                <div><b>Phone</b><a href="@telLink">@Model.Info.Phone</a></div>
            </div>
            <div class="hm-info-row">
                <i class="bi bi-clock" aria-hidden="true"></i>
                <div>
                    <b>Opening hours</b>
                    <table class="hm-hours">
                        @foreach (var row in Model.Hours)
                        {
                            @* "Fri 30 Oct · Holiday" -> date + small name; "10 AM – 3 PM · 5 PM – 10 PM" -> one line per period *@
                            var dayParts = row.Days.Split(" · ", 2);
                            <tr class="@(row.IsClosed ? "closed" : "") @(dayParts.Length > 1 ? "special" : "")">
                                <td>@dayParts[0]@if (dayParts.Length > 1) {<small>@dayParts[1]</small>}</td>
                                <td>@foreach (var period in row.Hours.Split(" · ")) {<span>@period</span>}</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        
        @* Quick booking box. Saves nothing: it only opens Member 2's booking page with date, time and guests filled in.
           The real checks (free table, capacity, opening hours) happen on Member 2's page. *@
        <form class="bk" id="bk" method="get" action="/Customer/Reservations/Create">
            <div class="bk-head"><h3>Make a reservation</h3><span class="jp">ご予約</span></div>
            <input type="hidden" name="date" id="bkDate" />
            <input type="hidden" name="time" id="bkTime" />
            <input type="hidden" name="guests" id="bkGuests" value="2" />

            <div class="bk-fields">
                <div class="bk-f wide" data-f="date">
                    <button type="button" class="bk-field" aria-haspopup="dialog">
                        <i class="bk-ico jp" aria-hidden="true">日</i><span><small>Date</small><b id="bkDateTxt">Choose a date</b></span>
                    </button>
                    <div class="bk-pop" role="dialog" aria-label="Choose a date">
                        <div class="bk-month">
                            <button type="button" class="bk-nav" id="bkPrev" aria-label="Previous month"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
                            <b id="bkMonthName"></b>
                            <button type="button" class="bk-nav" id="bkNext" aria-label="Next month"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
                        </div>
                        <div class="bk-cal" id="bkCal"></div>
                        <p class="bk-cal-note" id="bkRange"></p>
                    </div>
                </div>
                <div class="bk-f" data-f="time">
                    <button type="button" class="bk-field" aria-haspopup="dialog">
                        <i class="bk-ico jp" aria-hidden="true">時</i><span><small>Time</small><b id="bkTimeTxt">Choose a time</b></span>
                    </button>
                    <div class="bk-pop" role="dialog" aria-label="Choose a time">
                        <p class="bk-pop-head"><span id="bkTimeDay"></span><span id="bkLast"></span></p>
                        <div class="bk-tlist" id="bkSlots"></div>
                        <div class="bk-own" id="bkOwn">
                            <p class="bk-own-title">Or set your own time</p>
                            <div class="bk-own-row">
                                <div class="bk-wheel">
                                    <button type="button" id="bkOwnHUp" aria-label="One hour later"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10l4-4 4 4" /></svg></button>
                                    <b id="bkOwnH">7</b>
                                    <button type="button" id="bkOwnHDown" aria-label="One hour earlier"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg></button>
                                </div>
                                <span class="bk-colon">:</span>
                                <div class="bk-wheel">
                                    <button type="button" id="bkOwnMUp" aria-label="Five minutes later"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10l4-4 4 4" /></svg></button>
                                    <b id="bkOwnM">00</b>
                                    <button type="button" id="bkOwnMDown" aria-label="Five minutes earlier"><svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg></button>
                                </div>
                                <span class="bk-ap" id="bkOwnAp">PM</span>
                                <button type="button" class="bk-use" id="bkOwnUse">Use 7:00 PM</button>
                            </div>
                            <p class="bk-err" id="bkOwnErr" role="alert"></p>
                        </div>
                        <p class="bk-err" id="bkTimeErr" role="alert"></p>
                    </div>
                </div>
                <div class="bk-f right" data-f="guests">
                    <button type="button" class="bk-field" aria-haspopup="dialog">
                        <i class="bk-ico jp" aria-hidden="true">人</i><span><small>Guests</small><b id="bkGuestTxt">2 guests</b></span>
                    </button>
                    <div class="bk-pop" role="dialog" aria-label="Number of guests">
                        <p class="bk-pop-head"><span>How many guests?</span><span>Up to @Model.Booking.MaxGuests</span></p>
                        <div class="bk-guests">
                            <div class="bk-stepper">
                                <button type="button" id="bkMinus" aria-label="One guest fewer">−</button>
                                <input type="number" id="bkCount" class="bk-count" inputmode="numeric" min="1" step="1" value="2" aria-label="Number of guests" />
                                <button type="button" id="bkPlus" aria-label="One guest more">+</button>
                            </div>
                            <div class="bk-quick" id="bkQuick"></div>
                        </div>
                        <p class="bk-err" id="bkGuestErr" role="alert"></p>
                        <p class="bk-note">Tap + / − or type a number. Bigger group? <a href="@telLink">Call us</a></p>
                        <button type="button" class="bk-done">Done</button>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary bk-go" id="bkGo" type="submit" disabled>Book now <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
            <small class="bk-foot">You'll confirm the details on the next page.</small>
        </form>
    </div>
</section>

</div>

@* Bookable dates and guest limit for the booking box (Member 2's booking rules) *@
<script type="application/json" id="bkData">@Html.Raw(JsonSerializer.Serialize(Model.Booking))</script>

@* Dishes for the omikuji box (JsonSerializer escapes < > & so this is safe inside a script tag) *@
<script type="application/json" id="omiData">@Html.Raw(JsonSerializer.Serialize(Model.OmikujiDishes))</script>

@section Scripts {
    <script>
        // US50 quick booking box. The rules are Member 2's booking rules (US12), so this box offers exactly
        // what her booking page accepts: bookable dates and the guest limit come in bkData, and the times
        // for a date are loaded from ?handler=Slots (IReservationService.GetTimeSlotsAsync): opening hours,
        // breaks, special dates, the 90-minute sitting and the 1-hour notice are all handled there.
        // This box saves nothing; Member 2's page still does the real checks (free tables, limits).
        (function () {
            var box = document.getElementById('bk'), raw = document.getElementById('bkData');
            if (!box || !raw) return;
            var cfg = JSON.parse(raw.textContent);
            var MAX = cfg.MaxGuests, STEP = cfg.StepMinutes || 5, DAYS_AHEAD = cfg.DaysAhead;
            var DATES = new Set(cfg.Dates || []), SHUT = new Set(cfg.ClosedDates || []), SHUT_DAYS = new Set(cfg.ClosedWeekdays || []);
            var p = cfg.Now.split(/[-T:]/).map(Number), NOW = new Date(p[0], p[1] - 1, p[2], p[3], p[4]);
            var W = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], M = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            var MN = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            var $ = function (id) { return document.getElementById(id); };

            var today0 = new Date(NOW.getFullYear(), NOW.getMonth(), NOW.getDate());
            var lastDay = new Date(today0); lastDay.setDate(today0.getDate() + DAYS_AHEAD);
            var st = { date: null, time: null, timeError: '', guests: 2, guestError: '' };
            var view = new Date(today0.getFullYear(), today0.getMonth(), 1);
            var list = [];          // times for the chosen date, minutes from midnight (after-midnight times go past 1440)
            var cache = {};         // date -> list, so going back to a date does not ask the server again
            var request = 0;

            // ---------- helpers ----------
            function fmt(m) { var h = Math.floor(m / 60) % 24, n = m % 60; return ((h % 12) || 12) + ':' + (n < 10 ? '0' : '') + n + ' ' + (h < 12 ? 'AM' : 'PM'); }
            function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
            function hhmm(m) { return String(Math.floor(m / 60) % 24).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); }
            function nice(d) { return W[d.getDay()] + ', ' + d.getDate() + ' ' + M[d.getMonth()]; }
            function isToday(d) { return +d === +today0; }
            function bookable(d) { return DATES.has(iso(d)); }
            function shut(d) { return SHUT.has(iso(d)) || SHUT_DAYS.has(d.getDay()); }

            // Runs of times without a gap, e.g. [10:00 → 1:30 PM] and [5:00 → 8:30 PM] around a 3–5 PM break.
            // Any time inside a run (in 5-minute steps) is accepted by Member 2's page.
            function runs() {
                var out = [];
                list.forEach(function (t, i) {
                    if (i === 0 || t - list[i - 1] > 30) out.push([t, t]); else out[out.length - 1][1] = t;
                });
                return out;
            }

            // '' when the time is allowed, otherwise the message to show.
            function checkTime(t) {
                var r = runs();
                if (!r.length) return 'No times left on this day.';
                for (var i = 0; i < r.length; i++) if (t >= r[i][0] && t <= r[i][1]) return '';
                if (t < r[0][0]) return 'The first booking time on this day is ' + fmt(r[0][0]) + '.';
                if (t > r[r.length - 1][1]) return 'The last booking on this day is ' + fmt(r[r.length - 1][1]) + '.';
                for (var j = 0; j + 1 < r.length; j++) {
                    if (t > r[j][1] && t < r[j + 1][0])
                        return 'A 90-minute sitting then would run into our break. Choose up to ' + fmt(r[j][1]) + ', or from ' + fmt(r[j + 1][0]) + '.';
                }
                return 'Please choose another time.';
            }

            // Times for one date from Member 2's rules ("HH:mm" values; a time earlier than the one before is after midnight).
            function loadSlots(d) {
                var key = iso(d);
                if (cache[key]) return Promise.resolve(cache[key]);
                return fetch('?handler=Slots&date=' + key, { headers: { Accept: 'application/json' } })
                    .then(function (r) { return r.ok ? r.json() : []; })
                    .then(function (rows) {
                        var out = [], prev = -1;
                        rows.forEach(function (row) {
                            var q = row.value.split(':').map(Number), m = q[0] * 60 + q[1];
                            if (m < prev) m += 1440;
                            out.push(m); prev = m;
                        });
                        cache[key] = out;
                        return out;
                    })
                    .catch(function () { return null; });
            }

            // ---------- open / close the small pickers ----------
            function open(name) {
                [].forEach.call(box.querySelectorAll('.bk-f'), function (f) {
                    var on = f.dataset.f === name && !f.classList.contains('is-open');
                    f.classList.toggle('is-open', on);
                    if (!on) return;
                    var pop = f.querySelector('.bk-pop');
                    pop.classList.remove('up');                              // open below; flip above if there is no room
                    var r = pop.getBoundingClientRect();
                    if (r.bottom > window.innerHeight - 8 && f.getBoundingClientRect().top > r.height + 16) pop.classList.add('up');
                    if (name === 'time') { var c = $('bkSlots').querySelector('.bk-time.is-on'); if (c) $('bkSlots').scrollTop = c.offsetTop - $('bkSlots').offsetTop - 30; }
                });
            }
            [].forEach.call(box.querySelectorAll('.bk-field'), function (b) { b.addEventListener('click', function () { open(b.parentNode.dataset.f); }); });
            document.addEventListener('click', function (e) { if (!box.contains(e.target)) open(null); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') open(null); });
            [].forEach.call(box.querySelectorAll('.bk-done'), function (b) { b.addEventListener('click', function () { open(null); }); });

            // ---------- 日 date: one month at a time ----------
            function drawMonth() {
                var cal = $('bkCal'); cal.innerHTML = '';
                W.forEach(function (w) { var s = document.createElement('span'); s.className = 'w'; s.textContent = w[0]; cal.appendChild(s); });
                for (var b = 0; b < view.getDay(); b++) { var e = document.createElement('span'); e.className = 'bk-day blank'; cal.appendChild(e); }
                var n = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
                for (var i = 1; i <= n; i++) {
                    var d = new Date(view.getFullYear(), view.getMonth(), i), ok = bookable(d), past = d < today0, far = d > lastDay;
                    var c = document.createElement('button');
                    c.type = 'button'; c.disabled = !ok;
                    c.className = 'bk-day' + (st.date && +d === +st.date ? ' is-on' : '') + (isToday(d) ? ' is-today' : '');
                    c.title = ok ? nice(d) : past ? '' : far ? 'Too far ahead' : (shut(d) ? 'Closed' : 'No times left');
                    c.innerHTML = i + (isToday(d) ? '<small>Today</small>' : (!ok && !past && !far ? '<small>' + (shut(d) ? 'Shut' : 'Full') + '</small>' : ''));
                    (function (dd) { c.addEventListener('click', function () { pickDate(dd).then(function () { open('time'); }); }); })(d);
                    cal.appendChild(c);
                }
                $('bkMonthName').textContent = MN[view.getMonth()] + ' ' + view.getFullYear();
                $('bkPrev').disabled = view.getFullYear() === today0.getFullYear() && view.getMonth() === today0.getMonth();
                $('bkNext').disabled = view.getFullYear() === lastDay.getFullYear() && view.getMonth() === lastDay.getMonth();
            }
            $('bkPrev').addEventListener('click', function () { view.setMonth(view.getMonth() - 1); drawMonth(); });
            $('bkNext').addEventListener('click', function () { view.setMonth(view.getMonth() + 1); drawMonth(); });
            $('bkRange').textContent = 'Book up to ' + DAYS_AHEAD + ' days ahead · until ' + nice(lastDay);

            function pickDate(d) {
                var mine = ++request;
                st.date = d; drawMonth();
                $('bkTimeDay').textContent = nice(d);
                $('bkLast').textContent = '';
                $('bkSlots').innerHTML = '<div class="bk-empty">Loading times…</div>';
                update();
                return loadSlots(d).then(function (got) {
                    if (mine !== request) return;          // a newer date was picked meanwhile
                    if (got === null) { list = []; $('bkSlots').innerHTML = '<div class="bk-empty">Could not load the times. Please try again.</div>'; update(); return; }
                    list = got;
                    // keep the time if it is still allowed on the new day, otherwise 7 PM or the first free time
                    if (st.time === null || checkTime(st.time)) st.time = list.indexOf(1140) >= 0 ? 1140 : (list.length ? list[0] : null);
                    st.timeError = '';
                    $('bkLast').textContent = list.length ? 'Last booking ' + fmt(list[list.length - 1]) : '';
                    resetOwn();
                    drawSlots();
                    update();
                });
            }

            // ---------- 時 time: chips every 30 minutes, or set your own ----------
            function drawSlots() {
                var s = $('bkSlots'); s.innerHTML = '';
                if (!list.length) { s.innerHTML = '<div class="bk-empty">No times left this day.</div>'; return; }
                [['Lunch', 0, 900], ['Afternoon', 900, 1080], ['Evening', 1080, 3000]].forEach(function (g) {
                    var part = list.filter(function (t) { return t >= g[1] && t < g[2]; }); if (!part.length) return;
                    var wrap = document.createElement('div'); wrap.className = 'bk-group'; wrap.innerHTML = '<span>' + g[0] + '</span><div class="bk-times"></div>';
                    part.forEach(function (t) {
                        var c = document.createElement('button'); c.type = 'button'; c.className = 'bk-time'; c.dataset.t = t; c.textContent = fmt(t);
                        c.addEventListener('click', function () { st.time = t; st.timeError = ''; resetOwn(); update(); open(null); });
                        wrap.lastChild.appendChild(c);
                    });
                    s.appendChild(wrap);
                });
            }

            // ---------- your own time: hour and minute steppers + "Use this time" ----------
            // The steppers stay between the first and last time of the day; a time inside a break is refused.
            var own = null;
            function ownLimits() { return list.length ? [list[0], list[list.length - 1]] : null; }
            function resetOwn() {
                var lim = ownLimits(); if (!lim) { own = null; drawOwn(); return; }
                own = st.time !== null ? st.time : lim[0];
                own = Math.min(lim[1], Math.max(lim[0], own));
                drawOwn();
            }
            function moveOwn(delta) {
                var lim = ownLimits(); if (!lim || own === null) return;
                own = Math.min(lim[1], Math.max(lim[0], own + delta));
                drawOwn();
            }
            function drawOwn() {
                var lim = ownLimits(), wrap = $('bkOwn');
                wrap.classList.toggle('is-off', !lim);
                if (!lim) { $('bkOwnErr').textContent = ''; return; }
                var h = Math.floor(own / 60) % 24, m = own % 60;
                $('bkOwnH').textContent = (h % 12) || 12;
                $('bkOwnM').textContent = (m < 10 ? '0' : '') + m;
                $('bkOwnAp').textContent = h < 12 ? 'AM' : 'PM';
                $('bkOwnHDown').disabled = own - 60 < lim[0]; $('bkOwnHUp').disabled = own + 60 > lim[1];
                $('bkOwnMDown').disabled = own - STEP < lim[0]; $('bkOwnMUp').disabled = own + STEP > lim[1];
                var err = checkTime(own);
                $('bkOwnErr').textContent = err;
                $('bkOwnUse').disabled = !!err;
                $('bkOwnUse').textContent = err ? 'Not available' : 'Use ' + fmt(own);
            }
            $('bkOwnHUp').addEventListener('click', function () { moveOwn(60); });
            $('bkOwnHDown').addEventListener('click', function () { moveOwn(-60); });
            $('bkOwnMUp').addEventListener('click', function () { moveOwn(STEP); });
            $('bkOwnMDown').addEventListener('click', function () { moveOwn(-STEP); });
            $('bkOwnUse').addEventListener('click', function () {
                if (own === null || checkTime(own)) return;
                st.time = own; st.timeError = ''; update(); open(null);
            });

            // ---------- 人 guests: + / −, quick buttons, or type a number ----------
            function setGuests(n) { st.guests = n; st.guestError = ''; $('bkCount').value = n; update(); }
            function checkGuests(text) {
                if (!/^\d+$/.test(text.trim())) return 'Please enter a whole number of guests.';
                var n = parseInt(text, 10);
                if (n < 1) return 'At least 1 guest, please.';
                if (n > MAX) return 'Online bookings are up to ' + MAX + ' guests. For bigger groups, please call us.';
                return '';
            }
            [2, 4, 6].filter(function (n) { return n <= MAX; }).forEach(function (n) {
                var q = document.createElement('button'); q.type = 'button'; q.textContent = n;
                q.addEventListener('click', function () { setGuests(n); });
                $('bkQuick').appendChild(q);
            });
            $('bkMinus').addEventListener('click', function () { setGuests(Math.max(1, (st.guestError ? 2 : st.guests) - 1)); });
            $('bkPlus').addEventListener('click', function () { setGuests(Math.min(MAX, (st.guestError ? 1 : st.guests) + 1)); });
            $('bkCount').max = MAX;
            $('bkCount').addEventListener('input', function () {
                var err = checkGuests(this.value);
                st.guestError = err; if (!err) st.guests = parseInt(this.value, 10);
                update();
            });

            // ---------- show the current choice and enable Book now ----------
            function update() {
                var d = st.date;
                $('bkDateTxt').textContent = d ? nice(d) + (isToday(d) ? ' · Today' : (d - today0) === 864e5 ? ' · Tomorrow' : '') : 'Choose a date';
                $('bkDateTxt').classList.toggle('is-empty', !d);

                $('bkTimeTxt').textContent = st.timeError ? 'Check the time' : st.time !== null ? fmt(st.time) : 'Choose a time';
                $('bkTimeTxt').classList.toggle('is-empty', st.time === null && !st.timeError);
                $('bkTimeTxt').classList.toggle('is-bad', !!st.timeError);
                $('bkTimeErr').textContent = st.timeError;
                [].forEach.call($('bkSlots').querySelectorAll('.bk-time'), function (c) { c.classList.toggle('is-on', +c.dataset.t === st.time); });

                $('bkGuestTxt').textContent = st.guestError ? 'Check guests' : st.guests + (st.guests === 1 ? ' guest' : ' guests');
                $('bkGuestTxt').classList.toggle('is-bad', !!st.guestError);
                $('bkGuestErr').textContent = st.guestError;
                $('bkCount').classList.toggle('is-bad', !!st.guestError);
                $('bkMinus').disabled = !st.guestError && st.guests <= 1;
                $('bkPlus').disabled = !st.guestError && st.guests >= MAX;
                [].forEach.call($('bkQuick').children, function (q) { q.classList.toggle('is-on', !st.guestError && +q.textContent === st.guests); });

                var ready = d && st.time !== null && !st.timeError && !st.guestError;
                $('bkDate').value = d ? iso(d) : '';
                $('bkTime').value = st.time !== null ? hhmm(st.time) : '';
                $('bkGuests').value = st.guestError ? '' : st.guests;
                $('bkGo').disabled = !ready;
            }

            // start with the first bookable day (usually today or tomorrow), 7 PM, 2 guests
            setGuests(2);
            drawMonth();
            var first = (cfg.Dates || []).slice().sort()[0];
            if (first) {
                var q = first.split('-').map(Number), fd = new Date(q[0], q[1] - 1, q[2]);
                view = new Date(fd.getFullYear(), fd.getMonth(), 1);
                pickDate(fd);
            } else {
                $('bkSlots').innerHTML = '<div class="bk-empty">No booking dates are open right now. Please call us.</div>';
            }
            update();
        })();
    </script>
    <script>
        // US50 omikuji: shake the box, pick a random dish and a fortune.
        (function () {
            var box = document.getElementById('omiBox'), slip = document.getElementById('omiSlip');
            var dishes = JSON.parse(document.getElementById('omiData').textContent || '[]');
            if (!box || !slip || dishes.length === 0) return;

            var fortunes = [
                ['大吉', 'Great luck', "A great night is coming. Order a second round, you've earned it."],
                ['中吉', 'Good luck', 'Good company and good food. Share this one with a friend.'],
                ['吉', 'Luck', 'Simple and satisfying. Pair it with a cold highball.'],
                ['小吉', 'Small luck', "Small luck, big flavour. Don't skip dessert."],
                ['末吉', 'Future luck', 'Your luck grows as the night goes on. Try something new next time.']
            ];
            function el(tag, cls, text) {
                var e = document.createElement(tag);
                if (cls) e.className = cls;
                if (text) e.textContent = text;   // textContent: dish names are never treated as HTML
                return e;
            }
            function pick(list) { return list[Math.floor(Math.random() * list.length)]; }

            var numbers = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
            var stickNo = document.getElementById('omiNo');

            function draw() {
                box.classList.remove('drawn', 'shake');
                void box.offsetWidth;                // restart the shake animation
                box.classList.add('shake');
                setTimeout(function () {
                    if (stickNo) stickNo.textContent = pick(numbers) + '番';   // number on the stick
                    box.classList.add('drawn');
                    var d = pick(dishes), f = pick(fortunes);

                    var rank = el('div', 'hm-rank');
                    rank.append(el('b', 'jp', f[0]), el('small', null, f[1]));
                    var meta = el('p', 'meta', d.Category + ' · ');
                    meta.append(el('b', null, 'RM ' + Number(d.Price).toFixed(2)));
                    var btns = el('div', 'btns');
                    var menu = el('a', 'btn btn-primary btn-sm px-3', 'See it on the menu');
                    menu.href = d.Id ? '/Menu?ItemId=' + d.Id + '#dish-details' : '/Menu';
                    var again = el('button', 'btn btn-outline-secondary btn-sm px-3', 'Shake again');
                    again.type = 'button';
                    again.addEventListener('click', draw);
                    btns.append(menu, again);

                    slip.className = 'hm-slip reveal';
                    slip.replaceChildren(rank, el('span', 'kicker', 'Tonight the gods say you eat'),
                        el('h3', null, d.Name), meta, el('p', 'luck', '“' + f[2] + '”'), btns);
                }, 900);
            }
            box.addEventListener('click', draw);
            document.getElementById('omiShake').addEventListener('click', draw);
        })();
    </script>
}
