@page
@model RROMS.Pages.Customer.Feedback.Create

@{
    ViewData["Title"] = "Customer Feedback";
}

<div class="page-header">
    <div>
        <p class="eyebrow">Customer</p>
        <h1>Feedback</h1>
    </div>
</div>

<div class="feedback-section">

    <div class="feedback-intro">
        <div class="feedback-kanji">声</div>

        <div class="feedback-intro-content">
            <p class="feedback-overline">YOUR EXPERIENCE MATTERS</p>

            <h2>
                Share Your<br />
                Experience
            </h2>

            <p class="feedback-description">
                Every visit has a story. Tell us about your dining
                experience and help us make your next night at YORU
                even better.
            </p>

            <div class="feedback-accent"></div>
        </div>
    </div>

    <div class="feedback-card">

        <h3>How was your night at YORU?</h3>

        <p class="feedback-card-subtitle">
            Feedback is available for completed orders only.
        </p>

        @if (Model.EligibleOrders.Count == 0)
        {
            <div class="feedback-empty">
                <div class="feedback-empty-icon">声</div>

                <h4>No orders available for feedback</h4>

                <p>
                    You currently have no completed orders available
                    for feedback.
                </p>
            </div>
        }
        else
        {
            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="feedback-validation"></div>

                <!-- COMPLETED ORDER -->
                <div class="feedback-field">

                    <label asp-for="OrderId">
                        Completed Order
                    </label>

                    <input asp-for="OrderId"
                           type="hidden"
                           id="orderIdInput" />

                    <div class="yoru-dropdown"
                         id="orderDropdown">

                        <button type="button"
                                class="yoru-dropdown-trigger"
                                id="orderDropdownTrigger"
                                aria-expanded="false">

                            <span id="orderDropdownText">
                                Select an order
                            </span>

                            <span class="yoru-dropdown-arrow">
                                ⌄
                            </span>

                        </button>

                        <div class="yoru-dropdown-menu"
                             id="orderDropdownMenu">

                            @foreach (var order in Model.EligibleOrders)
                            {
                                <button type="button"
                                        class="yoru-dropdown-option"
                                        data-value="@order.Id"
                                        data-label="@order.OrderNo · RM @order.TotalAmount.ToString("N2")">

                                    <span class="yoru-order-info">

                                        <strong>
                                            @order.OrderNo
                                        </strong>

                                        <small>
                                            Completed Order · RM @order.TotalAmount.ToString("N2")
                                        </small>

                                    </span>

                                    <span class="yoru-option-check">
                                        ✓
                                    </span>

                                </button>
                            }

                        </div>

                    </div>

                    <span asp-validation-for="OrderId"
                          class="feedback-error"></span>

                </div>

                <!-- RATING -->
                <div class="feedback-field">

                    <label>
                        Your Rating
                    </label>

                    <input asp-for="Rating"
                           type="hidden"
                           id="ratingValue" />

                    <div class="feedback-stars"
                         id="ratingStars">

                        @for (var i = 1; i <= 5; i++)
                        {
                            <button type="button"
                                    class="feedback-star"
                                    data-rating="@i"
                                    aria-label="@i star rating">
                                ★
                            </button>
                        }

                    </div>

                    <div class="feedback-rating-text"
                         id="ratingText">
                        Tap a star to rate your experience
                    </div>

                    <span asp-validation-for="Rating"
                          class="feedback-error"></span>

                </div>

                <!-- COMMENT -->
                <div class="feedback-field">

                    <label asp-for="Comment">
                        Tell us more
                    </label>

                    <textarea asp-for="Comment"
                              id="feedbackComment"
                              class="feedback-textarea"
                              maxlength="500"
                              placeholder="What did you enjoy? Is there anything we can do better?"></textarea>

                    <div class="feedback-character-count">
                        <span id="characterCount">0</span> / 500
                    </div>

                    <span asp-validation-for="Comment"
                          class="feedback-error"></span>

                </div>

                <!-- ACTIONS -->
                <div class="feedback-actions">

                    <span>
                        One review per completed order.
                    </span>

                    <button type="submit"
                            class="feedback-submit">
                        Submit Feedback
                    </button>

                </div>

            </form>
        }

    </div>

</div>


<style>

    .feedback-section {
        display: grid;
        grid-template-columns:
            minmax(280px, 0.8fr)
            minmax(500px, 1.35fr);

        gap: clamp(40px, 5vw, 80px);

        align-items: center;

        width: 100%;
        max-width: none;

        margin: 10px 0 70px;
    }


    /* LEFT SIDE */

    .feedback-intro {
        position: relative;

        min-height: 380px;

        display: flex;
        align-items: center;

        padding-left: 35px;
    }

    .feedback-kanji {
        position: absolute;

        left: -10px;
        top: 20px;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 190px;
        line-height: 1;

        color: #ded4c4;

        opacity: 0.65;

        user-select: none;
    }

    .feedback-intro-content {
        position: relative;
        z-index: 2;
    }

    .feedback-overline {
        margin: 0 0 12px;

        color: #ad8551;

        font-size: 10px;
        font-weight: 700;

        letter-spacing: 2.5px;
    }

    .feedback-intro h2 {
        margin: 0 0 18px;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 38px;
        line-height: 1.15;

        color: #25211e;
    }

    .feedback-description {
        max-width: 330px;

        color: #77716a;

        font-size: 13px;
        line-height: 1.8;
    }

    .feedback-accent {
        width: 46px;
        height: 3px;

        margin-top: 26px;

        background: #c83b2d;
    }


    /* CARD */

    .feedback-card {
        padding: 32px 36px;

        background: #faf7ef;

        border: 1px solid #ddd3c3;
        border-radius: 4px;

        box-shadow:
            0 12px 30px rgba(50, 40, 25, 0.06);
    }

    .feedback-card h3 {
        margin: 0 0 7px;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 23px;

        color: #25211e;
    }

    .feedback-card-subtitle {
        margin-bottom: 28px;

        color: #888078;

        font-size: 12px;
    }


    /* FORM */

    .feedback-field {
        margin-bottom: 24px;
    }

    .feedback-field label {
        display: block;

        margin-bottom: 9px;

        font-size: 12px;
        font-weight: 700;

        color: #302c28;
    }

    .feedback-textarea {
        width: 100%;

        padding: 13px 14px;

        background: #fffdf8;

        border: 1px solid #d4c9b8;
        border-radius: 3px;

        color: #39342f;

        font-size: 13px;

        outline: none;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .feedback-textarea:focus {
        border-color: #b38b54;

        box-shadow:
            0 0 0 3px rgba(179, 139, 84, 0.12);
    }

    .feedback-textarea {
        min-height: 120px;

        resize: vertical;

        line-height: 1.6;
    }


    /* YORU CUSTOM DROPDOWN */

    .yoru-dropdown {
        position: relative;

        width: 100%;
    }

    .yoru-dropdown-trigger {
        width: 100%;
        min-height: 46px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 12px 14px;

        background: #fffdf8;

        border: 1px solid #d4c9b8;
        border-radius: 3px;

        color: #39342f;

        font-size: 13px;
        text-align: left;

        cursor: pointer;

        outline: none;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }

    .yoru-dropdown-trigger:hover {
        border-color: #b38b54;
    }

    .yoru-dropdown.open
    .yoru-dropdown-trigger {
        border-color: #b38b54;

        box-shadow:
            0 0 0 3px rgba(179, 139, 84, 0.12);
    }

    .yoru-dropdown-arrow {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 20px;
        height: 20px;

        font-size: 16px;
        line-height: 1;

        margin-left: auto;

        position: relative;
        top: -2px;

        transition: transform 0.2s ease;
    }

    .yoru-dropdown.open
    .yoru-dropdown-arrow {
        transform: rotate(180deg);
    }

    .yoru-dropdown-menu {
        position: absolute;

        z-index: 1000;

        top: calc(100% + 6px);
        left: 0;
        right: 0;

        display: none;

        padding: 6px;

        background: #fffdf8;

        border: 1px solid #d4c9b8;
        border-radius: 4px;

        box-shadow:
            0 12px 28px rgba(50, 40, 25, 0.14);
    }

    .yoru-dropdown.open
    .yoru-dropdown-menu {
        display: block;
    }

    .yoru-dropdown-option {
        width: 100%;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 15px;

        padding: 11px 12px;

        background: transparent;

        border: none;
        border-left: 3px solid transparent;

        border-radius: 2px;

        color: #39342f;

        text-align: left;

        cursor: pointer;

        transition:
            background 0.15s ease,
            border-color 0.15s ease;
    }

    .yoru-dropdown-option:hover {
        background: #f3ece1;

        border-left-color: #c83b2d;
    }

    .yoru-order-info {
        display: flex;
        flex-direction: column;

        gap: 3px;
    }

    .yoru-order-info strong {
        color: #302c28;

        font-size: 13px;
        font-weight: 700;
    }

    .yoru-order-info small {
        color: #8b8176;

        font-size: 11px;
    }

    .yoru-option-check {
        display: none;

        flex-shrink: 0;

        color: #c83b2d;

        font-size: 15px;
        font-weight: 700;
    }

    .yoru-dropdown-option.selected {
        background: #f3ece1;

        border-left-color: #c83b2d;
    }

    .yoru-dropdown-option.selected
    .yoru-option-check {
        display: block;
    }


    /* STARS */

    .feedback-stars {
        display: flex;

        gap: 9px;

        align-items: center;
    }

    .feedback-star {
        padding: 0;

        border: none;

        background: transparent;

        color: #d0c7b9;

        font-size: 38px;
        line-height: 1;

        cursor: pointer;

        transition:
            color 0.15s ease,
            transform 0.15s ease;
    }

    .feedback-star:hover {
        transform: translateY(-2px);
    }

    .feedback-star.active {
        color: #b38b54;
    }

    .feedback-rating-text {
        min-height: 18px;

        margin-top: 9px;

        color: #82796d;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 13px;
        font-style: italic;
    }


    /* CHARACTER COUNTER */

    .feedback-character-count {
        margin-top: 6px;

        text-align: right;

        color: #948b80;

        font-size: 10px;
    }


    /* BUTTON */

    .feedback-actions {
        display: flex;

        justify-content: space-between;
        align-items: center;

        margin-top: 28px;
    }

    .feedback-actions > span {
        color: #918980;

        font-size: 10px;
    }

    .feedback-submit {
        padding: 12px 23px;

        border: none;
        border-radius: 3px;

        background: #c83b2d;

        color: white;

        font-size: 13px;
        font-weight: 700;

        cursor: pointer;

        transition:
            background 0.2s ease,
            transform 0.15s ease;
    }

    .feedback-submit:hover {
        background: #ad3025;

        transform: translateY(-1px);
    }


    /* VALIDATION */

    .feedback-error {
        display: block;

        margin-top: 6px;

        color: #b02a37;

        font-size: 11px;
    }

    .feedback-validation {
        margin-bottom: 18px;

        color: #b02a37;

        font-size: 12px;
    }


    /* EMPTY STATE */

    .feedback-empty {
        padding: 35px 20px;

        text-align: center;

        border-top: 1px solid #e1d8ca;
    }

    .feedback-empty-icon {
        margin-bottom: 10px;

        color: #c8b79f;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-size: 45px;
    }

    .feedback-empty h4 {
        margin-bottom: 8px;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        color: #38322d;
    }

    .feedback-empty p {
        margin: 0;

        color: #888078;

        font-size: 12px;
    }


    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .feedback-section {
            grid-template-columns: 1fr;

            gap: 10px;

            margin-bottom: 45px;
        }

        .feedback-intro {
            min-height: 270px;

            padding-left: 25px;
        }

        .feedback-kanji {
            font-size: 145px;
        }

        .feedback-intro h2 {
            font-size: 32px;
        }

        .feedback-card {
            padding: 25px 21px;
        }

        .feedback-actions {
            gap: 20px;
        }

        .yoru-dropdown-menu {
            max-height: 240px;

            overflow-y: auto;
        }
    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            // ==========================================
            // YORU CUSTOM ORDER DROPDOWN
            // ==========================================

            const orderDropdown =
                document.getElementById("orderDropdown");

            const orderDropdownTrigger =
                document.getElementById("orderDropdownTrigger");

            const orderDropdownText =
                document.getElementById("orderDropdownText");

            const orderIdInput =
                document.getElementById("orderIdInput");

            const orderOptions =
                document.querySelectorAll(
                    ".yoru-dropdown-option"
                );


            // Open / close dropdown
            orderDropdownTrigger?.addEventListener(
                "click",
                function () {

                    if (!orderDropdown) {
                        return;
                    }

                    const isOpen =
                        orderDropdown.classList.toggle(
                            "open"
                        );

                    orderDropdownTrigger.setAttribute(
                        "aria-expanded",
                        isOpen.toString()
                    );
                }
            );


            // Select order
            orderOptions.forEach(
                function (option) {

                    option.addEventListener(
                        "click",
                        function () {

                            if (
                                !orderIdInput ||
                                !orderDropdownText ||
                                !orderDropdown
                            ) {
                                return;
                            }

                            const value =
                                option.dataset.value;

                            const label =
                                option.dataset.label;

                            orderIdInput.value =
                                value || "";

                            orderDropdownText.textContent =
                                label || "Select an order";


                            orderOptions.forEach(
                                function (item) {

                                    item.classList.remove(
                                        "selected"
                                    );

                                }
                            );


                            option.classList.add(
                                "selected"
                            );


                            orderDropdown.classList.remove(
                                "open"
                            );


                            orderDropdownTrigger?.setAttribute(
                                "aria-expanded",
                                "false"
                            );


                            orderIdInput.dispatchEvent(
                                new Event(
                                    "change",
                                    {
                                        bubbles: true
                                    }
                                )
                            );

                        }
                    );

                }
            );


            // Keep selected order after validation refresh
            if (
                orderIdInput &&
                orderIdInput.value
            ) {

                orderOptions.forEach(
                    function (option) {

                        if (
                            option.dataset.value ===
                            orderIdInput.value
                        ) {

                            option.classList.add(
                                "selected"
                            );

                            if (orderDropdownText) {

                                orderDropdownText.textContent =
                                    option.dataset.label ||
                                    "Select an order";

                            }

                        }

                    }
                );

            }


            // Close dropdown when clicking outside
            document.addEventListener(
                "click",
                function (event) {

                    if (
                        orderDropdown &&
                        !orderDropdown.contains(
                            event.target
                        )
                    ) {

                        orderDropdown.classList.remove(
                            "open"
                        );

                        orderDropdownTrigger?.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }
            );


            // ==========================================
            // STAR RATING
            // ==========================================

            const stars =
                document.querySelectorAll(
                    ".feedback-star"
                );

            const ratingInput =
                document.getElementById(
                    "ratingValue"
                );

            const ratingText =
                document.getElementById(
                    "ratingText"
                );


            const ratingLabels = {
                1: "1 / 5 · Poor",
                2: "2 / 5 · Fair",
                3: "3 / 5 · Good",
                4: "4 / 5 · Very Good",
                5: "5 / 5 · Excellent"
            };


            let selectedRating =
                parseInt(
                    ratingInput?.value || "0"
                );


            function paintStars(rating) {

                stars.forEach(
                    function (star) {

                        const starValue =
                            parseInt(
                                star.dataset.rating
                            );

                        star.classList.toggle(
                            "active",
                            starValue <= rating
                        );

                    }
                );

            }


            // Restore rating after validation
            if (selectedRating > 0) {

                paintStars(
                    selectedRating
                );

                if (ratingText) {

                    ratingText.textContent =
                        ratingLabels[
                            selectedRating
                        ];

                }

            }


            stars.forEach(
                function (star) {

                    star.addEventListener(
                        "mouseenter",
                        function () {

                            paintStars(
                                parseInt(
                                    star.dataset.rating
                                )
                            );

                        }
                    );


                    star.addEventListener(
                        "mouseleave",
                        function () {

                            paintStars(
                                selectedRating
                            );

                        }
                    );


                    star.addEventListener(
                        "click",
                        function () {

                            selectedRating =
                                parseInt(
                                    star.dataset.rating
                                );


                            if (ratingInput) {

                                ratingInput.value =
                                    selectedRating;

                            }


                            paintStars(
                                selectedRating
                            );


                            if (ratingText) {

                                ratingText.textContent =
                                    ratingLabels[
                                        selectedRating
                                    ];

                            }


                            ratingInput?.dispatchEvent(
                                new Event(
                                    "change",
                                    {
                                        bubbles: true
                                    }
                                )
                            );

                        }
                    );

                }
            );


            // ==========================================
            // COMMENT CHARACTER COUNTER
            // ==========================================

            const comment =
                document.getElementById(
                    "feedbackComment"
                );

            const characterCount =
                document.getElementById(
                    "characterCount"
                );


            function updateCharacterCount() {

                if (
                    !comment ||
                    !characterCount
                ) {
                    return;
                }

                characterCount.textContent =
                    comment.value.length;

            }


            updateCharacterCount();


            comment?.addEventListener(
                "input",
                updateCharacterCount
            );

        });

    </script>
}