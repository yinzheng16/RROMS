@page
@model RROMS.Pages.Customer.OrderConfirmationModel
@using System.Globalization
@using RROMS.Models
@{
    ViewData["Title"] = "Order received";
    var receipt = Model.Receipt;
    var ordersUrl = Url.Page("/Customer/Orders/Index");
    var quantity = receipt.Lines.Sum(line => line.Quantity);
    string Money(decimal value) => value.ToString("F2", CultureInfo.InvariantCulture);
}
<link rel="stylesheet" href="~/css/customer-cart.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/customer-order-status.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/customer-order-confirmation-art.css" asp-append-version="true" />
<div class="customer-cart cart-confirmation">
    
    <div class="cart-confirmation__layout">
        <section class="cart-confirmation__welcome" aria-labelledby="order-confirmation-title">
            <span class="cart-confirmation__japanese" lang="ja" aria-hidden="true">ありがとうございます</span>
            <header class="cart-confirmation__heading"><p class="cart-confirmation__eyebrow">YORU IZAKAYA <span aria-hidden="true">·</span> <span lang="ja">ご注文</span></p>
                <span class="cart-confirmation__mark" aria-hidden="true"></span>
                <h1 id="order-confirmation-title">Thank you,<span>from <strong>YORU.</strong></span></h1>
                <p>Your order has been received.</p>
            </header>
            <div class="cart-confirmation__status" data-customer-order-status
                 data-status-url="@Url.Page("/Customer/OrderConfirmation", "Status", new { id = receipt.Id })"
                 data-order-id="@receipt.Id" data-current-status="@receipt.Status">
                <div class="order-status-heading">
                    <span class="status-badge status-@receipt.Status" data-order-status-badge>@RROMS.Pages.Customer.OrderConfirmationModel.StatusLabel(receipt.Status)</span>
                    <button type="button" class="order-status-update" data-order-status-update hidden>
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Update status</span>
                    </button>
                </div>
                <p data-order-status-message>@RROMS.Pages.Customer.OrderConfirmationModel.StatusMessage(receipt.Status)</p>
                <p class="order-status-feedback" data-order-status-feedback role="status" hidden></p>
                <span class="visually-hidden" data-order-status-live role="status" aria-live="polite" aria-atomic="true"></span>
                <noscript><p>Refresh this page to check the latest order status.</p></noscript>
            </div>
            <dl class="cart-confirmation__details">
                <div><dt>Order number</dt><dd class="cart-confirmation__order-number">@receipt.OrderNo</dd></div>
                <div><dt>Order type</dt><dd>@(receipt.OrderType == OrderType.DineIn ? "Dine-in · Reservation" : "Takeaway")</dd></div>
                <div><dt>Placed</dt><dd>@receipt.CreatedAt.ToString("dd MMM yyyy · h:mm tt", CultureInfo.InvariantCulture)</dd></div>
                @if (receipt.ReservationReference is not null)
                {
                    <div><dt>Reservation</dt><dd>@receipt.ReservationReference · @receipt.ReservedAt?.ToString("dd MMM · h:mm tt", CultureInfo.InvariantCulture) · @receipt.Guests @(receipt.Guests == 1 ? "guest" : "guests")</dd></div>
                }
            </dl>
            <section class="cart-confirmation__remarks" aria-labelledby="order-remarks-title">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <div><h2 id="order-remarks-title">Order remarks</h2><p>@(receipt.Notes ?? "No additional remarks.")</p></div>
            </section>
            <div class="cart-confirmation__actions">
                @if (!string.IsNullOrWhiteSpace(ordersUrl))
                {
                    <a href="@ordersUrl" class="btn btn-primary">View my orders</a>
                }
                <a asp-page="/Menu/Index" class="btn btn-primary confirmation-back">← &nbsp; Back to menu</a>
            </div>
        </section>
        <section class="cart-receipt" aria-labelledby="order-dishes-title">
            <header class="cart-receipt__heading">
                <div><h2 id="order-dishes-title">Your order</h2><p>YORU IZAKAYA</p></div>
                <span class="cart-dishes__count">@quantity @(quantity == 1 ? "item" : "items")</span>
            </header>
            <ol class="cart-receipt__lines" role="list">
                @for (int i = 0; i < receipt.Lines.Count; i++)
                {
                    var line = receipt.Lines[i];
                    <li class="cart-receipt__line">
                        <span class="cart-receipt__number" aria-hidden="true">@((i + 1).ToString("D2", CultureInfo.InvariantCulture))</span>
                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                        {
                            <img src="@Url.Content(line.ImageUrl)" alt="@line.Name" width="120" height="120" />
                        }
                        else
                        {
                            <span class="cart-line__placeholder" aria-hidden="true">夜</span>
                        }
                        <div class="cart-receipt__line-info">
                            <p class="cart-line__code">@line.Code</p>
                            <h3>@line.Name <span class="cart-receipt__quantity">× @line.Quantity</span></h3>
                            @if (line.Notes is not null)
                            {
                                <p class="cart-receipt__note">@line.Notes</p>
                            }
                        </div>
                        <strong class="cart-receipt__price">RM @Money(line.LineTotal)</strong>
                    </li>
                }
            </ol>
            <dl class="cart-totals cart-receipt__totals">
                <div><dt>Subtotal</dt><dd>RM @Money(receipt.Subtotal)</dd></div>
                <div><dt>Service charge</dt><dd>RM @Money(receipt.ServiceCharge)</dd></div>
                <div><dt>Tax</dt><dd>RM @Money(receipt.Tax)</dd></div>
                <div class="cart-totals__total"><dt>Total</dt><dd>RM @Money(receipt.Total)</dd></div>
            </dl>
        </section>
    </div>
    <p class="cart-confirmation__hint">Your order is saved. This confirmation is not a payment receipt.</p>
</div>

@section Scripts {
    <script src="~/js/customer-order-status.js" asp-append-version="true"></script>
}
